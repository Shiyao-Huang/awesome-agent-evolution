---
import '../styles/global.css';
import { ctaByLang, footerLinks, navByLang, site } from '@/data/site';
const {
  title = site.title,
  description = site.description,
  image = '/visuals/self-evolve-og.png',
  imageAlt = 'Self Evolve AI 自我进化研究图谱',
  type = 'website',
  publishedTime,
  modifiedTime,
  pageKeywords = [],
  pageLang = 'zh-CN',
  alternateZh,
  alternateEn,
  xDefault,
  noindex = false
} = Astro.props;
const siteRoot = site.url.endsWith('/') ? site.url : `${site.url}/`;
const basePath = new URL(siteRoot).pathname.replace(/\/$/, '');
const routePath = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || '/'
  : Astro.url.pathname;
const absoluteUrl = (path = '/') => new URL(String(path).replace(/^\//, ''), siteRoot).toString();
const withBase = (path = '/') => `${basePath}${String(path).startsWith('/') ? path : `/${path}`}` || '/';
const canonical = absoluteUrl(routePath);
const zhAlternate = alternateZh ? absoluteUrl(alternateZh) : pageLang === 'zh-CN' ? canonical : undefined;
const enAlternate = alternateEn ? absoluteUrl(alternateEn) : pageLang === 'en' ? canonical : undefined;
const defaultAlternate = xDefault ? absoluteUrl(xDefault) : zhAlternate || canonical;
const langSwitchHref = pageLang === 'en' ? alternateZh : alternateEn;
const langSwitchLabel = pageLang === 'en' ? '中文' : 'EN';
const langKey = pageLang === 'en' ? 'en' : 'zh';
const activeNav = navByLang[langKey];
const activeCta = ctaByLang[langKey];
const activeFooterLinks = footerLinks[langKey];
const mergedKeywords = Array.from(new Set([...site.keywords, ...pageKeywords]));
const keywords = mergedKeywords.join(', ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  description: site.description,
  keywords: site.keywords,
  inLanguage: pageLang === 'en' ? 'en' : 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteRoot}search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: absoluteUrl('/visuals/self-evolve-og.png'),
  sameAs: [site.github, site.discord, site.x],
  description: site.description
};
---
<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="lUfX-2qOvdlsp-7_8lrKY_NMOmuqPu69YzPh7rIJ0p0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {zhAlternate && <link rel="alternate" hreflang="zh-CN" href={zhAlternate} />}
    {enAlternate && <link rel="alternate" hreflang="en" href={enAlternate} />}
    <link rel="alternate" hreflang="x-default" href={defaultAlternate} />
    <link rel="me" href={site.github} />
    <link rel="icon" type="image/svg+xml" href={withBase('/og.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Self Evolve RSS 订阅" href={withBase('/rss.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={pageLang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={pageLang === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:site_name" content={site.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(image)} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:site" content="@SelfEvolveAI" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">{pageLang === 'en' ? 'Skip to content' : '跳到正文'}</a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Self Evolve home"><span class="brand-mark"></span><span>Self Evolve</span></a>
        <nav class="nav-links" aria-label={pageLang === 'en' ? 'Main navigation' : '主导航'}>{activeNav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
        {langSwitchHref && <a class="text-link nav-lang" href={langSwitchHref}>{langSwitchLabel}</a>}
        <a class="button primary nav-cta" href={activeCta.href}>{activeCta.label}</a>
        <button class="menu-btn" id="menu-btn" aria-label={pageLang === 'en' ? 'Open menu' : '打开菜单'}>☰</button>
      </div>
    </header>
    <nav class="mobile-nav" id="mobile-nav" aria-label={pageLang === 'en' ? 'Mobile navigation' : '移动端导航'}>
      {activeNav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <strong>Self Evolve</strong>
          <p>{pageLang === 'en'
            ? 'English core summaries for judging self-evolving AI agents. Chinese pages remain the full evidence source until parity is complete.'
            : '中文默认入口。英文核心摘要已覆盖定义、五类回路和代码 benchmark；完整英文同证据链仍在推进。'}</p>
        </div>
        <nav class="footer-links" aria-label={pageLang === 'en' ? 'Site and source links' : '站点与开源链接'}>
          {activeFooterLinks.map((item) => (
            <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </footer>

    <!-- Mobile menu + Scroll reveal -->
    <script is:inline>
      // Mobile menu
      (function(){
        var btn=document.getElementById('menu-btn');
        var nav=document.getElementById('mobile-nav');
        btn.addEventListener('click',function(){
          nav.classList.toggle('open');
          btn.textContent=nav.classList.contains('open')?'✕':'☰';
        });
        nav.querySelectorAll('a').forEach(function(a){
          a.addEventListener('click',function(){
            nav.classList.remove('open');
            btn.textContent='☰';
          });
        });
      })();

      // Scroll reveal
      (function(){
        var els=document.querySelectorAll('.card,.timeline-item,.metric,.split,.section-head');
        els.forEach(function(el){el.classList.add('reveal')});
        var obs=new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}
          });
        },{threshold:0.01,rootMargin:'0px 0px -40px 0px'});
        els.forEach(function(el){obs.observe(el)});
      })();
    </script>
  </body>
</html>
