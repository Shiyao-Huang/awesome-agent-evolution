---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projects } from '@/data/projects';
import { featuredResearch } from '@/data/research';

const blogPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const researchNotes = (await getCollection('research')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatNumber = (value: number | string) => Number(value || 0).toLocaleString();
const formatDate = (value: Date | string) => new Date(value).toISOString().slice(0, 10);
const projectCount = projects.length;
const articleCount = blogPosts.length + researchNotes.length + featuredResearch.length;
const totalCards = projectCount + articleCount;
---

<BaseLayout
  title="Self Evolve Postcards — 文章、论文与项目卡片墙"
  description="Self Evolve 网站的 postcard card wall：汇总全部博客文章、研究笔记、代表论文与 GitHub 项目，便于分享、扫描与进入详情页。"
>
  <section class="section postcard-hero">
    <div class="container split">
      <div>
        <div class="eyebrow">Postcard Wall</div>
        <h1 class="gradient-text">每个项目和文章都有一张可分享卡片。</h1>
        <p class="lead">将 Self Evolve 的博客、论文、研究笔记和 GitHub 仓库统一成 postcard 视图：一眼看到主题、证据、指标、标签和下一步入口。</p>
        <div class="hero-actions">
          <a class="button primary" href="#articles">浏览文章卡片</a>
          <a class="button" href="#projects">浏览项目卡片</a>
        </div>
      </div>
      <div class="postcard-stats card" aria-label="Postcard coverage metrics">
        <div class="metric"><strong>{totalCards}</strong><span>张 postcard</span></div>
        <div class="metric"><strong>{articleCount}</strong><span>文章/论文/研究卡</span></div>
        <div class="metric"><strong>{projectCount}</strong><span>GitHub 项目卡</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="articles">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Articles</div>
          <h2>文章与研究 postcard</h2>
        </div>
        <p>覆盖博客 MDX、研究 MDX 与代表论文索引；每张卡片保留来源、日期、状态和标签。</p>
      </div>

      <div class="postcard-grid">
        {blogPosts.map((post) => (
          <article class="postcard postcard-article">
            <div class="postcard-topline">
              <span>Blog</span>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </div>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="postcard-meta">作者：{post.data.author}</div>
            <div class="pill-row">{post.data.tags.slice(0, 5).map((tag) => <span class="pill">{tag}</span>)}</div>
            <a class="postcard-link" href={`/blog/${post.id}/`}>阅读全文 →</a>
          </article>
        ))}

        {researchNotes.map((note) => (
          <article class="postcard postcard-research-note">
            <div class="postcard-topline">
              <span>Research Note</span>
              <time datetime={note.data.pubDate.toISOString()}>{formatDate(note.data.pubDate)}</time>
            </div>
            <h3><a href={`/research/${note.id}/`}>{note.data.title}</a></h3>
            <p>{note.data.description}</p>
            <div class="postcard-meta">状态：{note.data.status}{note.data.arxiv ? ` · arXiv: ${note.data.arxiv}` : ''}</div>
            <div class="pill-row">{note.data.tags.slice(0, 5).map((tag) => <span class="pill">{tag}</span>)}</div>
            <a class="postcard-link" href={`/research/${note.id}/`}>查看研究笔记 →</a>
          </article>
        ))}

        {featuredResearch.map((paper) => (
          <article class="postcard postcard-paper">
            <div class="postcard-topline"><span>Featured Paper</span><span>{paper.year}</span></div>
            <h3>{paper.url ? <a href={paper.url} target="_blank" rel="noopener">{paper.title}</a> : paper.title}</h3>
            <p>{paper.insight}</p>
            <div class="postcard-meta">{paper.cluster}{paper.relation ? ` · ${paper.relation}` : ''}</div>
            <div class="pill-row">{paper.tags.slice(0, 5).map((tag) => <span class="pill">{tag}</span>)}</div>
            {paper.url && <a class="postcard-link" href={paper.url} target="_blank" rel="noopener">打开论文来源 →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Projects</div>
          <h2>项目 postcard</h2>
        </div>
        <p>每个仓库卡片显示 stars、forks、语言、协议、活跃度、进化模式与分析报告入口。</p>
      </div>

      <div class="postcard-grid">
        {projects.map((project) => (
          <article class="postcard postcard-project">
            <div class="postcard-topline"><span>{project.category}</span><span>{project.status}</span></div>
            <h3><a href={project.url} target="_blank" rel="noopener">{project.name}</a></h3>
            <p class="postcard-repo">{project.repo}</p>
            <p>{project.description}</p>
            <div class="postcard-metrics">
              <span>★ {formatNumber(project.stars)}</span>
              <span>⑂ {project.forks}</span>
              <span>{project.language}</span>
              <span>{project.license}</span>
            </div>
            <div class="postcard-meta">进化模式：{project.pattern} · 最近活跃：{project.lastPushed.slice(0, 10)}</div>
            <div class="pill-row">{project.tags.slice(0, 5).map((tag) => <span class="pill">{tag}</span>)}</div>
            <div class="postcard-actions">
              <a class="postcard-link" href={project.url} target="_blank" rel="noopener">GitHub →</a>
              <a class="postcard-link" href={`/reports/${project.report}`}>分析报告 →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
