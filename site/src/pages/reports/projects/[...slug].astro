---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const reports = await getCollection('projectReports');
  return reports
    .filter((report) => report.id.toLowerCase() !== 'index')
    .map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const body = report.body ?? '';
const title = body.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? report.id.replace(/-/g, ' ');
const fallbackDescription = `${title} 的 Self Evolve 项目报告证据页：帮助读者检查 GitHub 可见信号、站内归类、机制线索和未复现限制；不是项目质量排名。`;
const lead = `这是 review-gated 项目报告证据页：它保留 ${title} 的源材料入口、机制线索和限制提醒，但正文尚未完成逐篇 reader/editor 与 academic public-copy review。`;
const descriptionSource = fallbackDescription;
const safeDescription = descriptionSource
  .replace(/->/g, ' to ')
  .replace(/[<>]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const description = safeDescription.length > 155 ? `${safeDescription.slice(0, 152)}...` : safeDescription;
const sourceUrl = `${site.github}/blob/main/site/public/reports/projects/${report.id}.md`;
const canonical = new URL(`/reports/projects/${report.id}/`, site.url).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'zh-CN',
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: canonical,
  isBasedOn: sourceUrl,
  about: ['self-evolving AI agents', 'AI agent project report', 'GitHub evidence map']
};
---
<BaseLayout
  title={`${title} | Self Evolve 项目报告`}
  description={description}
  type="article"
  pageKeywords={['Self Evolve project report', 'AI agent evolution', 'GitHub project analysis', title]}
  noindex={true}
>
  <article class="blog-article">
    <div class="eyebrow">Project report / GitHub evidence</div>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <div class="pill-row">
      <a class="pill" href="/reports/">报告索引</a>
      <a class="pill" href="/projects/">项目索引</a>
      <a class="pill" href={sourceUrl} target="_blank" rel="noopener">Markdown source</a>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <aside class="source-panel" aria-label="项目报告阅读边界">
      <div>
        <div class="eyebrow">How to read / 如何阅读</div>
        <h2>先看证据从哪里来，再判断是否值得深读</h2>
        <p>这类页面是项目报告的公开阅读入口，作用是把 GitHub 可见信号、站内分类、机制猜想和限制放在一起。它不是质量排名，不代表我们已经克隆源码、复跑 benchmark 或完成学术复核。</p>
        <p><strong>English:</strong> This page is a review-gated evidence snapshot. It supports source tracing and follow-up reading; it does not prove project quality, reproduce benchmarks, or endorse the repository. Use the source file, original GitHub repository, and limitation section before citing any claim.</p>
      </div>
      <div class="source-links">
        <a href={sourceUrl} target="_blank" rel="noopener">查看 Markdown 源文件</a>
        <a href="/projects/">从项目索引比较同类项目</a>
        <a href="/evolve-agi-index/">查看证据指数边界</a>
      </div>
    </aside>
    <aside class="source-panel" aria-label="未逐篇审查正文边界">
      <div>
        <div class="eyebrow">Legacy body / 未逐篇审查正文</div>
        <h2>下面正文保留为可访问证据材料，但暂不进入搜索索引</h2>
        <p>正文可能仍含旧报告里的强 claim、内部分析段或待补信息。当前模板已给出证据边界并设置 noindex；下一批会按 reader/editor 与 academic gate 逐篇决定重写、强化、降权或恢复索引。</p>
      </div>
      <div class="source-links">
        <a href="/reports/">查看报告索引</a>
        <a href="/projects/">回到项目证据入口</a>
      </div>
    </aside>
    <Content />
    <aside class="source-panel" aria-label="项目报告证据链">
      <div>
        <div class="eyebrow">Evidence trail / 证据链</div>
        <h2>从公开报告回到源材料</h2>
        <p>原始报告保留在 `site/public/reports/projects/`。如果正文里出现 benchmark、star、release、license 或能力描述，请优先检查源文件、GitHub 仓库和报告中的限制段落。</p>
      </div>
      <div class="source-links">
        <a href={sourceUrl} target="_blank" rel="noopener">查看 Markdown 源文件</a>
        <a href="/reports/">返回报告索引</a>
        <a href={`/search/?q=${encodeURIComponent(title)}`}>搜索相关材料</a>
      </div>
    </aside>
  </article>
</BaseLayout>
