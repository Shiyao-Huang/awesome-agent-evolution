---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { Content } from '../../../../../reports/survey-publication/README.md';

const title = 'Survey Publication Pack: Value-First Release Plan';
const description = 'Indexable publication plan for the Self Evolve survey package: release slices, reader decisions, Hacker News fit, quality bar, and source anchors.';
const canonical = new URL('/reports/survey-publication/overview/', site.url).toString();
const sourceUrl = `${site.github}/blob/main/reports/survey-publication/README.md`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'en',
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: canonical,
  isBasedOn: sourceUrl,
  about: ['self-evolving AI agents', 'AI agent survey', 'publication plan', 'SEO evidence asset']
};
---
<BaseLayout
  title={`${title} | Self Evolve Survey Publication`}
  description={description}
  type="article"
  pageLang="en"
  pageKeywords={['Self Evolve survey', 'survey publication plan', 'self-evolving AI agents', 'SEO evidence asset']}
>
  <article class="blog-article">
    <div class="eyebrow">Survey publication overview / Indexable release plan</div>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="pill-row">
      <a class="pill" href="/reports/">Reports index</a>
      <a class="pill" href="/survey/">Survey hub</a>
      <a class="pill" href={sourceUrl} target="_blank" rel="noopener">Markdown source</a>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <aside class="source-panel" aria-label="Survey publication overview evidence boundary">
      <div>
        <div class="eyebrow">How to read</div>
        <h2>Read this as the public release plan for the survey slices</h2>
        <p>This page makes the publication plan itself indexable: release order, HN fit, quality bar, and source anchors are public assets rather than hidden repository notes.</p>
        <p><strong>中文:</strong> 这是 survey 发布计划的可索引公开入口，不是内部操作手册；它说明每个切片如何服务读者决策与证据追溯。</p>
      </div>
      <div class="source-links">
        <a href={sourceUrl} target="_blank" rel="noopener">Open source Markdown</a>
        <a href="/reports/survey-publication/01-field-map/">Start with Slice 01</a>
        <a href="/projects/">Inspect project evidence cards</a>
      </div>
    </aside>
    <Content />
  </article>
</BaseLayout>
