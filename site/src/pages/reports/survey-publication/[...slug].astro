---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const reports = await getCollection('surveyPublication');
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const body = report.body ?? '';
const title = body.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? report.id.replace(/-/g, ' ');
const lead = `This is a review-gated survey publication slice for ${title}. It is accessible for editorial review, but it is noindexed until bilingual same-evidence copy and academic claim checks pass.`;
const description = lead.length > 155 ? `${lead.slice(0, 152)}...` : lead;
const canonical = new URL(`/reports/survey-publication/${report.id}/`, site.url).toString();
const sourceUrl = `${site.github}/blob/main/reports/survey-publication/${report.id}.md`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'en',
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: canonical,
  isBasedOn: sourceUrl,
  about: ['self-evolving AI agents', 'AI agent survey', 'AI agent evaluation', 'open-source evidence atlas']
};
---
<BaseLayout
  title={`${title} | Self Evolve Survey Publication`}
  description={description}
  type="article"
  pageLang="en"
  pageKeywords={['Self Evolve survey', 'self-evolving AI agents', 'AI agent evidence atlas', title]}
  noindex={true}
>
  <article class="blog-article">
    <div class="eyebrow">Survey publication slice / Evidence-backed article</div>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <div class="pill-row">
      <a class="pill" href="/reports/">Reports index</a>
      <a class="pill" href="/survey/">Survey hub</a>
      <a class="pill" href={sourceUrl} target="_blank" rel="noopener">Markdown source</a>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <aside class="source-panel" aria-label="Survey publication evidence boundary">
      <div>
        <div class="eyebrow">How to read</div>
        <h2>Read this as a review-gated publication slice, not as a final standalone paper</h2>
        <p>Each slice compresses survey, wiki, project-card, and report evidence into one public-article draft. Claims should remain traceable to the Evidence Chain section and to the linked Markdown source; search indexing stays disabled until the bilingual and academic review gates pass.</p>
        <p><strong>中文:</strong> 这是面向全球读者的发布切片候选，不是内部操作手册，也不是已完成双语发布；它需要补齐中文同证据链和学术 claim 复核后，才恢复索引。</p>
      </div>
      <div class="source-links">
        <a href={sourceUrl} target="_blank" rel="noopener">Open source Markdown</a>
        <a href="/graph/">Explore the knowledge graph</a>
        <a href="/projects/">Inspect project evidence cards</a>
      </div>
    </aside>
    <Content />
  </article>
</BaseLayout>
