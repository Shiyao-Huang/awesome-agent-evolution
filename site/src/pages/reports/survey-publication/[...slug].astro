---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const reports = await getCollection('surveyPublication');
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const body = report.body ?? '';
const title = body.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? report.id.replace(/-/g, ' ');
const cleanMarkdown = (value: string) =>
  value
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[`*_~]/g, '')
    .replace(/->/g, ' to ')
    .replace(/[<>]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
const paragraph = body
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter((block) => block && !block.startsWith('#') && !block.startsWith('|') && !block.startsWith('```') && !block.startsWith('>'))
  .map(cleanMarkdown)
  .find((block) => block.length >= 50);
const fallbackDescription = `${title} is a Self Evolve survey publication slice that turns papers, projects, benchmarks, and public evidence into an indexable article asset.`;
const lead = paragraph ?? fallbackDescription;
const description = lead.length > 155 ? `${lead.slice(0, 152)}...` : lead;
const canonical = new URL(`/reports/survey-publication/${report.id}/`, site.url).toString();
const sourceUrl = `${site.github}/blob/main/reports/survey-publication/${report.id}.md`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'en',
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: canonical,
  isBasedOn: sourceUrl,
  about: ['self-evolving AI agents', 'AI agent survey', 'AI agent evaluation', 'open-source evidence atlas']
};
---
<BaseLayout
  title={`${title} | Self Evolve Survey Publication`}
  description={description}
  type="article"
  pageLang="en"
  pageKeywords={['Self Evolve survey', 'self-evolving AI agents', 'AI agent evidence atlas', title]}
>
  <article class="blog-article">
    <div class="eyebrow">Survey publication slice / Evidence-backed article</div>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <div class="pill-row">
      <a class="pill" href="/reports/">Reports index</a>
      <a class="pill" href="/survey/">Survey hub</a>
      <a class="pill" href={sourceUrl} target="_blank" rel="noopener">Markdown source</a>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <aside class="source-panel" aria-label="Survey publication evidence boundary">
      <div>
        <div class="eyebrow">How to read</div>
        <h2>Read this as an indexable publication slice, not as a final standalone paper</h2>
        <p>Each slice compresses survey, wiki, project-card, and report evidence into one public article. Claims should remain traceable to the Evidence Chain section and to the linked Markdown source; later reader/editor and academic review can still strengthen or demote specific claims.</p>
        <p><strong>中文:</strong> 这是面向全球读者的可索引发布切片，不是内部操作手册；它把 survey、wiki、项目报告和 evidence chain 压缩成公开文章资产。</p>
      </div>
      <div class="source-links">
        <a href={sourceUrl} target="_blank" rel="noopener">Open source Markdown</a>
        <a href="/graph/">Explore the knowledge graph</a>
        <a href="/projects/">Inspect project evidence cards</a>
      </div>
    </aside>
    <Content />
  </article>
</BaseLayout>
