---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import growthSnapshotJson from '../../../../analysis/github-star-growth-ranking.json';

interface GrowthRow {
  rank: number;
  repo: string;
  url: string;
  category: string;
  evolution_focused: boolean;
  current_total_stars: number;
  fetched_star_events: number;
  coverage_status: string;
  new_stars_year: number;
  new_stars_recent_90d: number;
  growth_quality_score: number;
  raw_time_slice: string | null;
  public_report: string | null;
  created_at: string | null;
  pushed_at: string | null;
  first_starred_at: string | null;
  last_starred_at: string | null;
  fetch_priority_rank: number | null;
}

interface GrowthSnapshot {
  generated_at: string;
  ranking_year: number;
  since: string;
  counts: Record<string, number>;
  coverage_qualified_ranking: GrowthRow[];
  fetch_priority_backlog: GrowthRow[];
}

const snapshot = growthSnapshotJson as GrowthSnapshot;
const counts = snapshot.counts;
const qualifiedRows = snapshot.coverage_qualified_ranking;
const backlogRows = snapshot.fetch_priority_backlog.slice(0, 20);
const generatedDate = snapshot.generated_at.slice(0, 10);
const coverageRate = counts.seed_repositories
  ? Math.round((counts.repos_complete_or_near_complete / counts.seed_repositories) * 1000) / 10
  : 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'GitHub Star Growth Pilot Ledger for Self-Evolving AI Agents',
  alternateName: 'AI 自进化项目 2026 新增 Star 增长试点账本',
  description: 'Coverage-aware GitHub stargazer history pilot ledger for inspecting self-evolving AI agent projects by 2026 new-star momentum instead of historical total stars.',
  url: `${site.url}/star-growth/`,
  inLanguage: 'zh-CN',
  dateModified: snapshot.generated_at,
  isPartOf: { '@id': `${site.url}/#website` },
  measurementTechnique: 'GitHub REST stargazers API with starred_at timestamps and coverage-qualified ranking gates',
  variableMeasured: ['new_stars_2026', 'recent_90d_stars', 'coverage_status', 'growth_quality_score'],
};
---

<BaseLayout
  title="2026 GitHub Star 增长试点账本 — Self Evolve"
  description="Self Evolve 的 2026 GitHub 新增 Star 增长试点账本：把累计 Star 降为历史 adoption prior，用 stargazer history、覆盖状态和近期增长记录自进化项目当前动量。"
  pageKeywords={['GitHub star growth pilot ledger', '2026 new stars', 'AI agent momentum evidence', '自进化项目增长', 'coverage status']}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <style>
    .star-growth-page {
      max-width: 100%;
      overflow-x: hidden;
    }

    .star-growth-page :is(h1, h2, h3, p, strong, td, th, a) {
      overflow-wrap: anywhere;
    }

    .growth-rule {
      display: grid;
      gap: 12px;
      margin-top: 20px;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface-1);
    }

    .growth-rule code {
      color: var(--accent);
      font-weight: 800;
    }

    .growth-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .growth-metric {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 14px;
      background: var(--surface-1);
    }

    .growth-metric strong {
      display: block;
      font-family: var(--font-display);
      font-size: 34px;
      font-weight: 500;
      line-height: 1;
    }

    .growth-metric span {
      display: block;
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 750;
    }

    .growth-alert {
      border-left: 3px solid var(--caret-blue);
      padding: 12px 14px;
      background: var(--surface-1);
      color: var(--muted);
      line-height: 1.65;
    }

    .growth-table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface-card);
    }

    .growth-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .growth-table th {
      text-align: left;
      padding: 10px;
      border-bottom: 2px solid var(--line);
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .growth-table td {
      padding: 10px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }

    .growth-table tr:last-child td {
      border-bottom: 0;
    }

    .growth-table a {
      color: var(--fg);
      font-weight: 800;
      text-decoration: none;
    }

    .growth-table a:hover {
      color: var(--accent);
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 3px 8px;
      background: var(--surface-2);
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      white-space: nowrap;
    }

    .status-pill.good {
      border-color: rgba(46, 111, 78, .22);
      background: rgba(46, 111, 78, .08);
      color: var(--success);
    }

    .status-pill.waiting {
      border-color: rgba(165, 97, 23, .22);
      background: rgba(165, 97, 23, .08);
      color: var(--warn);
    }

    .growth-lanes {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 16px;
    }

    .growth-lane {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 16px;
      background: var(--surface-1);
    }

    .growth-lane ul {
      display: grid;
      gap: 10px;
      margin: 12px 0 0;
      padding-left: 18px;
      color: var(--muted);
      line-height: 1.65;
    }

    @media (max-width: 820px) {
      .growth-grid,
      .growth-lanes {
        grid-template-columns: 1fr;
      }

      .star-growth-page .hero h1 {
        font-size: 34px;
        line-height: 1.12;
      }

      .star-growth-page .hero-actions .button {
        flex: 1 1 100%;
        min-width: 100%;
        padding-inline: 12px;
      }
    }
  </style>

  <div class="star-growth-page">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">GitHub Star Growth / Current Momentum</div>
          <h1>不要再用累计 Star 判断当前价值。</h1>
          <p class="lead">这个页面把 GitHub stars 从“历史热度榜”改成“2026 新增 Star + 近期速度 + 覆盖状态”的证据账本。它现在是覆盖试点，不是假装完成的最终排行榜。</p>
          <div class="hero-actions">
            <a class="button primary" href="#qualified">看可发布排名</a>
            <a class="button" href="#backlog">看抓取队列</a>
            <a class="button" href="/evolve-agi-index/">回到 AGI Index</a>
            <a class="text-link" href="/star-analysis/">旧 Star 质量分析</a>
          </div>
          <div class="growth-rule">
            <strong>Public-use rule</strong>
            <p>只有 <code>coverage_status = complete_or_near_complete</code> 的项目可以进入 2026 增长结论；<code>not_fetched</code> 只说明还没抓取，不能解释成“没有需求”。</p>
          </div>
        </div>
        <aside class="hero-evidence" aria-label="Star growth evidence boundary">
          <div class="eyebrow">Snapshot</div>
          <ol>
            <li><span>Generated</span><strong>{generatedDate}</strong></li>
            <li><span>Seed repos</span><strong>{counts.seed_repositories}</strong></li>
            <li><span>Qualified</span><strong>{counts.coverage_qualified_rows}</strong></li>
            <li><span>Backlog</span><strong>{counts.fetch_backlog_rows}</strong></li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="section" style="background: var(--surface-1);">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Coverage audit</div>
            <h2>这是增长试点账本的覆盖状态，不是最终名次</h2>
          </div>
        </div>
        <div class="growth-grid">
          <div class="growth-metric"><strong>{counts.seed_repositories}</strong><span>seed repositories</span></div>
          <div class="growth-metric"><strong>{counts.star_events_deduped}</strong><span>deduped star events</span></div>
          <div class="growth-metric"><strong>{counts.repos_complete_or_near_complete}</strong><span>complete repos</span></div>
          <div class="growth-metric"><strong>{coverageRate}%</strong><span>coverage-qualified repo share</span></div>
        </div>
        <p class="growth-alert" style="margin-top:16px;">当前只有 {counts.coverage_qualified_rows} 个项目可用于正式 2026 new-star 结论；其余 {counts.repos_not_fetched} 个项目是抓取 backlog。这样公开展示是为了防止读者把“缺数据”误读成“没增长”。</p>
      </div>
    </section>

    <section class="section" id="qualified">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Coverage-qualified ranking</div>
            <h2>可发布的 2026 增长证据</h2>
          </div>
          <a class="text-link" href="https://github.com/Shiyao-Huang/awesome-agent-evolution/blob/main/analysis/github-star-growth-ranking.md" target="_blank" rel="noopener">分析来源</a>
        </div>
        <div class="growth-table-wrap">
          <table class="growth-table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Repo</th>
                <th>2026 new</th>
                <th>Recent 90d</th>
                <th>Total</th>
                <th>Score</th>
                <th>Coverage</th>
                <th>Window</th>
              </tr>
            </thead>
            <tbody>
              {qualifiedRows.map((row) => (
                <tr>
                  <td>{row.rank}</td>
                  <td>
                    <a href={row.url} target="_blank" rel="noopener">{row.repo}</a>
                    <div style="color:var(--muted);font-size:12px">{row.category}</div>
                  </td>
                  <td>{row.new_stars_year}</td>
                  <td>{row.new_stars_recent_90d}</td>
                  <td>{row.current_total_stars}</td>
                  <td>{Math.round(row.growth_quality_score)}</td>
                  <td><span class="status-pill good">{row.coverage_status}</span></td>
                  <td>{row.first_starred_at?.slice(0, 10)} -> {row.last_starred_at?.slice(0, 10)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="backlog" style="background: var(--surface-1);">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Fetch priority backlog</div>
            <h2>下一轮应该先抓哪些项目</h2>
          </div>
        </div>
        <p class="growth-alert" style="margin-bottom:16px;">下面这些不是增长排名。它们只是按 adoption prior 和 corpus 覆盖排序的抓取预算队列，用来决定下一次 GitHub API pagination 应该花在哪里。</p>
        <div class="growth-table-wrap">
          <table class="growth-table">
            <thead>
              <tr>
                <th>Fetch</th>
                <th>Repo</th>
                <th>Total hint</th>
                <th>Evolution</th>
                <th>Raw time</th>
                <th>Coverage</th>
              </tr>
            </thead>
            <tbody>
              {backlogRows.map((row) => (
                <tr>
                  <td>{row.fetch_priority_rank}</td>
                  <td>
                    <a href={row.url} target="_blank" rel="noopener">{row.repo}</a>
                    <div style="color:var(--muted);font-size:12px">{row.category}</div>
                  </td>
                  <td>{row.current_total_stars.toLocaleString()}</td>
                  <td>{row.evolution_focused ? 'yes' : 'no'}</td>
                  <td>{row.raw_time_slice ?? '-'}</td>
                  <td><span class="status-pill waiting">{row.coverage_status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Dataset path</div>
            <h2>从网站页面到 Hugging Face 数据集</h2>
          </div>
        </div>
        <div class="growth-lanes">
          <div class="growth-lane">
            <h3>现在已经有的表</h3>
            <ul>
              <li><strong>repos.seed.jsonl</strong>：全 GitHub corpus 的 repo seed。</li>
              <li><strong>repo-star-snapshots.jsonl</strong>：GitHub API snapshot。</li>
              <li><strong>star-events.jsonl</strong>：带 <code>starred_at</code> 的去标识化 star event。</li>
              <li><strong>monthly-repo-star-growth.csv</strong>：repo-month 增量聚合。</li>
            </ul>
          </div>
          <div class="growth-lane">
            <h3>进入 Evolve-AGI Index 前的门槛</h3>
            <ul>
              <li>strict evolution repos 优先全量分页。</li>
              <li>每个公开 growth claim 必须有完整或近完整覆盖。</li>
              <li>累计 Star 只作为 fetch backlog 和 adoption prior。</li>
              <li>发布前补 dataset card、license/source boundary 和 refresh log。</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
