---
import BaseLayout from '@/layouts/BaseLayout.astro';

type PropProject = {
  name: string; repo: string; url: string; stars: number;
  generation: string; relevance: string; pattern: string;
};

const propProjects: PropProject[] = [
  { name: 'AutoGPT', repo: 'Significant-Gravitas/AutoGPT', url: 'https://github.com/Significant-Gravitas/AutoGPT', stars: 175000, generation: 'G1', relevance: 'high', pattern: 'Autonomous Agent' },
  { name: 'MetaGPT', repo: 'geekan/MetaGPT', url: 'https://github.com/geekan/MetaGPT', stars: 52000, generation: 'G1', relevance: 'high', pattern: 'Multi-Agent Framework' },
  { name: 'ChatDev', repo: 'OpenBMB/ChatDev', url: 'https://github.com/OpenBMB/ChatDev', stars: 26000, generation: 'G1', relevance: 'high', pattern: 'Communication-driven' },
  { name: 'GPT-Engineer', repo: 'gpt-engineer-org/gpt-engineer', url: 'https://github.com/gpt-engineer-org/gpt-engineer', stars: 53000, generation: 'G1', relevance: 'high', pattern: 'Code Generation' },
  { name: 'OpenHands', repo: 'All-Hands-AI/OpenHands', url: 'https://github.com/All-Hands-AI/OpenHands', stars: 40000, generation: 'G1', relevance: 'high', pattern: 'Code Agent Platform' },
  { name: 'Devin', repo: 'coding/cognition', url: '#', stars: 28000, generation: 'G1', relevance: 'medium', pattern: 'Autonomous Dev' },
  { name: 'SWE-Agent', repo: 'princeton-nlp/SWE-agent', url: 'https://github.com/princeton-nlp/SWE-agent', stars: 14000, generation: 'G2', relevance: 'high', pattern: 'Issue Resolution' },
  { name: 'Aider', repo: 'paul-gauthier/aider', url: 'https://github.com/paul-gauthier/aider', stars: 27000, generation: 'G2', relevance: 'high', pattern: 'Pair Programming AI' },
  { name: 'Cline', repo: 'cline/cline', url: 'https://github.com/cline/cline', stars: 30000, generation: 'G2', relevance: 'high', pattern: 'Autonomous Coding' },
  { name: 'Cursor', repo: 'getcursor/cursor', url: 'https://github.com/getcursor/cursor', stars: 32000, generation: 'G2', relevance: 'medium', pattern: 'AI Editor' },
  { name: 'Devika', repo: 'stitionai/devika', url: 'https://github.com/stitionai/devika', stars: 21000, generation: 'G2', relevance: 'low', pattern: 'Me-too Devin' },
  { name: 'OpenDevin', repo: 'OpenDevin/OpenDevin', url: 'https://github.com/OpenDevin/OpenDevin', stars: 30000, generation: 'G2', relevance: 'medium', pattern: 'Open Devin Fork' },
  { name: 'DSPy', repo: 'stanfordnlp/dspy', url: 'https://github.com/stanfordnlp/dspy', stars: 21000, generation: 'G2', relevance: 'high', pattern: 'Programmatic LM' },
  { name: 'OpenEvolve', repo: 'algorithmicsuperintelligence/openevolve', url: 'https://github.com/algorithmicsuperintelligence/openevolve', stars: 6358, generation: 'G3', relevance: 'high', pattern: 'Code Self-Improvement' },
  { name: 'Agentless', repo: 'OpenAutoCoder/Agentless', url: 'https://github.com/OpenAutoCoder/Agentless', stars: 4300, generation: 'G3', relevance: 'high', pattern: 'Repair without Agent' },
  { name: 'AFL', repo: 'google/AFL', url: 'https://github.com/google/AFL', stars: 3600, generation: 'G3', relevance: 'high', pattern: 'Fuzzing Evolution' },
  { name: 'FunSearch', repo: 'google-deepmind/funsearch', url: 'https://github.com/google-deepmind/funsearch', stars: 5300, generation: 'G3', relevance: 'high', pattern: 'LLM + Evolution' },
  { name: 'AlphaCode', repo: 'google-deepmind/alphacode', url: 'https://github.com/google-deepmind/alphacode', stars: 4200, generation: 'G3', relevance: 'high', pattern: 'Competitive Coding' },
  { name: 'Reflexion', repo: 'noahshinn/reflexion', url: 'https://github.com/noahshinn/reflexion', stars: 2800, generation: 'G3', relevance: 'high', pattern: 'Self-Reflection' },
  { name: 'Self-Refine', repo: 'madaan/self-refine', url: 'https://github.com/madaan/self-refine', stars: 1800, generation: 'G3', relevance: 'high', pattern: 'Iterative Refinement' },
];

const pp = JSON.stringify(propProjects);
const maxStars = Math.max(...propProjects.map(p => p.stars));
const genColors: Record<string, string> = { G1: '#FF5B00', G2: '#007AFF', G3: '#2E6F4E' };
const relOrder: Record<string, number> = { high: 3, medium: 2, low: 1 };
---

<BaseLayout
  title="传播链分析 — Self Evolve 项目扩散与代际证据"
  description="AI Agent 领域 GitHub 项目的传播链重构：三代项目（G1/G2/G3）的演化脉络与 Bubble 可视化。"
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">Propagation Analysis</div>
      <h1 class="gradient-text">传播链分析</h1>
      <p class="lead">从 G1 开创者到 G3 自进化：三代项目的演化脉络</p>
      <p style="color:var(--muted);margin-top:8px">展示 {propProjects.length} 个代表性项目的代际关系与星标规模</p>
    </div>
  </section>

  <!-- Legend -->
  <section class="section">
    <div class="container">
      <div class="prop-legend">
        {Object.entries(genColors).map(([gen, color]) => (
          <span class="prop-legend-item"><span class="prop-dot" style={`background:${color}`}></span>{gen === 'G1' ? 'G1 开创者' : gen === 'G2' ? 'G2 发展者' : 'G3 自进化'}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Bubble Chart -->
  <section class="section">
    <div class="container">
      <div class="prop-chart-wrap">
        <svg id="prop-svg" viewBox="0 0 900 500" role="img" aria-label="Project propagation bubble chart"></svg>
      </div>
    </div>
  </section>

  <!-- Table -->
  <section class="section">
    <div class="container">
      <div class="prop-table-wrap">
        <table class="prop-table">
          <thead>
            <tr>
              <th>Generation</th>
              <th>Project</th>
              <th>Stars</th>
              <th>Pattern</th>
              <th>Relevance</th>
            </tr>
          </thead>
          <tbody>
            {propProjects.sort((a, b) => {
              const genDiff = a.generation.localeCompare(b.generation);
              if (genDiff !== 0) return genDiff;
              return b.stars - a.stars;
            }).map(p => (
              <tr>
                <td><span class="prop-gen" style={`background:${genColors[p.generation] || '#888'};color:#fff`}>{p.generation}</span></td>
                <td class="prop-name"><a href={p.url} target="_blank" rel="noopener">{p.name}</a><span class="prop-repo">{p.repo}</span></td>
                <td class="prop-stars">{p.stars.toLocaleString()}</td>
                <td>{p.pattern}</td>
                <td><span class={`prop-rel prop-rel-${p.relevance}`}>{p.relevance}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ pp, maxStars }}>
const projects = JSON.parse(pp);
const svg = document.getElementById('prop-svg');
if (!svg) throw new Error('no svg');

const genColors = { G1: '#FF5B00', G2: '#007AFF', G3: '#2E6F4E' };
const genX = { G1: 200, G2: 450, G3: 700 };

const byGen = { G1: [], G2: [], G3: [] };
projects.forEach(p => { if (byGen[p.generation]) byGen[p.generation].push(p); });

const rows = [];
Object.entries(byGen).forEach(([gen, list]) => {
  list.sort((a, b) => b.stars - a.stars);
  const cx = genX[gen];
  const totalH = list.length * 60;
  const startY = 250 - totalH / 2 + 30;
  list.forEach((p, i) => {
    const r = Math.max(14, Math.sqrt(p.stars / maxStars) * 45);
    const cy = startY + i * 60;
    rows.push({ ...p, cx, cy, r });
  });
});

rows.forEach(p => {
  const col = genColors[p.generation] || '#888';
  const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');

  const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  circle.setAttribute('cx', p.cx);
  circle.setAttribute('cy', p.cy);
  circle.setAttribute('r', p.r);
  circle.setAttribute('fill', col + '30');
  circle.setAttribute('stroke', col);
  circle.setAttribute('stroke-width', '2');
  g.appendChild(circle);

  if (p.r > 20) {
    const tx = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    tx.setAttribute('x', p.cx);
    tx.setAttribute('y', p.cy);
    tx.setAttribute('text-anchor', 'middle');
    tx.setAttribute('dominant-baseline', 'middle');
    tx.setAttribute('fill', col);
    tx.setAttribute('font-size', '10');
    tx.setAttribute('font-weight', '700');
    tx.textContent = p.name.length > 10 ? p.name.slice(0, 9) + '\u2026' : p.name;
    g.appendChild(tx);
  }

  const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
  title.textContent = p.name + ' (' + p.stars.toLocaleString() + ' stars, ' + p.generation + ')';
  g.appendChild(title);

  svg.appendChild(g);
});

['G1 开创者', 'G2 发展者', 'G3 自进化'].forEach((label, i) => {
  const gen = ['G1', 'G2', 'G3'][i];
  const tx = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  tx.setAttribute('x', genX[gen]);
  tx.setAttribute('y', 480);
  tx.setAttribute('text-anchor', 'middle');
  tx.setAttribute('fill', 'var(--muted)');
  tx.setAttribute('font-size', '13');
  tx.setAttribute('font-weight', '700');
  tx.textContent = label;
  svg.appendChild(tx);
});
</script>

<style>
.prop-legend{display:flex;gap:16px;flex-wrap:wrap}
.prop-legend-item{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--fg)}
.prop-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.prop-chart-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
#prop-svg{width:100%;max-width:900px;height:auto}
.prop-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.prop-table{width:100%;border-collapse:collapse;font-size:13px}
.prop-table th{text-align:left;padding:8px 10px;border-bottom:2px solid var(--line);color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}
.prop-table td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
.prop-table tr:hover td{background:var(--surface-2)}
.prop-gen{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:800}
.prop-name a{font-weight:700;color:var(--fg);text-decoration:none}.prop-name a:hover{color:var(--accent)}
.prop-repo{display:block;font-size:11px;color:var(--meta);margin-top:2px}
.prop-stars{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
.prop-rel{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:750;text-transform:uppercase}
.prop-rel-high{background:#2E6F4E20;color:#2E6F4E}
.prop-rel-medium{background:#A5611720;color:#A56117}
.prop-rel-low{background:#B8322420;color:#B83224}
@media(max-width:760px){.prop-table{font-size:12px}#prop-svg{min-width:600px}}
</style>
