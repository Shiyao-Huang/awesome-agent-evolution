---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '@/data/site';
const posts = (await getCollection('blog')).filter((p)=>!p.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featuredPost = posts[0];
const otherPosts = posts.slice(1);
const readingRoutes = [
  {
    title: '第一次理解自进化 Agent',
    description: '先读概念入口，再看五个循环，把“反思、搜索、评估、记忆、种群”放进同一张图。',
    href: '/blog/self-evolving-ai-introduction-static-to-evolving-agents/'
  },
  {
    title: '做技术选型',
    description: '从项目索引进入 GitHub 仓库，检查 stars、活跃度、许可证、技术栈和 model card 判断。',
    href: '/projects/'
  },
  {
    title: '写论文或做综述',
    description: '从研究图谱进入论文、benchmark 和 coverage gap，避免只看名字里带 evolution 的项目。',
    href: '/research/'
  },
  {
    title: '复查原始材料',
    description: '所有站点内容都应能回到 GitHub 仓库、论文草稿、项目分析或 raw 素材。',
    href: '/github/'
  }
];
---
<BaseLayout
  title="Self Evolve 博客 — AI 自我进化实践笔记与证据导读"
  description="围绕自进化智能体、LLM 迭代优化、代码自我改进、评测闭环和公开项目证据链的中文默认研究笔记；英文入口汇总核心阅读路径。"
  alternateZh="/blog/"
  alternateEn="/en/blog/"
>
  <section class="section blog-index-hero">
    <div class="container">
      <div>
        <div class="eyebrow">博客</div>
        <h1>Self Evolve 实践笔记</h1>
        <p class="lead">把自进化智能体、LLM 迭代优化、代码自我改进和评测闭环写成可搜索、可引用、能继续生长的研究笔记；中文是默认全文入口，英文页先提供同证据链的阅读路径和边界说明。</p>
      </div>
      <aside class="blog-note">
        <p>博客是这个站点的阅读入口：先用短文章建立概念，再进入项目 model card、论文精读和知识图谱。</p>
        <div class="pill-row">
          <a class="pill" href="/rss.xml">RSS</a>
          <a class="pill" href="/research/">研究图谱</a>
          <a class="pill" href="/projects/">项目索引</a>
          <a class="pill" href="/en/blog/">English guide</a>
          <a class="pill" href={site.github} target="_blank" rel="noopener">GitHub</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top: 20px">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Reading routes</div>
          <h2>按任务选择阅读路径</h2>
        </div>
        <a class="button" href="/github/">查看 GitHub 证据链</a>
      </div>
      <div class="grid">
        {readingRoutes.map((route) => (
          <article class="card">
            <h3><a href={route.href}>{route.title}</a></h3>
            <p>{route.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {featuredPost && (
    <section class="section" style="padding-top: 20px">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">最新文章</div>
            <h2>从最新一篇开始读</h2>
          </div>
        </div>
        <article class="post-card">
          <div class="post-number">01</div>
          <div>
            <h2><a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
            <p>{featuredPost.data.description}</p>
            <div class="pill-row">{featuredPost.data.tags.map((tag)=><a class="pill" href={`/blog/tag/${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
          </div>
          <div class="post-meta">{featuredPost.data.pubDate.toISOString().slice(0,10)}<br />{featuredPost.data.author}</div>
        </article>
      </div>
    </section>
  )}

  <section class="section" style="padding-top: 20px">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">全部文章</div>
          <h2>按发布时间继续阅读</h2>
        </div>
      </div>
      <div class="post-stack">
        {otherPosts.map((post, index)=>
          <article class="post-card">
            <div class="post-number">{String(index + 2).padStart(2, '0')}</div>
            <div>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <div class="pill-row">{post.data.tags.map((tag)=><a class="pill" href={`/blog/tag/${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
            </div>
            <div class="post-meta">{post.data.pubDate.toISOString().slice(0,10)}<br />{post.data.author}</div>
          </article>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
