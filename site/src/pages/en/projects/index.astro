---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, projectGroups } from '@/data/projects';
import { publicCorpusStats } from '@/data/publicCorpusStats';
import { site } from '@/data/site';

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const totalStars = projects.reduce((sum, project) => sum + Number(project.stars || 0), 0);
const recentProjects = [...projects]
  .sort((a, b) => new Date(b.lastPushed).valueOf() - new Date(a.lastPushed).valueOf())
  .slice(0, 5);

const readerChecks = [
  {
    title: 'What changes?',
    body: 'Look for the object that can change: prompt, workflow, memory, evaluator, code, architecture, or agent organization.'
  },
  {
    title: 'Who verifies it?',
    body: 'A repository is stronger when it has tests, benchmarks, reviewer feedback, or reproducible run logs.'
  },
  {
    title: 'Does the change persist?',
    body: 'Retained changes matter more than one-off demos. Check whether the system keeps a better artifact or policy.'
  },
  {
    title: 'What is still unproven?',
    body: 'Many reports are source-tracing notes. Treat stars and descriptions as visible signals, not proof of quality.'
  }
];

const groupCards = projectGroups.slice(0, 6).map((group) => ({
  title: group.title,
  count: group.repos.length,
  examples: group.repos.slice(0, 4)
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Self Evolve Projects',
  description: 'English same-evidence guide to the Self Evolve GitHub project index.',
  url: `${site.url}/en/projects/`,
  inLanguage: 'en',
  isPartOf: { '@id': `${site.url}/#website` },
  about: ['self-evolving AI agents', 'GitHub project evidence', 'AI agent evaluation']
};
---

<BaseLayout
  pageLang="en"
  alternateZh="/projects/"
  alternateEn="/en/projects/"
  title="Self Evolve Projects — GitHub evidence, not a quality ranking"
  description="English guide to the Self Evolve project index: how to read repository evidence, mechanism groups, model cards, reports, star limits, and review boundaries."
  pageKeywords={['self-evolving AI projects', 'GitHub evidence index', 'AI agent model cards', 'agent evolution repositories']}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <section class="section">
    <div class="container">
      <div class="eyebrow">Projects / English mirror</div>
      <h1 class="gradient-text">Use the project index as an evidence map, not a leaderboard.</h1>
      <p class="lead">The repository list answers one practical question: which projects are worth inspecting next, and why? It connects each project to a mechanism label, model-card route, source report, visible GitHub signals, and a non-reproduction boundary.</p>
      <div class="hero-actions">
        <a class="button primary" href="/projects/">Open full Chinese-first index</a>
        <a class="button" href="/reports/">Review-gated reports</a>
        <a class="text-link" href="/en/value-lsh/">How triage works</a>
      </div>
      <div class="metrics">
        <div class="metric"><strong>{publicCorpusStats.classifiedGithubRepos}</strong><span>classified GitHub repositories</span></div>
        <div class="metric"><strong>{projects.length}</strong><span>project cards on this site</span></div>
        <div class="metric"><strong>{totalStars.toLocaleString()}</strong><span>historical adoption prior</span></div>
      </div>
      <aside class="source-panel" aria-label="Project index evidence boundary">
        <div>
          <div class="eyebrow">Reader contract</div>
          <h2>Stars and cards are starting points.</h2>
          <p>The English page does not certify repository quality. It teaches how to read the full index: start with mechanism fit, then inspect source trails, tests, benchmarks, recent activity, and unresolved evidence gaps.</p>
          <p><strong>中文:</strong> 这是 `/projects/` 的英文同证据链摘要；中文页保留完整项目表，英文页先说明如何读、如何降权、如何继续复核。</p>
        </div>
        <div class="source-links">
          <a href="/projects/">Full project table</a>
          <a href="/en/topics/self-evolving-ai-agents/">Definition gate</a>
          <a href="/star-growth/">Star-growth pilot</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">How to read</div>
          <h2>Four checks before citing a project.</h2>
        </div>
      </div>
      <div class="grid">
        {readerChecks.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">Mechanism groups</div>
        <h2>The useful unit is a mechanism family, not a single famous repo.</h2>
      </div>
      <div class="card">
        <p>The full project index groups repositories by role: algorithm/code evolution, self-reflection, memory or skill substrate, evaluation harnesses, and multi-agent organization. This keeps the page teachable: compare projects that claim the same kind of improvement before trusting the strongest claim.</p>
      </div>
    </div>
    <div class="container">
      <div class="grid">
        {groupCards.map((group) => (
          <article class="card">
            <div class="eyebrow">{group.count} repos</div>
            <h3>{group.title}</h3>
            <p>{group.examples.join(', ')}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Recent signals</div>
          <h2>Recent activity is a signal; it is not proof.</h2>
        </div>
      </div>
      <div class="grid">
        {recentProjects.map((project) => (
          <article class="card">
            <div class="eyebrow">{project.category}</div>
            <h3><a href={`/projects/${slugify(project.repo)}/`}>{project.name}</a></h3>
            <p>{project.description}</p>
            <div class="pill-row">
              <span class="pill">{project.lastPushed.slice(0, 10)}</span>
              <span class="pill">{project.stars.toLocaleString()} stars</span>
              <a class="pill" href={project.url} target="_blank" rel="noopener">GitHub</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
