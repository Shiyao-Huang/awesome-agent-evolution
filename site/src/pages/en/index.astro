---
import BaseLayout from '@/layouts/BaseLayout.astro';

const evidenceCards = [
  {
    label: 'Paper',
    title: 'Citation status first',
    body: 'English mirror for the survey PDF, working-draft boundary, provisional metrics, and Chinese parity status.',
    href: '/en/paper/',
    status: 'EN mirror'
  },
  {
    label: 'Definition',
    title: 'What changed?',
    body: 'The core claim test: mutable object, feedback, verification, retention, and rollback.',
    href: '/en/topics/self-evolving-ai-agents/',
    status: 'EN mirror'
  },
  {
    label: 'Value LSH',
    title: 'Evidence triage, not ranking',
    body: 'A review queue for deciding which materials deserve inspection, which need repair, and which should not be cited yet.',
    href: '/en/value-lsh/',
    status: 'EN mirror'
  },
  {
    label: 'Projects',
    title: 'Evidence map, not leaderboard',
    body: 'Repository cards, mechanism groups, source trails, star limits, and model-card reading rules.',
    href: '/en/projects/',
    status: 'EN mirror'
  },
  {
    label: 'Resource coverage',
    title: 'Corpus scope and gaps',
    body: 'Coverage audit for raw sources, processed analysis, project cards, and public result layers.',
    href: '/en/resource-library/',
    status: 'EN mirror'
  },
  {
    label: 'Survey',
    title: 'Working taxonomy, not a finished review',
    body: 'Dated survey snapshot, working loops, method families, and source-scoped claim limits.',
    href: '/en/survey/',
    status: 'EN mirror'
  },
  {
    label: 'Reports',
    title: 'What is reviewed, what is gated',
    body: 'A report-status guide that separates public reading maps from review-gated source-tracing pages.',
    href: '/en/reports/',
    status: 'EN mirror'
  },
  {
    label: 'Research',
    title: 'Papers as source trails',
    body: 'A map for paper reviews, mechanism clusters, benchmark settings, and coverage gaps.',
    href: '/en/research/',
    status: 'EN mirror'
  },
  {
    label: 'Graph',
    title: 'Exploratory links, not proof',
    body: 'A guide to using the evidence graph as a research prompt while separating inferred links from verified claims.',
    href: '/en/graph/',
    status: 'EN mirror'
  },
  {
    label: 'Growth',
    title: 'Coverage before momentum',
    body: 'A star-history pilot ledger that treats total stars as adoption priors and missing events as missing data.',
    href: '/en/star-growth/',
    status: 'EN mirror'
  },
  {
    label: 'Worksheet',
    title: 'Evidence maturity, not AGI score',
    body: 'The Evolve-AGI worksheet explains benchmark, loop, transfer, governance, and evidence-chain limits.',
    href: '/en/evolve-agi-index/',
    status: 'EN mirror'
  },
  {
    label: 'Blog',
    title: 'Chinese-first notes, English route',
    body: 'An English guide that sends readers from article claims back to definitions, projects, papers, and sources.',
    href: '/en/blog/',
    status: 'EN guide'
  },
  {
    label: 'Search',
    title: 'Find the evidence trail',
    body: 'Use search when the English mirror is thin and you need the Chinese-first source chain.',
    href: '/search/',
    status: 'mixed'
  }
];
---

<BaseLayout
  pageLang="en"
  alternateZh="/"
  alternateEn="/en/"
  title="Self Evolve AI — English reader path for self-evolving agents"
  description="An English reader entry for Self Evolve: judge self-evolving AI agents by mutable objects, feedback, verification, retained change, benchmarks, and audit boundaries."
  pageKeywords={['Self-Evolving AI Agents', 'AI self evolution survey', 'agent benchmark evidence', 'Evolve-AGI Index']}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">For readers outside the Chinese site</div>
        <h1>Stop ranking self-evolving agents by demos or stars.</h1>
        <p class="lead">Ask the harder question: what changed, what feedback selected the change, who verified it, and did the change survive into the next run?</p>
        <div class="hero-actions">
          <a class="button primary" href="/en/topics/self-evolving-ai-agents/">Start with the definition</a>
          <a class="button" href="/en/topics/five-evolution-loops/">Five loops</a>
          <a class="button" href="/en/topics/code-evolution-benchmark/">Benchmark matrix</a>
          <a class="text-link" href="/">中文入口</a>
        </div>
      </div>
      <aside class="hero-evidence">
        <div class="eyebrow">Reader contract</div>
        <ol>
          <li><span>1</span><strong>Plain judgment before corpus detail.</strong></li>
          <li><span>2</span><strong>Every claim should point back to papers, reports, benchmarks, or indexes.</strong></li>
          <li><span>3</span><strong>Stars are adoption priors, not proof of current value.</strong></li>
          <li><span>4</span><strong>Weak evidence stays labeled as weak evidence.</strong></li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Start here</div>
          <h2>Read these three pages first.</h2>
        </div>
      </div>
      <div class="grid">
        <a class="card" href="/en/topics/self-evolving-ai-agents/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Definition</div>
          <h3>What counts as self-evolution?</h3>
          <p>A checklist for mutable objects, feedback, verification, retention, audit, and rollback.</p>
        </a>
        <a class="card" href="/en/topics/five-evolution-loops/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Mechanism</div>
          <h3>How does improvement happen?</h3>
          <p>Five review lenses: specification, search, evaluation, reflection, and archive or population pressure.</p>
        </a>
        <a class="card" href="/en/topics/code-evolution-benchmark/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Evidence</div>
          <h3>How strong is the proof?</h3>
          <p>Separate agent self-modification, algorithm discovery, architecture search, and prompt/program optimization.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">What is available now</div>
        <h2>The English path teaches the core judgment first.</h2>
      </div>
      <div class="card">
        <p>The English path now covers the core evidence route: definition, loops, benchmark matrix, projects, reports, Value LSH, resource coverage, survey snapshot, research map, evidence graph, growth pilot, worksheet, paper, and blog guide.</p>
        <p style="color: var(--muted); margin-top: 10px;">Boundary: long-tail article bodies and many report pages remain Chinese-first or source-tracing pages. English mirrors teach how to read the same evidence chain without claiming complete translation parity.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evidence you can inspect now</div>
          <h2>English mirrors the core evidence path; long-tail parity stays explicitly labeled.</h2>
        </div>
      </div>
      <div class="grid">
        {evidenceCards.map((card) => (
          <a class="card" href={card.href} style="text-decoration: none; color: inherit;">
            <div class="eyebrow">{card.label}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <div class="pill-row">
              <span class="pill">{card.status}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
