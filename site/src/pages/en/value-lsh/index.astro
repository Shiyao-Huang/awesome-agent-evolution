---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import valueSnapshotJson from '../../../../../analysis/value-lsh-index.json';
import graphSnapshotJson from '../../../../../analysis/value-lsh-graph-3d.json';

type ValueClass = 'high-value-candidate' | 'needs-review' | 'low-signal-or-risk';

interface ValueRow {
  id: string;
  type: string;
  title: string;
  url: string | null;
  source_path: string | null;
  score: {
    value_score: number;
    confidence: number;
    positive_tags: number;
    negative_tags: number;
    value_class: ValueClass;
  };
  evidence_refs?: {
    frontier_rank?: number | null;
    star_growth_rank?: number | null;
    raw_file?: string | null;
  };
}

const valueSnapshot = valueSnapshotJson as {
  generated_at: string;
  summary: {
    total_materials: number;
    value_tag_count: number;
    total_buckets: number;
    total_clusters: number;
    type_counts: Record<string, number>;
    value_class_counts: Record<ValueClass, number>;
  };
  top_high_value_candidates: ValueRow[];
  low_signal_or_risk_queue: ValueRow[];
};

const graphSnapshot = graphSnapshotJson as { summary: { embedding_clusters: number } };
const summary = valueSnapshot.summary;
const generatedDate = valueSnapshot.generated_at.slice(0, 10);
const classLabels: Record<ValueClass, string> = {
  'high-value-candidate': 'priority review',
  'needs-review': 'needs review',
  'low-signal-or-risk': 'repair or avoid citing'
};
const classRows = (Object.entries(summary.value_class_counts) as [ValueClass, number][])
  .map(([key, count]) => ({ key, count, label: classLabels[key] }));
const topCandidates = valueSnapshot.top_high_value_candidates.slice(0, 8);
const repairQueue = valueSnapshot.low_signal_or_risk_queue.slice(0, 8);
const scoreBand = (score: number) => {
  if (score >= 70) return 'priority review';
  if (score >= 45) return 'needs review';
  return 'do not cite yet';
};
const evidenceBand = (confidence: number) => {
  if (confidence >= 70) return 'stronger trail';
  if (confidence >= 45) return 'partial trail';
  return 'weak trail';
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Value LSH Evidence Triage Queue',
  description: 'English same-evidence guide to the Self Evolve heuristic review queue.',
  url: `${site.url}/en/value-lsh/`,
  inLanguage: 'en',
  isBasedOn: `${site.github}/tree/main/analysis`,
  variableMeasured: ['triage_score', 'tag_coverage', 'review_class', 'lsh_bucket']
};
---

<BaseLayout
  pageLang="en"
  alternateZh="/value-lsh/"
  alternateEn="/en/value-lsh/"
  title="Value LSH — evidence triage, not a final ranking"
  description="English guide to the Value LSH evidence triage queue: what the scores mean, what they do not prove, and how to use the repair queue."
  pageKeywords={['Value LSH', 'AI evidence triage', 'self-evolving agents value matrix', 'review queue']}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <section class="section">
    <div class="container">
      <div class="eyebrow">Value LSH / English mirror</div>
      <h1 class="gradient-text">Value LSH decides what to review next. It does not decide what is true.</h1>
      <p class="lead">The queue compresses {summary.total_materials.toLocaleString()} GitHub, paper, social/X, and blog materials into triage classes. Its job is narrow: choose what to inspect, what to repair, and what not to cite yet.</p>
      <div class="hero-actions">
        <a class="button primary" href="/value-lsh/">Open full visual queue</a>
        <a class="button" href={`${site.github}/blob/main/analysis/value-lsh-index.md`} target="_blank" rel="noopener">Read generated report</a>
        <a class="text-link" href="/en/projects/">Project evidence guide</a>
      </div>
      <aside class="source-panel" aria-label="Value LSH method boundary">
        <div>
          <div class="eyebrow">Method boundary</div>
          <h2>The score is a reading-order signal.</h2>
          <p>The facets are heuristic and not calibrated against human agreement. A high score means “review this sooner,” not “this project is good.” A low score often means missing evidence, stale metadata, or risk language that needs repair.</p>
          <p><strong>中文:</strong> 这是 `/value-lsh/` 的英文同证据链摘要；中文页保留完整 3D 图、表格和队列，英文页先说明分数边界。</p>
        </div>
        <div class="source-links">
          <a href="/value-lsh/">Full visual queue</a>
          <a href="/en/reports/">Report review status</a>
          <a href="/search/">Search source trail</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Snapshot</div>
          <h2>Enough structure to guide reading, not enough to replace review.</h2>
        </div>
        <span class="value-lsh-date">Generated {generatedDate}</span>
      </div>
      <div class="metrics">
        <div class="metric"><strong>{summary.total_materials.toLocaleString()}</strong><span>materials</span></div>
        <div class="metric"><strong>{summary.value_tag_count}</strong><span>triage facets</span></div>
        <div class="metric"><strong>{summary.total_buckets}</strong><span>LSH buckets</span></div>
        <div class="metric"><strong>{graphSnapshot.summary.embedding_clusters}</strong><span>embedding clusters</span></div>
      </div>
      <div class="grid">
        {classRows.map((row) => (
          <article class="card">
            <div class="eyebrow">{row.count.toLocaleString()} materials</div>
            <h3>{row.label}</h3>
            <p>{row.key === 'high-value-candidate'
              ? 'Inspect first, then verify source trail and claim strength.'
              : row.key === 'needs-review'
                ? 'Needs a human pass before strong public use.'
                : 'Repair evidence or avoid citation until the source chain improves.'}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">How to use</div>
        <h2>Turn a large corpus into a review queue.</h2>
      </div>
      <div class="card">
        <p>Use the queue to select the next deep read, then leave the queue and inspect the underlying paper, repository, model card, report, benchmark, or raw capture. The final judgment should be written in the reviewed page, not inferred from the score alone.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Priority review sample</div>
          <h2>Items to inspect before citing.</h2>
        </div>
      </div>
      <div class="grid">
        {topCandidates.map((row) => (
          <article class="card">
            <div class="eyebrow">{row.type} · {scoreBand(row.score.value_score)}</div>
            <h3>{row.url ? <a href={row.url} target="_blank" rel="noopener">{row.title}</a> : row.title}</h3>
            <p>{row.source_path || row.evidence_refs?.raw_file || row.id}</p>
            <div class="pill-row">
              <span class="pill">tag coverage: {evidenceBand(row.score.confidence)}</span>
              <span class="pill">{row.score.positive_tags} positive facets</span>
              <span class="pill">{row.score.negative_tags} negative facets</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Repair queue sample</div>
          <h2>Weak evidence is useful only when it stays labeled.</h2>
        </div>
      </div>
      <div class="grid">
        {repairQueue.map((row) => (
          <article class="card">
            <div class="eyebrow">{row.type} · {scoreBand(row.score.value_score)}</div>
            <h3>{row.url ? <a href={row.url} target="_blank" rel="noopener">{row.title}</a> : row.title}</h3>
            <p>{row.source_path || row.evidence_refs?.raw_file || row.id}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
