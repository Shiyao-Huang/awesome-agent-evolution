---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legacyResearchProjectReports, paperReports, projectReports, surveyPublicationReports } from '@/data/reports';
import { site } from '@/data/site';

const reportStates = [
  {
    label: 'Project reports',
    count: projectReports.length,
    body: 'Source-tracing evidence pages for repositories. They are indexable evidence entry points, but their body claims remain review-gated until page-level copy and claim checks pass.'
  },
  {
    label: 'Legacy research reports',
    count: legacyResearchProjectReports.length,
    body: 'Older research/project Markdown wrapped as review-gated HTML. Use them to find source trails, not as current conclusions.'
  },
  {
    label: 'Survey publication slices',
    count: surveyPublicationReports.length,
    body: 'Draft publication slices that still need bilingual same-evidence review and academic claim checks.'
  },
  {
    label: 'Paper reports',
    count: paperReports.length,
    body: 'Paper reading maps and cross-domain synthesis pages. These remain indexable only when they are useful as source-guided reading maps.'
  }
];

const readingRules = [
  'Read report pages as a source trail first, not as a verdict.',
  'Check whether the claim points back to raw GitHub, paper, benchmark, or current project card evidence.',
  'Use review-gated labels as a warning that public-copy review is not finished, even when a page is indexable.',
  'Prefer current project cards and paper pages when legacy report language conflicts with newer evidence.'
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Self Evolve Reports',
  description: 'English guide to the Self Evolve report index and review-gated evidence boundary.',
  url: `${site.url}/en/reports/`,
  inLanguage: 'en',
  isPartOf: { '@id': `${site.url}/#website` }
};
---

<BaseLayout
  pageLang="en"
  alternateZh="/reports/"
  alternateEn="/en/reports/"
  title="Self Evolve Reports — what is reviewed, what is still gated"
  description="English guide to Self Evolve reports: project evidence pages, legacy research wrappers, survey publication slices, paper maps, review-gated policy, and citation boundaries."
  pageKeywords={['Self Evolve reports', 'review-gated evidence', 'AI agent project reports', 'self-evolving AI survey reports']}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <section class="section">
    <div class="container">
      <div class="eyebrow">Reports / English mirror</div>
      <h1 class="gradient-text">The report index is a map of review status.</h1>
      <p class="lead">This page tells readers what they can safely do with each report family. Some pages are public reading maps; many project and legacy reports are only source-tracing evidence until reader/editor and academic review pass.</p>
      <div class="hero-actions">
        <a class="button primary" href="/reports/">Open full report index</a>
        <a class="button" href="/en/projects/">Project evidence guide</a>
        <a class="text-link" href="/reports/live-publication-readiness/">Live publication readiness</a>
        <a class="text-link" href="/en/reports/google-redirect-indexability/">Redirect indexability</a>
        <a class="text-link" href="/reports/github-topic-indexing-readiness/">GitHub topic readiness</a>
        <a class="text-link" href="/en/reports/text-asset-indexability/">Text asset coverage</a>
        <a class="text-link" href="/en/reports/public-i18n-route-audit/">I18N route audit</a>
      </div>
      <aside class="source-panel" aria-label="Report citation boundary">
        <div>
          <div class="eyebrow">Citation boundary</div>
          <h2>Accessible does not mean quality-certified.</h2>
          <p>Review-gated reports stay available so the evidence chain remains traceable, but they should not be cited as finished public copy. A page becomes stronger only after its claim strength, bilingual parity, limitations, and source trail are checked.</p>
          <p><strong>中文:</strong> 这是 `/reports/` 的英文同证据链摘要；中文页保留完整报告列表，英文页先说明哪些能引用、哪些只能追溯来源。</p>
        </div>
        <div class="source-links">
          <a href="/reports/">Full report list</a>
          <a href="/reports/live-publication-readiness/">Live crawl readiness</a>
          <a href="/en/reports/google-redirect-indexability/">Redirect indexability</a>
          <a href="/reports/github-topic-indexing-readiness/">GitHub topic readiness</a>
          <a href="/en/reports/text-asset-indexability/">Text asset coverage</a>
          <a href="/en/reports/public-i18n-route-audit/">I18N route audit</a>
          <a href="/search/">Search evidence</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Report states</div>
          <h2>Four families, four reading contracts.</h2>
        </div>
      </div>
      <div class="grid">
        {reportStates.map((state) => (
          <article class="card">
            <div class="eyebrow">{state.count} pages</div>
            <h3>{state.label}</h3>
            <p>{state.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">QA Audits</div>
          <h2>High-signal publication gates.</h2>
        </div>
      </div>
      <div class="grid">
        <article class="card" style="border-left: 4px solid #B83224;">
          <div class="eyebrow">QA · Live publication</div>
          <h3><a href="/reports/live-publication-readiness/">Live Publication Readiness Audit</a></h3>
          <p>Separates local SEO metadata success from strict HTTPS crawl readiness on the custom domain.</p>
          <div class="pill-row">
            <span class="pill">external crawl gate</span>
            <span class="pill" style="background: #B83224; color: white;">HTTPS BLOCKER</span>
            <a class="pill" href="/reports/live-publication-readiness/">Open status</a>
          </div>
        </article>
        <article class="card" style="border-left: 4px solid #B83224;">
          <div class="eyebrow">QA · Search Console redirect</div>
          <h3><a href="/en/reports/google-redirect-indexability/">Google Redirect Indexability Triage</a></h3>
          <p>Classifies Search Console “Page with redirect” rows by checking sitemap final URLs versus HTTP, www, slashless, and legacy GitHub Pages redirect entry points.</p>
          <div class="pill-row">
            <span class="pill">redirect gate</span>
            <span class="pill" style="background: #B83224; color: white;">HTTPS BLOCKER</span>
            <a class="pill" href="/en/reports/google-redirect-indexability/">Open redirect triage</a>
          </div>
        </article>
        <article class="card" style="border-left: 4px solid #2F6F4E;">
          <div class="eyebrow">QA · GitHub topic</div>
          <h3><a href="/reports/github-topic-indexing-readiness/">GitHub Topic Indexing Readiness</a></h3>
          <p>Checks repository topics, description, homepage, GitHub Search, and topic-page rendering instead of treating Google SEO as GitHub topic evidence.</p>
          <div class="pill-row">
            <span class="pill">GitHub discovery</span>
            <span class="pill" style="background: #2F6F4E; color: white;">TOPIC PASS</span>
            <a class="pill" href="/reports/github-topic-indexing-readiness/">Open topic status</a>
          </div>
        </article>
        <article class="card" style="border-left: 4px solid #B8860B;">
          <div class="eyebrow">QA · Text assets</div>
          <h3><a href="/en/reports/text-asset-indexability/">Text Asset Indexability Audit</a></h3>
          <p>Answers whether repository text has become indexable public assets by separating public HTML, GitHub README assets, processed-but-unrouted work, raw sources, and external mirrors.</p>
          <div class="pill-row">
            <span class="pill">coverage gate</span>
            <span class="pill" style="background: #B8860B; color: white;">INCOMPLETE</span>
            <a class="pill" href="/en/reports/text-asset-indexability/">Open text coverage</a>
          </div>
        </article>
        <article class="card" style="border-left: 4px solid #B8860B;">
          <div class="eyebrow">QA · I18N routes</div>
          <h3><a href="/en/reports/public-i18n-route-audit/">Public I18N Route Audit</a></h3>
          <p>Checks sitemap routes, HTML language, canonical links, hreflang alternates, the core English path, and Chinese-first long-tail gaps.</p>
          <div class="pill-row">
            <span class="pill">bilingual gate</span>
            <span class="pill" style="background: #B8860B; color: white;">INCOMPLETE</span>
            <a class="pill" href="/en/reports/public-i18n-route-audit/">Open i18n route audit</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">How to use</div>
        <h2>Use reports to locate evidence, then verify the claim.</h2>
      </div>
      <div class="card">
        <ol>
          {readingRules.map((rule) => <li>{rule}</li>)}
        </ol>
      </div>
    </div>
  </section>

  {paperReports.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Paper reading maps</div>
            <h2>Start with paper maps: they locate sources, not final survey verdicts.</h2>
          </div>
        </div>
        <p class="lead">These pages connect cross-domain papers, mechanisms, and source trails. Before citing a claim, return to the original paper, the current paper page, and the limitation notes.</p>
        <div class="grid">
          {paperReports.map((report) => (
            <article class="card">
              <div class="eyebrow">{report.category} · literature map</div>
              <h3><a href={report.href}>{report.title}</a></h3>
              <p>{report.excerpt}</p>
              <div class="pill-row">
                <span class="pill">paper source trail</span>
                <span class="pill">not peer-reviewed meta-analysis</span>
                <a class="pill" href={report.href}>Read report</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {projectReports.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Source-only project evidence</div>
            <h2>Project evidence pages: trace sources now, cite conclusions later.</h2>
          </div>
        </div>
        <p class="lead">These pages keep GitHub sources, classification hints, mechanism links, and limitations discoverable. They are indexable evidence entry points, but page-body claims stay review-gated until public-copy review passes.</p>
        <div class="grid">
          {projectReports.slice(0, 18).map((report) => (
            <article class="card">
              <div class="eyebrow">{report.category}</div>
              <h3><a href={report.href}>{report.title}</a></h3>
              <p>Use this page to locate source material and unresolved evidence gaps. Do not cite the body as a reviewed conclusion until the public-copy gate passes.</p>
              <div class="pill-row">
                <span class="pill">indexable</span>
                <span class="pill">review pending</span>
                <span class="pill">source trail</span>
                <a class="pill" href={report.href}>Open evidence page</a>
              </div>
            </article>
          ))}
        </div>
        {projectReports.length > 18 && <p style="margin-top: 18px; color: var(--muted);">Showing the first 18 of {projectReports.length} indexable project evidence pages.</p>}
      </div>
    </section>
  )}

  {legacyResearchProjectReports.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Legacy research reports</div>
            <h2>HTML wrappers for older research/project Markdown.</h2>
          </div>
        </div>
        <p class="lead">These files come from earlier research/project reports and now have canonical HTML wrappers in the sitemap. They solve discovery and traceability; readers should still verify against current project cards, original GitHub repositories, and limitation notes.</p>
        <div class="grid">
          {legacyResearchProjectReports.slice(0, 12).map((report) => (
            <article class="card">
              <div class="eyebrow">{report.category}</div>
              <h3><a href={report.href}>{report.title}</a></h3>
              <p>Review-gated legacy evidence wrapper. Use it for source tracing only; do not cite the legacy body as a current reviewed conclusion.</p>
              <div class="pill-row">
                <span class="pill">indexable wrapper</span>
                <span class="pill">legacy source</span>
                <a class="pill" href={report.href}>Open legacy wrapper</a>
              </div>
            </article>
          ))}
        </div>
        {legacyResearchProjectReports.length > 12 && <p style="margin-top: 18px; color: var(--muted);">Showing the first 12 of {legacyResearchProjectReports.length} indexable legacy research reports.</p>}
      </div>
    </section>
  )}

  {surveyPublicationReports.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Survey publication</div>
            <h2>Public-facing survey slices.</h2>
          </div>
        </div>
        <p class="lead">These slices are English publication candidates and are open as indexable article assets. They still need Chinese same-evidence parity and academic review before they can represent a complete bilingual release.</p>
        <div class="grid">
          {surveyPublicationReports.map((report) => (
            <article class="card">
              <div class="eyebrow">{report.category}</div>
              <h3><a href={report.href}>{report.title}</a></h3>
              <p>Review-gated publication slice. Read only as a draft evidence compression until bilingual and academic review passes.</p>
              <div class="pill-row">
                <span class="pill">indexable</span>
                <span class="pill">bilingual pending</span>
                <span class="pill">academic review pending</span>
                <a class="pill" href={report.href}>Read slice</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Safer entry points</div>
          <h2>Start from pages that explain their evidence boundary.</h2>
        </div>
      </div>
      <div class="grid">
        <a class="card" href="/en/paper/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Paper</div>
          <h3>What can be cited today?</h3>
          <p>Working-draft status, stable claims, provisional metrics, and Chinese parity limits.</p>
        </a>
        <a class="card" href="/en/projects/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Projects</div>
          <h3>How to read project evidence.</h3>
          <p>Repository signals, mechanism groups, adoption priors, and non-reproduction boundaries.</p>
        </a>
        <a class="card" href="/en/value-lsh/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Triage</div>
          <h3>Why some pages are queued.</h3>
          <p>Value LSH is a review queue for deciding what to inspect, repair, or avoid citing.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
