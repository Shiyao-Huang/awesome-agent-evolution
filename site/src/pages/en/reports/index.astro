---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legacyResearchProjectReports, paperReports, projectReports, surveyPublicationReports } from '@/data/reports';
import { site } from '@/data/site';

const reportStates = [
  {
    label: 'Project reports',
    count: projectReports.length,
    body: 'Source-tracing evidence pages for repositories. They are accessible for review but remain noindexed until page-level copy and claim checks pass.'
  },
  {
    label: 'Legacy research reports',
    count: legacyResearchProjectReports.length,
    body: 'Older research/project Markdown wrapped as review-gated HTML. Use them to find source trails, not as current conclusions.'
  },
  {
    label: 'Survey publication slices',
    count: surveyPublicationReports.length,
    body: 'Draft publication slices that still need bilingual same-evidence review and academic claim checks.'
  },
  {
    label: 'Paper reports',
    count: paperReports.length,
    body: 'Paper reading maps and cross-domain synthesis pages. These remain indexable only when they are useful as source-guided reading maps.'
  }
];

const readingRules = [
  'Read report pages as a source trail first, not as a verdict.',
  'Check whether the claim points back to raw GitHub, paper, benchmark, or current project card evidence.',
  'Use noindex/review-gated labels as a warning that public-copy review is not finished.',
  'Prefer current project cards and paper pages when legacy report language conflicts with newer evidence.'
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Self Evolve Reports',
  description: 'English guide to the Self Evolve report index and review-gated evidence boundary.',
  url: `${site.url}/en/reports/`,
  inLanguage: 'en',
  isPartOf: { '@id': `${site.url}/#website` }
};
---

<BaseLayout
  pageLang="en"
  alternateZh="/reports/"
  alternateEn="/en/reports/"
  title="Self Evolve Reports — what is reviewed, what is still gated"
  description="English guide to Self Evolve reports: project evidence pages, legacy research wrappers, survey publication slices, paper maps, noindex policy, and citation boundaries."
  pageKeywords={['Self Evolve reports', 'review-gated evidence', 'AI agent project reports', 'self-evolving AI survey reports']}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <section class="section">
    <div class="container">
      <div class="eyebrow">Reports / English mirror</div>
      <h1 class="gradient-text">The report index is a map of review status.</h1>
      <p class="lead">This page tells readers what they can safely do with each report family. Some pages are public reading maps; many project and legacy reports are only source-tracing evidence until reader/editor and academic review pass.</p>
      <div class="hero-actions">
        <a class="button primary" href="/reports/">Open full report index</a>
        <a class="button" href="/en/projects/">Project evidence guide</a>
        <a class="text-link" href="/en/paper/">Paper citation status</a>
      </div>
      <aside class="source-panel" aria-label="Report citation boundary">
        <div>
          <div class="eyebrow">Citation boundary</div>
          <h2>Accessible does not mean quality-certified.</h2>
          <p>Review-gated reports stay available so the evidence chain remains traceable, but they should not be cited as finished public copy. A page becomes stronger only after its claim strength, bilingual parity, limitations, and source trail are checked.</p>
          <p><strong>中文:</strong> 这是 `/reports/` 的英文同证据链摘要；中文页保留完整报告列表，英文页先说明哪些能引用、哪些只能追溯来源。</p>
        </div>
        <div class="source-links">
          <a href="/reports/">Full report list</a>
          <a href="/search/">Search evidence</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Report states</div>
          <h2>Four families, four reading contracts.</h2>
        </div>
      </div>
      <div class="grid">
        {reportStates.map((state) => (
          <article class="card">
            <div class="eyebrow">{state.count} pages</div>
            <h3>{state.label}</h3>
            <p>{state.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">How to use</div>
        <h2>Use reports to locate evidence, then verify the claim.</h2>
      </div>
      <div class="card">
        <ol>
          {readingRules.map((rule) => <li>{rule}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Safer entry points</div>
          <h2>Start from pages that explain their evidence boundary.</h2>
        </div>
      </div>
      <div class="grid">
        <a class="card" href="/en/paper/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Paper</div>
          <h3>What can be cited today?</h3>
          <p>Working-draft status, stable claims, provisional metrics, and Chinese parity limits.</p>
        </a>
        <a class="card" href="/en/projects/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Projects</div>
          <h3>How to read project evidence.</h3>
          <p>Repository signals, mechanism groups, adoption priors, and non-reproduction boundaries.</p>
        </a>
        <a class="card" href="/en/value-lsh/" style="text-decoration: none; color: inherit;">
          <div class="eyebrow">Triage</div>
          <h3>Why some pages are queued.</h3>
          <p>Value LSH is a review queue for deciding what to inspect, repair, or avoid citing.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
