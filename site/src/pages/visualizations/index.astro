---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FunnelChart from '@/components/visualizations/FunnelChart.astro';
import TaxonomyTree from '@/components/visualizations/TaxonomyTree.astro';
import RadarChart from '@/components/visualizations/RadarChart.astro';
import TimelineHeatmap from '@/components/visualizations/TimelineHeatmap.astro';
import RankTable from '@/components/visualizations/RankTable.astro';
import { categoryDistribution, themeDistribution, summaryStats, methodFamilyOptions } from '@/components/visualizations/vizData';

type DistributionEntry = { key: string; count: number };
type MethodFamilyOption = typeof methodFamilyOptions[number];
const overviewStats = [
  { label: 'Raw corpus', value: summaryStats.totalRaw, detail: 'classified repositories' },
  { label: 'Model cards', value: summaryStats.totalProjects, detail: 'public analysis reports' },
  { label: 'Strict evolution', value: summaryStats.coreEvolution, detail: 'core self-evolution projects' },
  { label: 'Broad context', value: summaryStats.broadEvolution, detail: 'adjacent AGI index evidence' }
];
---

<BaseLayout
  title="数据可视化 — Self Evolve"
  description="AI 自我进化项目的交互式数据可视化：分类体系、主题雷达、时间线热力图、项目排行榜。"
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">Data Visualizations</div>
      <h1 class="gradient-text">数据可视化</h1>
      <p class="lead">{summaryStats.totalRaw} 条 raw 语料、{summaryStats.totalProjects} 份项目分析报告的证据图谱。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="viz-stat-grid">
        {overviewStats.map(stat => (
          <div class="viz-stat">
            <strong>{stat.value.toLocaleString()}</strong>
            <span>{stat.label}</span>
            <small>{stat.detail}</small>
          </div>
        ))}
      </div>

      <div class="viz-grid-2col">
        <div class="card">
          <div class="card-head">
            <div class="eyebrow">Raw Buckets</div>
            <h3>语料功能桶</h3>
          </div>
          <div class="viz-bars">
            {categoryDistribution.map((cat: DistributionEntry) => {
              const maxCount = categoryDistribution[0]?.count || 1;
              const pct = Math.max(4, Math.round((cat.count / maxCount) * 100));
              return (
                <div class="viz-bar-row">
                  <span class="viz-bar-label">{cat.key}</span>
                  <div class="viz-bar-track">
                    <div class="viz-bar-fill" style={`width:${pct}%`}></div>
                  </div>
                  <span class="viz-bar-count">{cat.count}</span>
                </div>
              );
            })}
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="eyebrow">Theme Coverage</div>
            <h3>主题覆盖</h3>
          </div>
          <div class="viz-bars">
            {themeDistribution.slice(0, 11).map((theme: DistributionEntry) => {
              const maxTheme = themeDistribution[0]?.count || 1;
              const pct = Math.max(4, Math.round((theme.count / maxTheme) * 100));
              return (
                <div class="viz-bar-row">
                  <span class="viz-bar-label">{theme.key}</span>
                  <div class="viz-bar-track">
                    <div class="viz-bar-fill" style={`width:${pct}%`}></div>
                  </div>
                  <span class="viz-bar-count">{theme.count}</span>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:20px">
        <div class="card-head">
          <div class="eyebrow">Comparable Families</div>
          <h3>统一方法族</h3>
        </div>
        <div class="viz-family-pills">
          {methodFamilyOptions.map((family: MethodFamilyOption) => (
            <span class="viz-pill" style={`--pill-color:${family.color}`}>
              <i></i>{family.shortLabel} <small>{family.count}</small>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Charts -->
  <section class="section">
    <div class="container">
      <div class="viz-sh">
        <div class="eyebrow">Interactive Charts</div>
        <h2>交互式图表</h2>
      </div>
      <div class="viz-grid-2col">
        <FunnelChart />
        <TaxonomyTree />
      </div>
      <RadarChart />
      <TimelineHeatmap />
      <RankTable />
    </div>
  </section>
</BaseLayout>

<style>
.viz-stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:20px}
.viz-stat{border:1px solid var(--line);border-radius:8px;background:var(--surface-1);padding:14px}
.viz-stat strong{display:block;font-size:28px;line-height:1;font-weight:850;color:var(--fg);font-variant-numeric:tabular-nums}
.viz-stat span{display:block;margin-top:8px;font-size:13px;font-weight:800;color:var(--fg)}
.viz-stat small{display:block;margin-top:3px;font-size:11px;font-weight:650;color:var(--muted);line-height:1.35}
.viz-grid-2col{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}
.viz-grid-2col>*{min-width:0}
.viz-bars{display:flex;flex-direction:column;gap:6px}
.viz-bar-row{display:grid;grid-template-columns:minmax(128px,180px) 1fr 44px;gap:8px;align-items:center}
.viz-bar-label{font-size:13px;font-weight:650;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.viz-bar-track{height:24px;background:var(--surface-2);border-radius:6px;overflow:hidden}
.viz-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--brand2));border-radius:6px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.viz-bar-count{font-size:13px;font-weight:800;color:var(--meta);text-align:right;font-variant-numeric:tabular-nums}
.viz-family-pills{display:flex;flex-wrap:wrap;gap:8px}
.viz-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;font-size:13px;font-weight:700;color:var(--fg);background:var(--surface-1)}
.viz-pill i{width:8px;height:8px;border-radius:50%;background:var(--pill-color);flex-shrink:0}
.viz-pill small{color:var(--meta);font-weight:800}
.viz-sh{margin-bottom:24px}
.viz-sh .eyebrow{color:var(--accent);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
.viz-sh h2{font-family:var(--font-display);font-size:24px;font-weight:400;color:var(--fg);margin-top:4px}
@media(max-width:900px){.viz-stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.viz-grid-2col{grid-template-columns:minmax(0,1fr)}.viz-bar-row{grid-template-columns:minmax(96px,128px) minmax(0,1fr) 36px}.viz-bar-label{font-size:12px}}
</style>
