---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { featuredResearch } from '@/data/research';
import { knowledgeGraphStats } from '@/data/knowledgeGraph';
import { rankedProfiles } from '@/data/rankings';
import { starQualityScores } from '@/data/starAnalysis';
import { evolveAgiIndex, evolveAgiIndexSignals } from '@/data/evolveAgiIndex';
import ValueLshGraph3D from '@/components/ValueLshGraph3D.astro';
import valueLshSnapshotJson from '../../../analysis/value-lsh-index.json';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);

interface ValueLshHomeRow {
  type: string;
  title: string;
  score: {
    value_score: number;
    confidence: number;
  };
}

const valueLshSnapshot = valueLshSnapshotJson as {
  generated_at: string;
  summary: {
    total_materials: number;
    value_tag_count: number;
    total_buckets: number;
    total_clusters: number;
    value_class_counts: Record<string, number>;
  };
  top_high_value_candidates: ValueLshHomeRow[];
};
const valueLshSummary = valueLshSnapshot.summary;
const valueLshTop = valueLshSnapshot.top_high_value_candidates.slice(0, 3);

// ── Star Rankings (Top 15 by star count) ──
const starRanking = [...starQualityScores]
  .sort((a, b) => b.totalStars - a.totalStars)
  .slice(0, 15)
  .map((s, i) => ({
    rank: i + 1,
    name: s.name,
    stars: s.totalStars,
    quality: s.compositeScore,
    growth: s.growthPattern,
    verdict: s.verdict,
  }));

// ── Trend Board (sorted by star activity) ──
const trendBoard = [...starQualityScores]
  .sort((a, b) => b.starActivityScore - a.starActivityScore)
  .slice(0, 10)
  .map((s, i) => ({
    rank: i + 1,
    name: s.name,
    activity: s.starActivityScore,
    diversity: s.contributorDiversity,
    forkQuality: s.forkQualityScore,
    growth: s.growthPattern,
    stars: s.totalStars,
  }));

// ── Direction Map: best-in-class per mechanism direction ──
const directionMap = [
  {
    direction: '架构/代码自修改',
    icon: '🧬',
    color: '#B83224',
    tier: 'Tier A',
    champion: 'AlphaEvolve',
    championScore: 7.06,
    evidence: '打破 56 年矩阵乘法记录，75% SOTA 恢复率',
    runnerUp: 'DGM (6.78)',
    maturity: 'L4 Code Self-Mod',
    paperCount: 7,
  },
  {
    direction: 'Agent 自动设计',
    icon: '🏗️',
    color: '#9b59b6',
    tier: 'Tier A',
    champion: 'ADAS',
    championScore: 6.50,
    evidence: '自动发现 Agent 架构，跨域迁移',
    runnerUp: 'OpenEvolve (6.42)',
    maturity: 'L4 Arch Search',
    paperCount: 5,
  },
  {
    direction: '推理时自我修正',
    icon: '🪞',
    color: '#3498db',
    tier: 'Tier B+',
    champion: 'Reflexion',
    championScore: 6.39,
    evidence: 'HumanEval 91%, AlfWorld 97%',
    runnerUp: 'Self-Refine (6.00)',
    maturity: 'L2 Prompt/Output',
    paperCount: 15,
  },
  {
    direction: '训练时自博弈',
    icon: '🎮',
    color: '#e67e22',
    tier: 'Tier B',
    champion: 'Absolute Zero',
    championScore: 6.33,
    evidence: '零外部数据自博弈，NeurIPS Best Paper',
    runnerUp: 'ReVeal (5.89)',
    maturity: 'L2 Self-Play RL',
    paperCount: 12,
  },
  {
    direction: '声明式 Prompt 优化',
    icon: '⚡',
    color: '#2ecc71',
    tier: 'Tier B',
    champion: 'DSPy',
    championScore: 6.15,
    evidence: '最广泛采用，编译式 prompt 优化',
    runnerUp: 'OPRO (in ranking)',
    maturity: 'L2 Prompt Evo',
    paperCount: 10,
  },
  {
    direction: '技能/记忆积累',
    icon: '📚',
    color: '#1abc9c',
    tier: 'Tier B',
    champion: 'Voyager',
    championScore: 5.78,
    evidence: '3.3x 独特物品，技能库终身学习',
    runnerUp: 'SE-Agent (5.96)',
    maturity: 'L3 Memory/Skill',
    paperCount: 18,
  },
];

const swarmEvolveMap = [
  {
    track: '拓扑优化',
    systems: 'GPTSwarm / EvoMAC',
    signal: 'agent 节点、通信边和路由概率会随任务反馈更新',
    evidence: '看 held-out tasks、edge ablation、环境反馈',
  },
  {
    track: '自主组织基础设施',
    systems: 'CORAL / metaswarm',
    signal: 'worktree、shared state、grader、heartbeat 和 archive 形成组织级闭环',
    evidence: '看 grader 独立性、lineage replay、跨模型 review',
  },
  {
    track: '生产型 swarm runtime',
    systems: 'swarmclaw / OpenClaw team',
    signal: 'schedules、delegation、memory、provider routing 和工具权限进入运行时',
    evidence: '看真实 workflow、权限审计、成本上限和可观测性',
  },
  {
    track: '图谱涌现协作',
    systems: 'Insight Swarm',
    signal: 'shared knowledge graph、tension links、challenge votes 代替中心 orchestrator',
    evidence: '看反共识指标、证据链和 contested thesis 处理',
  },
];

const growthEmoji: Record<string, string> = {
  organic: '🌱',
  viral: '🚀',
  steady: '📊',
  suspicious: '⚠️',
};

const growthLabel: Record<string, string> = {
  organic: '自然增长',
  viral: '病毒式',
  steady: '稳定',
  suspicious: '可疑',
};
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Self Evolve AI · AI 自我进化</div>
        <h1>AI Agent 自进化的全景图。</h1>
        <p class="lead">Star 榜单、趋势追踪、方向 Map——用 Rank 过滤信息，一页看到整个自进化领域最有价值的项目和论文。</p>
        <div class="hero-actions">
          <a class="button primary" href="#star-ranking">Star 榜单</a>
          <a class="button" href="/resource-library/">资料库</a>
          <a class="button" href="/value-lsh/">价值分类</a>
          <a class="button" href="#evolve-agi-index">自进化系数</a>
          <a class="button" href="#trend-board">Trend 榜单</a>
          <a class="button" href="#direction-map">方向 Map</a>
          <a class="button" href="#agent-swarm-evolve">Agent-Swarm</a>
          <a class="text-link" href="/graph/">知识图谱</a>
        </div>
        <div class="metrics" aria-label="研究站点指标">
          <div class="metric"><strong>{starQualityScores.length}</strong><span>个分析项目</span></div>
          <div class="metric"><strong>{rankedProfiles.length}</strong><span>个系统排名</span></div>
          <div class="metric"><strong>{knowledgeGraphStats.nodes}</strong><span>个图谱节点</span></div>
        </div>
      </div>
      <aside class="hero-evidence" aria-label="Self Evolve evidence pipeline">
        <div class="eyebrow">Rank 体系</div>
        <ol>
          <li><span>Tier A</span><strong>自进化核心系统，有突破性证据</strong></li>
          <li><span>Tier B+</span><strong>高质量实现，可复用的工程价值</strong></li>
          <li><span>Tier B</span><strong>有效方法，有独立验证</strong></li>
          <li><span>Tier B-</span><strong>有价值概念，证据有限</strong></li>
        </ol>
        <p>Rank 不只看 Star 数，还看 Star 质量、增长模式、证据强度和可复现性。</p>
      </aside>
    </div>
  </section>

  <!-- ═══ Value LSH 3D Graph ═══ -->
  <section class="section value-lsh-home-section" id="value-lsh" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Value LSH 3D</div>
          <h2>用离散 value facets 给所有素材重新分层。</h2>
        </div>
        <a class="text-link" href="/value-lsh/">打开完整 3D 图谱 →</a>
      </div>
      <div class="value-lsh-home-layout">
        <div class="value-lsh-home-graph">
          <ValueLshGraph3D variant="compact" maxNodes={760} height={380} />
        </div>
        <div class="value-lsh-home-panel">
          <p>这不是累计 Star 榜，而是把 GitHub、论文、社交/X、博客放进同一套 `-1 / 0 / +1` value lines：先离散判别，再用 LSH bucket 找相似价值结构，最后用 3D projection 展示聚类。</p>
          <div class="value-lsh-home-stats">
            <div><strong>{valueLshSummary.total_materials.toLocaleString()}</strong><span>materials</span></div>
            <div><strong>{valueLshSummary.value_tag_count}</strong><span>value lines</span></div>
            <div><strong>{valueLshSummary.total_buckets}</strong><span>LSH buckets</span></div>
          </div>
          <div class="value-lsh-home-split">
            <span>高价值 {valueLshSummary.value_class_counts['high-value-candidate'].toLocaleString()}</span>
            <span>待复核 {valueLshSummary.value_class_counts['needs-review'].toLocaleString()}</span>
            <span>修复/风险 {valueLshSummary.value_class_counts['low-signal-or-risk'].toLocaleString()}</span>
          </div>
          <div class="value-lsh-home-list" aria-label="Top value LSH candidates">
            {valueLshTop.map((row) => (
              <article>
                <strong>{row.title}</strong>
                <span>{row.type} · value {row.score.value_score.toFixed(2)} · confidence {row.score.confidence.toFixed(2)}</span>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Evolve-AGI Index ═══ -->
  <section class="section" id="evolve-agi-index" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evolve-AGI Index</div>
          <h2>自进化系数：把领域成熟度压成一个可解释指数</h2>
        </div>
        <a class="text-link" href="/evolve-agi-index/">完整指数 →</a>
      </div>
      <div class="eai-home-grid">
        <a class="eai-home-score" href="/evolve-agi-index/" aria-label="Open Evolve-AGI Index page">
          <span>{evolveAgiIndex.zhName}</span>
          <strong>{evolveAgiIndex.score}</strong>
          <em>Grade {evolveAgiIndex.grade}</em>
          <p>{evolveAgiIndex.oneSentence}</p>
        </a>
        <div class="eai-home-signals" aria-label="Evolve-AGI Index signals">
          {evolveAgiIndexSignals.slice(0, 4).map((signal) => (
            <article>
              <div>
                <span>{signal.shortLabel}</span>
                <strong>{signal.score}</strong>
              </div>
              <div class="eai-home-bar"><span style={`width:${signal.score}%;`} /></div>
              <p>{signal.label} · 权重 {signal.weight}%</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Star Rankings ═══ -->
  <section class="section" id="star-ranking">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Star 榜单</div>
          <h2>GitHub 项目 Star 排名与当前增长</h2>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a class="text-link" href="/star-growth/">2026 增长数据库 →</a>
          <a class="text-link" href="/star-analysis/">完整质量分析 →</a>
        </div>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">累计 Star 只说明历史 adoption，不能直接说明当前价值；2026 新增 Star、近 90 天增长和 coverage status 已单独进入增长数据库。</p>
      <div style="overflow-x: auto;">
        <table class="panorama-table">
          <thead>
            <tr>
              <th class="rank-col">#</th>
              <th>项目</th>
              <th class="num-col">Stars</th>
              <th class="num-col">质量分</th>
              <th>增长</th>
              <th class="verdict-col">判定</th>
            </tr>
          </thead>
          <tbody>
            {starRanking.map((s) => (
              <tr>
                <td class="rank-col">
                  {s.rank <= 3 ? (
                    <span class="medal" style={`background: ${s.rank === 1 ? '#FFD700' : s.rank === 2 ? '#C0C0C0' : '#CD7F32'}; color: #333;`}>{s.rank}</span>
                  ) : (
                    <span style="color: var(--muted);">{s.rank}</span>
                  )}
                </td>
                <td style="font-weight: 600;">{s.name}</td>
                <td class="num-col" style="font-weight: 700;">{s.stars >= 1000 ? `${(s.stars / 1000).toFixed(s.stars >= 10000 ? 0 : 1)}K` : s.stars}</td>
                <td class="num-col">
                  <span class="score-badge" style={`background: ${s.quality >= 60 ? 'var(--success)' : s.quality >= 40 ? '#A56117' : '#B83224'}15; color: ${s.quality >= 60 ? 'var(--success)' : s.quality >= 40 ? '#A56117' : '#B83224'};`}>{s.quality}</span>
                </td>
                <td>{growthEmoji[s.growth] || ''} {growthLabel[s.growth] || s.growth}</td>
                <td class="verdict-col" style="font-size: 0.8rem; color: var(--muted);">{s.verdict}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ Trend Board ═══ -->
  <section class="section" id="trend-board">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Trend 榜单</div>
          <h2>活跃度与增长趋势</h2>
        </div>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">按 Star 活跃度排名（近 90 天 stargazer 活跃比例）。高活跃 ≠ 高质量，但反映社区关注度。</p>

      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        {trendBoard.map((t) => (
          <article class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <h3 style="margin: 0; font-size: 1rem;">{t.name}</h3>
              <span style="font-size: 0.8rem; color: var(--muted);">#{t.rank}</span>
            </div>
            <div style="display: flex; gap: 12px; margin-bottom: 8px;">
              <div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent);">{t.activity}</div>
                <div style="font-size: 0.7rem; color: var(--muted);">活跃度</div>
              </div>
              <div>
                <div style="font-size: 1.4rem; font-weight: 700;">{t.diversity}</div>
                <div style="font-size: 0.7rem; color: var(--muted);">贡献者多样性</div>
              </div>
              <div>
                <div style="font-size: 1.4rem; font-weight: 700;">{t.forkQuality}</div>
                <div style="font-size: 0.7rem; color: var(--muted);">Fork 质量</div>
              </div>
            </div>
            <div class="pill-row">
              <span class="pill">{growthEmoji[t.growth]} {growthLabel[t.growth]}</span>
              <span class="pill">★ {(t.stars / 1000).toFixed(0)}K</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Direction Map ═══ -->
  <section class="section" id="direction-map" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">方向 Map</div>
          <h2>每个方向的最高质量代表作</h2>
        </div>
        <a class="text-link" href="/rank/">完整系统排名 →</a>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">六大方向，每个方向标注 Champion（最高分系统）、Evidence（核心证据）、Runner-up。用 Rank 快速找到每个领域的最佳实现。</p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px;">
        {directionMap.map((d) => (
          <article class="card" style={`border-top: 4px solid ${d.color};`}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <h3 style="margin: 0;">{d.icon} {d.direction}</h3>
              <span class="pill" style={`background: ${d.color}15; color: ${d.color}; border: 1px solid ${d.color}40;`}>{d.tier}</span>
            </div>

            <div class="champion-block" style="background: var(--surface-2); border-radius: var(--radius); padding: 12px; margin: 8px 0;">
              <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <strong style="font-size: 1.1rem;">🏆 {d.champion}</strong>
                <span style="font-weight: 700; color: var(--accent);">{d.championScore}</span>
              </div>
              <p style="font-size: 0.85rem; color: var(--muted); margin-top: 4px;">{d.evidence}</p>
            </div>

            <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted);">
              <span>亚军: {d.runnerUp}</span>
              <span>{d.maturity}</span>
            </div>
            <div class="pill-row" style="margin-top: 6px;">
              <span class="pill">{d.paperCount} 篇论文</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Agent-Swarm Evolve ═══ -->
  <section class="section" id="agent-swarm-evolve">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Agent-Swarm Evolve</div>
          <h2>把 Agent 团队本身变成可进化对象</h2>
        </div>
        <a class="text-link" href="/reports/projects/89-coral-multi-agent-evolution.md">CORAL model card →</a>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">这一部分不是“多开几个角色”，而是看角色库、拓扑、共享状态、验证队列、handoff 协议和组织记忆是否会在独立反馈后更新，并且能留下 lineage、失败候选和回滚路径。</p>

      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        {swarmEvolveMap.map((item) => (
          <article class="card">
            <div class="eyebrow">{item.track}</div>
            <h3>{item.systems}</h3>
            <p>{item.signal}</p>
            <div class="pill-row">
              <span class="pill">{item.evidence}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ About ═══ -->
  <section class="section" id="about">
    <div class="container split">
      <div>
        <div class="eyebrow">关于</div>
        <h2>Rank 是这个项目的核心价值。</h2>
      </div>
      <div class="card">
        <p>Self Evolve 不只是索引——它是<strong>过滤后的全景图</strong>。125 篇论文、530 个项目、97 个用户痛点，全部经过 Rank、Trust Chain 和交叉验证。</p>
        <p>具体的方法分析有价值，但展示全景图更有效。先看到整个领域的结构和排名，再深入细节。</p>
        <p style="color: var(--muted); font-size: 0.85rem; margin-top: 8px;">Star 榜单看热度，Trend 榜单看活力，方向 Map 看质量。三个视角互补。</p>
      </div>
    </div>
  </section>

  <!-- ═══ Research Timeline ═══ -->
  <section class="section" id="research">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">研究</div>
          <h2>值得持续追踪的进化机制</h2>
        </div>
        <a class="button" href="/research/">全部研究</a>
      </div>
      <div class="timeline">
        {featuredResearch.slice(0, 8).map((paper) => (
          <article class="timeline-item">
            <div class="year">{paper.year}</div>
            <div>
              <h3>{paper.url ? <a href={paper.url} target="_blank" rel="noopener">{paper.title}</a> : paper.title}</h3>
              <p>{paper.insight}</p>
              <div class="pill-row">
                {paper.cluster && <span class="pill" style="border-color: var(--brand)">{paper.cluster}</span>}
                {paper.tags.slice(0, 2).map((t) => <span class="pill">{t}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="section" id="blog">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">博客</div>
          <h2>面向 SEO 与开发者的实践笔记</h2>
        </div>
        <a class="button" href="/blog/">全部文章</a>
      </div>
      <div class="grid">
        {posts.map((post) => (
          <article class="card">
            <div class="eyebrow">{post.data.pubDate.toISOString().slice(0,10)}</div>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="pill-row">{post.data.tags.map((tag) => <span class="pill">{tag}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="section">
    <div class="container">
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <a href="/star-growth/" class="card" style="text-decoration: none; color: inherit; text-align: center;">
          <div style="font-size: 1.5rem;">⭐</div>
          <h3>2026 Star 增长</h3>
        </a>
        <a href="/rank/" class="card" style="text-decoration: none; color: inherit; text-align: center;">
