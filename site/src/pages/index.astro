---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { featuredResearch } from '@/data/research';
import { starQualityScores } from '@/data/starAnalysis';
import { evolveAgiIndex, evolveAgiIndexSignals } from '@/data/evolveAgiIndex';
import { publicCorpusStats } from '@/data/publicCorpusStats';
import ValueLshGraph3D from '@/components/ValueLshGraph3D.astro';
import valueLshSnapshotJson from '../../../analysis/value-lsh-index.json';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);

interface ValueLshHomeRow {
  type: string;
  title: string;
  score: {
    value_score: number;
    confidence: number;
  };
}

const valueLshSnapshot = valueLshSnapshotJson as {
  generated_at: string;
  summary: {
    total_materials: number;
    value_tag_count: number;
    total_buckets: number;
    total_clusters: number;
    value_class_counts: Record<string, number>;
  };
  top_high_value_candidates: ValueLshHomeRow[];
};
const valueLshSummary = valueLshSnapshot.summary;
const valueLshTop = valueLshSnapshot.top_high_value_candidates.slice(0, 3);
const homeEvidenceBand = (confidence: number) => {
  if (confidence >= 70) return '较稳';
  if (confidence >= 45) return '待复核';
  return '弱证据';
};
const homeScoreBand = (score: number) => {
  if (score >= 70) return '优先深读';
  if (score >= 45) return '需要复核';
  return '暂不引用';
};

const readerPromises = [
  {
    label: 'Definition',
    title: '先判断它算不算自进化',
    body: '不是看名字里有没有 evolve，而是看可变对象、反馈、验证、保留和回滚。',
    bodyEn: 'Do not start with the name. Start with the mutable object, feedback signal, verifier, retention, and rollback path.',
    href: '/topics/self-evolving-ai-agents/',
  },
  {
    label: 'Mechanism',
    title: '再判断它通过哪条回路变强',
    body: '反思、搜索、评估、代码自改进、种群/归档不是同一件事，证据强度也不同。',
    bodyEn: 'Reflection, search, evaluator loops, code evolution, and population archives are different evidence modes.',
    href: '/topics/five-evolution-loops/',
  },
  {
    label: 'Evidence',
    title: '最后查证据和限制',
    body: 'Star、benchmark、项目报告、Value LSH 和 Evolve-AGI Index 都只是证据面，不是单点答案。',
    bodyEn: 'Stars, benchmarks, project reports, Value LSH, and the Evolve-AGI Index are evidence surfaces, not one-number truth.',
    href: '/resource-library/',
  },
];

const corePaths = [
  ['New reader', '从定义页开始', 'Start with the definition page', '/topics/self-evolving-ai-agents/'],
  ['Researcher', '看五类回路和论文主线', 'Read the five loops and paper spine', '/topics/five-evolution-loops/'],
  ['Builder', '看 benchmark 与项目报告', 'Compare benchmarks and project reports', '/topics/code-evolution-benchmark/'],
  ['Investor / product', '看增长、价值分类和信任边界', 'Use growth, value classification, and trust boundaries', '/value-lsh/'],
];

// ── Legacy adoption priors (Top 15 by historical star count) ──
const starRanking = [...starQualityScores]
  .sort((a, b) => b.totalStars - a.totalStars)
  .slice(0, 15)
  .map((s, i) => ({
    rank: i + 1,
    name: s.name,
    stars: s.totalStars,
    quality: s.compositeScore,
    growth: s.growthPattern,
    verdict: s.verdict,
  }));

// ── Trend Board (sorted by star activity) ──
const trendBoard = [...starQualityScores]
  .sort((a, b) => b.starActivityScore - a.starActivityScore)
  .slice(0, 10)
  .map((s, i) => ({
    rank: i + 1,
    name: s.name,
    activity: s.starActivityScore,
    diversity: s.contributorDiversity,
    forkQuality: s.forkQualityScore,
    growth: s.growthPattern,
    stars: s.totalStars,
  }));

// ── Direction Map: best-in-class per mechanism direction ──
const directionMap = [
  {
    direction: '架构/代码自修改',
    icon: '🧬',
    color: '#B83224',
    tier: 'Tier A',
    champion: 'AlphaEvolve',
    championScore: 7.06,
    evidence: '打破 56 年矩阵乘法记录，75% SOTA 恢复率',
    runnerUp: 'DGM (6.78)',
    maturity: 'L4 Code Self-Mod',
    paperCount: 7,
  },
  {
    direction: 'Agent 自动设计',
    icon: '🏗️',
    color: '#9b59b6',
    tier: 'Tier A',
    champion: 'ADAS',
    championScore: 6.50,
    evidence: '自动发现 Agent 架构，跨域迁移',
    runnerUp: 'OpenEvolve (6.42)',
    maturity: 'L4 Arch Search',
    paperCount: 5,
  },
  {
    direction: '推理时自我修正',
    icon: '🪞',
    color: '#3498db',
    tier: 'Tier B+',
    champion: 'Reflexion',
    championScore: 6.39,
    evidence: 'HumanEval 91%, AlfWorld 97%',
    runnerUp: 'Self-Refine (6.00)',
    maturity: 'L2 Prompt/Output',
    paperCount: 15,
  },
  {
    direction: '训练时自博弈',
    icon: '🎮',
    color: '#e67e22',
    tier: 'Tier B',
    champion: 'Absolute Zero',
    championScore: 6.33,
    evidence: '零外部数据自博弈，NeurIPS Best Paper',
    runnerUp: 'ReVeal (5.89)',
    maturity: 'L2 Self-Play RL',
    paperCount: 12,
  },
  {
    direction: '声明式 Prompt 优化',
    icon: '⚡',
    color: '#2ecc71',
    tier: 'Tier B',
    champion: 'DSPy',
    championScore: 6.15,
    evidence: '最广泛采用，编译式 prompt 优化',
    runnerUp: 'OPRO',
    maturity: 'L2 Prompt Evo',
    paperCount: 10,
  },
  {
    direction: '技能/记忆积累',
    icon: '📚',
    color: '#1abc9c',
    tier: 'Tier B',
    champion: 'Voyager',
    championScore: 5.78,
    evidence: '3.3x 独特物品，技能库终身学习',
    runnerUp: 'SE-Agent (5.96)',
    maturity: 'L3 Memory/Skill',
    paperCount: 18,
  },
];

const swarmEvolveMap = [
  {
    track: '拓扑优化',
    systems: 'GPTSwarm / EvoMAC',
    signal: 'agent 节点、通信边和路由概率会随任务反馈更新',
    evidence: '看 held-out tasks、edge ablation、环境反馈',
  },
  {
    track: '自主组织基础设施',
    systems: 'CORAL / metaswarm',
    signal: 'worktree、shared state、grader、heartbeat 和 archive 形成组织级闭环',
    evidence: '看 grader 独立性、lineage replay、跨模型 review',
  },
  {
    track: '生产型 swarm runtime',
    systems: 'swarmclaw / OpenClaw team',
    signal: 'schedules、delegation、memory、provider routing 和工具权限进入运行时',
    evidence: '看真实 workflow、权限审计、成本上限和可观测性',
  },
  {
    track: '图谱涌现协作',
    systems: 'Insight Swarm',
    signal: 'shared knowledge graph、tension links、challenge votes 代替中心 orchestrator',
    evidence: '看反共识指标、证据链和 contested thesis 处理',
  },
];

const growthEmoji: Record<string, string> = {
  organic: '🌱',
  viral: '🚀',
  steady: '📊',
  suspicious: '⚠️',
};

const growthLabel: Record<string, string> = {
  organic: '自然增长',
  viral: '病毒式',
  steady: '稳定',
  suspicious: '可疑',
};
const stripScore = (value: string) => value.replace(/\s*\([^)]*\)/g, '');
---

<BaseLayout alternateZh="/" alternateEn="/en/">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Self Evolve AI · 中文默认入口</div>
        <h1>AI Agent 自进化：到底改了什么、谁验证、能否留下来？</h1>
        <p class="lead">这不是链接收藏，而是面向可审计改进系统的判断图：一个 agent 到底改了什么、由什么反馈选择、谁验证、能否保留，失败时能不能回滚。</p>
        <p class="english-note">English core summaries are available under /en/. The full evidence corpus remains Chinese-first while parity is being built.</p>
        <div class="hero-actions">
          <a class="button primary" href="/topics/self-evolving-ai-agents/">先看定义 / Start</a>
          <a class="button" href="/topics/five-evolution-loops/">五类回路</a>
          <a class="button" href="/topics/code-evolution-benchmark/">Benchmark Matrix</a>
          <a class="button" href="/value-lsh/">Value LSH</a>
          <a class="text-link" href="/paper/">Paper</a>
        </div>
        <div class="metrics" aria-label="研究站点指标">
          <div class="metric"><strong>5问</strong><span>改了什么、谁验证、是否保留</span></div>
          <div class="metric"><strong>3层</strong><span>强证据、待复核、弱证据</span></div>
          <div class="metric"><strong>1路</strong><span>先判断，再查证据</span></div>
        </div>
      </div>
      <aside class="hero-evidence" aria-label="Self Evolve evidence pipeline">
        <div class="eyebrow">Reader contract</div>
        <ol>
          <li><span>1</span><strong>先给判断，不先给资料堆。</strong></li>
          <li><span>2</span><strong>每个判断都回到 paper、project report、benchmark 或 raw index。</strong></li>
          <li><span>3</span><strong>英文核心摘要可读；完整英文同证据链仍在推进。</strong></li>
          <li><span>4</span><strong>没有验证、保留和回滚的 claim 标成弱证据。</strong></li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Start here / 读者路径</div>
          <h2>如果你只读三件事，按这个顺序读。</h2>
        </div>
      </div>
      <div class="grid reader-promise-grid">
        {readerPromises.map((item) => (
          <a class="card" href={item.href} style="text-decoration: none; color: inherit;">
            <div class="eyebrow">{item.label}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="english-note">{item.bodyEn}</p>
          </a>
        ))}
      </div>
      <div class="score-table-wrap reader-path-table">
        <table class="score-table">
          <thead>
            <tr><th>Reader</th><th>中文路径</th><th>English path</th><th>Entry</th></tr>
          </thead>
          <tbody>
            {corePaths.map(([reader, zh, en, href]) => (
              <tr>
                <td><strong>{reader}</strong></td>
                <td>{zh}</td>
                <td>{en}</td>
                <td><a class="text-link" href={href}>Open</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ Value LSH 3D Graph ═══ -->
  <section class="section value-lsh-home-section" id="value-lsh" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evidence triage / 证据分诊</div>
          <h2>材料太多时，先决定哪些值得读、哪些需要复核。</h2>
        </div>
        <a class="text-link" href="/value-lsh/">打开完整 3D 图谱 →</a>
      </div>
      <div class="value-lsh-home-layout">
        <div class="value-lsh-home-graph">
          <ValueLshGraph3D variant="compact" maxNodes={760} height={380} />
        </div>
        <div class="value-lsh-home-panel">
          <p>这不是价值裁判，也不是累计 Star 榜。它用 26 个判断问题，把 GitHub、论文、社交/X 和博客材料先分成三类：值得深读、需要复核、证据不足或有风险。技术细节进入方法页，首页只保留读者用途。</p>
          <div class="value-lsh-home-stats">
            <div><strong>{valueLshSummary.total_materials.toLocaleString()}</strong><span>materials</span></div>
            <div><strong>{valueLshSummary.value_tag_count}</strong><span>判断问题</span></div>
            <div><strong>{valueLshSummary.total_buckets}</strong><span>相似证据组</span></div>
          </div>
          <div class="value-lsh-home-split">
            <span>优先深读 {valueLshSummary.value_class_counts['high-value-candidate'].toLocaleString()}</span>
            <span>待复核 {valueLshSummary.value_class_counts['needs-review'].toLocaleString()}</span>
            <span>修复/风险 {valueLshSummary.value_class_counts['low-signal-or-risk'].toLocaleString()}</span>
          </div>
          <div class="value-lsh-home-list" aria-label="Top value LSH candidates">
            {valueLshTop.map((row) => (
              <article>
                <strong>{row.title}</strong>
                <span>{row.type} · {homeScoreBand(row.score.value_score)} · {homeEvidenceBand(row.score.confidence)}</span>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Evolve-AGI Index ═══ -->
  <section class="section" id="evolve-agi-index" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evolve-AGI worksheet</div>
          <h2>一个工作型证据表，不是 AGI 分数。</h2>
        </div>
        <a class="text-link" href="/evolve-agi-index/">完整指数 →</a>
      </div>
      <div class="eai-home-grid">
        <a class="eai-home-score" href="/evolve-agi-index/" aria-label="Open Evolve-AGI Index page">
          <span>{evolveAgiIndex.zhName}</span>
          <strong>{evolveAgiIndex.score}</strong>
          <em>Exploratory rubric</em>
          <p>{evolveAgiIndex.oneSentence}</p>
        </a>
        <div class="eai-home-signals" aria-label="Evolve-AGI Index signals">
          {evolveAgiIndexSignals.slice(0, 4).map((signal) => (
            <article>
              <div>
                <span>{signal.shortLabel}</span>
                <strong>{signal.score}</strong>
              </div>
              <div class="eai-home-bar"><span style={`width:${signal.score}%;`} /></div>
              <p>{signal.label} · 权重 {signal.weight}%</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Historical Adoption Priors ═══ -->
  <section class="section" id="star-ranking">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Historical adoption prior</div>
          <h2>热度只提供候选线索，不能替代证据。</h2>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a class="text-link" href="/star-growth/">2026 增长试点账本 →</a>
          <a class="text-link" href="/star-analysis/">传播信号分析 →</a>
        </div>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">这个表只保留历史热度作为阅读线索，不负责判断当前质量。严肃判断必须回到 evaluator、benchmark、retention、失败记录和项目报告。</p>
      <div style="overflow-x: auto;">
        <table class="panorama-table">
          <thead>
            <tr>
              <th class="rank-col">#</th>
              <th>项目</th>
              <th class="num-col">Stars</th>
              <th class="num-col">线索分</th>
              <th>增长</th>
              <th class="verdict-col">判定</th>
            </tr>
          </thead>
          <tbody>
            {starRanking.map((s) => (
              <tr>
                <td class="rank-col">
                  {s.rank <= 3 ? (
                    <span style="color: var(--muted);">{s.rank}</span>
                  ) : (
                    <span style="color: var(--muted);">{s.rank}</span>
                  )}
                </td>
                <td style="font-weight: 600;">{s.name}</td>
                <td class="num-col" style="font-weight: 700;">{s.stars >= 1000 ? `${(s.stars / 1000).toFixed(s.stars >= 10000 ? 0 : 1)}K` : s.stars}</td>
                <td class="num-col">
                  <span class="score-badge" style={`background: ${s.quality >= 60 ? 'var(--success)' : s.quality >= 40 ? '#A56117' : '#B83224'}15; color: ${s.quality >= 60 ? 'var(--success)' : s.quality >= 40 ? '#A56117' : '#B83224'};`}>{s.quality}</span>
                </td>
                <td>{growthEmoji[s.growth] || ''} {growthLabel[s.growth] || s.growth}</td>
                <td class="verdict-col" style="font-size: 0.8rem; color: var(--muted);">{s.verdict}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ Trend Board ═══ -->
  <section class="section" id="trend-board">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Momentum clues</div>
          <h2>近期关注度只是下一步抓取线索</h2>
        </div>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">这里展示的是旧 star-signal 数据里的关注度线索，不是实时 GitHub 证据，也不是质量结论。完整 2026 new-star 判断必须等 star-history 覆盖达标。</p>

      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        {trendBoard.map((t) => (
          <article class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <h3 style="margin: 0; font-size: 1rem;">{t.name}</h3>
              <span style="font-size: 0.8rem; color: var(--muted);">#{t.rank}</span>
            </div>
            <div style="display: flex; gap: 12px; margin-bottom: 8px;">
              <div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent);">{t.activity}</div>
                <div style="font-size: 0.7rem; color: var(--muted);">活跃度</div>
              </div>
              <div>
                <div style="font-size: 1.4rem; font-weight: 700;">{t.diversity}</div>
                <div style="font-size: 0.7rem; color: var(--muted);">贡献者多样性</div>
              </div>
              <div>
                <div style="font-size: 1.4rem; font-weight: 700;">{t.forkQuality}</div>
                <div style="font-size: 0.7rem; color: var(--muted);">Fork 有效性</div>
              </div>
            </div>
            <div class="pill-row">
              <span class="pill">{growthEmoji[t.growth]} {growthLabel[t.growth]}</span>
              <span class="pill">★ {(t.stars / 1000).toFixed(0)}K</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Direction Map ═══ -->
  <section class="section" id="direction-map" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Mechanism anchors</div>
          <h2>六类代表案例：看为什么值得研究，不看谁是冠军。</h2>
        </div>
        <a class="text-link" href="/rank/">系统证据队列 →</a>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">这些不是最终排名。每类只给一个代表性证据锚点，帮助读者识别机制差异；严肃判断要回到论文、项目报告和原始 benchmark。</p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px;">
        {directionMap.map((d) => (
          <article class="card" style={`border-top: 4px solid ${d.color};`}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <h3 style="margin: 0;">{d.icon} {d.direction}</h3>
              <span class="pill" style={`background: ${d.color}15; color: ${d.color}; border: 1px solid ${d.color}40;`}>代表案例</span>
            </div>

            <div class="champion-block" style="background: var(--surface-2); border-radius: var(--radius); padding: 12px; margin: 8px 0;">
              <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <strong style="font-size: 1.1rem;">{d.champion}</strong>
                <span style="font-weight: 700; color: var(--accent);">证据锚点</span>
              </div>
              <p style="font-size: 0.85rem; color: var(--muted); margin-top: 4px;">{d.evidence}</p>
            </div>

            <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted);">
              <span>对照: {stripScore(d.runnerUp)}</span>
              <span>{d.maturity}</span>
            </div>
            <div class="pill-row" style="margin-top: 6px;">
              <span class="pill">{d.paperCount} 篇论文</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Agent-Swarm Evolve ═══ -->
  <section class="section" id="agent-swarm-evolve">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Agent-Swarm Evolve</div>
          <h2>把 Agent 团队本身变成可进化对象</h2>
        </div>
        <a class="text-link" href="/reports/projects/89-coral-multi-agent-evolution/">CORAL model card →</a>
      </div>
      <p style="color: var(--muted); margin-bottom: 20px;">这一部分不是“多开几个角色”，而是看角色库、拓扑、共享状态、验证队列、handoff 协议和组织记忆是否会在独立反馈后更新，并且能留下 lineage、失败候选和回滚路径。</p>

      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        {swarmEvolveMap.map((item) => (
          <article class="card">
