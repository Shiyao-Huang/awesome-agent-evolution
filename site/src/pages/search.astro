---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projects } from '@/data/projects';
import { featuredResearch } from '@/data/research';

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const items = [
  {
    type: '入口',
    title: 'GitHub 证据链',
    description: '从 Self Evolve 网站回到开源仓库、项目 model card、论文草稿、博客源码和索引规则。',
    href: '/github/',
    tags: ['GitHub', '开源仓库', '证据链', '源码']
  },
  {
    type: '入口',
    title: 'Survey 主题指南',
    description: '从资料库反推的自进化 AI 主题簇：定义、五类进化回路、代码自改进、记忆技能、Agent-Swarm、评估治理和生产痛点。',
    href: '/topics/',
    tags: ['主题地图', 'Survey', 'Self-Evolving Agents', '证据簇']
  },
  {
    type: '主题',
    title: '什么才算自进化 AI Agent',
    description: '稳定定义页：用可变对象、反馈信号、候选生成、独立验证、保留机制、审计回滚六个门槛判断一个系统是否真的自进化。',
    href: '/topics/self-evolving-ai-agents/',
    tags: ['自进化定义', 'Self-Evolving Agents', 'AI 自进化', 'Evolve-AGI Index', 'Survey']
  },
  {
    type: '主题',
    title: '五类进化回路',
    description: '稳定机制页：用规范到执行、搜索、评估、反思和种群五类回路理解自进化系统怎样把反馈变成可保留的改进。',
    href: '/topics/five-evolution-loops/',
    tags: ['五类进化回路', 'Five Evolution Loops', 'AI 自进化机制', 'feedback loop', 'Survey']
  },
  {
    type: '主题',
    title: '代码自我改进 Benchmark Matrix',
    description: '稳定 benchmark 页：区分 DGM/SICA、AlphaEvolve/OpenEvolve、ADAS/A-Evolve、OPRO/DSPy/GEPA 和反思修复回路的证据强度。',
    href: '/topics/code-evolution-benchmark/',
    tags: ['代码自我改进', 'AI code self improvement', 'AlphaEvolve', 'DGM', 'SWE-Bench', 'benchmark matrix']
  },
  {
    type: '入口',
    title: '2026 GitHub Star 抓取试点',
    description: '验证 stargazer history 抓取覆盖；coverage 达标前不构成 2026 增长排名。',
    href: '/star-growth/',
    tags: ['GitHub star growth', '2026 new stars', '增长试点账本', 'coverage status', 'Evolve-AGI Index']
  },
  {
    type: '入口',
    title: 'Value LSH 证据分诊',
    description: '用 26 个判断问题把素材分成优先深读、需要复核、弱证据/风险三类；它不是最终价值裁判。',
    href: '/value-lsh/',
    tags: ['Value LSH', '证据分诊', 'evidence repair', 'value facet matrix', 'AI Agent clustering']
  },
  {
    type: '入口',
    title: '资料库覆盖',
    description: '解释 Self Evolve 的 raw corpus、processed analysis、survey synthesis、project reports 和 Evolve-AGI Index 证据链。',
    href: '/resource-library/',
    tags: ['资料库', 'coverage', 'raw corpus', 'project reports', 'Evolve-AGI Index']
  },
  ...posts.map((post) => ({
    type: '博客',
    title: post.data.title,
    description: post.data.description,
    href: `/blog/${post.id}/`,
    tags: post.data.tags
  })),
  ...featuredResearch.map((paper) => ({
    type: '研究',
    title: paper.title,
    description: paper.insight,
    href: `/research/${slugify(paper.slug || paper.title)}/`,
    tags: paper.tags
  })),
  ...projects.map((project) => ({
    type: '项目',
    title: project.name,
    description: project.description,
    href: `/projects/${slugify(project.repo)}/`,
    tags: [project.category, project.pattern, ...project.tags]
  }))
];
const payload = JSON.stringify(items);
const readerTasks = [
  ['理解定义', '先判断一个系统到底算不算自进化。', '/topics/self-evolving-ai-agents/'],
  ['比较项目', '按机制、证据和限制比较项目，而不是按 star。', '/projects/'],
  ['查 benchmark', '看分数背后的 evaluator、失败候选和保留证据。', '/topics/code-evolution-benchmark/'],
  ['查风险/失败', '先找 weak evidence、回滚、权限、成本和记忆污染。', '/search/?q=risk']
];
---
<BaseLayout title="Self Evolve 搜索 — AI 自我进化项目、论文与博客" description="搜索 Self Evolve 的自进化 AI 博客、研究笔记和项目 model card。">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Search / 站内搜索</div>
      <h1>先选任务，再搜索证据。</h1>
      <p class="lead">搜索不是为了翻目录，而是为了回答一个判断问题：它算不算自进化、证据强不强、benchmark 能不能信、风险在哪里。</p>
      <div class="search-task-grid" aria-label="reader search tasks">
        {readerTasks.map(([title, body, href]) => (
          <a class="card" href={href} style="text-decoration: none; color: inherit;">
            <h3>{title}</h3>
            <p>{body}</p>
          </a>
        ))}
      </div>
      <div class="search-panel">
        <input id="search-input" class="search-input" type="search" placeholder="输入项目、论文、benchmark 或风险词..." autocomplete="off" />
        <div id="search-count" class="eyebrow">准备搜索</div>
      </div>
      <div id="search-results" class="post-stack" aria-live="polite"></div>
    </div>
  </section>
  <script is:inline define:vars={{ payload }}>
    const items = JSON.parse(payload);
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const count = document.getElementById('search-count');
    const params = new URLSearchParams(window.location.search);
    const normalize = (value) => String(value || '').toLowerCase();
    const render = (query) => {
      const q = normalize(query).trim();
      const matches = q
        ? items.filter((item) => normalize(`${item.title} ${item.description} ${(item.tags || []).join(' ')}`).includes(q)).slice(0, 40)
        : items.slice(0, 12);
      count.textContent = q ? `${matches.length} 条匹配` : `展示 ${matches.length} 条入口`;
      results.innerHTML = matches.map((item, index) => `
        <article class="post-card">
          <div class="post-number">${String(index + 1).padStart(2, '0')}</div>
          <div>
            <div class="eyebrow">${item.type}</div>
            <h2><a href="${item.href}">${item.title}</a></h2>
            <p>${item.description}</p>
            <div class="pill-row">${(item.tags || []).slice(0, 5).map((tag) => `<span class="pill">${tag}</span>`).join('')}</div>
          </div>
        </article>
      `).join('');
    };
    input.value = params.get('q') || '';
    input.addEventListener('input', () => render(input.value));
    render(input.value);
  </script>
</BaseLayout>

<style>
  .search-panel {
    display: grid;
    gap: 12px;
    margin: 28px 0;
  }
  .search-task-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .search-task-grid .card {
    padding: 16px;
  }
  .search-task-grid h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .search-task-grid p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .search-input {
    width: 100%;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--ink);
    border-radius: 8px;
    padding: 16px 18px;
    font: inherit;
    font-size: 18px;
  }
  .search-input:focus {
    outline: 2px solid var(--caret);
    outline-offset: 2px;
  }
  @media (max-width: 820px) {
    .search-task-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
