---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { coreKnowledgeGraph, knowledgeGraph, knowledgeGraphStats } from '@/data/knowledgeGraph';

const coreGraphPayload = JSON.stringify(coreKnowledgeGraph);
const fullGraphPayload = JSON.stringify(knowledgeGraph);
---
<BaseLayout title="Self Evolve 知识图谱 — 项目、论文与机制关系" description="Self Evolve 知识图谱，把自进化 AI 项目、论文、机制标签和研究簇连接成可检索的关系网络。">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Knowledge Graph / 知识图谱</div>
      <h1 class="gradient-text">项目、论文、机制和证据关系。</h1>
      <p class="lead">图谱现在从 README 全量索引、135 篇 paper review、前台项目卡片和人工质量排序项目共同生成。默认展示核心视图，避免全量节点变成不可读毛球。</p>
      <div class="metrics">
        <div class="metric"><strong>{knowledgeGraphStats.nodes}</strong><span>nodes</span></div>
        <div class="metric"><strong>{knowledgeGraphStats.edges}</strong><span>edges</span></div>
        <div class="metric"><strong>{knowledgeGraphStats.projects + knowledgeGraphStats.papers}</strong><span>projects + papers</span></div>
      </div>
    </div>
  </section>

  <section class="section graph-section">
    <div class="container graph-shell">
      <div class="graph-panel">
        <div class="graph-toolbar">
          <label>
            <span>Search</span>
            <input id="graph-search" type="search" placeholder="openevolve, Reflexion, 评估器..." />
          </label>
          <label>
            <span>Type</span>
            <select id="graph-type">
              <option value="all">All</option>
              <option value="project">Projects</option>
              <option value="paper">Papers</option>
              <option value="concept">Concepts</option>
              <option value="cluster">Clusters</option>
            </select>
          </label>
          <label>
            <span>Scope</span>
            <select id="graph-scope">
              <option value="core">Core 150</option>
              <option value="full">Full corpus</option>
            </select>
          </label>
        </div>
        <svg id="knowledge-graph" viewBox="0 0 1100 680" role="img" aria-label="Self Evolve knowledge graph"></svg>
      </div>
      <aside class="graph-detail" id="graph-detail">
        <div class="eyebrow">Selected Node</div>
        <h2>点击节点查看关系</h2>
        <p>搜索或选择类型后，图谱会高亮匹配节点及其直接关系。第一版使用静态生成数据，便于开源审计和后续替换为 Sigma.js 或 Cytoscape.js。</p>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ coreGraphPayload, fullGraphPayload }}>
    const graphs = {
      core: JSON.parse(coreGraphPayload),
      full: JSON.parse(fullGraphPayload)
    };
    let graph = graphs.core;
    const svg = document.querySelector('#knowledge-graph');
    const detail = document.querySelector('#graph-detail');
    const search = document.querySelector('#graph-search');
    const typeSelect = document.querySelector('#graph-type');
    const scopeSelect = document.querySelector('#graph-scope');
    const width = 1100;
    const height = 680;
    const center = { x: width / 2, y: height / 2 };
    const typeOrder = ['cluster', 'concept', 'paper', 'project'];
    const typeColor = {
      project: '#7cf7d4',
      paper: '#ffcf7c',
      concept: '#9f7cff',
      cluster: '#f6f8ff'
    };

    let byId = new Map();
    let adjacency = new Map();

    function indexGraph() {
      byId = new Map(graph.nodes.map((node) => [node.id, node]));
      adjacency = new Map(graph.nodes.map((node) => [node.id, new Set()]));
      for (const edge of graph.edges) {
        adjacency.get(edge.source)?.add(edge.target);
        adjacency.get(edge.target)?.add(edge.source);
      }
    }

    function placeNodes() {
      const grouped = Object.groupBy
        ? Object.groupBy(graph.nodes, (node) => node.type)
        : graph.nodes.reduce((acc, node) => {
            acc[node.type] ||= [];
            acc[node.type].push(node);
            return acc;
          }, {});

      typeOrder.forEach((type, ring) => {
        const list = grouped[type] || [];
        const radius = [70, 190, 310, 430][ring];
        list.forEach((node, index) => {
          const angle = (Math.PI * 2 * index) / Math.max(list.length, 1) - Math.PI / 2 + ring * 0.34;
          node.x = center.x + Math.cos(angle) * radius;
          node.y = center.y + Math.sin(angle) * radius;
        });
      });
    }

    function matches(node) {
      const q = search.value.trim().toLowerCase();
      const type = typeSelect.value;
      const typeOk = type === 'all' || node.type === type;
      const textOk = !q || `${node.label} ${node.summary || ''}`.toLowerCase().includes(q);
      return typeOk && textOk;
    }

    function render(selectedId) {
      const matched = new Set(graph.nodes.filter(matches).map((node) => node.id));
      const selectedNeighbors = selectedId ? adjacency.get(selectedId) || new Set() : new Set();
      svg.innerHTML = '';

      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.innerHTML = '<filter id="glow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>';
      svg.append(defs);

      for (const edge of graph.edges) {
        const source = byId.get(edge.source);
        const target = byId.get(edge.target);
        if (!source || !target) continue;
        const active = selectedId && (edge.source === selectedId || edge.target === selectedId);
        const visible = matched.has(edge.source) || matched.has(edge.target) || active;
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', source.x);
        line.setAttribute('y1', source.y);
        line.setAttribute('x2', target.x);
        line.setAttribute('y2', target.y);
        line.setAttribute('stroke', active ? '#7cf7d4' : 'rgba(255,255,255,.18)');
        line.setAttribute('stroke-width', active ? '2.5' : '1');
        line.setAttribute('opacity', visible ? '1' : '.14');
        svg.append(line);
      }

      for (const node of graph.nodes) {
        const active = node.id === selectedId;
        const related = selectedNeighbors.has(node.id);
        const visible = matched.has(node.id) || active || related;
        const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        group.setAttribute('transform', `translate(${node.x}, ${node.y})`);
        group.setAttribute('tabindex', '0');
        group.setAttribute('role', 'button');
        group.setAttribute('aria-label', node.label);
        group.style.cursor = 'pointer';
        group.addEventListener('click', () => selectNode(node.id));
        group.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') selectNode(node.id);
        });

        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('r', String(7 + node.weight * 1.5));
        circle.setAttribute('fill', typeColor[node.type]);
        circle.setAttribute('opacity', visible ? '1' : '.18');
        circle.setAttribute('stroke', active ? '#ffffff' : 'rgba(255,255,255,.55)');
        circle.setAttribute('stroke-width', active ? '3' : '1');
        if (active || related) circle.setAttribute('filter', 'url(#glow)');
        group.append(circle);

        if (node.frontier) {
          const frontierRing = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          frontierRing.setAttribute('r', String(16 + node.weight * 1.7));
          frontierRing.setAttribute('fill', 'none');
          frontierRing.setAttribute('stroke', '#ffcf7c');
          frontierRing.setAttribute('stroke-width', '2');
          frontierRing.setAttribute('stroke-dasharray', '4 6');
          group.append(frontierRing);
        }

        const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        label.textContent = node.label.length > 28 ? `${node.label.slice(0, 27)}...` : node.label;
        label.setAttribute('y', String(25 + node.weight));
        label.setAttribute('text-anchor', 'middle');
        label.setAttribute('fill', visible ? '#f6f8ff' : 'rgba(246,248,255,.28)');
        label.setAttribute('font-size', active || related || node.type === 'cluster' ? '13' : '11');
        label.setAttribute('font-weight', active || node.type === 'cluster' ? '800' : '500');
        group.append(label);
        svg.append(group);
      }
    }

    function selectNode(id) {
      const node = byId.get(id);
      if (!node) return;
      const neighbors = [...(adjacency.get(id) || [])].map((neighborId) => byId.get(neighborId)).filter(Boolean);
      detail.innerHTML = `
        <div class="eyebrow">${node.type}</div>
        <h2>${node.label}</h2>
        <p>${node.summary || 'No summary yet.'}</p>
        ${node.group ? `<p><strong>Group:</strong> ${node.group}</p>` : ''}
        ${node.source ? `<p><strong>Source:</strong> ${node.source}</p>` : ''}
        ${node.url ? `<p><a class="button" href="${node.url}" target="_blank" rel="noopener">Open source</a></p>` : ''}
        <h3>Direct relations</h3>
        <ul>${neighbors.slice(0, 12).map((item) => `<li>${item.type}: ${item.label}</li>`).join('')}</ul>
      `;
      render(id);
    }

    function setScope(scope) {
      graph = graphs[scope] || graphs.core;
      indexGraph();
      placeNodes();
      detail.innerHTML = `
        <div class="eyebrow">Graph Scope</div>
        <h2>${scope === 'full' ? 'Full corpus' : 'Core 150'}</h2>
        <p>${graph.nodes.length} nodes / ${graph.edges.length} edges. Search and filters operate inside the selected scope.</p>
      `;
      render();
    }

    setScope('core');
    search.addEventListener('input', () => render());
    typeSelect.addEventListener('change', () => render());
    scopeSelect.addEventListener('change', () => setScope(scopeSelect.value));
  </script>
</BaseLayout>

<style>
  .graph-section { padding-top: 12px }
  .graph-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 18px;
    align-items: stretch;
  }
  .graph-panel,
  .graph-detail {
    border: 1px solid var(--line);
    background: var(--card-bg);
    border-radius: var(--radius);
  }
  .graph-panel { overflow: hidden }
  .graph-toolbar {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 180px 170px;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }
  .graph-toolbar label {
    display: grid;
    gap: 7px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .graph-toolbar input,
  .graph-toolbar select {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(5, 6, 21, .8);
    color: var(--text);
    padding: 12px 14px;
    font: inherit;
    letter-spacing: 0;
  }
  #knowledge-graph {
    display: block;
    width: 100%;
    min-height: 620px;
    background:
      linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .graph-detail {
    padding: 22px;
    min-height: 620px;
  }
  .graph-detail h2 { font-size: 28px; line-height: 1.1; margin: 12px 0 }
  .graph-detail h3 { margin-top: 22px; font-size: 16px }
  .graph-detail ul { margin: 12px 0 0 18px; color: var(--muted); line-height: 1.7 }

  @media (max-width: 920px) {
    .graph-shell { grid-template-columns: 1fr }
    .graph-toolbar { grid-template-columns: 1fr }
    #knowledge-graph { min-height: 430px }
    .graph-detail { min-height: auto }
  }
</style>
