---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, projectGroups } from '@/data/projects';
import { featuredResearch } from '@/data/research';
import { site } from '@/data/site';
import { publicCorpusStats } from '@/data/publicCorpusStats';

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const projectHref = (repo: string) => `/projects/${slugify(repo)}/`;
const reportHref = (report: string) => `/reports/projects/${(report.split('/').pop() ?? report).replace(/\.md$/, '')}/`;
const researchHref = (slugOrTitle: string) => `/research/${slugify(slugOrTitle)}/`;
const paperHref = (url?: string) => {
  if (!url) return '';
  const arxiv = url.match(/arxiv\.org\/abs\/([^?#]+)/);
  return arxiv ? `https://arxiv.org/pdf/${arxiv[1]}` : url;
};
const normalize = (value = '') => value.toLowerCase().replace(/\s+/g, '');
const rankedProjects = [...projects].sort((a, b) => Number(b.stars || 0) - Number(a.stars || 0));
const rankByRepo = new Map(rankedProjects.map((project, index) => [project.repo.toLowerCase(), index + 1]));
const recentProjects = [...projects].sort((a,b)=>new Date(b.lastPushed).valueOf()-new Date(a.lastPushed).valueOf()).slice(0,4);
const readerPaths = [
  {
    title: '找真正的自进化闭环',
    body: '先看项目改变了什么对象，再看反馈、验证、保留和回滚是否存在。',
    href: '/en/topics/self-evolving-ai-agents/'
  },
  {
    title: '找可运行的工程线索',
    body: '优先检查 model card、源仓库、测试或 benchmark，再读 review-gated 报告。',
    href: '/projects/modelscope-agentevolver/'
  },
  {
    title: '找 2026 当前增长',
    body: '累计 Star 只是历史可见性；当前阶段价值要看新增 star、push、release 和证据完整度。',
    href: '/star-growth/'
  },
  {
    title: '找 swarm / harness 进化',
    body: '关注角色、拓扑、共享状态、验证器和 handoff 是否会随反馈改变。',
    href: '/topics/five-evolution-loops/'
  }
];
const relatedResearch = (project: (typeof projects)[number]) => {
  const projectTags = project.tags.map(normalize);
  const blob = normalize(`${project.name} ${project.repo} ${project.category} ${project.pattern} ${project.description} ${project.tags.join(' ')}`);
  return featuredResearch
    .map((paper) => {
      const terms = [paper.slug, paper.cluster, ...paper.tags, ...paper.title.split(/[：:,\s/]+/)].filter(Boolean).map(normalize);
      const tagScore = paper.tags.reduce((score, tag) => {
        const right = normalize(tag);
        return score + projectTags.reduce((sum, left) => sum + (left.includes(right) || right.includes(left) ? 4 : 0), 0);
      }, 0);
      const textScore = terms.reduce((score, term) => score + (term.length > 1 && blob.includes(term) ? 2 : 0), 0);
      return { paper, score: tagScore + textScore };
    })
    .filter((item) => item.score > 0 && item.paper.url)
    .sort((a, b) => b.score - a.score)
    .slice(0, 2)
    .map((item) => item.paper);
};
const enrichedProjects = projects.map((project) => ({
  ...project,
  href: projectHref(project.repo),
  reportHref: reportHref(project.report),
  rank: rankByRepo.get(project.repo.toLowerCase()) ?? projects.length,
  relatedPapers: relatedResearch(project)
}));
const enrichedByRepo = new Map(enrichedProjects.map((project) => [project.repo.toLowerCase(), project]));
const groups = projectGroups.map((group) => {
  const entries = group.repos.filter((repo): repo is string => typeof repo === 'string' && repo.length > 0).map((repo) => {
    const project = enrichedByRepo.get(repo.toLowerCase());
    return project
      ? { type: 'project' as const, repo, project }
      : { type: 'missing' as const, repo, githubHref: `https://github.com/${repo}` };
  });
  const groupStars = entries.reduce((sum, entry) => sum + (entry.type === 'project' ? Number(entry.project.stars || 0) : 0), 0);
  return { ...group, entries, groupStars };
});

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Self Evolve GitHub 项目索引',
  description: '自进化 AI 的 GitHub 证据入口图谱。累计 Star 顺序只是历史可见性线索，不是质量排名。',
  url: `${site.url}/projects/`,
  inLanguage: 'zh-CN',
  isPartOf: { '@id': `${site.url}/#website` },
  about: ['self-evolving AI agents', 'GitHub project evidence', 'AI agent model cards']
};
---
<BaseLayout title="Self Evolve 项目索引 — GitHub 自进化 AI 仓库" description="Self Evolve GitHub 项目索引，收录 OpenEvolve、AgentEvolver、Reflexion、Self-Refine 等自进化 AI 与 LLM 项目；Star 序号只是历史可见性信号，不是质量排名。" alternateZh="/projects/" alternateEn="/en/projects/">
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} is:inline />
  <section class="section">
    <div class="container">
      <div class="eyebrow">Projects / 项目索引</div>
      <h1 class="gradient-text">哪些 AI Agent 项目真的留下了“被反馈改进过”的证据？</h1>
      <p class="lead">本页不是仓库榜单，而是项目证据地图：先判断系统改了什么、谁验证、是否保留，再进入 model card、源仓库、自动关联论文线索和 review-gated 报告。</p>
      <div class="metrics">
        <div class="metric"><strong>{publicCorpusStats.classifiedGithubRepos}</strong><span>classified GitHub repos</span></div>
        <div class="metric"><strong>{projects.length}</strong><span>project cards / 证据卡</span></div>
        <div class="metric"><strong>{publicCorpusStats.strictEvolutionRepos}</strong><span>strict evolution candidates</span></div>
        <div class="metric"><strong>{recentProjects[0]?.lastPushed.slice(0,10)}</strong><span>最近活跃项目日期</span></div>
      </div>
      <aside class="source-panel" aria-label="项目索引阅读边界">
        <div>
          <div class="eyebrow">Bilingual evidence path / 双语证据路径</div>
          <h2>这是项目证据入口，不是质量榜单</h2>
          <p>每张卡先回答：项目是什么、它可能代表哪类自进化机制、证据从哪里来、哪些没有复现、下一步该读证据卡、源仓库还是待审报告。</p>
          <p><strong>English:</strong> Each entry points to the same evidence chain: repository, mechanism tag, model card, report route, visible source trail, and non-reproduction boundary. Star order is only historical visibility, not project quality.</p>
        </div>
        <div class="source-links">
          <a href="/en/projects/">English guide</a>
          <a href="/evolve-agi-index/">查看证据指数边界</a>
          <a href="/reports/">查看报告索引</a>
        </div>
      </aside>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Reader Path / 先按问题读</div><h2>先选你的判断任务，再进入完整目录</h2></div></div>
      <div class="grid">
        {readerPaths.map((path) => (
          <article class="card">
            <h3><a href={path.href}>{path.title}</a></h3>
            <p>{path.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">分组</div><h2>从代码进化到 Agent 组织进化</h2></div></div>
      <div class="grid project-group-grid">
        {groups.map((group)=><article class="card project-group-card">
          <header class="card-title-row">
            <div>
              <h3>{group.title}</h3>
              <p>{group.entries.length} repos · same mechanism family</p>
            </div>
          </header>
          <div class="project-link-list">
            {group.entries.map((entry) => entry.type === 'project' ? (
              <div class="project-link-row">
                <a class="project-link-main" href={entry.project.href}>
                  <span>Historical star-order signal #{String(entry.project.rank).padStart(3, '0')}</span>
                  <strong>{entry.project.name}</strong>
                  <em>{entry.project.repo}</em>
                </a>
                <div class="project-row-meta">
                  <span>{entry.project.stars.toLocaleString()} stars</span>
                  <span>{entry.project.lastPushed.slice(0,10)}</span>
                </div>
                <div class="project-row-actions">
                  <a href={entry.project.url} target="_blank" rel="noopener">GitHub</a>
                  <a href={entry.project.reportHref}>Report</a>
                  {entry.project.relatedPapers[0] && <a href={paperHref(entry.project.relatedPapers[0].url)} target="_blank" rel="noopener">PDF</a>}
                </div>
              </div>
            ) : (
              <div class="project-link-row muted">
                <a class="project-link-main" href={entry.githubHref} target="_blank" rel="noopener">
                  <span>new</span>
                  <strong>{entry.repo}</strong>
                  <em>GitHub source pending model card</em>
                </a>
                <div class="project-row-actions"><a href={entry.githubHref} target="_blank" rel="noopener">GitHub</a></div>
              </div>
            ))}
          </div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Repository Cards</div><h2>逐项复查：机制、证据、限制</h2></div></div>
      <div class="grid project-card-grid">
        {enrichedProjects.map((project)=><article class="card project-card">
          <div class="card-title-row">
            <div>
              <div class="eyebrow">{project.category}</div>
              <h3><a href={project.href}>{project.name}</a></h3>
            </div>
            <span class="rank-badge">Star-order signal #{String(project.rank).padStart(3, '0')}</span>
          </div>
          <p><a class="repo-link" href={project.url} target="_blank" rel="noopener">{project.repo}</a></p>
          <p>{project.description}</p>
          <div class="project-stat-grid">
            <div><span>Stars</span><strong>{project.stars.toLocaleString()}</strong></div>
            <div><span>Forks</span><strong>{project.forks}</strong></div>
            <div><span>Updated</span><strong>{project.lastPushed.slice(0,10)}</strong></div>
            <div><span>License</span><strong>{project.license}</strong></div>
          </div>
          <div class="pill-row">
            <span class="pill">{project.language}</span>
            {project.tags.map((tag)=><span class="pill">{tag}</span>)}
          </div>
          {project.relatedPapers.length > 0 && (
            <div class="related-paper-row">
              {project.relatedPapers.map((paper) => (
                <a class="pill" href={paperHref(paper.url)} target="_blank" rel="noopener">auto paper clue: {paper.title}</a>
              ))}
            </div>
          )}
          <div class="card-actions">
            <a class="button primary" href={project.href}>Evidence Card</a>
            <a class="button" href={project.url} target="_blank" rel="noopener">Source Repo</a>
            <a class="button" href={project.reportHref}>Review-gated Report</a>
            {project.relatedPapers[0] && <a class="button" href={researchHref(project.relatedPapers[0].slug || project.relatedPapers[0].title)}>Auto-related Research</a>}
          </div>
        </article>)}
      </div>
    </div>
  </section>
</BaseLayout>
