---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';
import { site } from '@/data/site';

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

export async function getStaticPaths() {
  const toSlug = (value: string) =>
    value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

  return projects.map((project) => ({
    params: { slug: toSlug(project.repo) },
    props: { project }
  }));
}

const { project } = Astro.props;
const projectSlug = slugify(project.repo);
const title = `${project.name} Model Card — ${project.category} | Self Evolve`;
const description = `${project.name} 项目证据卡：说明它在 Self Evolve 图谱中的角色、机制线索、可见证据和未复现边界。`;
const publishedReportPath = project.report.replace(/\.md$/, '');
const reportHref = `/reports/${publishedReportPath}/`;
const localReportPath = `site/public/reports/${project.report}`;
const githubReportUrl = `${site.github}/blob/main/${localReportPath}`;
const updatedDate = project.lastPushed ? project.lastPushed.slice(0, 10) : 'unknown';
const evidenceStatus =
  project.status === 'verified'
    ? {
        label: 'Source-traceable snapshot',
        zh: '已连到 GitHub 源、站内报告和项目索引；这不等于本仓库完成了本地复现、benchmark 复跑或质量背书。',
        en: 'Source-traceable snapshot; not a local reproduction, benchmark rerun, or quality endorsement.'
      }
    : project.status === 'candidate'
      ? {
          label: 'Evidence candidate',
          zh: '已有可读线索，但仍需要补充原始材料、运行证据或第三方复核。',
          en: 'Readable evidence exists, but source coverage, execution evidence, or independent review is still incomplete.'
        }
      : {
          label: 'Verification pending',
          zh: '占位项目卡，只能作为后续审查入口，不能作为公开结论引用。',
          en: 'Placeholder card for later review, not a public conclusion to cite.'
        };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: `${site.url}/projects/${projectSlug}/`,
  dateModified: project.lastPushed,
  inLanguage: 'zh-CN',
  keywords: [project.name, project.repo, project.category, project.pattern, ...project.tags],
  image: new URL('/visuals/self-evolve-og.png', site.url).toString(),
  publisher: { '@id': `${site.url}/#organization` },
  about: [
    project.name,
    project.repo,
    project.category,
    project.pattern,
    ...project.tags
  ],
  isBasedOn: project.url,
  mainEntity: {
    '@type': 'SoftwareSourceCode',
    name: project.name,
    codeRepository: project.url,
    programmingLanguage: project.language,
    license: project.license
  }
};
---

<BaseLayout title={title} description={description} type="article" modifiedTime={project.lastPushed} pageKeywords={[project.name, project.repo, project.category, project.pattern, ...project.tags]}>
  <article class="project-detail">
    <div class="container">
      <a class="button" href="/projects/">&larr; 返回项目索引</a>
      <header class="project-hero">
        <div>
          <div class="eyebrow">{project.category}</div>
          <h1>{project.name}</h1>
          <p class="lead">{project.description}</p>
          <div class="pill-row">
            <a class="pill" href={project.url} target="_blank" rel="noopener">{project.repo}</a>
            <span class="pill">{project.language}</span>
            <span class="pill">{project.license}</span>
            <span class="pill">{evidenceStatus.label}</span>
          </div>
        </div>
        <aside class="model-card-summary" aria-label={`${project.name} model card summary`}>
          <div class="eyebrow">Model Card</div>
          <dl>
            <div><dt>Stars</dt><dd>{project.stars.toLocaleString()}</dd></div>
            <div><dt>Forks</dt><dd>{project.forks}</dd></div>
            <div><dt>Updated</dt><dd>{updatedDate}</dd></div>
            <div><dt>Pattern</dt><dd>{project.pattern}</dd></div>
          </dl>
        </aside>
      </header>

      <aside class="source-panel" aria-label={`${project.name} evidence boundary`}>
        <div>
          <div class="eyebrow">How to read / 如何阅读</div>
          <h2>先把这页读成证据快照，不要读成项目质量排名</h2>
          <p>{evidenceStatus.zh}</p>
          <p><strong>English:</strong> {evidenceStatus.en}</p>
        </div>
        <div class="source-links">
          <a href={project.url} target="_blank" rel="noopener">原始 GitHub 仓库</a>
          <a href={reportHref}>公开项目报告</a>
          <a href="/evolve-agi-index/">查看证据指数边界</a>
        </div>
      </aside>

      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

      <section class="model-card-grid" aria-label="Project model card">
        <section class="model-card-block">
          <div class="eyebrow">1. 它在图谱里的角色</div>
          <h2>为什么这个项目重要</h2>
          <p>{project.name} 属于 <strong>{project.category}</strong>，在 Self Evolve 图谱中是 <strong>{project.pattern}</strong> 这一类机制的观察样本。它的阅读价值不只来自 Star 数，而来自它能把自进化问题落到可检查的工程环节：生成、反馈、评估、记忆、搜索、编排或训练数据闭环。</p>
        </section>

        <section class="model-card-block">
          <div class="eyebrow">2. 进化机制</div>
          <h2>它如何产生改进信号</h2>
          <p>当前归档的机制链是：<strong>{project.pattern}</strong>。阅读时应优先确认三件事：改进对象是什么，反馈信号来自哪里，评估是否能阻止退化。</p>
          <div class="pill-row">{project.tags.map((tag) => <span class="pill">{tag}</span>)}</div>
        </section>

        <section class="model-card-block">
          <div class="eyebrow">3. 教学用法</div>
          <h2>适合拿来教什么</h2>
          <p>适合用作 <strong>{project.category}</strong> 的案例卡。教学时可以让读者沿着 “目标任务 -> 反馈来源 -> 改动策略 -> 评估指标 -> 失败模式” 五步复盘，而不是只看 README 或安装命令。</p>
        </section>

        <section class="model-card-block">
          <div class="eyebrow">4. 工程表面</div>
          <h2>技术栈与可运行性线索</h2>
          <p>主要语言是 <strong>{project.language}</strong>，记录的技术栈包括：{project.stack.join('、')}。许可证记录为 <strong>{project.license}</strong>，最近活跃日期为 <strong>{updatedDate}</strong>。</p>
        </section>

        <section class="model-card-block">
          <div class="eyebrow">5. 证据链</div>
          <h2>从原始材料到分析</h2>
          <p>站内数据保留了 GitHub 源、局部镜像路径和公开报告路径。这里的证据链优先说明“材料从哪里来、我们如何归类、哪里还没有复现”，而不是替原项目做最终质量裁决。</p>
          <ul>
            <li>GitHub: <a href={project.url} target="_blank" rel="noopener">{project.url}</a></li>
            <li>Local mirror: <code>{project.localPath ?? 'not recorded'}</code></li>
            <li>Source report: <a href={githubReportUrl} target="_blank" rel="noopener">{localReportPath}</a></li>
            <li>Published report path: <a href={reportHref}>{reportHref}</a></li>
          </ul>
        </section>

        <section class="model-card-block">
          <div class="eyebrow">6. 读者问题</div>
          <h2>继续深挖时问什么</h2>
          <ul>
            <li>这个项目的评估信号能否稳定复现，还是只在 demo 中成立？</li>
            <li>它改进的是 prompt、工具、记忆、代码、策略、数据，还是完整 agent 组织？</li>
            <li>失败样本会不会被保存，并在下一轮产生行为改变？</li>
            <li>它和同类项目相比，多出来且可复查的机制是什么？</li>
          </ul>
        </section>
      </section>

      <aside class="source-panel" aria-label={`${project.name} GitHub evidence links`}>
        <div>
          <div class="eyebrow">Open Source Trail</div>
          <h2>回到 GitHub 检查这个项目</h2>
          <p>这个 model card 的目的不是替代原仓库，而是帮读者先建立判断框架：项目解决什么问题、用什么进化机制、证据链在哪里。做技术选型时，仍应回到 GitHub 查看代码、issue、release 和最近提交。</p>
        </div>
        <div class="source-links">
          <a href={project.url} target="_blank" rel="noopener">打开原始 GitHub 仓库</a>
          <a href={githubReportUrl} target="_blank" rel="noopener">查看分析源码</a>
          <a href={`${site.github}/issues/new?title=${encodeURIComponent(`Update model card: ${project.repo}`)}`} target="_blank" rel="noopener">提交更新线索</a>
          <a href={`/search/?q=${encodeURIComponent(project.repo)}`}>搜索站内相关内容</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
