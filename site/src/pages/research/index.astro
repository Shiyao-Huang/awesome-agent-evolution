---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { featuredResearch, researchClusters } from '@/data/research';
import { researchCoverage } from '@/data/researchCoverage';
import { getCollection } from 'astro:content';
const notes = (await getCollection('research')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout
  title="Self Evolve 研究图谱 — 自进化智能体论文复核入口"
  description="Self Evolve 研究图谱把自进化智能体、代码自我改进、benchmark、机制簇和论文缺口整理成可复核入口；当前仍是持续补全的研究地图，不是完整系统综述。"
  alternateZh="/research/"
  alternateEn="/en/research/"
>
  <section class="section"><div class="container"><div class="eyebrow">研究图谱</div><h1 class="gradient-text">先看论文支持了什么 claim，再看它还没证明什么。</h1><p class="lead">这里不是“论文越多越好”的列表，而是把论文精读、benchmark 设置、机制簇和 coverage gaps 放到同一张复核地图。读者可以先判断每篇论文支持的是定义、方法、系统、评估还是治理，再回到原文、PDF 和站内笔记。</p><div class="hero-actions" style="margin-top: 22px;"><a class="button primary" href="/en/research/">English guide</a><a class="button" href="/graph/">探索性证据图</a><a class="text-link" href="/paper/">论文主线</a></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Coverage boundary</div><h2>缺口不是附录，是读者判断的一部分。</h2></div><a class="button" href="/graph/">查看探索性证据图</a></div><p style="color: var(--muted); max-width: 860px; line-height: 1.75;">当前已有 {researchCoverage.reviewFiles} 篇 review 与 {researchCoverage.rawUniqueIds} 个 raw unique paper IDs，但 mainstream survey、benchmark、安全治理和经验学习分支还需要补强。下面这些条目不是“已完成引用清单”，而是下一轮 source tracing 的优先队列。</p><div class="metrics" style="margin-top: 18px;"><div class="metric"><strong>{researchCoverage.rawUniqueIds}</strong><span>raw unique paper IDs</span></div><div class="metric"><strong>{researchCoverage.reviewFiles}</strong><span>review files</span></div><div class="metric"><strong>{researchCoverage.identifiedCoverageGaps}</strong><span>priority gaps</span></div></div><div class="grid" style="margin-top: 18px">{researchCoverage.coverageGaps.slice(0, 6).map((paper)=><article class="card"><div class="eyebrow">{paper.year} · {paper.status}</div><h3><a href={paper.url} target="_blank" rel="noopener">{paper.title}</a></h3><p>{paper.reason}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">研究簇</div><h2>Self Evolve 的五条技术支流</h2></div></div><div class="grid">{researchClusters.map((cluster)=><article class="card"><h3>{cluster.title}</h3><p>{cluster.summary}</p><div class="pill-row">{cluster.items.map((item)=><span class="pill">{item}</span>)}</div></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">代表工作</div><h2>可直接进入 Landing Page 的研究卡片</h2></div></div><div class="timeline">{featuredResearch.map((paper)=><article class="timeline-item"><div class="year">{paper.year}</div><div><h2>{paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}</h2><p>{paper.insight}</p><p><strong>关联：</strong>{paper.relation}</p><div class="pill-row"><span class="pill">{paper.cluster}</span>{paper.tags.map((tag)=><span class="pill">{tag}</span>)}</div></div></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">MDX 笔记</div><h2>可持续发布的论文精读页</h2></div></div><div class="grid">{notes.map((note)=><article class="card"><div class="eyebrow">{note.data.status}</div><h3><a href={`/research/${note.id}/`}>{note.data.title}</a></h3><p>{note.data.description}</p><div class="pill-row">{note.data.tags.map((tag)=><span class="pill">{tag}</span>)}</div></article>)}</div></div></section>
</BaseLayout>
