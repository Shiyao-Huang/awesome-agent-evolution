---
import BaseLayout from '../layouts/BaseLayout.astro';

const whatWorked = [
  {
    title: 'LLM Wiki Pattern 知识累积',
    verdict: '有效',
    color: '#27ae60',
    stats: '52 页面, 737 关键词',
    detail: '三层架构（Raw→Wiki→Schema）解决了 RAG 重复推导的痛点。Ingest→Query→Lint 循环让知识编译一次、持续更新、交叉引用不需要每次重建。这个 2026-05-26 复盘快照中，125 篇论文的分析结果持久存储在 52 个 wiki 页面中。'
  },
  {
    title: '多 Agent 并行素材收集',
    verdict: '有效',
    color: '#27ae60',
    stats: '4 Researcher, 3,272 条素材',
    detail: 'GitHub/论文/社交/博客四类素材并行分析，6 天产出 3,272 条原始素材、122 次提交。专业化分工（Researcher 挖掘 → Scribe 索引 → QA 验证 → Architect 综合）在角色边界清晰时效率最高。'
  },
  {
    title: '三源交叉验证方法论',
    verdict: '有效',
    color: '#27ae60',
    stats: '论文 × 项目 × 痛点',
    detail: '论文声称 self-play 有效 → DGM 实现 SWE-bench 20→50% → 用户报告"自改进目前是神话"。三源形成张力，避免单一源偏见。这是调查的核心差异化贡献。'
  },
  {
    title: 'Mom Test 痛点提取',
    verdict: '有效',
    color: '#27ae60',
    stats: '97 痛点, 5 跨平台主题',
    detail: 'Reddit(47) + HN(36) + X/Twitter(14) 真实讨论语义分析，不是问卷调查。发现 5 个跨平台重复主题，直接反推系统设计需求。'
  },
  {
    title: '质量门禁自动化',
    verdict: '有效',
    color: '#27ae60',
    stats: '6 条规则, 1 自动检查',
    detail: '把危险操作规则写入仓库后，破坏性操作显著减少；自动检查也拦截了高风险命令。经验是：质量规则必须变成可复跑的门禁，而不是只靠团队记忆。'
  },
  {
    title: '五维机制框架 (M1-M5)',
    verdict: '有效',
    color: '#27ae60',
    stats: '125 papers classified',
    detail: 'M1 观测(12) → M2 评估(11) → M3 改进(52) → M4 协同(19) → M5 涌现(7)。这是 2026-05-26 论文分类快照，不等同于当前全仓库计数。每个维度都有独立研究且通过 DAG 互连。'
  }
];

const whatFailed = [
  {
    title: '自动化流程破坏未提交工作',
    verdict: 'P0 失败',
    color: '#e74c3c',
    stats: '~20min 周期, 41 stashes, 3 文件丢失',
    detail: '周期性自动化曾清理未提交状态，导致已经写入磁盘的文件丢失。教训不是“不要自动化”，而是完成状态必须有可恢复提交、补丁或审计记录。'
  },
  {
    title: 'EN→CN 结构映射失败',
    verdict: 'P0 失败',
    color: '#e74c3c',
    stats: '7/8 章偏离, 2 CRITICAL',
    detail: '中英文稿件在结构上曾明显偏离：8 章中 7 章需要复核，Ch3 分类法不同，Ch4 体量差异过大。根因不是翻译问题，而是缺少自动结构比对和逐章证据映射。'
  },
  {
    title: '完成状态缺少可恢复证据',
    verdict: 'P1 问题',
    color: '#e67e22',
    stats: '初始交付率 25%',
    detail: '页面状态曾显示完成，但对应文件后来无法恢复。真相是文件确实写入过磁盘，却没有进入可恢复的版本记录。这暴露了"完成 = 文件存在"必须升级为"完成 = 有提交、索引和验证证据"。'
  },
  {
    title: '多角色协作开销大',
    verdict: 'P1 问题',
    color: '#e67e22',
    stats: '18 agents, 协调 >50%',
    detail: '团队消息日志显示大量"我在做什么""谁在做这个"的协调消息。实际编码时间 < 50%。多角色协作如果没有共享状态、任务边界和完成证据，协调成本会非线性增长。'
  },
  {
    title: '上下文窗口溢出',
    verdict: 'P1 问题',
    color: '#e67e22',
    stats: '6 会话中断',
    detail: '长任务中上下文容易溢出，团队会丢失之前的分析结果。被迫通过持久知识库和提交历史恢复，而不是直接继续。6 个协作会话因上下文耗尽而中断。'
  },
  {
    title: 'M5 涌现行为研究严重不足',
    verdict: 'Research Gap',
    color: '#e74c3c',
    stats: '7/125 papers, safety-critical',
    detail: '安全风险的时间涌现、能力边界漂移——这些最关键的问题研究最少。在 2026-05-26 论文分类快照中，仅 7 篇主要研究涌现行为。Goodhart\'s Law 只有 1 个量化案例（Self-Rewarding LM 长度膨胀 1092→2552 tokens）。'
  },
  {
    title: '框架缺乏预测力',
    verdict: 'Research Gap',
    color: '#e67e22',
    stats: 'descriptive, not predictive',
    detail: 'M1-M5 DAG 能分类已有系统，但不能预测"哪种路径更可能成功"。缺乏对改进饱和点、plateau 的系统性测量。每种自改进方法在什么条件下饱和？几乎无人研究。'
  }
];

const directions = [
  {
    title: '自进化安全评估基准',
    priority: 'P0',
    color: '#e74c3c',
    action: '需要一个类似 SWE-bench 的 Self-Evolution Safety Benchmark：给系统自修改权限，测量未意图行为。SEA-Eval 是唯一尝试（rank 3），需大幅扩展。M5 只有 7 篇论文却是风险最高的维度。',
  },
  {
    title: '评估器退化对抗实验',
    priority: 'P0',
    color: '#e74c3c',
    action: 'Goodhart\'s Law 是自进化的根本限制，但只有 1 个量化案例。需要系统性实验：在不同评估器下运行自改进循环，测量退化速率和模式。建立评估器鲁棒性分级。',
  },
  {
    title: '修复 EN→CN 映射',
    priority: 'P0',
    color: '#e74c3c',
    action: '方案 B：结构对齐。中文章节标题匹配英文主线，独有内容移入附录。建立自动化 section 匹配检查。优先修复 Ch3（分类法不同）和 Ch4（体量差过大）。',
  },
  {
    title: '改进饱和点测量',
    priority: 'P1',
    color: '#e67e22',
    action: '每种自改进方法在什么条件下饱和？Voyager 的技能库是否真的能无限累积？需要纵向实验追踪改进曲线，把框架从描述性提升到预测性。',
  },
  {
    title: '跨机制组合实验',
    priority: 'P1',
    color: '#e67e22',
    action: '52 篇 M3 论文各自独立研究一种改进方法。几乎没有论文研究"提示词进化 + 记忆进化 + 架构搜索"的组合效应。现实系统需要多种机制协作，但组合空间几乎未被探索。',
  },
  {
    title: '小团队优先 + 流程改进',
    priority: 'P1',
    color: '#e67e22',
    action: '下次使用更小的研究团队。强制中英文同步检查，深度检查先于数量检查。更短周期、更频繁地固化结果。质量自动化要覆盖 frontmatter、trust chain 和 rank。',
  },
  {
    title: '中国自进化生态深度分析',
    priority: 'P2',
    color: '#3498db',
    action: '清华AIR、DeepSeek、智源、百川——中国实验室需要与北美同等的深度分析。语言壁垒不应成为知识盲区。',
  }
];

const dataPoints = [
  { label: '总 commits (6天)', value: '122', color: '' },
  { label: '完成任务记录', value: '22', color: '' },
  { label: '论文分类', value: '125', color: '' },
  { label: 'GitHub 项目', value: '530', color: '' },
  { label: '原始素材', value: '3,272', color: '' },
  { label: 'Wiki 页面', value: '52', color: '' },
  { label: 'Site 页数', value: '213', color: '' },
  { label: '用户痛点', value: '97', color: '' },
  { label: 'EN→CN 合规率', value: '12.5% (1/8)', color: '#e74c3c' },
  { label: '文件恢复率', value: '94%', color: '#27ae60' },
];
---

<BaseLayout
  title="项目复盘 — 实验、教训与未来方向"
  description="AI Self-Evolution 调查项目的 2026-05-26 历史方法复盘快照：知识累积、证据质量、论文分类、项目分析——什么有效、什么失败、未来怎么做。"
  publishedTime="2026-05-26T21:30:00+08:00"
  modifiedTime="2026-05-26T21:30:00+08:00"
  noindex={true}
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">Retrospective · 方法附录</div>
      <h1 class="gradient-text">复盘：研究方法、证据质量与未来方向</h1>
      <p class="lead">这是 2026-05-26 的历史方法附录，用来解释当时的实验规模、有效实践、失败教训和未来方向；它不是站点主阅读入口。当前全仓库计数以资料库覆盖页和 master index 为准。</p>
      <div class="metrics">
        <div class="metric"><strong>125</strong><span>篇论文分类快照</span></div>
        <div class="metric"><strong>530</strong><span>个项目捕获快照</span></div>
        <div class="metric"><strong>122</strong><span>次提交</span></div>
        <div class="metric"><strong>3,272</strong><span>条原始素材</span></div>
      </div>
    </div>
  </section>

  <!-- What Worked -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow" style="color: #27ae60;">什么有效</div>
          <h2>有效的实践</h2>
        </div>
      </div>
      <div class="grid">
        {whatWorked.map((item) => (
          <article class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <h3 style="margin:0;">{item.title}</h3>
              <span style={`padding:2px 10px; border-radius:10px; font-size:0.75rem; font-weight:600; background:${item.color}15; color:${item.color}; border:1px solid ${item.color}40;`}>{item.verdict}</span>
            </div>
            <p style="color:var(--muted); font-size:0.85rem; margin:0 0 8px;">{item.stats}</p>
            <p style="font-size:0.9rem;">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- What Failed -->
  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow" style="color: #e74c3c;">什么失败 / 不足</div>
          <h2>失败的实践与研究缺口</h2>
        </div>
      </div>
      <div class="grid">
        {whatFailed.map((item) => (
          <article class="card" style={`border-left: 3px solid ${item.color};`}>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <h3 style="margin:0;">{item.title}</h3>
              <span style={`padding:2px 10px; border-radius:10px; font-size:0.75rem; font-weight:600; background:${item.color}15; color:${item.color}; border:1px solid ${item.color}40;`}>{item.verdict}</span>
            </div>
            <p style="color:var(--muted); font-size:0.85rem; margin:0 0 8px;">{item.stats}</p>
            <p style="font-size:0.9rem;">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Lessons -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">核心教训</div>
          <h2>这个项目说明了什么</h2>
        </div>
      </div>

      <div class="card" style="padding: 24px; border-left: 4px solid var(--accent); margin-bottom: 16px;">
        <h3>1. 多角色研究可以完成系统化学术调查——但有条件</h3>
        <p style="margin-top: 8px;">角色要清晰、产出要标准化、质量要有门禁。专业化分工在边界清晰时效率最高，但团队规模过大时协调成本会迅速上升。</p>
      </div>

      <div class="card" style="padding: 24px; border-left: 4px solid var(--accent); margin-bottom: 16px;">
        <h3>2. LLM Wiki Pattern 是有效的知识管理方式</h3>
        <p style="margin-top: 8px;">比一次性检索更适合累积性知识工作。采集、查询、校验三个步骤值得保留。三层架构（原始材料不可变、知识页持续更新、规则层约束格式）避免了重复分析。</p>
      </div>

      <div class="card" style="padding: 24px; border-left: 4px solid var(--accent); margin-bottom: 16px;">
        <h3>3. 自进化领域的关键缺口是安全和评估</h3>
        <p style="margin-top: 8px;">在 2026-05-26 分类快照中，只有 7 篇研究涌现行为，Goodhart's Law 只有 1 个量化案例。这说明未来研究仍需要更强的安全和评估证据。能力研究远超安全研究。</p>
      </div>

      <div class="card" style="padding: 24px; border-left: 4px solid #B83224;">
        <h3 style="color: #B83224;">4. "规则不等于执行"</h3>
        <p style="margin-top: 8px;">规则曾经写成文档，但没有自动化执行机制。7/8 章的 EN→CN 映射违规发生在规则制定之后。没有门禁的规则只是建议；下次必须用自动检查强制执行。</p>
      </div>
    </div>
  </section>

  <!-- Future Directions -->
  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">未来方向</div>
          <h2>应该怎么做</h2>
        </div>
      </div>
      {directions.map((dir) => (
        <div class="card" style="margin-bottom: 12px;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <h3 style="margin:0;">{dir.title}</h3>
            <span style={`padding:2px 10px; border-radius:10px; font-size:0.75rem; font-weight:600; background:${dir.color}15; color:${dir.color}; border:1px solid ${dir.color}40;`}>{dir.priority}</span>
          </div>
          <p style="margin-top:10px; font-size:0.9rem;">{dir.action}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Data Summary -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">数据总览</div>
          <h2>实验规模</h2>
        </div>
      </div>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
          <thead>
            <tr style="border-bottom:2px solid var(--border,#e0e0e0); text-align:left;">
              <th style="padding:8px;">指标</th>
              <th style="padding:8px;">数值</th>
            </tr>
          </thead>
          <tbody>
            {dataPoints.map((dp) => (
              <tr style="border-bottom:1px solid var(--border,#e0e0e0);">
                <td style="padding:8px;">{dp.label}</td>
                <td style={`padding:8px; font-weight:600; ${dp.color ? `color:${dp.color};` : ''}`}>{dp.value}</td>
              </tr>
            ))}
            <tr style="border-bottom:1px solid var(--border,#e0e0e0);">
              <td style="padding:8px;">论文分类 M3/M5 比</td>
              <td style="padding:8px; font-weight:600;">52 : 7（7.4x 不平衡）</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border,#e0e0e0);">
              <td style="padding:8px;">年份分布</td>
              <td style="padding:8px;">2022(1) → 2023(8) → 2024(25) → 2025(61) → 2026(30)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Cross Links -->
  <section class="section">
    <div class="container">
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
        <a href="/reports/en-cn-mapping-audit" class="card" style="text-decoration: none; color: inherit; border-top: 3px solid #B83224;">
          <h3>EN→CN 审查</h3>
          <p>8 章结构映射完整性评估。</p>
        </a>
        <a href="/survey/" class="card" style="text-decoration: none; color: inherit; border-top: 3px solid var(--caret-blue);">
          <h3>Survey 核心发现</h3>
          <p>五大进化环、七大方法族。</p>
        </a>
        <a href="/paper/" class="card" style="text-decoration: none; color: inherit; border-top: 3px solid var(--success);">
          <h3>论文下载</h3>
          <p>中英文 PDF 和源文件。</p>
        </a>
        <a href="/reports/" class="card" style="text-decoration: none; color: inherit; border-top: 3px solid var(--accent);">
          <h3>研究报告</h3>
          <p>350+ 份项目和论文报告。</p>
        </a>
      </div>
      <p style="color:var(--muted); font-size:0.85rem; margin-top: 24px;">
        复盘日期：2026-05-26 | 审计更新：完整版（含研究内容复盘） |
        <a href="/reports/en-cn-mapping-audit">EN→CN 映射审计</a>
      </p>
    </div>
  </section>
</BaseLayout>
