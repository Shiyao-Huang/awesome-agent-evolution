---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  starQualityScores,
  competitiveMatrix,
  propagationChains,
  comparisonGroups,
  scoreColor
} from '@/data/starAnalysis';
---

<BaseLayout
  title="GitHub Star 传播与异常信号分析 — Self Evolve"
  description="AI Agent 领域 GitHub 项目的 Star 传播线索、异常增长信号和对比矩阵。它帮助复核热度来源，不等于项目质量或学术价值判断。"
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">数据研究报告</div>
      <h1 class="gradient-text">GitHub Star 传播与异常信号分析</h1>
      <p class="lead">这页只回答热度从哪里来、是否异常、哪些项目需要复核；它不是项目能力、代码质量或学术价值排名。</p>
      <p style="color: var(--muted); margin-top: 12px">覆盖 {starQualityScores.length} 个核心项目，{comparisonGroups.length} 组对比分析；严肃判断仍要回到 benchmark、报告、失败样本和原始仓库。</p>
    </div>
  </section>

  <!-- Executive Summary -->
  <section class="section" id="summary">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">复核线索</div>
          <h2>Visibility Signal Summary</h2>
        </div>
      </div>
      <div class="split">
        <div class="card">
          <h3>需要复核的信号</h3>
          <ul class="finding-list">
            <li><strong>Star 数只是可见性信号</strong>：高 Star 项目和低 Star 项目都需要回到 benchmark、代码维护、报告和失败样本复核。</li>
            <li><strong>爆发式增长需要解释来源</strong>：短时间大幅增长通常应检查传播链、fork 有效性、issue 有效性和贡献者结构。</li>
            <li><strong>论文驱动项目可能增长较慢</strong>：DSPy、SWE-Agent 等项目的可见性节奏不同，不能用总 Star 直接判断研究价值。</li>
            <li><strong>Me-too 项目需要额外复核</strong>：借热点增长的项目要看后续维护、真实使用和 issue/PR 活动是否持续。</li>
            <li><strong>Stars/Contributor Ratio</strong> 只是启发式异常线索：超过阈值意味着需要复核，不等于“炒作检测器”。</li>
          </ul>
        </div>
        <div class="card">
          <h3>启发式信号</h3>
          <ul class="finding-list">
            <li><strong>Star 活跃度线索</strong>：过去 90 天内有活动的 stargazer 占比</li>
            <li><strong>贡献者多样性</strong>：Gini 系数反转，top 10 贡献者占比越低越好</li>
            <li><strong>Fork 有效性</strong>：有实际 commit/push 的 fork 占比</li>
            <li><strong>Issue 有效性</strong>：非灌水/非模板 issue 占比</li>
            <li><strong>PR 合并率</strong>：merged PRs / total PRs</li>
            <li><strong>Stars/Contributor Ratio</strong>：每个贡献者对应的 star 数（偏高=需要复核）</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

      <!-- Star Signal Queue -->
  <section class="section" id="signal-scores">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Star signal queue</div>
          <h2>传播信号复核队列</h2>
        </div>
      </div>
      <p style="color: var(--muted); margin-bottom: 24px">基于 5 维度加权线索：Star 活跃度(20%) + 贡献者多样性(20%) + Fork 有效性(20%) + Issue 有效性(20%) + PR 合并率(20%)。分数只用于发现异常和选择复核顺序。</p>
      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th>项目</th>
              <th>Stars</th>
              <th>分诊分</th>
              <th>Star 活跃</th>
              <th>贡献多样性</th>
              <th>Fork 有效性</th>
              <th>Issue 有效性</th>
              <th>PR 合并</th>
              <th>增长模式</th>
            </tr>
          </thead>
          <tbody>
            {starQualityScores
              .sort((a, b) => b.compositeScore - a.compositeScore)
              .map((s) => (
              <tr>
                <td><strong>{s.name}</strong><br/><span style="color:var(--muted);font-size:12px">{s.repo}</span></td>
                <td>{s.totalStars.toLocaleString()}</td>
                <td>
                  <span class="score-badge" style={`background:${scoreColor(s.compositeScore)}20;color:${scoreColor(s.compositeScore)}`}>
                    {s.compositeScore}
                  </span>
                </td>
                <td>{s.starActivityScore}</td>
                <td>{s.contributorDiversity}</td>
                <td>{s.forkQualityScore}</td>
                <td>{s.issueQualityScore}</td>
                <td>{s.prMergeRate}</td>
                <td><span class={`growth-badge growth-${s.growthPattern}`}>{s.growthPattern}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Verdict cards -->
      <div class="grid" style="margin-top: 36px">
        {starQualityScores
          .sort((a, b) => b.compositeScore - a.compositeScore)
          .slice(0, 6)
          .map((s) => (
          <article class="card">
            <div style="display:flex;justify-content:space-between;align-items:start">
              <div>
                <div class="eyebrow">{s.growthPattern}</div>
                <h3>{s.name}</h3>
              </div>
              <span class="score-badge" style={`background:${scoreColor(s.compositeScore)}20;color:${scoreColor(s.compositeScore)};font-size:24px;font-weight:900`}>
                {s.compositeScore}
              </span>
            </div>
            <p style="font-size:14px;color:var(--muted);margin-top:12px">{s.verdict}</p>
            <div class="pill-row">
              <span class="pill">&#9733; {s.totalStars.toLocaleString()}</span>
              {s.daysFrom1Kto10K ? <span class="pill">1K→10K: {s.daysFrom1Kto10K}天</span> : <span class="pill">未达 10K</span>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Radar Charts (CSS-only) -->
  <section class="section" id="radar">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Visibility signal radar</div>
          <h2>传播信号雷达</h2>
          <p>雷达只展示 adoption/maintenance proxy，不代表代码质量、产品质量或学术价值。</p>
        </div>
      </div>
      <div class="radar-grid">
        {['AutoGPT', 'MetaGPT', 'CrewAI', 'DSPy', 'OpenEvolve', 'Devika'].map((name) => {
          const s = starQualityScores.find((x) => x.name === name)!;
          const scores = [s.starActivityScore, s.contributorDiversity, s.forkQualityScore, s.issueQualityScore, s.prMergeRate];
          return (
            <div class="radar-card card">
              <h3 style="text-align:center;margin-bottom:16px">{name} <span style="font-size:14px;color:var(--muted)">({s.compositeScore})</span></h3>
              <div class="radar-visual">
                {scores.map((val, i) => {
                  const labels = ['活跃', '多样性', 'Fork', 'Issue', 'PR'];
                  return (
                    <div class="radar-bar-row">
                      <span class="radar-label">{labels[i]}</span>
                      <div class="radar-bar-track">
                        <div class="radar-bar-fill" style={`width:${val}%;background:${scoreColor(val)}`} />
                      </div>
                      <span class="radar-value">{val}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Competitive Matrix -->
  <section class="section" id="competitive">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">竞品对比矩阵</div>
          <h2>横向对比</h2>
        </div>
      </div>

      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th>项目</th>
              <th>Stars</th>
              <th>Forks</th>
              <th>贡献者</th>
              <th>Star/Contrib</th>
              <th>代码维护线索</th>
              <th>社区</th>
              <th>文档</th>
              <th>营销度</th>
              <th>类型</th>
            </tr>
          </thead>
          <tbody>
            {competitiveMatrix
              .sort((a, b) => b.stars - a.stars)
              .map((c) => (
              <tr>
                <td><strong>{c.name}</strong></td>
                <td>{c.stars.toLocaleString()}</td>
                <td>{c.forks.toLocaleString()}</td>
                <td>{c.contributors}</td>
                <td>
                  <span style={`color:${c.starsPerContributor > 150 ? '#ef4444' : c.starsPerContributor > 100 ? '#f59e0b' : '#10b981'}`}>
                    {c.starsPerContributor}
                  </span>
                </td>
                <td>{'●'.repeat(c.codeQuality)}{'○'.repeat(10 - c.codeQuality)}</td>
                <td>{'●'.repeat(c.communityHealth)}{'○'.repeat(10 - c.communityHealth)}</td>
                <td>{'●'.repeat(c.docQuality)}{'○'.repeat(10 - c.docQuality)}</td>
                <td>
                  <span class={`marketing-${c.marketingDriven}`}>{c.marketingDriven}</span>
                </td>
                <td><span class="org-badge org-{c.orgType}">{c.orgType}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Group Comparisons -->
  <section class="section" id="comparisons">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">分组对比</div>
          <h2>四维对比分析</h2>
        </div>
      </div>
      <div class="grid">
        {comparisonGroups.map((group) => (
          <article class="card">
            <div class="eyebrow">{group.label}</div>
            <h3>{group.description}</h3>
            <p style="color:var(--muted);margin:12px 0">{group.verdict}</p>
            <div class="pill-row">
              <span class="pill">平均评分: {group.avgCompositeScore}</span>
              <span class="pill">Star/Contrib: {group.avgStarsPerContributor}</span>
              <span class="pill">代码维护线索: {group.avgCodeQuality}/10</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Propagation Chains -->
  <section class="section" id="propagation">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">传播链</div>
          <h2>Star 增长时间轴</h2>
        </div>
      </div>

      {propagationChains.map((chain) => (
        <div style="margin-bottom: 48px">
          <h3 style="margin-bottom: 16px">{chain.name}</h3>

          <!-- Timeline visualization -->
          <div class="timeline">
            {chain.nodes.map((node, i) => (
              <article class="timeline-item">
                <div class="year">{node.date.slice(0, 10)}</div>
                <div>
                  <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
                    <span class="platform-badge platform-{node.platform.toLowerCase().replace(/[^a-z]/g,'')}">{node.platform}</span>
                    <strong>{node.event}</strong>
                  </div>
                  <p style="color:var(--hot);font-weight:700;font-size:14px">
                    &#9733; {node.starsAfter.toLocaleString()}
                    {i > 0 && <span style="color:var(--muted);font-weight:400;margin-left:8px">
                      (+{(node.starsAfter - chain.nodes[i-1].starsAfter).toLocaleString()})
                    </span>}
                  </p>
                </div>
              </article>
            ))}
          </div>

          <!-- Signals -->
          <div class="split" style="margin-top: 18px">
            <div class="card" style="border-color: #ef444440">
              <h3 style="color:#ef4444;font-size:16px;margin-bottom:10px">炒作信号</h3>
              <ul class="signal-list">
                {chain.hypeSignals.map((s) => <li style="color:var(--muted);font-size:14px">{s}</li>)}
              </ul>
            </div>
            <div class="card" style="border-color: #10b98140">
              <h3 style="color:#10b981;font-size:16px;margin-bottom:10px">自发信号</h3>
              <ul class="signal-list">
                {chain.organicSignals.map((s) => <li style="color:var(--muted);font-size:14px">{s}</li>)}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Mermaid Diagrams -->
  <section class="section" id="diagrams">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">可视化</div>
          <h2>传播链流程图</h2>
        </div>
      </div>

      <div class="mermaid-wrap">
        <pre class="mermaid" set:html={`flowchart LR
    A[GitHub 创建] --> B[Twitter/X 首发]
    B --> C{"是否有 KOL 转发?"}
    C -->|有| D[HN Front Page]
    C -->|无| E[缓慢自然增长]
    D --> F[Reddit 热帖]
    F --> G[YouTube 教程]
    G --> H[中文媒体翻译]
    H --> I[Star 爆发]
    E --> J[学术引用]
    J --> K[长期稳步增长]
    I --> L[高 Star 待复核]
    K --> M[低 Star 仍可能有研究价值]

    style L fill:#ef4444,stroke:#ef4444,color:#fff
    style M fill:#10b981,stroke:#10b981,color:#fff`} />
      </div>

      <div class="mermaid-wrap" style="margin-top:24px">
        <pre class="mermaid" set:html={`graph TD
    subgraph 炒作驱动
        A1[AutoGPT 175K] --> A2[Devika 22K]
        A1 ---|3天→50K| A3[爆发式增长]
        A2 ---|5天→20K| A3
        A3 --> A4["低 Fork 有效性 / 低 Issue 有效性 / Stars/Contrib > 150"]
    end
    subgraph 稳健增长
        B1[CrewAI 30K] --> B2[AutoGen 50K]
        B1 ---|30天→1K| B3[自然增长]
        B2 ---|21天→1K| B3
        B3 --> B4["高社区健康度 / 高 PR 合并率 / Stars/Contrib < 120"]
    end
    subgraph 学术驱动
        C1[DSPy 25K] --> C2[SWE-Agent 15K]
        C1 ---|90天→1K| C3[论文驱动增长]
        C2 ---|30天→1K| C3
        C3 --> C4["较强代码维护线索 / 较强 Issue 有效性 / Stars/Contrib < 160"]
    end

    style A3 fill:#ef444480,stroke:#ef4444
    style B3 fill:#f59e0b80,stroke:#f59e0b
    style C3 fill:#10b98180,stroke:#10b981`} />
      </div>
    </div>
  </section>

  <!-- Methodology -->
  <section class="section" id="methodology">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">方法论</div>
          <h2>Star 传播信号评分草案</h2>
          <p>这个评分草案没有经过外部校准，不应作为项目质量、代码质量或学术价值判断；它只帮助发现传播异常和下一步复核顺序。</p>
        </div>
      </div>
      <div class="split">
        <div class="card">
          <h3>评分维度与权重</h3>
          <table class="score-table" style="margin-top:16px">
            <thead>
              <tr><th>维度</th><th>权重</th><th>数据来源</th><th>说明</th></tr>
            </thead>
            <tbody>
              <tr><td>Star 活跃度</td><td>20%</td><td>GitHub API</td><td>90天内活跃 stargazer 占比</td></tr>
              <tr><td>贡献者多样性</td><td>20%</td><td>GitHub API</td><td>Gini 系数反转，避免单人/单组织垄断</td></tr>
              <tr><td>Fork 有效性</td><td>20%</td><td>GitHub API</td><td>有 commit 的 fork 占比（排除空 fork）</td></tr>
              <tr><td>Issue 有效性</td><td>20%</td><td>GitHub API + NLP</td><td>非灌水/非模板 issue 占比</td></tr>
              <tr><td>PR 合并率</td><td>20%</td><td>GitHub API</td><td>merged / total PRs 比例</td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <h3>炒作检测阈值</h3>
          <table class="score-table" style="margin-top:16px">
            <thead>
              <tr><th>指标</th><th>绿色 (&lt; 50)</th><th>黄色 (50-150)</th><th>红色 (&gt; 150)</th></tr>
            </thead>
            <tbody>
              <tr><td>Stars/Contributor</td><td>健康</td><td>可能偏高</td><td>炒作嫌疑</td></tr>
              <tr><td>0→1K 天数</td><td>&gt; 30 天</td><td>7-30 天</td><td>&lt; 7 天</td></tr>
              <tr><td>Fork 有效性</td><td>&gt; 40%</td><td>20-40%</td><td>&lt; 20%</td></tr>
              <tr><td>Issue 有效性</td><td>&gt; 60%</td><td>40-60%</td><td>&lt; 40%</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer note -->
  <section class="section">
    <div class="container">
      <div class="card" style="border-color: var(--brand)">
        <p style="color:var(--muted);font-size:14px">
          <strong style="color:var(--text)">声明</strong>：本分析基于公开 GitHub 数据估算，评分模型为启发式复核用途，不代表对任何项目的价值判断。
          Star 数是可见性指标而非质量指标。建议研究者同时参考论文引用量、代码实际使用量、benchmark、失败样本和社区讨论深度。
          本报告将作为 arXiv 论文「Self Evolving AI: A Survey」的补充材料。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Score badges */
  .score-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 14px;
  }

  /* Growth pattern badges */
  .growth-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .growth-organic { background: rgba(16,185,129,.15); color: #10b981; }
  .growth-steady { background: rgba(59,130,246,.15); color: #3b82f6; }
  .growth-viral { background: rgba(245,158,11,.15); color: #f59e0b; }
  .growth-suspicious { background: rgba(239,68,68,.15); color: #ef4444; }

  /* Table */
  .score-table-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--line) }
  .score-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .score-table th {
    background: var(--bg2);
    padding: 12px 14px;
    text-align: left;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--muted);
    white-space: nowrap;
    border-bottom: 1px solid var(--line);
  }
  .score-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .score-table tbody tr:hover { background: var(--card-bg) }

  /* Finding list */
  .finding-list { list-style: none; padding: 0 }
  .finding-list li {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    line-height: 1.6;
  }
  .finding-list li:last-child { border-bottom: none }

  /* Signal list */
  .signal-list { list-style: disc; padding-left: 20px }
  .signal-list li { padding: 4px 0; line-height: 1.5 }

  /* Platform badges */
  .platform-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
  }
  .platform-github { background: rgba(255,255,255,.12); color: var(--text) }
  .platform-twitterx { background: rgba(29,155,240,.2); color: #1d9bf0 }
  .platform-hackernews { background: rgba(255,102,0,.2); color: #ff6600 }
  .platform-reddit { background: rgba(255,69,0,.2); color: #ff4500 }
  .platform-youtube { background: rgba(255,0,0,.2); color: #ff0000 }
  .platform-wechat { background: rgba(7,193,96,.2); color: #07c160 }
  .platform-arxiv { background: rgba(179,27,27,.2); color: #b31b1b }
  .platform-linkedin { background: rgba(0,119,181,.2); color: #0077b5 }
  .platform-iclr { background: rgba(124,124,247,.2); color: #7c7cf7 }

  /* Marketing badges */
  .marketing-low { color: #10b981 }
  .marketing-medium { color: #f59e0b }
  .marketing-high { color: #ef4444 }

  /* Org badges */
  .org-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    background: var(--card-bg);
  }
  .org-deepmind { background: rgba(66,133,244,.15); color: #4285f4 }
  .org-big-tech { background: rgba(59,130,246,.15); color: #3b82f6 }
  .org-startup { background: rgba(168,85,247,.15); color: #a855f7 }
  .org-academic { background: rgba(16,185,129,.15); color: #10b981 }
  .org-community { background: rgba(245,158,11,.15); color: #f59e0b }
  .org-chinese-team { background: rgba(239,68,68,.15); color: #ef4444 }

  /* Radar */
  .radar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
