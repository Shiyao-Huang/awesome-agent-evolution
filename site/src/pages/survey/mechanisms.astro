---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { evolutionLoops, methodFamilies, surveyFigurePaths } from '@/data/survey';

const loopDetails = [
  {
    loop: evolutionLoops[0],
    howItWorks: 'User specifies goals in natural language → system decomposes into sub-tasks → selects/configures ML pipelines → executes and evaluates → feeds results back.',
    failureMode: 'Ambiguous specifications lead to wrong pipeline selections.',
    compositionPattern: 'Feeds into Search Loop and Evaluator Loop.',
    evidence: 'AutoML-GPT achieves competitive results on tabular benchmarks.',
  },
  {
    loop: evolutionLoops[1],
    howItWorks: 'Define search space → LLM proposes candidates → evaluator scores → select best → mutate/recombine → repeat.',
    failureMode: 'Search space too large → random walk. Too small → local optima.',
    compositionPattern: 'Core of ADAS, OPRO, AlphaEvolve. Requires Evaluator Loop.',
    evidence: 'OPRO discovers prompts outperforming human-designed ones. ADAS architectures transfer across tasks.',
  },
  {
    loop: evolutionLoops[2],
    howItWorks: 'Define tests/benchmarks → run candidate → score objectively → accept/reject → iterate.',
    failureMode: 'Benchmark contamination. Goodhart\'s law.',
    compositionPattern: 'Every other loop depends on this.',
    evidence: 'FunSearch discovered new algorithms verified by formal proof.',
  },
  {
    loop: evolutionLoops[3],
    howItWorks: 'Execute task → observe failure → generate reflection → store in memory → retrieve → revise strategy.',
    failureMode: 'Reflection can be wrong. Memory grows without bound.',
    compositionPattern: 'Feeds into Search Loop. Combines with Population Loop.',
    evidence: 'Reflexion: HumanEval 80→91%. Voyager: skill library compounds.',
  },
  {
    loop: evolutionLoops[4],
    howItWorks: 'Initialize diverse population → evaluate → select top → mutate/crossover → archive elites → repeat.',
    failureMode: 'Premature convergence. Loss of diversity.',
    compositionPattern: 'AlphaEvolve combines with Evaluator and Search.',
    evidence: 'AlphaEvolve: 4×4 complex-valued matrix multiplication with 48 scalar multiplications after 56 years; scope is source-specific.',
  },
];

const collaborationPatterns = [
  { nameZh: '生成-验证', roles: 'Generator → Verifier', description: 'One agent generates, another verifies.', example: 'FunSearch, CodeEvolve' },
  { nameZh: '对抗辩论', roles: 'Proposer ↔ Opponent → Judge', description: 'Two agents argue; judge decides.', example: 'Multi-Agent Debate' },
  { nameZh: '进化锦标赛', roles: 'Population → Selection → Mutation', description: 'Candidates compete; winners reproduce.', example: 'AlphaEvolve, DGM' },
  { nameZh: '层级监督', roles: 'Worker → Reviewer → Approver', description: 'Multi-level quality gates.', example: 'DGM archive system' },
];
---

<BaseLayout
  title="五大进化环详解 — AI 自进化机制与证据边界分析"
  description="AI自进化的统一框架：规范到执行环、搜索环、评估环、反思环、种群环。每个环的机制、证据、失效模式和组合模式。"
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">Mechanisms · 机制详解</div>
      <h1 class="gradient-text">五大进化环</h1>
      <p class="lead">将 196 篇论文中散乱的"自改进"方法统一为五个可组合的进化环。</p>
      <div class="hero-actions" style="margin-top: 16px;">
        <a class="text-link" href="/survey/">← 返回 Survey 总览</a>
        <a class="text-link" href="/survey/case-studies/">案例研究 →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">State Machine</div>
          <h2>自进化状态机</h2>
        </div>
      </div>
      <div class="card" style="padding: 24px;">
        <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; align-items: center;">
          {['INIT 🏁', 'OBSERVE 👁️', 'EVALUATE 📊', 'DECIDE 🤔', 'UPDATE ✏️', 'VERIFY ✅', 'ARCHIVE 📦'].map((state, i, arr) => (
            <>
              <div style="background: var(--accent); color: white; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;">
                {state}
              </div>
              {i < arr.length - 1 && <span style="font-size: 1.2rem;">→</span>}
            </>
          ))}
        </div>
        <p style="text-align: center; margin-top: 16px; color: var(--muted);">
          可变对象：prompt · memory · skill · code · architecture · policy
        </p>
      </div>
    </div>
  </section>

  {loopDetails.map((detail, i) => (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Loop {i + 1} of 5</div>
            <h2>{detail.loop.icon} {detail.loop.nameZh}</h2>
            <p style="color: var(--muted);">{detail.loop.name}</p>
          </div>
        </div>
        <div class="split">
          <div class="card" style="border-top: 3px solid var(--accent);">
            <h3>机制</h3>
            <p>{detail.howItWorks}</p>
            <h4 style="margin-top: 16px;">代表系统</h4>
            <div class="pill-row">
              {detail.loop.examples.map((ex) => (
                <span class="pill">{ex}</span>
              ))}
            </div>
            <h4 style="margin-top: 16px;">组合模式</h4>
            <p style="color: var(--muted);">{detail.compositionPattern}</p>
          </div>
          <div>
            <div class="card" style="border-left: 4px solid #e74c3c; margin-bottom: 16px;">
              <h3>⚠️ 失效模式</h3>
              <p>{detail.failureMode}</p>
            </div>
            <div class="card" style="border-left: 4px solid #2ecc71;">
              <h3>✅ 证据</h3>
              <p>{detail.evidence}</p>
            </div>
            <div class="card" style="border-left: 4px solid var(--accent); margin-top: 16px;">
              <h3>💡 核心洞察</h3>
              <p style="font-style: italic;">{detail.loop.keyInsight}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Collaboration</div>
          <h2>四种多智能体协作模式</h2>
        </div>
      </div>
      <div class="grid">
        {collaborationPatterns.map((pattern) => (
          <article class="card" style="border-top: 3px solid var(--accent);">
            <h3>{pattern.nameZh}</h3>
            <p style="color: var(--muted); font-size: 0.85rem;">{pattern.roles}</p>
            <p>{pattern.description}</p>
            <div class="pill-row">
              <span class="pill">{pattern.example}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Methods</div>
          <h2>七大方法族速查</h2>
        </div>
      </div>
      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th>方法族</th>
              <th>论文数</th>
              <th>代表方法</th>
              <th>一句话洞察</th>
            </tr>
          </thead>
          <tbody>
            {methodFamilies.map((f) => (
              <tr>
                <td><strong>{f.nameZh}</strong></td>
                <td>{f.papers} ({f.share})</td>
                <td>{f.keyMethods.join(', ')}</td>
                <td style="font-style: italic;">{f.oneLineInsight}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="visual-grid" style="margin-top: 24px;">
        <figure class="visual-panel">
          <img src={surveyFigurePaths.strictVsBroad} alt="Strict vs broad evolution" loading="lazy" />
          <figcaption>严格自进化 vs 广义自改进</figcaption>
        </figure>
        <figure class="visual-panel">
          <img src={surveyFigurePaths.categoryTheme} alt="Category-theme heatmap" loading="lazy" />
          <figcaption>类别-主题热力图</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <a href="/survey/" class="card" style="text-decoration: none; color: inherit;">← Survey 总览</a>
        <a href="/survey/case-studies/" class="card" style="text-decoration: none; color: inherit;">案例研究 →</a>
        <a href="/paper/" class="card" style="text-decoration: none; color: inherit;">论文下载 →</a>
        <a href="/projects/" class="card" style="text-decoration: none; color: inherit;">项目索引 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
