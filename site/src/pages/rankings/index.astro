---
import BaseLayout from '@/layouts/BaseLayout.astro';
import analysis from '@/data/analysis.json';

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const method = analysis.ranking_method;
const ranked = [...(analysis.recency_weighted_project_ranking ?? [])].slice(0, 30);
const rankedTotal = ranked.length || 1;
type RankedProject = (typeof ranked)[number];

const average = (values: number[]) => values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
const percentOfTop30 = (count: number) => Math.round((count / rankedTotal) * 100);

const valueBands = [
  {
    label: '优先深读',
    range: '80+',
    description: '机制、证据和近期性都强，适合优先阅读源码和项目报告。',
    min: 80,
    max: Infinity
  },
  {
    label: '重点跟踪',
    range: '70-79',
    description: '方向清楚，但还需要补足报告、对照实验或长期活跃度。',
    min: 70,
    max: 80
  },
  {
    label: '补证据',
    range: '60-69',
    description: '可能有价值，当前更适合回到原始仓库和报告验证机制。',
    min: 60,
    max: 70
  },
  {
    label: '背景观察',
    range: '<60',
    description: '作为生态背景，不应抢占当前研究优先级。',
    min: -Infinity,
    max: 60
  }
].map(band => {
  const items = ranked.filter(project => project.scores.current_value >= band.min && project.scores.current_value < band.max);
  return {
    ...band,
    count: items.length,
    pct: percentOfTop30(items.length),
    examples: items.slice(0, 3).map(project => project.name)
  };
});

const signalText = (project: RankedProject) => [
  project.name,
  project.category,
  project.pattern,
  ...(project.tags ?? [])
].join(' ');

const signalRules = [
  {
    label: '进化闭环',
    color: '#FF5B00',
    description: '候选生成、搜索、反馈精炼、自我改进。',
    test: /进化|演化|自进化|自改进|反馈|搜索循环|self-evol|self-improv|evolution|evolve|reflection|outer-loop|autonomous-iteration/i
  },
  {
    label: '评估/基准',
    color: '#007AFF',
    description: '评估器、benchmark、harness、可复现验证。',
    test: /评估|评测|基准|打分|验证|evaluation|benchmark|harness|grader|score|reproducibility|eval/i
  },
  {
    label: '训练/RL',
    color: '#7C3AED',
    description: '训练循环、强化学习、蒸馏、数据回流。',
    test: /训练|training|reinforcement|rl|distillation|agent-training|data loop/i
  },
  {
    label: '多 Agent/编排',
    color: '#0891B2',
    description: '多智能体协作、工作流、handoff、subagent。',
    test: /智能体编排|multi-agent|workflow|orchestration|handoff|subagents|open-ended tasks/i
  },
  {
    label: '记忆/上下文',
    color: '#2E6F4E',
    description: '记忆、上下文、检索、图结构和推理状态。',
    test: /记忆|上下文|memory|context|retrieval|graph|reasoning|persistent/i
  },
  {
    label: '代码/技能/工具',
    color: '#A56117',
    description: '代码自修改、技能选择、工具与插件优化。',
    test: /代码|技能|工具|code|coding|skill|tool|plugin|prompt|optimizer|teleprompter|python|typescript|github-actions/i
  },
  {
    label: '安全/治理',
    color: '#B83224',
    description: '安全策略、权限、policy、治理和防御。',
    test: /安全|治理|策略|security|policy|governance|defense/i
  }
].map(signal => {
    const items = ranked.filter(project => signal.test.test(signalText(project)));
    const avgScore = average(items.map(project => project.scores.current_value));
    const topProject = [...items].sort((a, b) => b.scores.current_value - a.scores.current_value)[0];
    return {
      ...signal,
      count: items.length,
      pct: percentOfTop30(items.length),
      avgScore,
      topProject: topProject?.name ?? ''
    };
  })
  .filter(signal => signal.count > 0)
  .sort((a, b) => b.count - a.count || b.avgScore - a.avgScore || a.label.localeCompare(b.label));
---

<BaseLayout
  title="当前价值排名 — Self Evolve"
  description="AI 自我进化项目当前价值排名：时间新近性占 50%，并结合自进化机制、证据链、社区动量和实用适配度。"
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">Rankings</div>
      <h1 class="gradient-text">当前价值排名</h1>
      <p class="lead">Top 30 自进化项目排行 · 时间权重 50% · 避免旧项目被历史 Stars 垄断。</p>
      <div class="metrics">
        <div class="metric"><strong>{ranked.length}</strong><span>展示项目</span></div>
        <div class="metric"><strong>50%</strong><span>时间权重</span></div>
        <div class="metric"><strong>{analysis.counts.analyzed_projects}</strong><span>分析项目</span></div>
      </div>
    </div>
  </section>

  <!-- Top 3 Podium -->
  <section class="section">
    <div class="container">
      <div class="rank-podium">
        {ranked.slice(0, 3).map((p, i) => (
          <div class={`rank-podium-item rank-pos-${i + 1}`}>
            <div class="rank-medal">{i + 1}</div>
            <div class="rank-podium-name">
              <a href={`/projects/${slugify(p.repo)}/`}>{p.name}</a>
            </div>
            <div class="rank-podium-stars">{p.scores.current_value.toFixed(2)} 分</div>
            <div class="rank-podium-cat">{p.category}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full Ranking Table -->
  <section class="section">
    <div class="container">
      <div class="rank-table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Project</th>
              <th>Score</th>
              <th>Time</th>
              <th>Mechanism</th>
              <th>Evidence</th>
              <th>Category</th>
              <th>Created</th>
              <th>Activity</th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((p, i) => (
              <tr>
                <td class="rank-num">{i + 1}</td>
                <td class="rank-name">
                  <a href={`/projects/${slugify(p.repo)}/`}>{p.name}</a>
                  <span class="rank-repo">{p.repo}</span>
                  {p.caveat && <span class="rank-caveat">{p.caveat}</span>}
                </td>
                <td class="rank-stars">{p.scores.current_value.toFixed(2)}</td>
                <td>{p.scores.time.toFixed(1)}</td>
                <td>{p.scores.mechanism.toFixed(1)}</td>
                <td>{p.scores.evidence.toFixed(1)}</td>
                <td>{p.category}</td>
                <td class="rank-date">{p.created_at ? p.created_at.slice(0, 10) : 'unknown'}</td>
                <td class="rank-date">{p.activity_at ? p.activity_at.slice(0, 10) : '\u2014'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Category Breakdown -->
  <section class="section">
    <div class="container">
      <div class="card">
        <div class="card-head">
          <div class="eyebrow">Method</div>
          <h3>这个排名怎么用</h3>
        </div>
        <p>先用它决定下一步行动：80 分以上优先深读，70-79 分重点跟踪，60-69 分先补证据，60 分以下只作为生态背景。分数不是最终学术结论，而是把时间、机制、证据链和社区动量压成一个研究排队器。</p>
        <div class="rank-usage-grid">
          <div class="rank-usage-panel">
            <div class="rank-usage-title">怎么用这个排名</div>
            <div class="rank-bands">
              {valueBands.map(band => (
                <div class="rank-band-row">
                  <div class="rank-band-head">
                    <span>{band.label}</span>
                    <strong>{band.count}</strong>
                  </div>
                  <div class="rank-cat-bar-wrap" aria-label={`${band.label}: ${band.count} projects`}>
                    <div class="rank-cat-bar" style={`width:${band.pct}%`}></div>
                  </div>
                  <div class="rank-band-meta">
                    <span>{band.range} 分</span>
                    <span>{band.description}</span>
                  </div>
                  {band.examples.length > 0 && <div class="rank-band-examples">{band.examples.join(' · ')}</div>}
                </div>
              ))}
            </div>
          </div>

          <div class="rank-usage-panel">
            <div class="rank-usage-title">Top 30 机制信号覆盖</div>
            <div class="rank-cats">
              {signalRules.map(signal => (
                <div class="rank-cat-row">
                  <span class="rank-cat-label" title={signal.description}>{signal.label}</span>
                  <div class="rank-cat-bar-wrap" aria-label={`${signal.label}: ${signal.count} projects`}>
                    <div class="rank-cat-bar" style={`width:${signal.pct}%; background:${signal.color}`}></div>
                  </div>
                  <span class="rank-cat-count">{signal.count}</span>
                  <span class="rank-cat-note">{Math.round(signal.avgScore)} avg · {signal.topProject}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <details class="rank-method-details">
          <summary>查看评分权重和证据边界</summary>
          <p>当前价值排名不是历史影响力排名。时间新近性占 50%，自进化机制强度占 20%，证据链完整度占 15%，社区动量占 10%，实用适配度占 5%。GitHub API 无法确认创建时间的项目会被标记 caveat，时间分最高封顶 45/100，避免本地 mirror 或采集时间制造“假新项目”。</p>
          <div class="score-table-wrap" style="margin:16px 0 0;">
            <table class="rank-table">
              <thead><tr><th>Dimension</th><th>Weight</th><th>Meaning</th></tr></thead>
              <tbody>
                <tr><td>Time</td><td>{Math.round(method.weights.time * 100)}%</td><td>创建时间新近性 + 最近活动；创建时间缺失时封顶。</td></tr>
                <tr><td>Mechanism</td><td>{Math.round(method.weights.mechanism * 100)}%</td><td>是否真的包含进化、评估器、记忆/技能、训练/数据循环。</td></tr>
                <tr><td>Evidence</td><td>{Math.round(method.weights.evidence * 100)}%</td><td>是否有 raw、classification、公开报告、GitHub API 或本地镜像证据。</td></tr>
                <tr><td>Adoption</td><td>{Math.round(method.weights.adoption * 100)}%</td><td>log-scaled stars，只作为动量信号，不再主导排名。</td></tr>
                <tr><td>Usefulness</td><td>{Math.round(method.weights.usefulness * 100)}%</td><td>是否适合工程使用、评测、harness、memory/skill 或自进化实践。</td></tr>
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.rank-podium{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.rank-podium-item{display:flex;flex-direction:column;align-items:center;gap:8px;padding:24px 16px;border-radius:12px;background:var(--surface-2);text-align:center}
.rank-pos-1{border:2px solid #FFD700}.rank-pos-2{border:2px solid #C0C0C0}.rank-pos-3{border:2px solid #CD7F32}
.rank-medal{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;color:#fff}
.rank-pos-1 .rank-medal{background:#FFD700;color:#333}.rank-pos-2 .rank-medal{background:#C0C0C0;color:#333}.rank-pos-3 .rank-medal{background:#CD7F32}
.rank-podium-name a{font-weight:800;font-size:16px;color:var(--fg);text-decoration:none}.rank-podium-name a:hover{color:var(--accent)}
.rank-podium-stars{font-weight:900;font-size:20px;color:var(--accent);font-variant-numeric:tabular-nums}
.rank-podium-cat{font-size:12px;color:var(--muted);font-weight:700}

.rank-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.rank-table{width:100%;border-collapse:collapse;font-size:13px}
.rank-table th{text-align:left;padding:8px 10px;border-bottom:2px solid var(--line);color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}
.rank-table td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
.rank-table tr:hover td{background:var(--surface-2)}
.rank-num{font-weight:800;color:var(--meta);width:36px}
.rank-name a{font-weight:700;color:var(--fg);text-decoration:none}.rank-name a:hover{color:var(--accent)}
.rank-repo{display:block;font-size:11px;color:var(--meta);margin-top:2px}
.rank-caveat{display:block;font-size:11px;color:var(--muted);margin-top:4px;max-width:360px}
.rank-stars{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
.rank-pattern{max-width:180px}
.rank-tag{display:inline-block;padding:2px 6px;margin:1px 2px;border:1px solid var(--line);border-radius:4px;font-size:11px;font-weight:650;color:var(--muted);white-space:nowrap}
.rank-date{white-space:nowrap;color:var(--muted);font-size:12px}

.rank-usage-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;margin-top:18px}
.rank-usage-panel{border:1px solid var(--line);border-radius:8px;padding:14px;background:color-mix(in srgb,var(--surface-2) 55%,transparent)}
.rank-usage-title{font-size:13px;font-weight:850;color:var(--fg);margin-bottom:12px}
.rank-method-details{margin-top:16px;border-top:1px solid var(--line);padding-top:14px}
.rank-method-details summary{cursor:pointer;color:var(--fg);font-size:13px;font-weight:850}
.rank-method-details p{margin-top:12px}
.rank-bands{display:flex;flex-direction:column;gap:12px}
.rank-band-row{display:grid;grid-template-columns:1fr;gap:6px}
.rank-band-head{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;font-weight:800;color:var(--fg)}
.rank-band-head strong{font-variant-numeric:tabular-nums;color:var(--accent)}
.rank-band-meta{display:grid;grid-template-columns:64px 1fr;gap:8px;font-size:12px;line-height:1.45;color:var(--muted)}
.rank-band-meta span:first-child{font-weight:800;color:var(--meta);white-space:nowrap}
.rank-band-examples{font-size:11px;line-height:1.45;color:var(--meta);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-cats{display:flex;flex-direction:column;gap:10px}
.rank-cat-row{display:grid;grid-template-columns:110px 1fr 34px;gap:8px;align-items:center}
.rank-cat-label{font-size:13px;font-weight:650;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-cat-bar-wrap{height:18px;background:var(--surface);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.rank-cat-bar{height:100%;background:linear-gradient(90deg,var(--accent),var(--brand2));border-radius:6px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.rank-cat-count{font-size:13px;font-weight:800;color:var(--meta);text-align:right}
.rank-cat-note{grid-column:2 / 4;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

@media(max-width:760px){
  .rank-podium{grid-template-columns:1fr}
  .rank-table{font-size:12px}
  .rank-usage-grid{grid-template-columns:1fr}
  .rank-cat-row{grid-template-columns:96px 1fr 30px}
  .rank-band-meta{grid-template-columns:1fr}
  .rank-band-examples{white-space:normal}
}
</style>
