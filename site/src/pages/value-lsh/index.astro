---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ValueLshGraph3D from '@/components/ValueLshGraph3D.astro';
import { site } from '@/data/site';
import { valueLshEmbeddingClusters, valueLshRegions } from '@/data/valueLshRegions';
import valueSnapshotJson from '../../../../analysis/value-lsh-index.json';
import graphSnapshotJson from '../../../../analysis/value-lsh-graph-3d.json';

type ValueClass = 'high-value-candidate' | 'needs-review' | 'low-signal-or-risk';

interface ValueRow {
  id: string;
  type: string;
  title: string;
  url: string | null;
  source_path: string | null;
  score: {
    value_score: number;
    confidence: number;
    positive_tags: number;
    negative_tags: number;
    value_class: ValueClass;
  };
  evidence_refs?: {
    frontier_rank?: number | null;
    star_growth_rank?: number | null;
    raw_file?: string | null;
    public_report?: string | null;
  };
}

interface ValueCluster {
  cluster_id: string;
  label: string;
  size: number;
  type_counts: Record<string, number>;
  value_class_counts: Record<ValueClass, number>;
  score_avg: number;
  confidence_avg: number;
  top_tags: { id: string; average: number; label: string }[];
  representatives: { title: string; type: string; value_score: number; value_class: ValueClass; source_path: string | null }[];
}

interface ValueTag {
  id: string;
  weight: number;
  label: string;
  line: string;
}

const valueSnapshot = valueSnapshotJson as {
  generated_at: string;
  summary: {
    total_materials: number;
    value_tag_count: number;
    total_buckets: number;
    total_clusters: number;
    score_average: number;
    confidence_average: number;
    type_counts: Record<string, number>;
    value_class_counts: Record<ValueClass, number>;
    incremental?: Record<string, number | string>;
  };
  value_tags: ValueTag[];
  top_high_value_candidates: ValueRow[];
  low_signal_or_risk_queue: ValueRow[];
  clusters: ValueCluster[];
  largest_buckets: { key: string; band: number; chars: string; size: number; features: string[]; sample_members: string[] }[];
};

const graphSnapshot = graphSnapshotJson as { summary: { nodes: number; embedding_clusters: number } };
const summary = valueSnapshot.summary;
const generatedDate = valueSnapshot.generated_at.slice(0, 10);
const materialCountLabel = summary.total_materials.toLocaleString();
const classLabels: Record<ValueClass, string> = {
  'high-value-candidate': '优先复核',
  'needs-review': '待复核',
  'low-signal-or-risk': '修复 / 风险',
};
const classColors: Record<ValueClass, string> = {
  'high-value-candidate': 'var(--success)',
  'needs-review': 'var(--caret-blue)',
  'low-signal-or-risk': 'var(--danger)',
};
const classRows = (Object.entries(summary.value_class_counts) as [ValueClass, number][])
  .map(([key, count]) => ({ key, count, label: classLabels[key], color: classColors[key] }));
const typeRows = Object.entries(summary.type_counts).map(([key, count]) => ({ key, count }));
const maxTypeCount = Math.max(...typeRows.map((row) => row.count), 1);
const topCandidates = valueSnapshot.top_high_value_candidates.slice(0, 12);
const repairQueue = valueSnapshot.low_signal_or_risk_queue.slice(0, 12);
const regionRankings = valueLshRegions;
const semanticClusters = valueLshEmbeddingClusters.slice(0, 6);
const buckets = valueSnapshot.largest_buckets.slice(0, 6);
const repoPath = `${site.github}/tree/main`;
const evidenceBand = (confidence: number) => {
  if (confidence >= 70) return 'heuristic trail stronger';
  if (confidence >= 45) return 'partial trail';
  return 'weak trail';
};
const scoreBand = (score: number) => {
  if (score >= 70) return '优先复核';
  if (score >= 45) return '需要复核';
  return '暂不引用';
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Value LSH Evidence Triage Queue',
  alternateName: 'AI 自进化素材证据分诊队列',
  description: 'A heuristic triage-facet queue over GitHub projects, papers, social/X captures, and blog materials for deciding what to read, review, or avoid citing for now.',
  url: `${site.url}/value-lsh/`,
  inLanguage: 'zh-CN',
  dateModified: valueSnapshot.generated_at,
  isPartOf: { '@id': `${site.url}/#website` },
  measurementTechnique: '-1/0/+1 triage facets, locality-sensitive hashing buckets, PCA/TSNE-ready embedding projection',
  variableMeasured: ['triage_score', 'tag_coverage', 'review_class', 'embedding_cluster', 'lsh_bucket'],
};
---

<BaseLayout
  title="Value LSH 证据分诊队列 — Self Evolve"
  description="Self Evolve 的 Value LSH 是启发式证据分诊队列：当材料太多时，帮助决定先读哪些、先复核哪些、哪些暂时不要引用；它不是最终价值裁判。"
  pageKeywords={['Value LSH', '3D embedding graph', 'AI 自进化证据分诊', '局部敏感哈希', 'triage facet matrix']}
  alternateZh="/value-lsh/"
  alternateEn="/en/value-lsh/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <section class="section value-lsh-hero">
    <div class="container">
      <div class="eyebrow">Evidence triage · heuristic queue</div>
      <h1>材料太多时，先决定读哪一批、复核哪一批、哪些暂时不要引用。</h1>
      <p class="lead">Value LSH 是一个启发式分诊队列：用 26 个判断问题，把 {materialCountLabel} 条 GitHub、论文、社交/X 和博客材料分成“优先复核、需要复核、弱证据/风险”三类。</p>
      <p class="value-lsh-caveat">方法边界：这里的 triage score 和标签覆盖度没有完成校准，也没有人工一致性验证；页面只用于排研究顺序，不能替代论文精读、项目运行验证或学术审查。<strong>English:</strong> This is a review queue, not a calibrated value judgment or final quality ranking.</p>
      <div class="value-lsh-actions">
        <a class="button primary" href="#priority-review">看优先复核候选</a>
        <a class="button" href="#repair-queue">看证据修复队列</a>
        <a class="text-link" href="/en/value-lsh/">English method boundary</a>
      </div>
    </div>
  </section>

  <section class="section value-lsh-graph-section">
    <div class="container">
      <aside class="source-panel" aria-label="Value LSH 图谱阅读方式">
        <div>
          <div class="eyebrow">How to read this graph / 怎么读图</div>
          <h2>先看区域，再看候选，最后回到源文件</h2>
          <p>颜色和区域只是启发式分诊结果：它们回答“先读什么”和“哪里缺证据”，不是项目质量排名。距离、簇和标签覆盖度都来自 facet 向量，尚未完成校准或人工一致性验证。</p>
        </div>
        <div class="source-links">
          <a href={`${repoPath}/analysis/value-lsh-index.md`} target="_blank" rel="noopener">查看生成报告</a>
          <a href={`${repoPath}/data-engine/value-lsh-index`} target="_blank" rel="noopener">数据目录</a>
        </div>
      </aside>
      <div class="value-lsh-metrics" aria-label="Value LSH summary metrics">
        <div><strong>{summary.total_materials.toLocaleString()}</strong><span>materials</span></div>
        <div><strong>{summary.value_tag_count}</strong><span>triage facets</span></div>
        <div><strong>{summary.total_buckets}</strong><span>LSH buckets</span></div>
        <div><strong>{graphSnapshot.summary.embedding_clusters}</strong><span>facet-vector clusters</span></div>
      </div>
      <ValueLshGraph3D variant="full" maxNodes={summary.total_materials} height={590} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
            <div class="eyebrow">Evidence Regions</div>
          <h2>先看哪一块空间，不再只看一堆散点。</h2>
        </div>
      </div>
      <p class="lead">这些区域指标是 heuristic proxy：frontier 表示前沿性线索，attention 表示讨论/素材关注度，evidence density 表示证据链密度代理；它们不是外部验证过的学术指标。</p>
      <div class="value-region-grid">
        {regionRankings.map((region, index) => (
          <article class="value-region-panel">
            <div class="value-region-panel-head">
              <span class="value-region-panel-rank">{index + 1}</span>
              <div>
                <strong>{region.arrow} {region.rankingLabel}</strong>
                <span>{region.clusterId} · {region.nodeCount} nodes</span>
              </div>
            </div>
            <p>{region.meaning}</p>
            <div class="value-chip-row">
              {region.topFacets.slice(0, 4).map((facet) => <span>{facet.label}</span>)}
            </div>
            <div class="value-region-metrics">
              <span>frontier {region.metrics.frontier.toFixed(2)}</span>
              <span>attention {region.metrics.attention.toFixed(2)}</span>
              <span>evidence-density proxy {region.metrics.quality.toFixed(2)}</span>
              <span>priority-review share {(region.metrics.highValueShare * 100).toFixed(0)}%</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container value-lsh-grid">
      <div>
        <div class="section-head compact">
          <div>
            <div class="eyebrow">Class Split</div>
            <h2>三段证据分诊</h2>
          </div>
        </div>
        <div class="value-lsh-bars">
          {classRows.map((row) => {
            const pct = Math.round((row.count / summary.total_materials) * 1000) / 10;
            return (
              <div class="value-bar-row">
                <div>
                  <strong>{row.label}</strong>
                  <span>{row.count.toLocaleString()} · {pct}%</span>
                </div>
                <div class="value-bar-track"><span style={`width:${pct}%;background:${row.color};`} /></div>
              </div>
            );
          })}
        </div>
      </div>

      <div>
        <div class="section-head compact">
          <div>
            <div class="eyebrow">Corpus Split</div>
            <h2>素材来源覆盖</h2>
          </div>
        </div>
        <div class="value-lsh-bars">
          {typeRows.map((row) => {
            const pct = Math.max(3, Math.round((row.count / maxTypeCount) * 100));
            return (
              <div class="value-bar-row">
                <div>
                  <strong>{row.key}</strong>
                  <span>{row.count.toLocaleString()}</span>
                </div>
                <div class="value-bar-track"><span style={`width:${pct}%;`} /></div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="priority-review" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Priority Review Candidates</div>
          <h2>当前优先复核的候选</h2>
        </div>
        <span class="value-lsh-date">Generated {generatedDate}</span>
      </div>
      <div class="value-table-wrap">
        <table class="value-table">
          <thead>
            <tr>
              <th>素材</th>
              <th>类型</th>
              <th>分诊</th>
              <th>证据等级</th>
              <th>正/负 Facets</th>
              <th>证据链</th>
            </tr>
          </thead>
          <tbody>
            {topCandidates.map((row) => (
              <tr>
                <td>
                  <strong>{row.url ? <a href={row.url} target="_blank" rel="noopener">{row.title}</a> : row.title}</strong>
                  <span>{row.source_path || row.evidence_refs?.raw_file || row.id}</span>
                </td>
                <td><span class="value-type">{row.type}</span></td>
                <td>{scoreBand(row.score.value_score)}</td>
                <td>{evidenceBand(row.score.confidence)}</td>
                <td>{row.score.positive_tags} / {row.score.negative_tags}</td>
                <td>
                  <span>frontier {row.evidence_refs?.frontier_rank ?? 'n/a'}</span>
                  <span>star-growth {row.evidence_refs?.star_growth_rank ?? 'n/a'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="repair-queue">
    <div class="container value-lsh-grid">
      <div>
        <div class="section-head compact">
          <div>
            <div class="eyebrow">Repair Queue</div>
            <h2>需要修复证据链的对象</h2>
          </div>
        </div>
        <div class="value-queue">
          {repairQueue.map((row) => (
            <article>
              <div>
                <strong>{row.url ? <a href={row.url} target="_blank" rel="noopener">{row.title}</a> : row.title}</strong>
                <span>{row.type} · {scoreBand(row.score.value_score)} · {evidenceBand(row.score.confidence)}</span>
              </div>
              <p>{row.source_path || row.evidence_refs?.raw_file || row.id}</p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <div class="section-head compact">
          <div>
            <div class="eyebrow">Facet-vector clusters</div>
            <h2>这些簇是启发式语义标签，不是学术分类</h2>
          </div>
        </div>
        <div class="value-clusters">
          {semanticClusters.map((cluster) => (
            <article>
              <div>
                <strong>{cluster.semanticTitle}</strong>
                <span>{cluster.clusterId} · {cluster.size.toLocaleString()} items · avg triage score {cluster.metrics.value.toFixed(1)}</span>
              </div>
              <p>{cluster.meaning}</p>
              <div class="value-chip-row">
                {cluster.topPositiveFacets.slice(0, 4).map((tag) => <span>{tag.label}</span>)}
              </div>
              <div class="value-region-metrics">
                <span>tag coverage {cluster.metrics.confidence.toFixed(1)}</span>
                <span>frontier {cluster.metrics.frontier.toFixed(2)}</span>
                <span>attention {cluster.metrics.attention.toFixed(2)}</span>
                <span>evidence-density proxy {cluster.metrics.quality.toFixed(2)}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Triage Facets</div>
          <h2>这 26 个判断问题如何帮读者筛材料。</h2>
        </div>
      </div>
      <div class="value-tags">
        {valueSnapshot.value_tags.map((tag) => (
          <article>
            <strong>{tag.label}</strong>
            <span>weight {tag.weight}</span>
            <p>{tag.line}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Largest Buckets</div>
          <h2>最大的相似材料组也可能暴露粗标签误导。</h2>
        </div>
      </div>
      <div class="value-buckets">
        {buckets.map((bucket) => (
          <article>
            <strong>{bucket.key}</strong>
            <span>band {bucket.band} · {bucket.size.toLocaleString()} members · chars {bucket.chars}</span>
            <p>{bucket.features.join(' / ')}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .value-lsh-hero {
    padding-bottom: 34px;
  }

  .value-lsh-hero h1 {
    max-width: 860px;
    margin-top: 16px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 400;
    line-height: 1.08;
  }

  .value-lsh-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .value-lsh-caveat {
    max-width: 860px;
    margin: 18px 0 0;
    padding: 12px 14px;
    border-left: 3px solid var(--caret-blue);
    background: var(--surface-1);
    color: var(--muted);
    line-height: 1.65;
  }

  .value-lsh-graph-section {
    padding-top: 28px;
  }

  .value-lsh-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .value-lsh-metrics div,
  .value-tags article,
  .value-buckets article,
  .value-queue article,
  .value-clusters article {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-card);
    box-shadow: var(--shadow-mockup);
  }

  .value-lsh-metrics div {
    padding: 16px;
  }

  .value-lsh-metrics strong {
    display: block;
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
  }

  .value-lsh-metrics span,
  .value-lsh-date {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .value-lsh-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .value-region-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .value-region-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-card);
    box-shadow: var(--shadow-mockup);
    padding: 16px;
  }

  .value-region-panel-head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .value-region-panel-rank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--surface-1);
    font-size: 12px;
    font-weight: 850;
  }

  .value-region-panel strong,
  .value-region-panel span {
    display: block;
  }

  .value-region-panel > p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .value-region-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .value-region-metrics span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-1);
    padding: 5px 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .section-head.compact {
    margin-bottom: 16px;
  }

  .section-head.compact h2 {
    font-size: 30px;
  }

  .value-lsh-bars,
  .value-queue,
  .value-clusters,
  .value-buckets,
  .value-tags {
    display: grid;
    gap: 10px;
  }

  .value-bar-row {
    display: grid;
    grid-template-columns: minmax(120px, 190px) minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .value-bar-row strong,
  .value-bar-row span {
    display: block;
  }

  .value-bar-row span {
    margin-top: 3px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 750;
  }

  .value-bar-track {
    height: 32px;
    overflow: hidden;
    border-radius: 7px;
    background: var(--surface-2);
  }

  .value-bar-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  .value-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-card);
    -webkit-overflow-scrolling: touch;
  }

  .value-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .value-table th,
  .value-table td {
    padding: 11px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .value-table th {
    color: var(--muted);
    font-size: 11px;
    font-weight: 850;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .value-table tr:last-child td {
    border-bottom: 0;
  }

  .value-table td > span,
  .value-table td span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .value-table a,
  .value-queue a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(26, 26, 26, .2);
    text-underline-offset: 4px;
  }

  .value-table a:hover,
  .value-queue a:hover {
    text-decoration-color: var(--accent);
  }

  .value-type {
    display: inline-flex !important;
    width: fit-content;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-1);
    padding: 4px 8px;
    color: var(--fg) !important;
    font-weight: 800;
  }

  .value-num {
    color: var(--fg);
    font-weight: 850;
    white-space: nowrap;
  }

  .value-queue article,
  .value-clusters article,
  .value-buckets article,
  .value-tags article {
    padding: 16px;
  }

  .value-queue article div,
  .value-clusters article div:first-child {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .value-queue article span,
  .value-clusters article span,
  .value-buckets article span,
  .value-tags article span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .value-queue article p,
  .value-clusters article p,
  .value-buckets article p,
  .value-tags article p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .value-chip-row {
    display: flex !important;
    flex-wrap: wrap;
    justify-content: flex-start !important;
    gap: 7px !important;
    margin-top: 12px;
  }

  .value-chip-row span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-1);
    padding: 5px 8px;
  }

  .value-tags {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .value-lsh-metrics,
    .value-lsh-grid,
    .value-tags,
    .value-region-grid {
