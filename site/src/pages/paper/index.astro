---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { surveyFigureAtlas } from '@/data/survey';
import { publicCorpusStats } from '@/data/publicCorpusStats';
import { paperReports } from '@/data/reports';

const surveyLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  name: 'Self-Evolving AI Agents: A Survey of Feedback-Driven Generation, Evaluation, Memory, and Self-Modification',
  description: 'Site landing page for a working survey draft on AI self-evolution. It links English and Chinese PDFs and marks which evidence remains provisional.',
  author: { '@type': 'Organization', name: 'aha team' },
  datePublished: '2026-05',
  inLanguage: 'zh-CN',
  about: { '@type': 'Thing', name: 'AI Self-Evolution' },
  keywords: ['self-evolving AI', 'LLM agents', 'recursive self-improvement', 'agent evaluation', 'code evolution']
};

const chapters = [
  ['1', 'Introduction', 'Definition, scope, contributions, boundaries', 'Draft-complete'],
  ['2', 'Taxonomy', 'Five evolution loops and formal design dimensions', 'Draft-complete'],
  ['3', 'Methods', 'Inference-time and training-time self-improvement', 'Draft-complete'],
  ['4', 'Evolutionary Systems', 'Code evolution, algorithm discovery, agent self-evolution', 'Draft-complete'],
  ['5', 'Evaluation', 'Benchmarks, process metrics, disclosure standard', 'Needs evidence audit'],
  ['6', 'Frameworks', 'Agent frameworks and infrastructure gaps', 'Draft-complete'],
  ['7', 'Pain Points', 'User pain points and production constraints', 'Needs source cleanup'],
  ['8', 'Future Directions', 'Open problems, roadmap, conclusion', 'Needs final tightening'],
  ['Appendix', 'Tables', 'Projects, papers, benchmarks, star visibility signals', 'Compiled, needs layout polish']
];

const methodFamilies = [
  { name: 'Prompt/Search Optimization', papers: 68, share: '34.7%', color: '#9b59b6' },
  { name: 'Reward/RL/Self-Play', papers: 51, share: '26.0%', color: '#e74c3c' },
  { name: 'Code/Self-Modification', papers: 28, share: '14.3%', color: '#3498db' },
  { name: 'Multi-Agent Reflection/Debate', papers: 16, share: '8.2%', color: '#2ecc71' },
  { name: 'Memory/Knowledge Evolution', papers: 16, share: '8.2%', color: '#f39c12' },
  { name: 'Web/Tool/Environment Adaptation', papers: 13, share: '6.6%', color: '#1abc9c' },
  { name: 'Evaluation/Safety/Governance', papers: 4, share: '2.0%', color: '#8e8e93' },
];

const frameworkRadar = [
  { name: 'LangChain/LangGraph', adoption: 5, observability: 3, production: 5, evolution: 3, governance: 3, status: '[INFERRED]' },
  { name: 'CrewAI', adoption: 5, observability: 4, production: 4, evolution: 2, governance: 2, status: '[INFERRED]' },
  { name: 'AutoGen', adoption: 5, observability: 4, production: 4, evolution: 2, governance: 2, status: '[INFERRED]' },
  { name: 'OpenAI Agents SDK', adoption: 5, observability: 1, production: 5, evolution: 2, governance: 3, status: '[INFERRED]' },
  { name: 'EvoAgentX', adoption: 5, observability: 4, production: 4, evolution: 5, governance: 2, status: '[INFERRED]' },
  { name: 'DGM/OpenEvolve', adoption: 5, observability: 4, production: 5, evolution: 5, governance: 2, status: '[INFERRED]' },
];

const corpusRows = [
  {
    dataset: 'Survey-display papers',
    count: publicCorpusStats.surveyDisplayPapers,
    basis: '196-paper display snapshot used for the current figure atlas.',
    limit: 'Automatic keyword grouping; not a final systematic-review denominator.'
  },
  {
    dataset: 'Paper review files',
    count: paperReports.length,
    basis: 'Public paper report files exported under site/public/reports/papers.',
    limit: 'Coverage is file-count based; individual claims still need source-level audit.'
  },
  {
    dataset: 'GitHub raw captures',
    count: publicCorpusStats.rawGithubCaptures,
    basis: `${publicCorpusStats.analyzedProjectReports} project/model-card analyses and ${publicCorpusStats.publicProjectReports} public project reports are currently surfaced.`,
    limit: 'Raw capture count is not project quality, maturity, or research value.'
  },
  {
    dataset: 'Public pain-point signals',
    count: publicCorpusStats.painPointSignals,
    basis: 'Semantic analysis of Reddit, Hacker News, and X/Twitter public discussions.',
    limit: 'These are public discussion signals, not formal interviews or survey respondents.'
  },
  {
    dataset: 'Site corpus snapshot',
    count: publicCorpusStats.generatedOn,
    basis: 'Counts generated by the public corpus/index pipeline.',
    limit: 'Use this as a dated snapshot; hourly metadata may update downstream pages.'
  },
];

---

<BaseLayout
  title="Self-Evolving AI Survey — 论文下载 & 数据可视化"
  description="Self-Evolving AI 综述论文入口：提供中英文 PDF、方法分类图、框架对比草稿和证据边界说明；中文为默认入口，英文 citation/status 镜像已提供。"
  alternateZh="/paper/"
  alternateEn="/en/paper/"
>
  <section class="section">
    <script type="application/ld+json" set:html={JSON.stringify(surveyLd)} is:inline />
    <div class="container">
      <div class="eyebrow">Paper / 论文</div>
      <h1 class="gradient-text">Self-Evolving AI 综述论文</h1>
      <p class="lead">这篇 working survey 试图回答一个问题：AI Agent 的“自我改进”什么时候只是反复尝试，什么时候已经形成可验证、可保留、可回滚的系统过程？当前版本连接 {publicCorpusStats.surveyDisplayPapers} 篇论文展示集、{publicCorpusStats.rawGithubCaptures} 个 GitHub 原始捕获、{publicCorpusStats.analyzedProjectReports} 份项目/模型卡分析和 {publicCorpusStats.painPointSignals} 个公开痛点信号；这些数字说明证据来源，不等同于完成度或排名。</p>
      <div class="metrics">
        <div class="metric"><strong>{publicCorpusStats.surveyDisplayPapers}</strong><span>篇论文覆盖</span></div>
        <div class="metric"><strong>{publicCorpusStats.rawGithubCaptures}</strong><span>个 GitHub 原始捕获</span></div>
        <div class="metric"><strong>{publicCorpusStats.painPointSignals}</strong><span>个公开痛点信号</span></div>
        <div class="metric"><strong>8</strong><span>章 + 附录</span></div>
      </div>
    </div>
  </section>

  <!-- PDF Download -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Download</div>
          <h2>论文 PDF 下载</h2>
        </div>
      </div>
      <div class="grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
        <article class="card" style="border-top: 3px solid #FF5B00;">
          <div class="card-title-row">
            <div>
              <div class="eyebrow">English</div>
              <h3>Self-Evolving AI Survey</h3>
            </div>
          </div>
          <p>Working survey draft on AI self-evolution: taxonomy, methods, frameworks, evaluation, and future directions. 8 chapters + appendix. Treat sections on evaluation, pain points, and framework scoring as provisional until their evidence audit is complete.</p>
          <div class="pill-row">
            <span class="pill">XeLaTeX</span>
            <span class="pill">8 Chapters</span>
            <span class="pill">62 BibTeX Items</span>
          </div>
          <div class="card-actions">
            <a class="button primary" href="/reports/self-evolve-survey-en.pdf" target="_blank" rel="noopener">Download English PDF</a>
          </div>
        </article>
        <article class="card" style="border-top: 3px solid #007AFF;">
          <div class="card-title-row">
            <div>
              <div class="eyebrow">中文版</div>
              <h3>AI 自进化综述</h3>
            </div>
          </div>
          <p>当前发布的是 44 页中文伴读版，便于快速阅读核心框架、方法分类、评估体系和未来方向。长版中文稿仍是校对中的同步版本，不作为公开最终稿引用。</p>
          <div class="pill-row">
            <span class="pill">XeLaTeX</span>
            <span class="pill">中文伴读版</span>
            <span class="pill">44 页</span>
          </div>
          <div class="card-actions">
            <a class="button primary" href="/reports/self-evolve-survey-zh.pdf" target="_blank" rel="noopener">下载中文 PDF</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Key Figures: Survey Figure Atlas -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Figures</div>
          <h2>论文现在直接使用 Survey Figure Atlas。</h2>
        </div>
      </div>
      <p style="margin-bottom: 24px; color: var(--muted);">这里不再只放旧的站点装饰图；每张图都对应一个 paper chapter 和一个公开 evidence boundary。</p>
      <div class="visual-grid">
        {surveyFigureAtlas.map((figure) => (
          <figure class="visual-panel">
            <img src={figure.path} alt={`${figure.title}: ${figure.insight}`} loading="lazy" />
            <figcaption><strong>{figure.titleZh}</strong> · {figure.chapter}<br />{figure.insight}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Method Taxonomy -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Method Taxonomy</div>
          <h2>方法族分类 — 196 篇论文</h2>
        </div>
      </div>
      <div class="method-bars">
        {methodFamilies.map((f) => (
          <div class="radar-bar-row">
            <span class="radar-label" style="min-width: 220px;">{f.name}</span>
            <div class="radar-bar-track" style="flex: 1;">
              <div class="radar-bar-fill" style={`width: ${(f.papers / 68) * 100}%; background: ${f.color};`} />
            </div>
            <span class="radar-value">{f.papers} ({f.share})</span>
          </div>
        ))}
      </div>
      <p style="margin-top: 16px; color: var(--muted);">[INFERRED] 2026-05-26 自动关键词初分类（196-paper display snapshot）。它用于说明当前语料倾向，后续需要由 paper review、纳入/排除标准和人工复核校正。</p>
    </div>
  </section>

  <!-- Framework Radar -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Framework comparison draft</div>
          <h2>框架对比现在只作为评分协议草稿</h2>
        </div>
      </div>
      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th>Framework</th>
              <th>Adoption</th>
              <th>Observability</th>
              <th>Production Fit</th>
              <th>Self-Evolution Fit</th>
              <th>Safety/Governance</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {frameworkRadar.map((fw) => (
              <tr>
                <td><strong>{fw.name}</strong></td>
                <td>{fw.adoption >= 4 ? '●' : '○'} {fw.adoption}/5</td>
                <td>{fw.observability >= 4 ? '●' : '○'} {fw.observability}/5</td>
                <td>{fw.production >= 4 ? '●' : '○'} {fw.production}/5</td>
                <td>{fw.evolution >= 4 ? '●' : '○'} {fw.evolution}/5</td>
                <td>{fw.governance >= 3 ? '●' : '○'} {fw.governance}/5</td>
                <td>{fw.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 12px; color: var(--muted);">[INFERRED] 这些 1-5 分仍是启发式草稿，基于 repo 信号和痛点分析；还缺少完整 rubric、打分人、反例、reviewer disagreement 和逐项来源，因此不能当学术排名引用。</p>

      <div class="grid radar-grid" style="margin-top: 24px;">
        {frameworkRadar.map((fw) => (
          <article class="card" style="padding: 16px;">
            <h4 style="margin-bottom: 10px;">{fw.name}</h4>
            <div>
              {Object.entries({Adoption: fw.adoption, Observability: fw.observability, Production: fw.production, 'Self-Evo': fw.evolution, Governance: fw.governance}).map(([dim, val]) => (
                <div class="radar-bar-row">
                  <span class="radar-label">{dim}</span>
                  <div class="radar-bar-track">
                    <div class="radar-bar-fill" style={`width: ${(val / 5) * 100}%; background: ${val >= 5 ? '#FF5B00' : val >= 4 ? '#007AFF' : val >= 3 ? '#f39c12' : '#8e8e93'};`} />
                  </div>
                  <span class="radar-value">{val}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Evidence-led Case Studies -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evidence-led case studies</div>
          <h2>案例选择回到论文证据和评估协议，不看累计 Star。</h2>
        </div>
      </div>
      <div class="card">
        <h3>Research Visibility vs Adoption Signal</h3>
        <p>自进化研究前沿（ADAS、DGM、Absolute Zero、Reflexion 等）不一定会同步反映在 GitHub Star 数中。这里的读者提示很简单：Star 只能作为 adoption prior，不能替代论文证据、可运行实现、评估协议和失败记录。</p>
        <div class="score-table-wrap" style="margin-top: 12px;">
          <table class="score-table">
            <thead>
              <tr><th>Research Method</th><th>Paper Signal</th><th>GitHub Signal</th><th>Reader Interpretation</th></tr>
            </thead>
            <tbody>
              <tr><td>Architecture Search (ADAS)</td><td>ICML 2024</td><td>repository dependent</td><td>Check method evidence before adoption signal.</td></tr>
              <tr><td>Godel Machine (DGM)</td><td>arXiv 2025</td><td>repository dependent</td><td>Inspect retained changes, evaluator, and rollback evidence.</td></tr>
              <tr><td>Self-Play Reward (Absolute Zero)</td><td>arXiv 2025</td><td>repository dependent</td><td>Do not infer maturity from stars alone.</td></tr>
              <tr><td>Reflection (Reflexion)</td><td>NeurIPS 2023</td><td>paper/code ecosystem</td><td>Separate research influence from production readiness.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Corpus Status -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Corpus Status</div>
          <h2>基础语料状态，不写成百分比覆盖率</h2>
        </div>
      </div>
      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr><th>Dataset</th><th>Count / Snapshot</th><th>Basis</th><th>Limit</th></tr>
          </thead>
          <tbody>
            {corpusRows.map((row) => (
              <tr>
                <td><strong>{row.dataset}</strong></td>
                <td>{row.count}</td>
                <td>{row.basis}</td>
                <td>{row.limit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 12px; color: var(--muted);">Mom Test 97 痛点来源：Reddit 47、Hacker News 36、X/Twitter 14。它们是公开讨论信号，不是受控访谈样本。</p>
    </div>
  </section>

  <!-- Chapter Status -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Chapters</div>
          <h2>章节完成度</h2>
        </div>
      </div>
      <div class="timeline">
        {chapters.map(([number, title, role, status]) => (
          <article class="timeline-item">
            <div class="year">{number}</div>
            <div>
              <h3>{title}</h3>
              <p>{role}</p>
              <div class="pill-row">
                <span class="pill">{status}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Version Status -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Version Status</div>
          <h2>读者应该如何引用当前版本</h2>
        </div>
      </div>
      <div class="grid">
        {[
          '可作为 working draft 引用：定义框架、五类进化回路、主要证据边界和当前公开 PDF；引用时必须标注版本日期与 provisional status。',
          '谨慎引用：方法族比例、框架 1-5 分、项目覆盖数字和痛点统计，它们仍是 dated snapshot。',
          '不要引用为最终结论：Evolve-AGI worksheet、Star/Rank 页面、framework radar 和 corpus count。',
          '引用数字时必须带日期：当前公开语料快照为 2026-06-05，部分站点元数据会继续更新。',
          '需要继续补强：逐项 citation mapping、benchmark source audit、中文长稿同步和英文网页镜像的图表逐项说明。'
        ].map((item) => (
          <article class="card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
