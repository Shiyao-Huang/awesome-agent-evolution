---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { surveyFigureAtlas } from '@/data/survey';

const surveyLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  name: 'Self-Evolving AI Agents: A Survey of Feedback-Driven Generation, Evaluation, Memory, and Self-Modification',
  description: 'Comprehensive survey on AI self-evolution covering taxonomy, methods, frameworks, evaluation, and future directions.',
  author: { '@type': 'Organization', name: 'aha team' },
  datePublished: '2026-05',
  inLanguage: ['en', 'zh'],
  about: { '@type': 'Thing', name: 'AI Self-Evolution' },
  keywords: ['self-evolving AI', 'LLM agents', 'recursive self-improvement', 'agent evaluation', 'code evolution']
};

const chapters = [
  ['1', 'Introduction', 'Definition, scope, contributions, boundaries', 'Draft-complete'],
  ['2', 'Taxonomy', 'Five evolution loops and formal design dimensions', 'Draft-complete'],
  ['3', 'Methods', 'Inference-time and training-time self-improvement', 'Draft-complete'],
  ['4', 'Evolutionary Systems', 'Code evolution, algorithm discovery, agent self-evolution', 'Draft-complete'],
  ['5', 'Evaluation', 'Benchmarks, process metrics, disclosure standard', 'Needs evidence audit'],
  ['6', 'Frameworks', 'Agent frameworks and infrastructure gaps', 'Draft-complete'],
  ['7', 'Pain Points', 'User pain points and production constraints', 'Needs source cleanup'],
  ['8', 'Future Directions', 'Open problems, roadmap, conclusion', 'Needs final tightening'],
  ['Appendix', 'Tables', 'Projects, papers, benchmarks, star quality', 'Compiled, needs layout polish']
];

const methodFamilies = [
  { name: 'Prompt/Search Optimization', papers: 68, share: '34.7%', color: '#9b59b6' },
  { name: 'Reward/RL/Self-Play', papers: 51, share: '26.0%', color: '#e74c3c' },
  { name: 'Code/Self-Modification', papers: 28, share: '14.3%', color: '#3498db' },
  { name: 'Multi-Agent Reflection/Debate', papers: 16, share: '8.2%', color: '#2ecc71' },
  { name: 'Memory/Knowledge Evolution', papers: 16, share: '8.2%', color: '#f39c12' },
  { name: 'Web/Tool/Environment Adaptation', papers: 13, share: '6.6%', color: '#1abc9c' },
  { name: 'Evaluation/Safety/Governance', papers: 4, share: '2.0%', color: '#8e8e93' },
];

const frameworkRadar = [
  { name: 'LangChain/LangGraph', adoption: 5, observability: 3, production: 5, evolution: 3, governance: 3 },
  { name: 'CrewAI', adoption: 5, observability: 4, production: 4, evolution: 2, governance: 2 },
  { name: 'AutoGen', adoption: 5, observability: 4, production: 4, evolution: 2, governance: 2 },
  { name: 'OpenAI Agents SDK', adoption: 5, observability: 1, production: 5, evolution: 2, governance: 3 },
  { name: 'EvoAgentX', adoption: 5, observability: 4, production: 4, evolution: 5, governance: 2 },
  { name: 'DGM/OpenEvolve', adoption: 5, observability: 4, production: 5, evolution: 5, governance: 2 },
];

const coverage = [
  { dataset: 'Papers', current: 196, coverage: 196 },
  { dataset: 'Reviews', current: 137, coverage: 156 },
  { dataset: 'Repos', current: 677, coverage: 283 },
  { dataset: 'Blog Files', current: 1308, coverage: 100 },
  { dataset: 'Social JSON', current: 613, coverage: 204 },
  { dataset: 'Pain Points', current: 97, coverage: 100 },
];

const starProjects = [
  { name: 'AutoResearchClaw', stars: '12.6K', dimension: 'Skill + Memory + Workflow', method: 'PIVOT/REFINE loop, multi-agent debate' },
  { name: 'GenericAgent', stars: '11.9K', dimension: 'Architecture', method: 'Architecture self-modification' },
  { name: 'hive', stars: '10.4K', dimension: 'Workflow/Graph', method: 'Failure-driven graph evolution' },
];
---

<BaseLayout
  title="Self-Evolving AI Survey — 论文下载 & 数据可视化"
  description="Self-Evolving AI 综述论文：提供中英文 PDF 下载、方法分类图、框架雷达图、项目传播链、数据覆盖率等图文并茂的可视化内容。"
>
  <section class="section">
    <script type="application/ld+json" set:html={JSON.stringify(surveyLd)} is:inline />
    <div class="container">
      <div class="eyebrow">Paper / 论文</div>
      <h1 class="gradient-text">Self-Evolving AI 综述论文</h1>
      <p class="lead">论文追踪 AI Self-Evolution 的研究图谱：从推理时自改进到代码自进化，连接 196 篇 survey-display papers、677 个 raw GitHub captures、283 个 analyzed project/model-card reports 和 97 个 public pain-point signals。</p>
      <div class="metrics">
        <div class="metric"><strong>196</strong><span>篇论文覆盖</span></div>
        <div class="metric"><strong>677</strong><span>个 raw GitHub captures</span></div>
        <div class="metric"><strong>97</strong><span>个用户痛点</span></div>
        <div class="metric"><strong>8</strong><span>章 + 附录</span></div>
      </div>
    </div>
  </section>

  <!-- PDF Download -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Download</div>
          <h2>论文 PDF 下载</h2>
        </div>
      </div>
      <div class="grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
        <article class="card" style="border-top: 3px solid #FF5B00;">
          <div class="card-title-row">
            <div>
              <div class="eyebrow">English</div>
              <h3>Self-Evolving AI Survey</h3>
            </div>
          </div>
          <p>Comprehensive survey on AI self-evolution: taxonomy, methods, frameworks, evaluation, and future directions. 9 chapters + appendix.</p>
          <div class="pill-row">
            <span class="pill">XeLaTeX</span>
            <span class="pill">8 Chapters</span>
            <span class="pill">62 BibTeX Items</span>
          </div>
          <div class="card-actions">
            <a class="button primary" href="/reports/self-evolve-survey-en.pdf" target="_blank" rel="noopener">Download English PDF</a>
          </div>
        </article>
        <article class="card" style="border-top: 3px solid #007AFF;">
          <div class="card-title-row">
            <div>
              <div class="eyebrow">中文版</div>
              <h3>AI 自进化综述</h3>
            </div>
          </div>
          <p>当前发布的是 44 页中文伴读版，便于快速阅读核心框架、方法分类、评估体系和未来方向；完整 205 页中文版正在生成和校验。</p>
          <div class="pill-row">
            <span class="pill">XeLaTeX</span>
            <span class="pill">中文伴读版</span>
            <span class="pill">44 页</span>
          </div>
          <div class="card-actions">
            <a class="button primary" href="/reports/self-evolve-survey-zh.pdf" target="_blank" rel="noopener">下载中文 PDF</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Key Figures: Survey Figure Atlas -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Figures</div>
          <h2>论文现在直接使用 Survey Figure Atlas。</h2>
        </div>
      </div>
      <p style="margin-bottom: 24px; color: var(--muted);">这里不再只放旧的站点装饰图；每张图都对应一个 paper chapter 和一个公开 evidence boundary。</p>
      <div class="visual-grid">
        {surveyFigureAtlas.map((figure) => (
          <figure class="visual-panel">
            <img src={figure.path} alt={`${figure.title}: ${figure.insight}`} loading="lazy" />
            <figcaption><strong>{figure.titleZh}</strong> · {figure.chapter}<br />{figure.insight}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Method Taxonomy -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Method Taxonomy</div>
          <h2>方法族分类 — 196 篇论文</h2>
        </div>
      </div>
      <div class="method-bars">
        {methodFamilies.map((f) => (
          <div class="radar-bar-row">
            <span class="radar-label" style="min-width: 220px;">{f.name}</span>
            <div class="radar-bar-track" style="flex: 1;">
              <div class="radar-bar-fill" style={`width: ${(f.papers / 68) * 100}%; background: ${f.color};`} />
            </div>
            <span class="radar-value">{f.papers} ({f.share})</span>
          </div>
        ))}
      </div>
      <p style="margin-top: 16px; color: var(--muted);">自动关键词初分类（196 papers），后续由论文 review 深度结论校正。</p>
    </div>
  </section>

  <!-- Framework Radar -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Framework Comparison</div>
          <h2>框架对比雷达图</h2>
        </div>
      </div>
      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th>Framework</th>
              <th>Adoption</th>
              <th>Observability</th>
              <th>Production Fit</th>
              <th>Self-Evolution Fit</th>
              <th>Safety/Governance</th>
            </tr>
          </thead>
          <tbody>
            {frameworkRadar.map((fw) => (
              <tr>
                <td><strong>{fw.name}</strong></td>
                <td>{fw.adoption >= 4 ? '●' : '○'} {fw.adoption}/5</td>
                <td>{fw.observability >= 4 ? '●' : '○'} {fw.observability}/5</td>
                <td>{fw.production >= 4 ? '●' : '○'} {fw.production}/5</td>
                <td>{fw.evolution >= 4 ? '●' : '○'} {fw.evolution}/5</td>
                <td>{fw.governance >= 3 ? '●' : '○'} {fw.governance}/5</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 12px; color: var(--muted);">启发式评分（1-5），基于 repo 信号和痛点分析。EvoAgentX 和 DGM/OpenEvolve 在 Self-Evolution Fit 上领先。</p>

      <div class="grid" style="grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 24px;">
        {frameworkRadar.map((fw) => (
          <article class="card" style="padding: 16px;">
            <h4 style="margin-bottom: 10px;">{fw.name}</h4>
            <div>
              {Object.entries({Adoption: fw.adoption, Observability: fw.observability, Production: fw.production, 'Self-Evo': fw.evolution, Governance: fw.governance}).map(([dim, val]) => (
                <div class="radar-bar-row">
                  <span class="radar-label">{dim}</span>
                  <div class="radar-bar-track">
                    <div class="radar-bar-fill" style={`width: ${(val / 5) * 100}%; background: ${val >= 5 ? '#FF5B00' : val >= 4 ? '#007AFF' : val >= 3 ? '#f39c12' : '#8e8e93'};`} />
                  </div>
                  <span class="radar-value">{val}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Star Project Propagation -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Star Projects</div>
          <h2>10K+ Stars 自进化核心项目</h2>
        </div>
      </div>
      <div class="grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
        {starProjects.map((p) => (
          <article class="card" style="border-top: 3px solid #f39c12;">
            <div class="card-title-row">
              <div>
                <h3>{p.name}</h3>
                <p>{p.stars} stars</p>
              </div>
            </div>
            <p><strong>进化维度：</strong>{p.dimension}</p>
            <p><strong>方法：</strong>{p.method}</p>
          </article>
        ))}
      </div>
      <div class="card" style="margin-top: 20px;">
        <h3>Research Visibility vs Adoption Signal</h3>
        <p>自进化研究前沿（ADAS、DGM、Absolute Zero）不一定会同步反映在 GitHub Star 数中。这里是读者提示：Star 可作为 adoption prior，不能替代论文证据、可运行实现和评估协议。</p>
        <div class="score-table-wrap" style="margin-top: 12px;">
          <table class="score-table">
            <thead>
              <tr><th>Research Method</th><th>Paper Signal</th><th>GitHub Signal</th><th>Reader Interpretation</th></tr>
            </thead>
            <tbody>
              <tr><td>Architecture Search (ADAS)</td><td>ICML 2024</td><td>repository dependent</td><td>Check method evidence before adoption signal.</td></tr>
              <tr><td>Godel Machine (DGM)</td><td>arXiv 2025</td><td>repository dependent</td><td>Inspect retained changes, evaluator, and rollback evidence.</td></tr>
              <tr><td>Self-Play Reward (Absolute Zero)</td><td>arXiv 2025</td><td>repository dependent</td><td>Do not infer maturity from stars alone.</td></tr>
              <tr><td>Reflection (Reflexion)</td><td>NeurIPS 2023</td><td>paper/code ecosystem</td><td>Separate research influence from production readiness.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Coverage -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Data Coverage</div>
          <h2>基础数据覆盖率</h2>
        </div>
      </div>
      <div class="method-bars">
        {coverage.map((c) => (
          <div class="radar-bar-row">
            <span class="radar-label" style="min-width: 120px;">{c.dataset}</span>
            <div class="radar-bar-track" style="flex: 1;">
              <div class="radar-bar-fill" style={`width: ${Math.min(c.coverage, 100)}%; background: ${c.coverage >= 150 ? '#FF5B00' : c.coverage >= 100 ? '#2ecc71' : '#f39c12'};`} />
            </div>
            <span class="radar-value">{c.current} ({c.coverage}%)</span>
          </div>
        ))}
      </div>
      <p style="margin-top: 12px; color: var(--muted);">Mom Test 97 痛点来源：Reddit 47, HN 36, X/Twitter 14。</p>
    </div>
  </section>

  <!-- Chapter Status -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Chapters</div>
          <h2>章节完成度</h2>
        </div>
      </div>
      <div class="timeline">
        {chapters.map(([number, title, role, status]) => (
          <article class="timeline-item">
            <div class="year">{number}</div>
            <div>
              <h3>{title}</h3>
              <p>{role}</p>
              <div class="pill-row">
                <span class="pill">{status}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Release Gates -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Release Gates</div>
          <h2>发布前必须过的门</h2>
        </div>
      </div>
      <div class="grid">
        {[
          'Citation gate: merge aliases back into canonical BibTeX keys.',
          'Evidence gate: every benchmark number points to a paper review, raw paper, or official source.',
          'Figure gate: Survey Figure Atlas now appears on the site and key SVG assets are exported into paper-drafts/figures for the English manuscript.',
          'Consistency gate: unify terminology across README, site, paper, and survey LaTeX.',
          'Release gate: PDF compile now passes; next produce an arXiv source bundle after warning cleanup.'
        ].map((item) => (
          <article class="card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
