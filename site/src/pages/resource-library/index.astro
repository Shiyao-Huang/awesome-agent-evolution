---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { projects } from '@/data/projects';
import { surveyStats } from '@/data/survey';
import { evolveAgiIndex } from '@/data/evolveAgiIndex';
import { publicCorpusStats } from '@/data/publicCorpusStats';

const headlineStats = [
  { value: String(publicCorpusStats.rawGithubCaptures), label: 'raw GitHub captures', detail: '进入分类表的开源项目证据' },
  { value: '201', label: 'raw paper files', detail: '论文原始材料磁盘口径' },
  { value: String(publicCorpusStats.publicProjectReports), label: 'review-gated public report snapshots', detail: '可在站点阅读的项目证据快照' }
];

const countBoundaries = [
  [String(publicCorpusStats.rawGithubCaptures), 'raw / classified', 'GitHub 原始采集和分类表口径，说明收了多少、分到了哪里。'],
  [String(publicCorpusStats.analyzedProjectReports), 'analyzed model-card reports', '治理索引中的项目分析漏斗口径，不等于站点精选列表。'],
  [String(publicCorpusStats.publicProjectReports), 'review-gated public report snapshots', '静态站点可进入的项目证据快照；它们用于 source tracing，不等于逐页 public copy 已完成审查。'],
  [String(projects.length), 'curated project records', '当前 `/projects/` 页面使用的精选展示数组。'],
  [String(surveyStats.papers), 'survey-display papers', 'Survey 页面展示用论文口径；raw paper files 当前是 201。'],
  [String(surveyStats.repos), 'survey-display repos', 'Survey 页面把论文、项目和方法组织成结论时使用的展示口径。']
];

const pipeline = [
  {
    layer: 'Raw evidence',
    title: '原始材料',
    body: 'GitHub、论文、博客、社交和 ranked social 子集保留原貌，用来回答“证据从哪里来”。',
    href: '/github/'
  },
  {
    layer: 'Processed evidence',
    title: '加工分析',
    body: '分类、model card、paper review、Value LSH、证据队列和 Evolve-AGI Index 把材料转成可比较证据。',
    href: '/projects/'
  },
  {
    layer: 'Survey synthesis',
    title: 'Survey 综合',
    body: '五类进化回路、用户痛点、benchmark 和 AGI index 合成论文主线。',
    href: '/survey/'
  },
  {
    layer: 'Public results',
    title: '公开结果',
    body: '网站、PDF、报告、图谱和博客让读者从结论回到证据。',
    href: '/reports/'
  }
];

const readerPaths = [
  ['研究者', '先读 Survey 和论文，再查 project reports 与 paper reviews，确认每个结论是否可追溯。', '/survey/'],
  ['工程师', '从项目页进入 model card，优先看可变对象、反馈信号、评估器、回滚和可运行性。', '/projects/'],
  ['产品/投资读者', '用 Evolve-AGI Index 区分领域成熟度、热度、治理准备度和真实可用性。', '/evolve-agi-index/'],
  ['研究维护者', '用 Value LSH 找出最值得先深挖的候选和证据修复队列。', '/value-lsh/'],
  ['内容与研究读者', '从主题指南进入长尾问题：方法、benchmark、痛点、项目和趋势。', '/topics/']
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Self-Evolving AI Agents Resource Library',
  alternateName: 'AI 自进化资料库',
  description: 'Self Evolve 的公开资料库覆盖页：解释 self-evolving AI agents 的 raw corpus、processed analysis、survey synthesis、project reports 和 Evolve-AGI Index。',
  url: `${site.url}/resource-library/`,
  inLanguage: 'zh-CN',
  isPartOf: { '@id': `${site.url}/#website` },
  about: ['Self-Evolving AI Agents', 'AI Self Evolution', 'Evolve-AGI Index', 'Agent Evaluation', 'AI Agent Survey'],
  mainEntity: {
    '@type': 'DataCatalog',
    name: 'Self Evolve Evidence Catalog',
    dataset: [
      { '@type': 'Dataset', name: 'Raw GitHub captures', description: `${publicCorpusStats.rawGithubCaptures} raw GitHub captures and classified repository rows.` },
      { '@type': 'Dataset', name: 'Raw papers', description: '201 raw paper files used by the survey and paper pipeline.' },
      { '@type': 'Dataset', name: 'Review-gated public report snapshots', description: `${publicCorpusStats.publicProjectReports} public report snapshot files for model-card style source tracing and evidence review.` }
    ]
  }
};
---

<BaseLayout
  title="Self-Evolving AI Agents 资料库 — Survey 证据源、项目报告与 Evolve-AGI Index"
  description="Self Evolve 公开资料库覆盖页：解释 AI 自进化领域的 raw corpus、项目 model card、论文 Survey、公开报告、主题指南和 Evolve-AGI Index 之间的证据链。"
  pageKeywords={['Self-Evolving AI Agents Resource Library', 'AI 自进化资料库', '自进化智能体 Survey', 'AI Agent 项目报告', 'Evolve-AGI Index']}
  alternateZh="/resource-library/"
  alternateEn="/en/resource-library/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <style>
    .resource-library-page :is(h1, h2, h3, p, strong, td, a) {
      overflow-wrap: anywhere;
    }

    .resource-library-page {
      max-width: 100%;
      overflow-x: hidden;
    }

    @media (max-width: 700px) {
      .resource-library-page .hero h1 {
        font-size: 34px;
        line-height: 1.12;
        word-break: break-word;
      }

      .resource-library-page .hero-actions .button {
        flex: 1 1 100%;
        min-width: 100%;
        padding-inline: 12px;
      }

      .resource-library-page .hero-actions .text-link {
        width: 100%;
        min-height: auto;
      }

      .resource-library-page .hero-evidence li {
        grid-template-columns: 42px minmax(0, 1fr);
        gap: 10px;
      }
    }
  </style>

  <div class="resource-library-page">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Resource Library / 资料库覆盖</div>
        <h1>自进化 AI Agent 的证据库，不只是链接清单。</h1>
        <p class="lead">如果你想判断一个 agent 是否真的会自我改进，先不要只看 star、demo 或项目名。这个资料库把原始材料、项目分析、论文 survey、公开报告和 AGI 指数接成一条可以复查的证据链。</p>
        <div class="hero-actions">
          <a class="button primary" href="/survey/">进入 Survey</a>
          <a class="button" href="/projects/">查项目报告</a>
          <a class="button" href="/topics/">主题地图</a>
          <a class="button" href="/evolve-agi-index/">看 AGI Index</a>
          <a class="text-link" href="/github/">复查 GitHub 证据链</a>
        </div>
        <div class="metrics" aria-label="资料库核心覆盖指标">
          {headlineStats.map((item) => (
            <div class="metric">
              <strong>{item.value}</strong>
              <span>{item.label}<br />{item.detail}</span>
            </div>
          ))}
        </div>
      </div>
      <aside class="hero-evidence" aria-label="资料库判断规则">
        <div class="eyebrow">How to judge</div>
        <ol>
          <li><span>Object</span><strong>系统到底改了提示词、记忆、工具策略、工作流、代码、权重还是种群?</strong></li>
          <li><span>Signal</span><strong>反馈来自 benchmark、用户、环境、验证器，还是只来自模型自评?</strong></li>
          <li><span>Verifier</span><strong>谁判断改动变好，是否有隐藏测试、回归、成本和失败候选?</strong></li>
          <li><span>Retention</span><strong>改动是否被保留、迁移、回滚，并留下可审计 lineage?</strong></li>
        </ol>
        <p>资料库的价值不是“收了多少”，而是让这些问题能被快速回答。</p>
      </aside>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evidence pipeline</div>
          <h2>从原始素材到 Survey 结论</h2>
        </div>
      </div>
      <div class="grid">
        {pipeline.map((step) => (
          <article class="card">
            <div class="eyebrow">{step.layer}</div>
            <h3><a href={step.href}>{step.title}</a></h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Count boundaries</div>
          <h2>先读数字的边界，再读结论</h2>
        </div>
        <a class="text-link" href="https://github.com/Shiyao-Huang/awesome-agent-evolution/blob/main/analysis/resource-library-coverage-audit.md" target="_blank" rel="noopener">完整覆盖审计</a>
      </div>
      <div class="score-table-wrap">
        <table class="score-table">
          <thead>
            <tr><th>数字</th><th>口径</th><th>读者应该怎样理解</th></tr>
          </thead>
          <tbody>
            {countBoundaries.map(([count, scope, meaning]) => (
              <tr>
                <td><strong>{count}</strong></td>
                <td>{scope}</td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 16px; color: var(--muted); max-width: 820px;">这些数字不是互相矛盾，而是不同层级：raw 回答“收了什么”，processed 回答“分析了什么”，site/report 回答“读者能看什么”，survey 回答“结论如何组织”。</p>
    </div>
  </section>

  <section class="section" style="padding-top: 20px">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Reader map</div>
          <h2>按你的问题进入资料库</h2>
        </div>
      </div>
      <div class="grid">
        {readerPaths.map(([role, next, href]) => (
          <article class="card">
            <h3><a href={href}>{role}</a></h3>
            <p>{next}</p>
            <div class="pill-row">
              <a class="pill" href={href}>打开入口</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--surface-1);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Evolve-AGI Index</div>
          <h2>资料库最终服务于可审计的成熟度判断</h2>
        </div>
        <a class="text-link" href="/evolve-agi-index/">指数详情</a>
      </div>
      <div class="split">
        <article class="card">
          <div class="eyebrow">Current snapshot</div>
          <h3>{evolveAgiIndex.zhName}</h3>
          <p>{evolveAgiIndex.oneSentence}</p>
          <div class="metrics" style="grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 18px;">
            <div class="metric"><strong>{evolveAgiIndex.score}</strong><span>worksheet score</span></div>
            <div class="metric"><strong>{evolveAgiIndex.grade}</strong><span>editorial rubric band</span></div>
          </div>
        </article>
        <article class="card">
          <div class="eyebrow">Why it matters</div>
          <h3>不要把热度误读成能力成熟。</h3>
          <p>Evolve-AGI worksheet 把 benchmark、闭环强度、证据可信度、迁移验证、可运行性、领域动量和治理准备度放到同一张可解释表。它不是 AGI 终局评分，也不是领域成熟度结论，而是下一轮研究复核和证据修复的分诊工具。</p>
        </article>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
