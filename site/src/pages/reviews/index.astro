---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="同行评审 — Self Evolve"
  description="AI 自我进化研究的同行评审结果：方法对比、评审维度打分、跨项目评审雷达图。"
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">Peer Reviews</div>
      <h1 class="gradient-text">同行评审</h1>
      <p class="lead">跨项目评审维度对比与方法评估</p>
      <p style="color:var(--muted);margin-top:8px">覆盖 {projects.length} 个自进化项目的结构化评审</p>
    </div>
  </section>

  <!-- Review Dimensions -->
  <section class="section">
    <div class="container">
      <div class="review-grid">
        <div class="card">
          <div class="card-head">
            <div class="eyebrow">Review Framework</div>
            <h3>评审维度</h3>
          </div>
          <div class="review-dims">
            <div class="review-dim">
              <span class="review-dim-label">Novelty</span>
              <span class="review-dim-desc">方法创新性</span>
            </div>
            <div class="review-dim">
              <span class="review-dim-label">Soundness</span>
              <span class="review-dim-desc">技术严谨性</span>
            </div>
            <div class="review-dim">
              <span class="review-dim-label">Reproducibility</span>
              <span class="review-dim-desc">可复现性</span>
            </div>
            <div class="review-dim">
              <span class="review-dim-label">Evolution Impact</span>
              <span class="review-dim-desc">对自进化领域的贡献</span>
            </div>
            <div class="review-dim">
              <span class="review-dim-label">Scalability</span>
              <span class="review-dim-desc">可扩展性</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="eyebrow">Status</div>
            <h3>评审进度</h3>
          </div>
          <div class="review-status-list">
            <div class="review-status-row">
              <span class="review-status-label">待评审项目</span>
              <span class="review-status-count">{projects.length}</span>
            </div>
            <div class="review-status-row">
              <span class="review-status-label">已完成评审</span>
              <span class="review-status-count">0</span>
            </div>
            <div class="review-status-row">
              <span class="review-status-label">评审维度</span>
              <span class="review-status-count">5</span>
            </div>
          </div>
          <p style="color:var(--muted);font-size:13px;margin-top:12px">
            评审数据准备中。数据来源于 <code>research/peer-reviews/</code>，待研究团队完成后将自动填充。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table Placeholder -->
  <section class="section">
    <div class="container">
      <div class="card">
        <div class="card-head">
          <div class="eyebrow">Comparison Matrix</div>
          <h3>方法对比矩阵</h3>
        </div>
        <div class="review-placeholder">
          <p>评审结果对比表格将在数据就绪后自动生成。</p>
          <p style="font-size:13px;color:var(--muted);margin-top:8px">
            生成条件：<code>research/peer-reviews/*.md</code> 文件存在且包含结构化评审数据。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.review-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.review-dims{display:flex;flex-direction:column;gap:10px}
.review-dim{display:flex;align-items:center;gap:12px;padding:8px 12px;border-radius:8px;background:var(--surface-2)}
.review-dim-label{font-size:13px;font-weight:800;color:var(--accent);min-width:130px}
.review-dim-desc{font-size:13px;color:var(--muted)}
.review-status-list{display:flex;flex-direction:column;gap:8px}
.review-status-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}
.review-status-label{font-size:13px;font-weight:650;color:var(--fg)}
.review-status-count{font-size:14px;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums}
.review-placeholder{padding:32px;text-align:center;border:2px dashed var(--line);border-radius:12px;color:var(--muted)}
.review-placeholder p{font-size:14px}
@media(max-width:760px){.review-grid{grid-template-columns:1fr}}
</style>
