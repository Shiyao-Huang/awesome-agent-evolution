---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Review dimensions and placeholder scores
// Will be updated when reviewers complete their work
const reviewDimensions = ['Rigor', 'Novelty', 'Clarity', 'Evidence', 'Methodology'];
const reviewers = [
  { name: 'Reviewer A', focus: 'Rigor & Methodology', scores: [0, 0, 0, 0, 0], status: 'pending' },
  { name: 'Reviewer B', focus: 'Novelty & Contribution', scores: [0, 0, 0, 0, 0], status: 'pending' },
  { name: 'Reviewer C', focus: 'Clarity & Presentation', scores: [0, 0, 0, 0, 0], status: 'pending' }
];

const dimsPayload = JSON.stringify(reviewDimensions);
const reviewersPayload = JSON.stringify(reviewers);
---

<BaseLayout title="Self Evolve 同行评审 — 评审结果可视化" description="Self Evolve survey 同行评审结果：三位 reviewer 从严谨性、创新性、清晰度三个维度进行评审。">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Peer Review</div>
        <h1 class="gradient-text">同行评审可视化</h1>
        <p class="lead">三位 Reviewer 从学术严谨性、创新性、清晰度三个维度对 Self Evolve survey 进行评审</p>
      </div>

      <div class="metrics">
        <div class="metric"><strong>3</strong><span>Reviewers</span></div>
        <div class="metric"><strong>5</strong><span>评分维度</span></div>
        <div class="metric"><strong>{reviewers.filter(r => r.status === 'pending').length}</strong><span>评审中</span></div>
      </div>

      <!-- Review Radar -->
      <div class="review-chart-wrap">
        <div class="viz-section-head">
          <div class="eyebrow">Review Radar</div>
          <h2>评审评分雷达图</h2>
          <p>等待评审完成后自动更新</p>
        </div>
        <svg id="review-radar-svg" viewBox="0 0 500 500" role="img" aria-label="Review scores radar chart"></svg>
        <div class="review-legend" id="review-legend"></div>
        <div class="review-placeholder" id="review-placeholder">
          <p>评审报告尚在进行中。完成后此处将展示三维评分雷达图、对比表和关键发现摘要。</p>
          <p>数据源：<code>research/peer-reviews/</code></p>
        </div>
      </div>

      <!-- Review Comparison Table -->
      <div class="review-table-section">
        <div class="viz-section-head">
          <div class="eyebrow">Review Comparison</div>
          <h2>评审对比表</h2>
        </div>
        <div class="viz-rank-table-wrap">
          <table class="viz-rank-table">
            <thead>
              <tr>
                <th>Reviewer</th>
                <th>审查视角</th>
                <th>Rigor</th>
                <th>Novelty</th>
                <th>Clarity</th>
                <th>Evidence</th>
                <th>Methodology</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {reviewers.map(r => (
                <tr>
                  <td><strong>{r.name}</strong></td>
                  <td>{r.focus}</td>
                  <td>—</td><td>—</td><td>—</td><td>—</td><td>—</td>
                  <td><span class="rel-badge" style="background:#f39c12;color:#fff">Pending</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .review-chart-wrap {
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-media);
    background: var(--surface-card);
    padding: 24px;
    text-align: center;
  }
  .viz-section-head { margin-bottom: 16px; text-align: left; }
  .viz-section-head .eyebrow { color: var(--accent); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .viz-section-head h2 { font-family: var(--font-display); font-size: 24px; font-weight: 400; color: var(--fg); margin-top: 4px; }
  .viz-section-head p { color: var(--muted); font-size: 14px; margin-top: 4px; }
  #review-radar-svg { width: 100%; max-width: 400px; height: auto; display: none; }
  .review-placeholder { color: var(--muted); font-size: 14px; line-height: 1.6; margin-top: 20px; }
  .review-placeholder code { background: var(--surface-2); padding: 2px 6px; border-radius: 4px; font-size: 13px; }
  .review-table-section { margin-top: 40px; }
  .rel-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 750; }
  .review-legend { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 12px; }
</style>
