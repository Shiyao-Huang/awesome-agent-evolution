---
import { projectRankData, methodFamilyOptions } from './vizData';

type MethodFamilyOption = typeof methodFamilyOptions[number];

const projectsPayload = JSON.stringify(projectRankData);
const familiesPayload = JSON.stringify(methodFamilyOptions);
---

<div class="viz-rank">
  <div class="viz-sh">
    <div class="eyebrow">Project Rankings</div>
    <h2>项目排行榜</h2>
    <p>按统一方法族过滤，而不是按项目自带短描述过滤。</p>
  </div>
  <div class="viz-rank-controls">
    <input id="vr-s" type="search" placeholder="搜索项目、repo、机制..." aria-label="搜索项目" />
    <select id="vr-c" aria-label="方法族">
      <option value="">所有方法族</option>
      {methodFamilyOptions.map((family: MethodFamilyOption) => <option value={family.id}>{family.shortLabel} · {family.count}</option>)}
    </select>
    <select id="vr-so" aria-label="排序">
      <option value="sd">Stars 高→低</option>
      <option value="sa">Stars 低→高</option>
      <option value="na">名称 A→Z</option>
      <option value="ud">最近更新</option>
    </select>
  </div>
  <div class="viz-rco" id="vr-co" aria-live="polite"></div>
  <div class="viz-rtw">
    <table class="viz-rt">
      <thead>
        <tr>
          <th>#</th>
          <th>项目</th>
          <th>Stars</th>
          <th>方法族</th>
          <th>机制证据</th>
          <th>更新</th>
        </tr>
      </thead>
      <tbody id="vr-tb"></tbody>
    </table>
  </div>
</div>

<script is:inline define:vars={{ projectsPayload, familiesPayload }}>
const allProjects = JSON.parse(projectsPayload);
const families = JSON.parse(familiesPayload);
const familyMap = new Map(families.map(family => [family.id, family]));
const tableBody = document.getElementById('vr-tb');
const searchInput = document.getElementById('vr-s');
const familySelect = document.getElementById('vr-c');
const sortSelect = document.getElementById('vr-so');
const countOutput = document.getElementById('vr-co');

function esc(value) {
  return String(value ?? '').replace(/[&<>"']/g, char => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[char]);
}

function row(project, index) {
  const family = familyMap.get(project.methodFamilyId);
  const color = family?.color || 'var(--meta)';
  const tags = (project.tags || []).slice(0, 3).map(tag => `<span class="viz-rtg">${esc(tag)}</span>`).join('');
  return `<tr>
    <td class="viz-rn">${index + 1}</td>
    <td class="viz-rnm">
      <a href="${esc(project.url)}" target="_blank" rel="noopener">${esc(project.name)}</a>
      <span class="viz-rr">${esc(project.repo)}</span>
    </td>
    <td class="viz-rs">${Number(project.stars).toLocaleString()}</td>
    <td class="viz-rf">
      <span class="viz-family-dot" style="background:${esc(color)}"></span>
      <span>${esc(project.category)}</span>
      <small>${esc(project.rawCategory)}</small>
    </td>
    <td class="viz-rm">
      <span class="viz-pattern">${esc(project.pattern || '未标注')}</span>
      <span class="viz-tags-line">${tags}</span>
    </td>
    <td class="viz-rd">${project.lastPushed ? esc(project.lastPushed.slice(0, 10)) : '—'}</td>
  </tr>`;
}

function render() {
  if (!tableBody || !searchInput || !familySelect || !sortSelect || !countOutput) return;
  const query = (searchInput.value || '').trim().toLowerCase();
  const familyId = familySelect.value;
  const sortKey = sortSelect.value;

  let filtered = allProjects.filter(project => {
    const searchable = [
      project.name,
      project.repo,
      project.pattern,
      project.rawCategory,
      project.methodFamily,
      ...(project.tags || [])
    ].join(' ').toLowerCase();
    const matchesQuery = !query || searchable.includes(query);
    const matchesFamily = !familyId || project.methodFamilyId === familyId;
    return matchesQuery && matchesFamily;
  });

  if (sortKey === 'sd') filtered.sort((a, b) => b.stars - a.stars);
  if (sortKey === 'sa') filtered.sort((a, b) => a.stars - b.stars);
  if (sortKey === 'na') filtered.sort((a, b) => a.name.localeCompare(b.name));
  if (sortKey === 'ud') filtered.sort((a, b) => (b.lastPushed || '').localeCompare(a.lastPushed || ''));

  countOutput.textContent = `${filtered.length} / ${allProjects.length} 个项目`;
  tableBody.innerHTML = filtered.slice(0, 80).map(row).join('');
}

if (tableBody && searchInput && familySelect && sortSelect) {
  render();
  searchInput.addEventListener('input', render);
  familySelect.addEventListener('change', render);
  sortSelect.addEventListener('change', render);
}
</script>

<style is:global>
.viz-rank{max-width:100%;overflow-x:hidden}
.viz-rank-controls{display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.viz-rank-controls input,.viz-rank-controls select{border:1px solid var(--line);border-radius:var(--radius-cta);background:var(--surface-1);color:var(--fg);padding:8px 12px;font:600 13px/1.2 var(--font-body)}
.viz-rank-controls input{flex:1;min-width:220px}
.viz-rank-controls select{min-width:180px}
.viz-rank-controls input:focus,.viz-rank-controls select:focus{outline:none;box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--accent)}
.viz-rco{color:var(--muted);font-size:12px;font-weight:750;margin-bottom:10px}
.viz-rtw{width:100%;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;contain:inline-size}
.viz-rt{width:100%;border-collapse:collapse;font-size:13px}
.viz-rt th{text-align:left;padding:9px 10px;border-bottom:2px solid var(--line);color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}
.viz-rt td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
.viz-rt tr:hover td{background:var(--surface-2)}
.viz-rn{font-weight:800;color:var(--meta);width:36px}
.viz-rnm a{font-weight:750;color:var(--fg);text-decoration:none}
.viz-rnm a:hover{color:var(--accent)}
.viz-rr{display:block;font-size:11px;color:var(--meta);margin-top:2px}
.viz-rs{font-weight:850;font-variant-numeric:tabular-nums;white-space:nowrap}
.viz-rf{min-width:150px}
.viz-rf span:not(.viz-family-dot){display:inline;font-weight:750;color:var(--fg)}
.viz-rf small{display:block;margin-top:3px;color:var(--meta);font-size:11px;line-height:1.3}
.viz-family-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:1px}
.viz-rm{max-width:280px}
.viz-pattern{display:block;font-size:12px;font-weight:650;color:var(--fg);line-height:1.35}
.viz-tags-line{display:block;margin-top:4px}
.viz-rtg{display:inline-block;padding:2px 6px;margin:1px 2px 1px 0;border:1px solid var(--line);border-radius:4px;font-size:11px;font-weight:650;color:var(--muted);white-space:nowrap}
.viz-rd{white-space:nowrap;color:var(--muted);font-size:12px}
@media(max-width:760px){.viz-rank-controls{flex-direction:column}.viz-rank-controls input,.viz-rank-controls select{width:100%;min-width:0}.viz-rt{font-size:12px}.viz-rm{min-width:220px}}
</style>
