---
import { projects } from '@/data/projects';
const rp=[...projects].sort((a,b)=>Number(b.stars||0)-Number(a.stars||0)).map(p=>({name:p.name,repo:p.repo,url:p.url,stars:Number(p.stars||0),category:p.category,pattern:p.pattern,tags:p.tags,lastPushed:p.lastPushed}));
const pp=JSON.stringify(rp);const cats=[...new Set(rp.map(p=>p.category))];
---
<div class="viz-rank"><div class="viz-sh"><div class="eyebrow">Project Rankings</div><h2>项目排行榜</h2><p>可排序、可过滤的项目对比表</p></div>
<div class="viz-rc"><input id="vr-s" type="search" placeholder="搜索项目..." aria-label="搜索"/><select id="vr-c" aria-label="类别"><option value="">所有类别</option>{cats.map(c=><option value={c}>{c}</option>)}</select><select id="vr-so" aria-label="排序"><option value="sd">Stars 高→低</option><option value="sa">Stars 低→高</option><option value="na">名称 A→Z</option><option value="ud">最近更新</option></select></div>
<div class="viz-rco" id="vr-co" aria-live="polite"></div>
<div class="viz-rtw"><table class="viz-rt"><thead><tr><th>#</th><th>项目</th><th>Stars</th><th>类别</th><th>进化机制</th><th>更新</th></tr></thead><tbody id="vr-tb"></tbody></table></div></div>
<script is:inline define:vars={{ pp }}>
const ap=JSON.parse(pp),tb=document.getElementById('vr-tb'),si=document.getElementById('vr-s'),cs=document.getElementById('vr-c'),so=document.getElementById('vr-so'),co=document.getElementById('vr-co');
function ren(){const q=(si.value||'').trim().toLowerCase(),cat=cs.value,sk=so.value;
let f=ap.filter(p=>{const mq=!q||p.name.toLowerCase().includes(q)||p.repo.toLowerCase().includes(q)||p.pattern.toLowerCase().includes(q)||(p.tags||[]).some(t=>t.toLowerCase().includes(q));const mc=!cat||p.category===cat;return mq&&mc});
if(sk==='sd')f.sort((a,b)=>b.stars-a.stars);else if(sk==='sa')f.sort((a,b)=>a.stars-b.stars);else if(sk==='na')f.sort((a,b)=>a.name.localeCompare(b.name));else if(sk==='ud')f.sort((a,b)=>(b.lastPushed||'').localeCompare(a.lastPushed||''));
co.textContent=f.length+' / '+ap.length+' 个项目';
tb.innerHTML=f.slice(0,50).map((p,i)=>{const tg=(p.tags||[]).slice(0,3).map(t=>'<span class="viz-rtg">'+t+'</span>').join('');
return '<tr><td class="viz-rn">'+(i+1)+'</td><td class="viz-rnm"><a href="'+p.url+'" target="_blank" rel="noopener">'+p.name+'</a><span class="viz-rr">'+p.repo+'</span></td><td class="viz-rs">'+p.stars.toLocaleString()+'</td><td>'+p.category+'</td><td class="viz-rm">'+tg+'</td><td class="viz-rd">'+(p.lastPushed?p.lastPushed.slice(0,10):'\u2014')+'</td></tr>'}).join('')}
ren();si.addEventListener('input',ren);cs.addEventListener('change',ren);so.addEventListener('change',ren);
</script>
<style>
.viz-rc{display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap}.viz-rc input,.viz-rc select{border:1px solid var(--line);border-radius:var(--radius-cta);background:var(--surface-1);color:var(--fg);padding:8px 12px;font:600 13px/1.2 var(--font-body)}.viz-rc input{flex:1;min-width:180px}.viz-rc input:focus,.viz-rc select:focus{outline:none;box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--accent)}
.viz-rco{color:var(--muted);font-size:12px;font-weight:750;margin-bottom:10px}.viz-rtw{overflow-x:auto;-webkit-overflow-scrolling:touch}.viz-rt{width:100%;border-collapse:collapse;font-size:13px}
.viz-rt th{text-align:left;padding:8px 10px;border-bottom:2px solid var(--line);color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}
.viz-rt td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}.viz-rt tr:hover td{background:var(--surface-2)}
.viz-rn{font-weight:800;color:var(--meta);width:36px}.viz-rnm a{font-weight:700;color:var(--fg);text-decoration:none}.viz-rnm a:hover{color:var(--accent)}.viz-rr{display:block;font-size:11px;color:var(--meta);margin-top:2px}
.viz-rs{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}.viz-rm{max-width:220px}.viz-rtg{display:inline-block;padding:2px 6px;margin:1px 2px;border:1px solid var(--line);border-radius:4px;font-size:11px;font-weight:650;color:var(--muted);white-space:nowrap}.viz-rd{white-space:nowrap;color:var(--muted);font-size:12px}
@media(max-width:760px){.viz-rc{flex-direction:column}.viz-rt{font-size:12px}}
</style>
