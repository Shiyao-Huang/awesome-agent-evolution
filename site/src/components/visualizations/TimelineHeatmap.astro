---
import { timelineData, timeSliceData } from './visualizationData';

const timelinePayload = JSON.stringify(timelineData);
const timeSlicePayload = JSON.stringify(timeSliceData);
---

<div class="viz-timeline" id="viz-timeline">
  <div class="viz-timeline-header">
    <h3>Timeline Heatmap</h3>
    <p>Repository creation activity over time</p>
  </div>
  <div class="viz-timeline-tabs">
    <button class="viz-tab active" data-tab="created" id="tab-created">By Created Date</button>
    <button class="viz-tab" data-tab="activity" id="tab-activity">By Activity</button>
  </div>
  <div class="viz-timeline-chart" id="viz-timeline-chart"></div>
</div>

<script is:inline define:vars={{ timelinePayload, timeSlicePayload }}>
  const createdData = JSON.parse(timelinePayload);
  const activityData = JSON.parse(timeSlicePayload);
  const container = document.getElementById('viz-timeline-chart');
  const tabCreated = document.getElementById('tab-created');
  const tabActivity = document.getElementById('tab-activity');
  if (!container) throw new Error('Timeline container not found');

  function renderTimeline(data) {
    container.innerHTML = '';
    if (data.length === 0) {
      container.innerHTML = '<p style="color:var(--muted);font-size:14px;padding:20px">No time data available</p>';
      return;
    }

    const maxCount = Math.max(...data.map(d => d.count));
    const grid = document.createElement('div');
    grid.className = 'viz-heatmap-grid';

    data.forEach(entry => {
      const intensity = maxCount > 0 ? entry.count / maxCount : 0;
      const cell = document.createElement('div');
      cell.className = 'viz-heatmap-cell';
      cell.setAttribute('title', `${entry.key}: ${entry.count} repos`);
      cell.setAttribute('aria-label', `${entry.key}: ${entry.count} repositories`);

      const bar = document.createElement('div');
      bar.className = 'viz-heatmap-bar';
      bar.style.height = '0%';
      bar.style.maxHeight = `${Math.max(8, intensity * 100)}%`;
      const opacity = 0.15 + intensity * 0.85;
      bar.style.setProperty('--bar-opacity', String(opacity));

      const label = document.createElement('span');
      label.className = 'viz-heatmap-label';
      label.textContent = entry.key.slice(2); // Remove century prefix

      const countLabel = document.createElement('span');
      countLabel.className = 'viz-heatmap-count';
      countLabel.textContent = entry.count;

      cell.appendChild(bar);
      cell.appendChild(countLabel);
      cell.appendChild(label);
      grid.appendChild(cell);
    });

    container.appendChild(grid);

    // Animate bars
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const bars = container.querySelectorAll('.viz-heatmap-bar');
          bars.forEach(bar => {
            bar.style.height = bar.style.maxHeight;
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    observer.observe(container);
  }

  renderTimeline(createdData);

  tabCreated.addEventListener('click', () => {
    tabCreated.classList.add('active');
    tabActivity.classList.remove('active');
    renderTimeline(createdData);
  });

  tabActivity.addEventListener('click', () => {
    tabActivity.classList.add('active');
    tabCreated.classList.remove('active');
    renderTimeline(activityData);
  });
</script>

<style>
  .viz-timeline {
    border: 1px solid var(--line);
    border-radius: var(--radius-media);
    background: var(--surface-card);
    padding: 24px;
  }
  .viz-timeline-header {
    margin-bottom: 16px;
  }
  .viz-timeline-header h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    color: var(--fg);
    line-height: 1.1;
  }
  .viz-timeline-header p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }
  .viz-timeline-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .viz-tab {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-cta);
    background: var(--surface-1);
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition);
  }
  .viz-tab.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .viz-tab:hover:not(.active) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .viz-heatmap-grid {
    display: flex;
    gap: 4px;
    align-items: flex-end;
    height: 200px;
    padding: 8px 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .viz-heatmap-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 36px;
    flex: 1;
    height: 100%;
    position: relative;
  }
  .viz-heatmap-bar {
    width: 100%;
    flex: 1;
    border-radius: 4px 4px 0 0;
    background: var(--accent);
    opacity: var(--bar-opacity, 0.6);
    transition: height 0.8s cubic-bezier(.4, 0, .2, 1);
    align-self: flex-end;
    position: relative;
  }
  .viz-heatmap-count {
    position: absolute;
    top: -18px;
    font-size: 10px;
    font-weight: 800;
    color: var(--muted);
    white-space: nowrap;
  }
  .viz-heatmap-bar .viz-heatmap-count {
    position: static;
  }
  .viz-heatmap-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--meta);
    white-space: nowrap;
    flex-shrink: 0;
  }
  @media (max-width: 760px) {
    .viz-heatmap-cell {
      min-width: 28px;
    }
    .viz-heatmap-label {
      font-size: 8px;
    }
  }
</style>
