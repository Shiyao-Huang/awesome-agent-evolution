---
import { projects } from '@/data/projects';
const cg = new Map<string, {count:number;tags:Map<string,number>}>();
for(const p of projects){const e=cg.get(p.category);if(e){e.count++;for(const t of p.tags)e.tags.set(t,(e.tags.get(t)||0)+1)}else{const m=new Map<string,number>();for(const t of p.tags)m.set(t,1);cg.set(p.category,{count:1,tags:m})}}
const tree=[...cg.entries()].sort((a,b)=>b[1].count-a[1].count).map(([c,d])=>({id:'c:'+c,label:c,count:d.count,children:[...d.tags.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([t,n])=>({id:'t:'+t,label:t,count:n}))}));
const tp=JSON.stringify(tree);
---
<div class="viz-tax"><div class="viz-sh"><div class="eyebrow">Method Taxonomy</div><h2>方法分类体系</h2><p>点击展开方法族，探索进化机制</p></div><div class="viz-tt" id="viz-tt"></div></div>
<script is:inline define:vars={{ tp }}>
const tree=JSON.parse(tp),c=document.getElementById('viz-tt');if(!c)return;const cl=['#FF5B00','#007AFF','#2E6F4E','#A56117','#B83224','#8B5CF6','#0891B2','#BE185D'];
function rn(n,dp,ci){const col=dp===0?cl[ci%cl.length]:'var(--muted)',el=document.createElement('div');el.className='viz-tn depth-'+dp;const h=document.createElement('div');h.className='viz-th';if(dp===0)h.style.cursor='pointer';
const b=document.createElement('span');b.className='viz-tb';b.style.background=dp===0?col:'var(--surface-3)';b.style.color=dp===0?'#fff':'var(--fg)';b.textContent=n.count;
const l=document.createElement('span');l.className='viz-tl';l.textContent=n.label;h.appendChild(b);h.appendChild(l);
if(n.children&&n.children.length>0){const ch=document.createElement('span');ch.className='viz-tc';ch.textContent='\u25B8';ch.style.color=col;h.appendChild(ch);
const cb=document.createElement('div');cb.className='viz-tch collapsed';n.children.forEach(x=>cb.appendChild(rn(x,dp+1,ci)));el.appendChild(h);el.appendChild(cb);
h.addEventListener('click',()=>{const s=cb.classList.contains('collapsed');cb.classList.toggle('collapsed',!s);cb.classList.toggle('expanded',s);ch.textContent=s?'\u25BE':'\u25B8'})}else el.appendChild(h);return el}
tree.forEach((n,i)=>{const g=document.createElement('div');g.appendChild(rn(n,0,i));c.appendChild(g)});
</script>
<style>
.viz-tax{margin-top:32px}.viz-tt{display:flex;flex-direction:column;gap:6px}.viz-th{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:var(--radius);transition:background var(--transition);user-select:none}.viz-th:hover{background:var(--surface-2)}
.viz-tb{display:inline-flex;align-items:center;justify-content:center;min-width:32px;height:28px;padding:0 8px;border-radius:6px;font-size:12px;font-weight:800;flex-shrink:0}.viz-tl{font-size:14px;font-weight:650;color:var(--fg);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.depth-1 .viz-tl{font-weight:550;font-size:13px}.viz-tc{font-size:14px;font-weight:800;flex-shrink:0}.viz-tch{display:grid;gap:2px;padding-left:24px;border-left:2px solid var(--line);margin-left:16px}.viz-tch.collapsed{display:none}.viz-tch.expanded{display:grid}
</style>
