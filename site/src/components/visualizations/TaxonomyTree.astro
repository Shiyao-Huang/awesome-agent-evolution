---
import { taxonomyTree } from './vizData';

const treePayload = JSON.stringify(taxonomyTree);
---

<div class="viz-tax">
  <div class="viz-sh">
    <div class="eyebrow">Method Taxonomy</div>
    <h2>统一方法族</h2>
    <p>把项目短描述归并成可比较的方法族，避免一项目一类别。</p>
  </div>
  <div class="viz-tt" id="viz-tt"></div>
</div>

<script is:inline define:vars={{ treePayload }}>
const tree = JSON.parse(treePayload);
const container = document.getElementById('viz-tt');
const colors = ['#FF5B00', '#2E6F4E', '#007AFF', '#8B5CF6', '#0891B2', '#A56117', '#BE185D', '#586069'];

function nodeEl(node, depth, color) {
  const wrapper = document.createElement('div');
  wrapper.className = 'viz-tn depth-' + depth;

  const header = document.createElement('button');
  header.type = 'button';
  header.className = 'viz-th';
  header.style.setProperty('--node-color', color);
  header.setAttribute('aria-expanded', depth === 0 ? 'false' : 'true');

  const count = document.createElement('span');
  count.className = 'viz-tb';
  count.textContent = String(node.count);

  const copy = document.createElement('span');
  copy.className = 'viz-tcopy';
  const label = document.createElement('span');
  label.className = 'viz-tl';
  label.textContent = node.label;
  const description = document.createElement('span');
  description.className = 'viz-td';
  description.textContent = node.description || '';
  copy.appendChild(label);
  copy.appendChild(description);

  header.appendChild(count);
  header.appendChild(copy);

  if (node.children && node.children.length > 0) {
    const chevron = document.createElement('span');
    chevron.className = 'viz-tc';
    chevron.textContent = '›';
    header.appendChild(chevron);

    const children = document.createElement('div');
    children.className = 'viz-tch collapsed';
    node.children.forEach(child => children.appendChild(nodeEl(child, depth + 1, color)));
    wrapper.appendChild(header);
    wrapper.appendChild(children);

    header.addEventListener('click', () => {
      const isOpen = !children.classList.contains('collapsed');
      children.classList.toggle('collapsed', isOpen);
      header.setAttribute('aria-expanded', String(!isOpen));
      chevron.textContent = isOpen ? '›' : '⌄';
    });
  } else {
    header.classList.add('leaf');
    wrapper.appendChild(header);
  }

  return wrapper;
}

if (container) {
  tree.forEach((node, index) => {
    container.appendChild(nodeEl(node, 0, colors[index % colors.length]));
  });
}
</script>

<style is:global>
.viz-tax{margin-top:32px}
.viz-tt{display:grid;gap:8px}
.viz-th{width:100%;display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--fg);text-align:left;transition:background var(--transition),border-color var(--transition);cursor:pointer}
.viz-th:hover,.viz-th:focus-visible{background:var(--surface-2);border-color:var(--line);outline:none}
.viz-tb{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:30px;padding:0 8px;border-radius:6px;background:var(--node-color);color:#fff;font-size:12px;font-weight:800;flex-shrink:0;font-variant-numeric:tabular-nums}
.depth-1 .viz-tb{background:var(--surface-3);color:var(--fg);border:1px solid var(--line)}
.viz-tcopy{display:grid;gap:2px;min-width:0;flex:1}
.viz-tl{font-size:14px;font-weight:750;color:var(--fg);line-height:1.25}
.viz-td{font-size:12px;font-weight:550;color:var(--muted);line-height:1.35}
.depth-1 .viz-tl{font-size:13px;font-weight:700}
.depth-1 .viz-td{font-size:11px}
.viz-tc{color:var(--node-color);font-size:20px;font-weight:800;line-height:1;flex-shrink:0}
.viz-tch{display:grid;gap:3px;margin-left:16px;padding-left:22px;border-left:2px solid color-mix(in srgb,var(--node-color) 45%,var(--line))}
.viz-tch.collapsed{display:none}
.viz-th.leaf{cursor:default}
@media(max-width:760px){.viz-th{padding:9px 8px}.viz-td{display:none}.viz-tch{margin-left:10px;padding-left:14px}}
</style>
