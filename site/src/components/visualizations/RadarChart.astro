---
import { radarAxes, radarSeries } from './vizData';

const axesPayload = JSON.stringify(radarAxes);
const seriesPayload = JSON.stringify(radarSeries);
---

<div class="viz-radar">
  <div class="viz-sh">
    <div class="eyebrow">Evidence Radar</div>
    <h2>主题证据雷达</h2>
    <p>用主题占比对比 raw 语料和 model card，避免 raw 绝对数量把分析报告压成一个点。</p>
  </div>
  <div class="viz-radar-body">
    <svg id="viz-rs" viewBox="0 0 560 520" role="img" aria-label="Self-evolution corpus evidence radar"></svg>
    <div class="viz-rl" id="viz-rl"></div>
  </div>
</div>

<script is:inline define:vars={{ axesPayload, seriesPayload }}>
const axes = JSON.parse(axesPayload);
const series = JSON.parse(seriesPayload);
const svg = document.getElementById('viz-rs');
const legend = document.getElementById('viz-rl');
const palette = ['#FF5B00', '#007AFF'];

function svgEl(name, attrs) {
  const el = document.createElementNS('http://www.w3.org/2000/svg', name);
  Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value)));
  return el;
}

function wrapLabel(label) {
  if (label.length <= 6) return [label];
  return [label.slice(0, 6), label.slice(6, 12)];
}

if (svg && legend && axes.length > 2) {
  const cx = 280;
  const cy = 250;
  const maxRadius = 170;
  const step = (Math.PI * 2) / axes.length;
  const maxValue = Math.max(1, ...series.flatMap(item => item.values));

  function point(index, value, radiusScale = 1) {
    const angle = step * index - Math.PI / 2;
    const radius = (value / maxValue) * maxRadius * radiusScale;
    return {
      x: cx + Math.cos(angle) * radius,
      y: cy + Math.sin(angle) * radius
    };
  }

  [0.2, 0.4, 0.6, 0.8, 1].forEach(level => {
    const points = axes.map((_, index) => point(index, maxValue * level)).map(p => `${p.x},${p.y}`).join(' ');
    svg.appendChild(svgEl('polygon', {
      points,
      fill: 'none',
      stroke: 'rgba(26,26,26,0.1)',
      'stroke-width': 1
    }));
  });

  axes.forEach((axis, index) => {
    const edge = point(index, maxValue);
    svg.appendChild(svgEl('line', {
      x1: cx,
      y1: cy,
      x2: edge.x,
      y2: edge.y,
      stroke: 'rgba(26,26,26,0.14)',
      'stroke-width': 1
    }));

    const labelPoint = point(index, maxValue, 1.2);
    const text = svgEl('text', {
      x: labelPoint.x,
      y: labelPoint.y - 7,
      'text-anchor': 'middle',
      'dominant-baseline': 'middle',
      fill: 'var(--muted)',
      'font-size': 11,
      'font-weight': 750
    });
    wrapLabel(axis.label).forEach((part, lineIndex) => {
      const tspan = svgEl('tspan', { x: labelPoint.x, dy: lineIndex === 0 ? 0 : 13 });
      tspan.textContent = part;
      text.appendChild(tspan);
    });
    svg.appendChild(text);
  });

  series.forEach((item, seriesIndex) => {
    const color = palette[seriesIndex % palette.length];
    const points = item.values.map((value, index) => point(index, value)).map(p => `${p.x},${p.y}`).join(' ');
    svg.appendChild(svgEl('polygon', {
      points,
      fill: `${color}24`,
      stroke: color,
      'stroke-width': 2.5
    }));

    item.values.forEach((value, index) => {
      const dot = point(index, value);
      svg.appendChild(svgEl('circle', {
        cx: dot.x,
        cy: dot.y,
        r: 3.5,
        fill: color
      }));
    });

    const row = document.createElement('div');
    row.className = 'viz-rli';
    const swatch = document.createElement('span');
    swatch.className = 'viz-rd';
    swatch.style.background = color;
    const label = document.createElement('span');
    label.textContent = `${item.name} · n=${item.total.toLocaleString()}`;
    row.appendChild(swatch);
    row.appendChild(label);
    legend.appendChild(row);
  });

  const axisList = document.createElement('div');
  axisList.className = 'viz-rmetrics';
  axes.slice(0, 6).forEach(axis => {
    const item = document.createElement('div');
    item.className = 'viz-rmetric';
    const rawShare = series[0]?.values?.[axes.indexOf(axis)] ?? 0;
    const modelShare = series[1]?.values?.[axes.indexOf(axis)] ?? 0;
    item.innerHTML = `<strong>${rawShare}% / ${modelShare}%</strong><span>${axis.label} · raw/model</span>`;
    axisList.appendChild(item);
  });
  legend.appendChild(axisList);
}
</script>

<style is:global>
.viz-radar{margin-top:32px}
.viz-radar-body{display:flex;gap:24px;align-items:center;justify-content:center;flex-wrap:wrap}
#viz-rs{width:100%;max-width:520px;height:auto}
.viz-rl{display:grid;gap:10px;min-width:210px}
.viz-rli{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--fg)}
.viz-rd{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.viz-rmetrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:4px}
.viz-rmetric{padding:8px;border:1px solid var(--line);border-radius:8px;background:var(--surface-1)}
.viz-rmetric strong{display:block;font-size:15px;font-weight:850;color:var(--fg);font-variant-numeric:tabular-nums}
.viz-rmetric span{display:block;margin-top:2px;font-size:11px;font-weight:650;color:var(--muted)}
@media(max-width:760px){.viz-radar-body{flex-direction:column}.viz-rl{width:100%;min-width:0}.viz-rmetrics{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:520px){.viz-rmetrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
