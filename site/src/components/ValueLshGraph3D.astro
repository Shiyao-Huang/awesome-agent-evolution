            }
          }
          if (child instanceof THREE.Mesh && (child.name === 'transitionSourceHalo' || child.name === 'transitionTargetHalo')) {
            child.lookAt(camera.position);
            child.scale.setScalar(1 + (1 - transitionFade) * 0.22);
          }
        });
        if (transitionFade === 0) {
          transitionGroup.clear();
          transitionCurve = null;
          transitionGuidePoint = null;
          if (regionArcGuide instanceof HTMLElement) regionArcGuide.dataset.active = 'false';
        }
      }
      updateRegionMarkers();
      updateArcGuidePosition();
      renderer?.render(scene, camera);
      requestAnimationFrame(tick);
    };
    tick();
  });
