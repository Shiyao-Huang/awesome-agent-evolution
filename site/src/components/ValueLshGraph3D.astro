---
import graphSnapshotJson from '../../../analysis/value-lsh-graph-3d.json';
import analysisSnapshotJson from '../data/analysis.json';
import { valueLshRegions } from '@/data/valueLshRegions';

type ValueClass = 'high-value-candidate' | 'needs-review' | 'low-signal-or-risk';
type AnalysisProject = {
  normalized_repo?: string | null;
  public_report?: string | null;
  raw_file?: string | null;
  localPath?: string | null;
  url?: string | null;
};

interface GraphNode {
  id: string;
  type: string;
  title: string;
  url?: string | null;
  source_path?: string | null;
  value_score: number;
  confidence: number;
  value_class: ValueClass;
  embedding_cluster: string;
  lsh_cluster_hint?: string | null;
  top_lsh_neighbors?: LshNeighbor[];
  x: number;
  y: number;
  z: number;
}

interface LshNeighbor {
  id: string;
  title: string;
  type: string;
  value_score: number;
  value_class: ValueClass;
  shared_bucket_count: number;
  shared_features: string[];
  relation_weight: number;
  url?: string | null;
  rawUrl?: string | null;
  reportUrl?: string | null;
}

interface GraphSnapshot {
  generated_at: string;
  method: {
    provider: string;
    projection: string;
    k: number;
  };
  summary: {
    nodes: number;
    embedding_clusters: number;
    value_classes: Record<ValueClass, number>;
  };
  nodes: GraphNode[];
}

interface AnalysisSnapshot {
  analyzed_projects?: AnalysisProject[];
}

interface Props {
  variant?: 'compact' | 'full';
  maxNodes?: number;
  height?: number;
}

const graphSnapshot = graphSnapshotJson as GraphSnapshot;
const analysisSnapshot = analysisSnapshotJson as AnalysisSnapshot;
const projectRepoBase = 'https://github.com/Shiyao-Huang/awesome-agent-evolution/blob/main/';
const toPublicReportUrl = (value?: string | null) => value ? `/${value.replace(/^site\/public\//, '')}` : null;
const toRawCaptureUrl = (value?: string | null) => value ? `${projectRepoBase}${value}` : null;
const projectLinkMap = new Map<string, { reportUrl?: string | null; rawUrl?: string | null; sourceUrl?: string | null }>();

for (const project of analysisSnapshot.analyzed_projects ?? []) {
  const normalizedRepo = project.normalized_repo?.trim().toLowerCase();
  if (!normalizedRepo) continue;
  projectLinkMap.set(normalizedRepo, {
    reportUrl: toPublicReportUrl(project.public_report),
    rawUrl: toRawCaptureUrl(project.raw_file ?? project.localPath),
    sourceUrl: project.url ?? null,
  });
}

const { variant = 'full', maxNodes = variant === 'compact' ? 760 : graphSnapshot.summary.nodes, height = variant === 'compact' ? 360 : 560 } = Astro.props;
const allNodes = graphSnapshot.nodes ?? [];
const sampleStep = Math.max(1, Math.ceil(allNodes.length / maxNodes));
const sceneNodes = allNodes
  .filter((_, index) => index % sampleStep === 0)
  .slice(0, maxNodes)
  .map((node) => {
    const normalizedRepo = node.id.replace(/^github:/, '').trim().toLowerCase();
    const projectLinks = projectLinkMap.get(normalizedRepo);
    return {
    id: node.id,
    type: node.type,
    title: node.title,
    url: node.url,
    sourcePath: node.source_path,
    rawUrl: projectLinks?.rawUrl ?? toRawCaptureUrl(node.source_path),
    reportUrl: projectLinks?.reportUrl ?? null,
    primaryUrl: projectLinks?.reportUrl ?? node.url ?? toRawCaptureUrl(node.source_path),
    score: node.value_score,
    confidence: node.confidence,
    valueClass: node.value_class,
    embeddingCluster: node.embedding_cluster,
    lshCluster: node.lsh_cluster_hint,
    neighbors: (node.top_lsh_neighbors || []).map((neighbor) => {
      const neighborRepo = neighbor.id.replace(/^github:/, '').trim().toLowerCase();
      const neighborLinks = projectLinkMap.get(neighborRepo);
      return {
        ...neighbor,
        url: neighborLinks?.sourceUrl ?? null,
        rawUrl: neighborLinks?.rawUrl ?? null,
        reportUrl: neighborLinks?.reportUrl ?? null,
      };
    }),
    x: Number(node.x.toFixed(6)),
    y: Number(node.y.toFixed(6)),
    z: Number(node.z.toFixed(6)),
  };
  });

const classLabels: Record<ValueClass, string> = {
  'high-value-candidate': 'High value',
  'needs-review': 'Needs review',
  'low-signal-or-risk': 'Repair / risk',
};

const classColors: Record<ValueClass, string> = {
  'high-value-candidate': '#2E6F4E',
  'needs-review': '#007AFF',
  'low-signal-or-risk': '#B83224',
};

const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
const fallbackNodes = [...sceneNodes]
  .sort((a, b) => a.z - b.z)
  .slice(0, variant === 'compact' ? 220 : 420)
  .map((node) => ({
    ...node,
    sx: clamp(500 + node.x * 390 + node.z * 72, 36, 964),
    sy: clamp(270 - node.y * 190 + node.z * 34, 30, 510),
    r: clamp(2.2 + (node.score - 50) / 14 + node.z * 1.1, 1.8, 7.4),
    opacity: clamp(0.38 + (node.z + 1) * 0.24, 0.28, 0.92),
  }));

const fallbackRegionOverlays = valueLshRegions.map((region, index) => {
  const centerX = clamp(500 + region.centroid.x * 390 + region.centroid.z * 72, 92, 908);
  const centerY = clamp(270 - region.centroid.y * 190 + region.centroid.z * 34, 74, 472);
  const boxWidth = clamp(Math.abs(region.bounds.max.x - region.bounds.min.x) * 410 + 110, 110, 360);
  const boxHeight = clamp(Math.abs(region.bounds.max.y - region.bounds.min.y) * 230 + 84, 84, 260);
  return {
    ...region,
    rank: index + 1,
    centerX,
    centerY,
    boxWidth,
    boxHeight,
    boxX: centerX - boxWidth / 2,
    boxY: centerY - boxHeight / 2,
    labelX: clamp(centerX + boxWidth / 2 + 18, 120, 908),
    labelY: clamp(centerY - boxHeight / 2 - 16, 34, 504),
  };
});

const scenePayload = {
  variant,
  nodes: sceneNodes,
  colors: classColors,
  regions: valueLshRegions.map((region) => ({
    kind: region.kind,
    title: region.title,
    shortLabel: region.shortLabel,
    arrow: region.arrow,
    color: region.color,
    clusterId: region.clusterId,
    rankingLabel: region.rankingLabel,
    metricKey: region.metricKey,
    metricValue: region.metricValue,
    meaning: region.meaning,
    summary: region.summary,
    nodeCount: region.nodeCount,
    centroid: region.centroid,
    bounds: region.bounds,
    representativeId: region.representatives.find((rep) => sceneNodes.some((node) => node.id === rep.id))?.id ?? region.representatives[0]?.id ?? null,
    topFacets: region.topFacets,
  })),
};
const defaultNode = sceneNodes.find((node) => node.neighbors.length > 0) ?? sceneNodes[0];
const defaultNeighbors = defaultNode?.neighbors.slice(0, 6) ?? [];
---

<div class={`value-lsh-three ${variant}`} data-value-lsh-three style={`--value-graph-height:${height}px;`}>
  <script type="application/json" data-value-lsh-points set:html={JSON.stringify(scenePayload)} is:inline />
  <div class="value-lsh-stage" data-value-lsh-stage>
    <canvas data-value-lsh-canvas aria-label="Value LSH 3D graph"></canvas>
    <div class="value-lsh-fallback" aria-hidden="true">
      <svg viewBox="0 0 1000 540" role="img">
        <defs>
          <radialGradient id={`value-lsh-glow-${variant}`} cx="50%" cy="45%" r="62%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="72%" stop-color="#FFF5EB" />
            <stop offset="100%" stop-color="#FAF7F2" />
          </radialGradient>
        </defs>
        <rect width="1000" height="540" rx="8" fill={`url(#value-lsh-glow-${variant})`} />
        <circle cx="500" cy="270" r="212" fill="none" stroke="rgba(0,0,0,.08)" />
        <ellipse cx="500" cy="270" rx="360" ry="120" fill="none" stroke="rgba(0,122,255,.12)" />
        <ellipse cx="500" cy="270" rx="210" ry="318" fill="none" stroke="rgba(255,91,0,.12)" transform="rotate(-18 500 270)" />
        {fallbackNodes.map((node) => (
          <circle
            cx={node.sx}
            cy={node.sy}
            r={node.r}
            fill={classColors[node.valueClass]}
            fill-opacity={node.opacity}
          />
        ))}
        {fallbackRegionOverlays.map((region) => (
          <g>
            <rect
              x={region.boxX}
              y={region.boxY}
              width={region.boxWidth}
              height={region.boxHeight}
              rx="18"
              fill="none"
              stroke={region.color}
              stroke-opacity="0.34"
              stroke-width="2"
              stroke-dasharray="8 6"
            />
            <circle cx={region.centerX} cy={region.centerY} r="6" fill={region.color} fill-opacity="0.9" />
            <path
              d={`M ${region.centerX + 8} ${region.centerY - 8} L ${region.labelX - 18} ${region.labelY + 14}`}
              fill="none"
              stroke={region.color}
              stroke-opacity="0.42"
              stroke-width="2"
            />
            <g transform={`translate(${region.labelX}, ${region.labelY})`}>
              <rect x="0" y="0" width="146" height="40" rx="16" fill="rgba(255,252,248,.92)" stroke="rgba(20,25,34,.10)" />
              <circle cx="18" cy="20" r="10" fill="rgba(246,239,230,.98)" />
              <text x="18" y="24" text-anchor="middle" font-size="11" font-weight="700" fill="#1f2430">{region.rank}</text>
              <text x="36" y="16" font-size="12" font-weight="700" fill="#1f2430">{region.arrow} {region.rankingLabel}</text>
              <text x="36" y="29" font-size="10" font-weight="600" fill="rgba(31,36,48,.66)">{region.clusterId}</text>
            </g>
          </g>
        ))}
      </svg>
    </div>
    <div class="value-lsh-region-markers" data-region-markers aria-label="Evidence region anchors"></div>
  </div>
  {variant === 'full' ? (
    <div class="value-lsh-region-rail" aria-label="Evidence region guide">
      {valueLshRegions.map((region, index) => (
        <button type="button" class="value-region-card" data-region-button data-region-id={region.kind}>
          <div class="value-region-card-head">
            <span class="value-region-rank">{index + 1}</span>
            <strong>{region.arrow} {region.rankingLabel}</strong>
            <small>{region.clusterId}</small>
          </div>
          <p>{region.meaning}</p>
          <div class="value-region-card-meta">
            <span>{region.metricKey} {region.metricValue.toFixed(2)}</span>
            <span>{region.nodeCount} nodes</span>
          </div>
          <div class="value-chip-row region">
            {region.topFacets.slice(0, 3).map((facet) => <span>{facet.label}</span>)}
          </div>
        </button>
      ))}
    </div>
  ) : null}
  <div class="value-lsh-legend" aria-label="Value LSH legend">
    {(Object.keys(classLabels) as ValueClass[]).map((valueClass) => (
      <span><i style={`background:${classColors[valueClass]}`}></i>{classLabels[valueClass]} <strong>{graphSnapshot.summary.value_classes[valueClass].toLocaleString()}</strong></span>
    ))}
    <span><i class="projection-dot"></i>{graphSnapshot.method.provider} + {graphSnapshot.method.projection.toUpperCase()}</span>
    <span><i class="cluster-dot"></i>{graphSnapshot.summary.embedding_clusters} value-vector k-means clusters</span>
    <span><i class="node-dot"></i>{graphSnapshot.summary.nodes.toLocaleString()} nodes</span>
  </div>
  <div class="value-lsh-inspector" data-value-lsh-inspector aria-live="polite">
    {defaultNode ? (
      <article class="value-lsh-selected">
        <div class="value-lsh-selected-head">
          <div>
            <span>{defaultNode.type} · {defaultNode.valueClass}</span>
            <h3>{defaultNode.primaryUrl ? <a href={defaultNode.primaryUrl} target="_blank" rel="noopener">{defaultNode.title}</a> : defaultNode.title}</h3>
          </div>
          <div class="value-lsh-selected-actions">
            {defaultNode.reportUrl ? <a href={defaultNode.reportUrl} target="_blank" rel="noopener">report</a> : null}
            {defaultNode.url ? <a href={defaultNode.url} target="_blank" rel="noopener">source</a> : null}
            {defaultNode.rawUrl ? <a href={defaultNode.rawUrl} target="_blank" rel="noopener">raw</a> : null}
          </div>
        </div>
        <div class="value-lsh-selected-metrics">
          <div><strong>{defaultNode.score.toFixed(2)}</strong><span>value</span></div>
          <div><strong>{defaultNode.confidence.toFixed(2)}</strong><span>confidence</span></div>
          <div><strong>{defaultNode.embeddingCluster}</strong><span>k-means cluster</span></div>
        </div>
        <p>{defaultNode.rawUrl ? <a href={defaultNode.rawUrl} target="_blank" rel="noopener">{defaultNode.sourcePath || defaultNode.id}</a> : (defaultNode.sourcePath || defaultNode.id)}{defaultNode.lshCluster ? ` · ${defaultNode.lshCluster}` : ''}</p>
        <h4>LSH neighbors</h4>
        <p>共享 hash bands 的近邻召回，不等于上面的 k-means cluster 标签。</p>
        <ul>
          {defaultNeighbors.length ? defaultNeighbors.map((neighbor) => (
            <li>
              <strong>{neighbor.reportUrl || neighbor.url || neighbor.rawUrl ? <a href={neighbor.reportUrl || neighbor.url || neighbor.rawUrl || undefined} target="_blank" rel="noopener">{neighbor.title}</a> : neighbor.title}</strong>
              <span>{neighbor.type} · value {neighbor.value_score.toFixed(2)} · shared buckets {neighbor.shared_bucket_count}</span>
              <small>{neighbor.shared_features.slice(0, 4).join(' / ')}</small>
            </li>
          )) : (
            <li><span>当前采样内没有可展示邻居。</span></li>
          )}
        </ul>
      </article>
    ) : (
      <div class="value-lsh-inspector-empty">No nodes available.</div>
    )}
  </div>
</div>

<script>
  import * as THREE from 'three';

  type SceneNeighbor = {
    id: string;
    title: string;
    type: string;
    value_score: number;
    value_class: string;
    shared_bucket_count: number;
    shared_features: string[];
    relation_weight: number;
    url?: string | null;
    rawUrl?: string | null;
    reportUrl?: string | null;
  };
  type SceneNode = {
    id: string;
    type: string;
    title: string;
    url?: string | null;
    sourcePath?: string | null;
    rawUrl?: string | null;
    reportUrl?: string | null;
    primaryUrl?: string | null;
    score: number;
    confidence: number;
    valueClass: string;
    embeddingCluster: string;
    lshCluster?: string | null;
    neighbors: SceneNeighbor[];
    x: number;
    y: number;
    z: number;
  };
  type SceneRegion = {
    kind: string;
    title: string;
    shortLabel: string;
    arrow: string;
    color: string;
    clusterId: string;
    rankingLabel: string;
    metricKey: string;
    metricValue: number;
    meaning: string;
    summary: string;
    nodeCount: number;
    centroid: { x: number; y: number; z: number };
    bounds: {
      min: { x: number; y: number; z: number };
      max: { x: number; y: number; z: number };
    };
    representativeId?: string | null;
    topFacets?: { id: string; label: string; average: number }[];
  };
  type ScenePayload = { variant?: string; nodes?: SceneNode[]; colors: Record<string, string>; regions?: SceneRegion[] };

  const roots = document.querySelectorAll('[data-value-lsh-three]');
  roots.forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.valueLshReady === 'true') return;
    root.dataset.valueLshReady = 'true';

    const payloadElement = root.querySelector('[data-value-lsh-points]');
    const stage = root.querySelector('[data-value-lsh-stage]');
    const canvas = root.querySelector('[data-value-lsh-canvas]');
    const inspector = root.querySelector('[data-value-lsh-inspector]');
    const markerLayer = root.querySelector('[data-region-markers]');
    if (!(payloadElement instanceof HTMLScriptElement) || !(stage instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement) || !(inspector instanceof HTMLElement) || !(markerLayer instanceof HTMLElement)) return;

    let payload: ScenePayload;
    try {
      payload = JSON.parse(payloadElement.textContent || '{}');
    } catch {
      return;
    }
    const nodes: SceneNode[] = Array.isArray(payload.nodes) ? payload.nodes : [];
    const regions: SceneRegion[] = Array.isArray(payload.regions) ? payload.regions : [];
    if (!nodes.length) return;

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    } catch {
      return;
    }

    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(44, 1, 0.1, 100);
    camera.position.set(0, 0, payload.variant === 'compact' ? 4.25 : 4.75);
    const raycaster = new THREE.Raycaster();
    raycaster.params.Points.threshold = payload.variant === 'compact' ? 0.1 : 0.08;
    const pointer = new THREE.Vector2();
    const nodeById = new Map(nodes.map((node) => [node.id, node]));

    const group = new THREE.Group();
    group.rotation.x = -0.26;
    group.rotation.y = 0.34;
    scene.add(group);

    const positions = new Float32Array(nodes.length * 3);
    const colors = new Float32Array(nodes.length * 3);
    const baseColors = new Float32Array(nodes.length * 3);
    const color = new THREE.Color();
    nodes.forEach((node: SceneNode, index: number) => {
      const i = index * 3;
      positions[i] = node.x * 1.72;
      positions[i + 1] = node.y * 1.72;
      positions[i + 2] = node.z * 1.72;
      color.set(payload.colors[node.valueClass] || '#007AFF');
      colors[i] = color.r;
      colors[i + 1] = color.g;
      colors[i + 2] = color.b;
      baseColors[i] = color.r;
      baseColors[i + 1] = color.g;
      baseColors[i + 2] = color.b;
    });

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
      size: payload.variant === 'compact' ? 0.072 : 0.062,
      vertexColors: true,
      transparent: true,
      opacity: 0.96,
      depthWrite: false,
      sizeAttenuation: true,
    });
    const pointsCloud = new THREE.Points(geometry, material);
    group.add(pointsCloud);

    const highlightGroup = new THREE.Group();
    group.add(highlightGroup);
    const regionGroup = new THREE.Group();
    group.add(regionGroup);

    const escapeHtml = (value: unknown) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
    const renderLink = (href: string | null | undefined, label: string) => href
      ? `<a href="${escapeHtml(href)}" target="_blank" rel="noopener">${escapeHtml(label)}</a>`
      : escapeHtml(label);

    const nodePosition = (node: SceneNode) => new THREE.Vector3(node.x * 1.72, node.y * 1.72, node.z * 1.72);
    const regionPosition = (region: SceneRegion) => new THREE.Vector3(region.centroid.x * 1.72, region.centroid.y * 1.72, region.centroid.z * 1.72);
    const focusRegion = (region: SceneRegion) => {
      const focusVector = regionPosition(region).normalize();
      const planar = Math.sqrt(focusVector.x ** 2 + focusVector.z ** 2) || 1;
      const focusTilt = -Math.atan2(focusVector.y, planar) - 0.12;
      const focusTurn = Math.atan2(focusVector.x, focusVector.z) - 0.08;
      targetX = Math.max(-1.15, Math.min(1.15, focusTilt));
      targetY = focusTurn;
    };

    const renderInspector = (node: SceneNode) => {
      const title = renderLink(node.primaryUrl, node.title);
      const actions = [
        node.reportUrl ? `<a href="${escapeHtml(node.reportUrl)}" target="_blank" rel="noopener">report</a>` : '',
        node.url ? `<a href="${escapeHtml(node.url)}" target="_blank" rel="noopener">source</a>` : '',
        node.rawUrl ? `<a href="${escapeHtml(node.rawUrl)}" target="_blank" rel="noopener">raw</a>` : '',
      ].filter(Boolean).join('');
      const sourcePath = node.rawUrl
        ? `<a href="${escapeHtml(node.rawUrl)}" target="_blank" rel="noopener">${escapeHtml(node.sourcePath || node.id)}</a>`
        : escapeHtml(node.sourcePath || node.id);
      const neighbors = node.neighbors.slice(0, 6).map((neighbor) => `
        <li>
          <strong>${renderLink(neighbor.reportUrl || neighbor.url || neighbor.rawUrl, neighbor.title)}</strong>
          <span>${escapeHtml(neighbor.type)} · value ${Number(neighbor.value_score).toFixed(2)} · shared buckets ${neighbor.shared_bucket_count}</span>
          <small>${escapeHtml((neighbor.shared_features || []).slice(0, 4).join(' / '))}</small>
        </li>
      `).join('');
      inspector.innerHTML = `
        <article class="value-lsh-selected">
          <div class="value-lsh-selected-head">
            <div>
              <span>${escapeHtml(node.type)} · ${escapeHtml(node.valueClass)}</span>
              <h3>${title}</h3>
            </div>
            <div class="value-lsh-selected-actions">${actions}</div>
          </div>
          <div class="value-lsh-selected-metrics">
            <div><strong>${Number(node.score).toFixed(2)}</strong><span>value</span></div>
            <div><strong>${Number(node.confidence).toFixed(2)}</strong><span>confidence</span></div>
            <div><strong>${escapeHtml(node.embeddingCluster)}</strong><span>k-means cluster</span></div>
          </div>
          <p>${sourcePath}${node.lshCluster ? ` · ${escapeHtml(node.lshCluster)}` : ''}</p>
          <h4>LSH neighbors</h4>
          <p>共享 hash bands 的近邻召回，不等于上面的 k-means cluster 标签。</p>
          <ul>${neighbors || '<li><span>当前采样内没有可展示邻居。</span></li>'}</ul>
        </article>
      `;
    };

    const regionButtons = [...root.querySelectorAll('[data-region-button]')].filter((element): element is HTMLButtonElement => element instanceof HTMLButtonElement);
    const regionVisuals = new Map<string, THREE.Group>();
    const regionMarkers = new Map<string, HTMLButtonElement>();
    const mutedColor = new THREE.Color('#d8d1c7');
    const setMaterialOpacity = (material: THREE.Material | THREE.Material[], opacity: number) => {
      const materials = Array.isArray(material) ? material : [material];
      materials.forEach((item) => {
        item.transparent = true;
        item.opacity = opacity;
      });
    };

    const applyRegionClusterFocus = (activeClusterId?: string | null) => {
      for (let index = 0; index < nodes.length; index += 1) {
        const i = index * 3;
        if (!activeClusterId) {
          colors[i] = baseColors[i];
          colors[i + 1] = baseColors[i + 1];
          colors[i + 2] = baseColors[i + 2];
          continue;
        }
        const isActiveCluster = nodes[index]?.embeddingCluster === activeClusterId;
        if (isActiveCluster) {
          colors[i] = Math.min(1, baseColors[i] * 1.08);
          colors[i + 1] = Math.min(1, baseColors[i + 1] * 1.08);
          colors[i + 2] = Math.min(1, baseColors[i + 2] * 1.08);
        } else {
          colors[i] = baseColors[i] * 0.22 + mutedColor.r * 0.78;
          colors[i + 1] = baseColors[i + 1] * 0.22 + mutedColor.g * 0.78;
          colors[i + 2] = baseColors[i + 2] * 0.22 + mutedColor.b * 0.78;
        }
      }
      const colorAttribute = geometry.getAttribute('color');
      if (colorAttribute) colorAttribute.needsUpdate = true;
      material.opacity = activeClusterId ? 0.98 : 0.96;
      material.size = activeClusterId
        ? (payload.variant === 'compact' ? 0.076 : 0.068)
        : (payload.variant === 'compact' ? 0.072 : 0.062);
      material.needsUpdate = true;
    };

    const setRegionActiveState = (activeId?: string | null) => {
      regionButtons.forEach((button) => {
        button.dataset.active = button.dataset.regionId === activeId ? 'true' : 'false';
      });
      regionMarkers.forEach((marker, key) => {
        marker.dataset.active = key === activeId ? 'true' : 'false';
      });
      regionVisuals.forEach((visual, key) => {
        const opacity = key === activeId ? 0.95 : 0.22;
        visual.children.forEach((child) => {
          const candidateMaterial = Reflect.get(child as object, 'material');
          if (candidateMaterial && candidateMaterial instanceof THREE.Material) {
            setMaterialOpacity(candidateMaterial, opacity);
          } else if (Array.isArray(candidateMaterial) && candidateMaterial.every((item) => item instanceof THREE.Material)) {
            setMaterialOpacity(candidateMaterial, opacity);
          }
          if (child instanceof THREE.ArrowHelper) {
            setMaterialOpacity(child.line.material, opacity);
            setMaterialOpacity(child.cone.material, opacity);
          }
        });
      });
    };

    const createRegionVisual = (region: SceneRegion) => {
      const visual = new THREE.Group();
      const size = new THREE.Vector3(
        Math.max((region.bounds.max.x - region.bounds.min.x) * 1.72, 0.2),
        Math.max((region.bounds.max.y - region.bounds.min.y) * 1.72, 0.2),
        Math.max((region.bounds.max.z - region.bounds.min.z) * 1.72, 0.2),
      );
      const center = regionPosition(region);
      const outline = new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.BoxGeometry(size.x, size.y, size.z)),
        new THREE.LineBasicMaterial({ color: region.color, transparent: true, opacity: 0.22 }),
      );
      outline.position.copy(center);
      visual.add(outline);

      const arrowDirection = center.clone().normalize();
      const arrowOrigin = center.clone().addScaledVector(arrowDirection, -0.65);
      const arrow = new THREE.ArrowHelper(arrowDirection, arrowOrigin, 0.52, region.color, 0.12, 0.08);
      setMaterialOpacity(arrow.line.material, 0.22);
      setMaterialOpacity(arrow.cone.material, 0.22);
      visual.add(arrow);

      const anchor = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 14, 14),
        new THREE.MeshBasicMaterial({ color: region.color, transparent: true, opacity: 0.22 }),
      );
      anchor.position.copy(center);
      visual.add(anchor);
      return visual;
    };

    const createRegionMarker = (region: SceneRegion, index: number) => {
      const marker = document.createElement('button');
      marker.type = 'button';
      marker.className = 'value-region-marker';
      marker.dataset.regionId = region.kind;
      marker.setAttribute('aria-label', `${index + 1}. ${region.rankingLabel}`);
      marker.innerHTML = `
        <span class="value-region-marker-rank">${index + 1}</span>
        <span class="value-region-marker-copy">
          <strong>${escapeHtml(region.arrow)} ${escapeHtml(region.rankingLabel)}</strong>
          <small>${escapeHtml(region.clusterId)}</small>
        </span>
      `;
      marker.addEventListener('click', () => selectRegion(region));
      markerLayer.append(marker);
      regionMarkers.set(region.kind, marker);
    };

    regions.forEach((region) => {
      const visual = createRegionVisual(region);
      regionVisuals.set(region.kind, visual);
      regionGroup.add(visual);
    });
    regions.forEach((region, index) => createRegionMarker(region, index));

    const updateRegionMarkers = () => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      group.updateMatrixWorld(true);
      camera.updateMatrixWorld();
      regions.forEach((region) => {
        const marker = regionMarkers.get(region.kind);
        if (!marker) return;
        const world = group.localToWorld(regionPosition(region).clone());
        const projected = world.project(camera);
        const visible = projected.z > -1 && projected.z < 1;
        if (!visible) {
          marker.dataset.hidden = 'true';
          return;
        }
        const x = ((projected.x + 1) / 2) * width;
        const y = ((-projected.y + 1) / 2) * height;
        const markerWidth = marker.offsetWidth || 146;
        const markerHeight = marker.offsetHeight || 40;
        const clampedX = Math.min(width - markerWidth / 2 - 8, Math.max(markerWidth / 2 + 8, x));
        const clampedY = Math.min(height - markerHeight / 2 - 8, Math.max(markerHeight / 2 + 8, y));
        const insideViewport = clampedX >= markerWidth / 2 && clampedX <= width - markerWidth / 2 && clampedY >= markerHeight / 2 && clampedY <= height - markerHeight / 2;
        marker.dataset.hidden = insideViewport ? 'false' : 'true';
        if (insideViewport) {
          marker.style.transform = `translate(${clampedX}px, ${clampedY}px) translate(-50%, -50%)`;
        }
      });
    };

    const selectNode = (node: SceneNode) => {
      highlightGroup.clear();
      const selectedMaterial = new THREE.MeshBasicMaterial({ color: payload.colors[node.valueClass] || '#007AFF', transparent: true, opacity: 0.95 });
      const selected = new THREE.Mesh(new THREE.SphereGeometry(0.075, 18, 18), selectedMaterial);
      const origin = nodePosition(node);
      selected.position.copy(origin);
      highlightGroup.add(selected);

      const linePositions: number[] = [];
      node.neighbors.slice(0, 8).forEach((neighbor) => {
        const target = nodeById.get(neighbor.id);
        if (!target) return;
        const targetPosition = nodePosition(target);
        linePositions.push(origin.x, origin.y, origin.z, targetPosition.x, targetPosition.y, targetPosition.z);
        const targetMarker = new THREE.Mesh(
          new THREE.SphereGeometry(0.044, 14, 14),
          new THREE.MeshBasicMaterial({ color: payload.colors[target.valueClass] || '#007AFF', transparent: true, opacity: 0.78 })
        );
        targetMarker.position.copy(targetPosition);
        highlightGroup.add(targetMarker);
      });
      if (linePositions.length) {
        const lineGeometry = new THREE.BufferGeometry();
        lineGeometry.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
        highlightGroup.add(new THREE.LineSegments(
          lineGeometry,
          new THREE.LineBasicMaterial({ color: 0x1a1a1a, transparent: true, opacity: 0.24 })
        ));
      }
      renderInspector(node);
    };

    const selectRegion = (region: SceneRegion) => {
      setRegionActiveState(region.kind);
      focusRegion(region);
      applyRegionClusterFocus(region.clusterId);
      const targetNode = (region.representativeId && nodeById.get(region.representativeId))
        || nodes.find((node) => node.embeddingCluster === region.clusterId)
        || nodes[0];
      if (targetNode) selectNode(targetNode);
    };

    const ringMaterial = new THREE.LineBasicMaterial({ color: 0x7a6b5e, transparent: true, opacity: 0.18 });
    const makeRing = (radius: number, rotation: [number, number, number]) => {
      const points = [];
      for (let i = 0; i < 144; i += 1) {
        const angle = (i / 144) * Math.PI * 2;
        points.push(new THREE.Vector3(Math.cos(angle) * radius, Math.sin(angle) * radius, 0));
      }
      const ring = new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(points), ringMaterial);
      ring.rotation.set(rotation[0], rotation[1], rotation[2]);
      return ring;
    };
    group.add(makeRing(1.94, [0, 0, 0]));
    group.add(makeRing(1.94, [Math.PI / 2, 0, 0]));
    group.add(makeRing(1.94, [0, Math.PI / 2, 0]));

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      const width = Math.max(1, Math.floor(rect.width));
      const height = Math.max(1, Math.floor(rect.height));
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    resize();
    new ResizeObserver(resize).observe(stage);

    let pointerActive = false;
    let pointerMoved = false;
    let lastX = 0;
    let lastY = 0;
    let targetX = group.rotation.x;
    let targetY = group.rotation.y;
    const motionEnabled = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    stage.addEventListener('pointerdown', (event) => {
      pointerActive = true;
      pointerMoved = false;
      lastX = event.clientX;
      lastY = event.clientY;
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointermove', (event) => {
      if (!pointerActive) return;
      if (Math.abs(event.clientX - lastX) + Math.abs(event.clientY - lastY) > 2) pointerMoved = true;
      targetY += (event.clientX - lastX) * 0.006;
      targetX += (event.clientY - lastY) * 0.004;
      targetX = Math.max(-1.15, Math.min(1.15, targetX));
      lastX = event.clientX;
      lastY = event.clientY;
    });
    stage.addEventListener('pointerup', () => {
      pointerActive = false;
    });
    stage.addEventListener('pointercancel', () => {
      pointerActive = false;
    });

    stage.addEventListener('click', (event) => {
      if (pointerMoved) return;
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointer, camera);
      const hits = raycaster.intersectObject(pointsCloud);
      const hit = hits[0];
      if (!hit || typeof hit.index !== 'number') return;
      const node = nodes[hit.index];
      if (node) selectNode(node);
    });

    regionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const region = regions.find((candidate) => candidate.kind === button.dataset.regionId);
        if (region) selectRegion(region);
      });
    });

    const defaultRegion = regions[0];
    if (defaultRegion) {
      selectRegion(defaultRegion);
    } else {
      selectNode(nodes.find((node) => node.neighbors.length > 0) || nodes[0]);
    }

    root.classList.add('is-canvas-ready');
    const tick = () => {
      if (motionEnabled && !pointerActive) {
        targetY += payload.variant === 'compact' ? 0.0016 : 0.0011;
      }
      group.rotation.x += (targetX - group.rotation.x) * 0.08;
      group.rotation.y += (targetY - group.rotation.y) * 0.08;
      updateRegionMarkers();
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    };
    tick();
  });
</script>

