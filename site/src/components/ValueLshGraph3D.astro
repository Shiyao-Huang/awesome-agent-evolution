      }
    }
    const tick = () => {
      if (motionEnabled && !pointerActive) {
        targetY += payload.variant === 'compact' ? 0.0016 : 0.0011;
      }
      group.rotation.x += (targetX - group.rotation.x) * 0.08;
      group.rotation.y += (targetY - group.rotation.y) * 0.08;
      camera.position.z += (targetCameraZ - camera.position.z) * (motionEnabled ? 0.12 : 0.18);
      if (transitionFade > 0) {
        transitionFade = Math.max(0, transitionFade - (motionEnabled ? 0.035 : 0.08));
        transitionTravel = Math.min(1, transitionTravel + (motionEnabled ? 0.075 : 0.16));
        if (transitionCurve) {
          transitionGuidePoint = transitionCurve.getPoint(Math.min(0.82, 0.22 + transitionTravel * 0.44));
        }
        transitionGroup.children.forEach((child) => {
          const candidateMaterial = Reflect.get(child as object, 'material');
          if (candidateMaterial && candidateMaterial instanceof THREE.Material) {
            const baseOpacity = child.name === 'transitionArc'
              ? 0.88
              : child.name === 'transitionSpark'
                ? 0.95
                : child.name === 'transitionTargetHalo'
                  ? 0.7
                  : 0.45;
            setMaterialOpacity(candidateMaterial, baseOpacity * transitionFade);
