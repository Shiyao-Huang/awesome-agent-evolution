---
import graphSnapshotJson from '../../../analysis/value-lsh-graph-3d.json';
import analysisSnapshotJson from '../data/analysis.json';
import { valueLshRegions } from '@/data/valueLshRegions';

type ValueClass = 'high-value-candidate' | 'needs-review' | 'low-signal-or-risk';
type AnalysisProject = {
  normalized_repo?: string | null;
  public_report?: string | null;
  raw_file?: string | null;
  localPath?: string | null;
  url?: string | null;
};

interface GraphNode {
  id: string;
  type: string;
  title: string;
  url?: string | null;
  source_path?: string | null;
  value_score: number;
  confidence: number;
  value_class: ValueClass;
  embedding_cluster: string;
  lsh_cluster_hint?: string | null;
  top_lsh_neighbors?: LshNeighbor[];
  x: number;
  y: number;
  z: number;
}

interface LshNeighbor {
  id: string;
  title: string;
  type: string;
  value_score: number;
  value_class: ValueClass;
  shared_bucket_count: number;
  shared_features: string[];
  relation_weight: number;
  url?: string | null;
  rawUrl?: string | null;
  reportUrl?: string | null;
}

interface GraphSnapshot {
  generated_at: string;
  method: {
    provider: string;
    projection: string;
    k: number;
  };
  summary: {
    nodes: number;
    embedding_clusters: number;
    value_classes: Record<ValueClass, number>;
  };
  nodes: GraphNode[];
}

interface AnalysisSnapshot {
  analyzed_projects?: AnalysisProject[];
}

interface Props {
  variant?: 'compact' | 'full';
  maxNodes?: number;
  height?: number;
}

type RegionWithOptionalEnglish = typeof valueLshRegions[number] & {
  meaningEn?: string;
  summaryEn?: string;
};

const graphSnapshot = graphSnapshotJson as GraphSnapshot;
const analysisSnapshot = analysisSnapshotJson as AnalysisSnapshot;
const projectRepoBase = 'https://github.com/Shiyao-Huang/awesome-agent-evolution/blob/main/';
const toPublicReportUrl = (value?: string | null) => {
  if (!value) return null;
  const fileName = value.split('/').pop();
  return fileName ? `/reports/projects/${fileName.replace(/\.md$/, '')}/` : null;
};
const toRawCaptureUrl = (value?: string | null) => value ? `${projectRepoBase}${value}` : null;
const projectLinkMap = new Map<string, { reportUrl?: string | null; rawUrl?: string | null; sourceUrl?: string | null }>();

for (const project of analysisSnapshot.analyzed_projects ?? []) {
  const normalizedRepo = project.normalized_repo?.trim().toLowerCase();
  if (!normalizedRepo) continue;
  projectLinkMap.set(normalizedRepo, {
    reportUrl: toPublicReportUrl(project.public_report),
    rawUrl: toRawCaptureUrl(project.raw_file ?? project.localPath),
    sourceUrl: project.url ?? null,
  });
}

const { variant = 'full', maxNodes = variant === 'compact' ? 760 : graphSnapshot.summary.nodes, height = variant === 'compact' ? 360 : 560 } = Astro.props;
const allNodes = graphSnapshot.nodes ?? [];
const sampleStep = Math.max(1, Math.ceil(allNodes.length / maxNodes));
const sceneNodes = allNodes
  .filter((_, index) => index % sampleStep === 0)
  .slice(0, maxNodes)
  .map((node) => {
    const normalizedRepo = node.id.replace(/^github:/, '').trim().toLowerCase();
    const projectLinks = projectLinkMap.get(normalizedRepo);
    return {
    id: node.id,
    type: node.type,
    title: node.title,
    url: node.url,
    sourcePath: node.source_path,
    rawUrl: projectLinks?.rawUrl ?? toRawCaptureUrl(node.source_path),
    reportUrl: projectLinks?.reportUrl ?? null,
    primaryUrl: projectLinks?.reportUrl ?? node.url ?? toRawCaptureUrl(node.source_path),
    score: node.value_score,
    confidence: node.confidence,
    valueClass: node.value_class,
    embeddingCluster: node.embedding_cluster,
    lshCluster: node.lsh_cluster_hint,
    neighbors: (node.top_lsh_neighbors || []).map((neighbor) => {
      const neighborRepo = neighbor.id.replace(/^github:/, '').trim().toLowerCase();
      const neighborLinks = projectLinkMap.get(neighborRepo);
      return {
        ...neighbor,
        url: neighborLinks?.sourceUrl ?? null,
        rawUrl: neighborLinks?.rawUrl ?? null,
        reportUrl: neighborLinks?.reportUrl ?? null,
      };
    }),
    x: Number(node.x.toFixed(6)),
    y: Number(node.y.toFixed(6)),
    z: Number(node.z.toFixed(6)),
  };
  });

const classLabels: Record<ValueClass, string> = {
  'high-value-candidate': 'Priority review',
  'needs-review': 'Needs review',
  'low-signal-or-risk': 'Repair / risk',
};

const metricLabels: Record<string, string> = {
  frontier: 'frontier evidence',
  attention: 'attention signal',
  quality: 'evidence density',
};
const regionMeaningEn = (region: typeof valueLshRegions[number]) => (region as RegionWithOptionalEnglish).meaningEn ?? region.meaning;
const regionSummaryEn = (region: typeof valueLshRegions[number]) => (region as RegionWithOptionalEnglish).summaryEn ?? region.summary;

const classColors: Record<ValueClass, string> = {
  'high-value-candidate': '#2E6F4E',
  'needs-review': '#007AFF',
  'low-signal-or-risk': '#B83224',
};

const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
const formatSignedDelta = (value: number) => `${value > 0 ? '+' : value < 0 ? '' : ''}${value.toFixed(2)}`;
const regionContrastSummary = (region: typeof valueLshRegions[number]) => valueLshRegions
  .filter((candidate) => candidate.kind !== region.kind)
  .map((otherRegion) => {
    const axisDiffs = (['x', 'y', 'z'] as const)
      .map((axis) => ({
        axis,
        delta: Number((region.centroid[axis] - otherRegion.centroid[axis]).toFixed(2)),
      }))
      .sort((left, right) => Math.abs(right.delta) - Math.abs(left.delta));
    const metricDiffs = (['frontier', 'attention', 'quality'] as const)
      .map((metricKey) => ({
        key: metricKey,
        label: metricLabels[metricKey] || metricKey,
        delta: Number(((region.metrics?.[metricKey] || 0) - (otherRegion.metrics?.[metricKey] || 0)).toFixed(2)),
      }))
      .sort((left, right) => Math.abs(right.delta) - Math.abs(left.delta));
    const dominantAxis = axisDiffs[0];
    const dominantMetric = metricDiffs[0];
    return {
      kind: otherRegion.kind,
      arrow: otherRegion.arrow,
      rankingLabel: otherRegion.rankingLabel,
      clusterId: otherRegion.clusterId,
      axisDiffs,
      metricDiffs,
      separationNote: dominantAxis.delta > 0
        ? `当前区域在 ${dominantAxis.axis.toUpperCase()} 轴更靠正 ${Math.abs(dominantAxis.delta).toFixed(2)}。`
        : dominantAxis.delta < 0
          ? `当前区域在 ${dominantAxis.axis.toUpperCase()} 轴更靠负 ${Math.abs(dominantAxis.delta).toFixed(2)}。`
          : `当前区域与它在 ${dominantAxis.axis.toUpperCase()} 轴几乎重合。`,
      metricNote: dominantMetric.delta > 0
        ? `${dominantMetric.label} 更高 ${Math.abs(dominantMetric.delta).toFixed(2)}。`
        : dominantMetric.delta < 0
          ? `${dominantMetric.label} 更低 ${Math.abs(dominantMetric.delta).toFixed(2)}。`
          : `${dominantMetric.label} 几乎持平。`,
    };
  });
const projectRegionPoint = (region: typeof valueLshRegions[number]) => ({
  x: 500 + region.centroid.x * 390 + region.centroid.z * 72,
  y: 270 - region.centroid.y * 190 + region.centroid.z * 34,
});
const regionSpatialMap = (region: typeof valueLshRegions[number]) => {
  const projected = valueLshRegions.map((candidate) => ({ region: candidate, point: projectRegionPoint(candidate) }));
  const minX = Math.min(...projected.map((item) => item.point.x));
  const maxX = Math.max(...projected.map((item) => item.point.x));
  const minY = Math.min(...projected.map((item) => item.point.y));
  const maxY = Math.max(...projected.map((item) => item.point.y));
  const width = 260;
  const height = 150;
  const padding = 18;
  const scaleX = (value: number) => padding + (((value - minX) / Math.max(1, maxX - minX)) * (width - padding * 2));
  const scaleY = (value: number) => padding + (((value - minY) / Math.max(1, maxY - minY)) * (height - padding * 2));
  const nodes = projected.map(({ region: candidate, point }) => ({
    kind: candidate.kind,
    arrow: candidate.arrow,
    rankingLabel: candidate.rankingLabel,
    clusterId: candidate.clusterId,
    x: Number(scaleX(point.x).toFixed(1)),
    y: Number(scaleY(point.y).toFixed(1)),
    current: candidate.kind === region.kind,
  }));
  const currentNode = nodes.find((item) => item.current) ?? nodes[0];
  return {
    width,
    height,
    nodes,
    links: nodes
      .filter((item) => !item.current)
      .map((item) => ({
        fromX: currentNode.x,
        fromY: currentNode.y,
        toX: item.x,
        toY: item.y,
        kind: item.kind,
      })),
  };
};
const fallbackNodes = [...sceneNodes]
  .sort((a, b) => a.z - b.z)
  .slice(0, variant === 'compact' ? 220 : 420)
  .map((node) => ({
    ...node,
    sx: clamp(500 + node.x * 390 + node.z * 72, 36, 964),
    sy: clamp(270 - node.y * 190 + node.z * 34, 30, 510),
    r: clamp(2.2 + (node.score - 50) / 14 + node.z * 1.1, 1.8, 7.4),
    opacity: clamp(0.38 + (node.z + 1) * 0.24, 0.28, 0.92),
  }));

const fallbackRegionOverlays = valueLshRegions.map((region, index) => {
  const centerX = clamp(500 + region.centroid.x * 390 + region.centroid.z * 72, 92, 908);
  const centerY = clamp(270 - region.centroid.y * 190 + region.centroid.z * 34, 74, 472);
  const boxWidth = clamp(Math.abs(region.bounds.max.x - region.bounds.min.x) * 410 + 110, 110, 360);
  const boxHeight = clamp(Math.abs(region.bounds.max.y - region.bounds.min.y) * 230 + 84, 84, 260);
  return {
    ...region,
    rank: index + 1,
    centerX,
    centerY,
    boxWidth,
    boxHeight,
    boxX: centerX - boxWidth / 2,
    boxY: centerY - boxHeight / 2,
    labelX: clamp(centerX + boxWidth / 2 + 18, 120, 908),
    labelY: clamp(centerY - boxHeight / 2 - 16, 34, 504),
  };
});

const scenePayload = {
  variant,
  nodes: sceneNodes,
  colors: classColors,
  regions: valueLshRegions.map((region) => ({
    kind: region.kind,
    title: region.title,
    shortLabel: region.shortLabel,
    arrow: region.arrow,
    color: region.color,
    clusterId: region.clusterId,
    rankingLabel: region.rankingLabel,
    metricKey: region.metricKey,
    metricValue: region.metricValue,
    meaning: region.meaning,
    meaningEn: regionMeaningEn(region),
    summary: region.summary,
    summaryEn: regionSummaryEn(region),
    metrics: region.metrics,
    nodeCount: region.nodeCount,
    centroid: region.centroid,
    bounds: region.bounds,
    fallbackOverlay: (() => {
      const fallback = fallbackRegionOverlays.find((item) => item.kind === region.kind);
      return fallback ? {
        centerX: fallback.centerX,
        centerY: fallback.centerY,
        boxX: fallback.boxX,
        boxY: fallback.boxY,
        boxWidth: fallback.boxWidth,
        boxHeight: fallback.boxHeight,
        labelX: fallback.labelX,
        labelY: fallback.labelY,
      } : undefined;
    })(),
    representativeId: region.representatives.find((rep) => sceneNodes.some((node) => node.id === rep.id))?.id ?? region.representatives[0]?.id ?? null,
    representatives: region.representatives.slice(0, 3),
    topFacets: region.topFacets,
    contrasts: regionContrastSummary(region),
    spatialMap: regionSpatialMap(region),
  })),
};
const defaultNode = sceneNodes.find((node) => node.neighbors.length > 0) ?? sceneNodes[0];
const defaultNeighbors = defaultNode?.neighbors.slice(0, 6) ?? [];
const defaultRegion = valueLshRegions[0];
---

<div class={`value-lsh-three ${variant}`} data-value-lsh-three style={`--value-graph-height:${height}px;`}>
  <script type="application/json" data-value-lsh-points set:html={JSON.stringify(scenePayload)} is:inline />
  <div class="value-lsh-stage" data-value-lsh-stage>
    <canvas data-value-lsh-canvas aria-label="Value LSH evidence triage graph"></canvas>
    <div class="value-lsh-fallback" data-value-lsh-fallback aria-hidden="true">
      <svg viewBox="0 0 1000 540" role="img" data-region-fallback-svg>
        <defs>
          <radialGradient id={`value-lsh-glow-${variant}`} cx="50%" cy="45%" r="62%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="72%" stop-color="#FFF5EB" />
            <stop offset="100%" stop-color="#FAF7F2" />
          </radialGradient>
        </defs>
        <rect width="1000" height="540" rx="8" fill={`url(#value-lsh-glow-${variant})`} />
        <circle cx="500" cy="270" r="212" fill="none" stroke="rgba(0,0,0,.08)" />
        <ellipse cx="500" cy="270" rx="360" ry="120" fill="none" stroke="rgba(0,122,255,.12)" />
        <ellipse cx="500" cy="270" rx="210" ry="318" fill="none" stroke="rgba(255,91,0,.12)" transform="rotate(-18 500 270)" />
        <g data-region-fallback-route></g>
        {fallbackNodes.map((node) => (
          <circle
            cx={node.sx}
            cy={node.sy}
            r={node.r}
            fill={classColors[node.valueClass]}
            fill-opacity={node.opacity}
          />
        ))}
        {fallbackRegionOverlays.map((region) => (
          <g data-region-fallback-target={region.kind} tabindex="0" role="button" aria-label={`${region.rank}. ${region.rankingLabel}`}>
            <rect
              x={region.boxX}
              y={region.boxY}
              width={region.boxWidth}
              height={region.boxHeight}
              rx="18"
              fill="none"
              stroke={region.color}
              stroke-opacity="0.34"
              stroke-width="2"
              stroke-dasharray="8 6"
            />
            <circle cx={region.centerX} cy={region.centerY} r="6" fill={region.color} fill-opacity="0.9" />
            <path
              d={`M ${region.centerX + 8} ${region.centerY - 8} L ${region.labelX - 18} ${region.labelY + 14}`}
              fill="none"
              stroke={region.color}
              stroke-opacity="0.42"
              stroke-width="2"
            />
            <g transform={`translate(${region.labelX}, ${region.labelY})`}>
              <rect x="0" y="0" width="146" height="40" rx="16" fill="rgba(255,252,248,.92)" stroke="rgba(20,25,34,.10)" />
              <circle cx="18" cy="20" r="10" fill="rgba(246,239,230,.98)" />
              <text x="18" y="24" text-anchor="middle" font-size="11" font-weight="700" fill="#1f2430">{region.rank}</text>
              <text x="36" y="16" font-size="12" font-weight="700" fill="#1f2430">{region.arrow} {region.rankingLabel}</text>
              <text x="36" y="29" font-size="10" font-weight="600" fill="rgba(31,36,48,.66)">{region.clusterId}</text>
            </g>
          </g>
        ))}
      </svg>
    </div>
    <div class="value-lsh-stage-guide" data-region-guide aria-live="polite">
      <strong data-region-guide-label>Guiding to ↗ 前沿证据</strong>
      <span data-region-guide-detail>camera focus + cluster spotlight</span>
      <div class="value-lsh-stage-guide-badges" data-region-guide-badges></div>
    </div>
    <div class="value-lsh-arc-guide" data-region-arc-guide aria-hidden="true">
      <span class="value-lsh-arc-guide-kicker" data-region-arc-kicker>3D route cue</span>
      <strong data-region-arc-title>↗ 前沿证据</strong>
      <p data-region-arc-detail>camera focus + cluster spotlight</p>
      <div class="value-lsh-arc-guide-badges" data-region-arc-badges></div>
    </div>
    <div class="value-lsh-region-markers" data-region-markers aria-label="Evidence region anchors"></div>
  </div>
  {variant === 'full' ? (
    <div class="value-lsh-region-rail" aria-label="Evidence region guide">
      {valueLshRegions.map((region, index) => (
        <button type="button" class="value-region-card" data-region-button data-region-id={region.kind}>
          <div class="value-region-card-head">
            <span class="value-region-rank">{index + 1}</span>
            <strong>{region.arrow} {region.rankingLabel}</strong>
            <small>{region.clusterId}</small>
          </div>
          <p>{region.meaning}</p>
          <p><strong>English:</strong> {regionMeaningEn(region)}</p>
          <div class="value-region-card-meta">
            <span>{metricLabels[region.metricKey] || region.metricKey} {region.metricValue.toFixed(2)}</span>
            <span>{region.nodeCount} nodes</span>
          </div>
          <div class="value-chip-row region">
            {region.topFacets.slice(0, 3).map((facet) => <span>{facet.label}</span>)}
          </div>
        </button>
      ))}
    </div>
  ) : null}
  {variant === 'full' ? (
    <div class="value-lsh-region-tour" aria-label="Evidence region tour">
      <div class="value-lsh-region-tour-copy">
        <strong>Region tour</strong>
        <p data-region-status>1 / 3</p>
      </div>
      <div class="value-lsh-region-tour-actions">
        <button type="button" data-region-prev>Prev</button>
        <button type="button" data-region-next>Next</button>
      </div>
    </div>
  ) : null}
  {variant === 'full' && defaultRegion ? (
    <div class="value-lsh-region-summary-panel" data-region-summary-panel aria-label="Active evidence region summary">
      <div class="value-lsh-region-summary-head">
        <div>
          <span data-region-summary-cluster>Region focus · {defaultRegion.clusterId}</span>
          <h4 data-region-summary-label>{defaultRegion.arrow} {defaultRegion.rankingLabel}</h4>
        </div>
        <div class="value-lsh-region-summary-metrics">
          <strong data-region-summary-metric-value>{defaultRegion.metricValue.toFixed(2)}</strong>
          <span data-region-summary-metric-key>{metricLabels[defaultRegion.metricKey] || defaultRegion.metricKey}</span>
        </div>
      </div>
      <p class="value-lsh-region-summary-note" data-region-summary-note>{defaultRegion.summary}</p>
      <p data-region-summary-meaning>{defaultRegion.meaning}</p>
      <p data-region-summary-meaning-en><strong>English:</strong> {regionMeaningEn(defaultRegion)}</p>
      <div class="value-chip-row region-summary" data-region-summary-facets>
        {defaultRegion.topFacets.slice(0, 4).map((facet) => <span>{facet.label}</span>)}
      </div>
      <div class="value-lsh-region-summary-grid">
        <div><strong data-region-summary-frontier>{defaultRegion.metrics.frontier.toFixed(2)}</strong><span>frontier</span></div>
        <div><strong data-region-summary-attention>{defaultRegion.metrics.attention.toFixed(2)}</strong><span>attention</span></div>
        <div><strong data-region-summary-quality>{defaultRegion.metrics.quality.toFixed(2)}</strong><span>evidence density</span></div>
        <div><strong data-region-summary-nodes>{defaultRegion.nodeCount}</strong><span>nodes</span></div>
      </div>
      <div class="value-lsh-region-rationale">
        <h5>Why this zone</h5>
        <ul data-region-summary-rationale>
          {defaultRegion.topFacets.slice(0, 4).map((facet) => (
            <li>
              <div class="value-lsh-region-rationale-head">
                <strong>{facet.label}</strong>
                <span>{facet.average.toFixed(2)}</span>
              </div>
              <div class="value-lsh-region-rationale-bar"><i style={`width:${Math.max(16, Math.round(Math.abs(facet.average) * 100))}%`}></i></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="value-lsh-region-contrast">
        <h5>How it differs from other priority-review regions</h5>
        <ul data-region-summary-contrasts>
          {regionContrastSummary(defaultRegion).map((contrast) => (
            <li>
              <div class="value-lsh-region-contrast-head">
                <strong>{contrast.arrow} {contrast.rankingLabel}</strong>
                <span>{contrast.clusterId}</span>
              </div>
              <p>{contrast.separationNote} {contrast.metricNote}</p>
              <div class="value-lsh-region-contrast-strip">
                {contrast.axisDiffs.map((item) => (
                  <span>{item.axis.toUpperCase()} {formatSignedDelta(item.delta)}</span>
                ))}
              </div>
              <div class="value-lsh-region-contrast-strip metric">
                {contrast.metricDiffs.map((item) => (
                  <span>{item.label} {formatSignedDelta(item.delta)}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="value-lsh-region-spatial-map">
        <div class="value-lsh-region-spatial-map-head">
          <h5>Where the other priority-review regions sit</h5>
          <span>current projection view</span>
        </div>
        <svg
          viewBox={`0 0 ${regionSpatialMap(defaultRegion).width} ${regionSpatialMap(defaultRegion).height}`}
          data-region-summary-map
          aria-label="Active region spatial delta map"
        >
          {regionSpatialMap(defaultRegion).links.map((link) => (
            <path
              d={`M ${link.fromX} ${link.fromY} L ${link.toX} ${link.toY}`}
              fill="none"
              stroke="rgba(20,25,34,.18)"
              stroke-width="1.5"
              stroke-dasharray="5 4"
            />
          ))}
          {regionSpatialMap(defaultRegion).nodes.map((item) => (
            <g>
              <circle
                cx={item.x}
                cy={item.y}
                r={item.current ? 9 : 7}
                data-region-map-node={item.kind}
                fill={item.current ? defaultRegion.color : 'rgba(255,252,248,.98)'}
                stroke={item.current ? defaultRegion.color : 'rgba(20,25,34,.18)'}
                stroke-width={item.current ? 2.5 : 1.5}
              />
              <text x={item.x} y={item.y + 3} text-anchor="middle" font-size="10" font-weight="700" fill={item.current ? '#fff' : '#1f2430'}>{item.arrow}</text>
              <text x={item.x + 12} y={item.y - 8} font-size="10" font-weight="700" fill="#1f2430">{item.rankingLabel}</text>
              <text x={item.x + 12} y={item.y + 5} font-size="9" font-weight="600" fill="rgba(31,36,48,.66)">{item.clusterId}</text>
            </g>
          ))}
        </svg>
      </div>
      <h5>Representative materials</h5>
      <ul data-region-summary-representatives>
        {defaultRegion.representatives.slice(0, 3).map((representative) => (
          <li>
            <div class="value-lsh-region-representative-head">
              <strong>{representative.url ? <a href={representative.url} target="_blank" rel="noopener">{representative.title}</a> : representative.title}</strong>
              <button type="button" class="value-lsh-region-focus-button" data-region-focus-node={representative.id}>focus</button>
            </div>
            <span>{representative.type} · triage score {representative.value_score.toFixed(2)} · confidence {representative.confidence.toFixed(2)}</span>
          </li>
        ))}
      </ul>
    </div>
  ) : null}
  {variant === 'full' ? (
    <div class="value-lsh-region-compare" aria-label="Evidence region comparison">
      {valueLshRegions.map((region) => (
        <button type="button" class="value-lsh-region-compare-card" data-region-compare-id={region.kind}>
          <div class="value-lsh-region-compare-head">
            <strong>{region.arrow} {region.rankingLabel}</strong>
            <span>{region.clusterId}</span>
          </div>
          <p>{region.summary}</p>
          <p><strong>English:</strong> {regionSummaryEn(region)}</p>
          <div class="value-lsh-region-compare-grid">
            <div><strong>{region.metrics.frontier.toFixed(2)}</strong><span>frontier</span></div>
            <div><strong>{region.metrics.attention.toFixed(2)}</strong><span>attention</span></div>
            <div><strong>{region.metrics.quality.toFixed(2)}</strong><span>evidence density</span></div>
            <div><strong>{region.nodeCount}</strong><span>nodes</span></div>
          </div>
        </button>
      ))}
    </div>
  ) : null}
  <div class="value-lsh-legend" aria-label="Value LSH triage legend">
    {(Object.keys(classLabels) as ValueClass[]).map((valueClass) => (
      <span><i style={`background:${classColors[valueClass]}`}></i>{classLabels[valueClass]} <strong>{graphSnapshot.summary.value_classes[valueClass].toLocaleString()}</strong></span>
    ))}
    <span><i class="projection-dot"></i>{graphSnapshot.method.provider} + {graphSnapshot.method.projection.toUpperCase()}</span>
    <span><i class="cluster-dot"></i>{graphSnapshot.summary.embedding_clusters} facet-vector k-means clusters</span>
    <span><i class="node-dot"></i>{graphSnapshot.summary.nodes.toLocaleString()} nodes</span>
  </div>
  <div class="value-lsh-inspector" data-value-lsh-inspector aria-live="polite">
    {defaultNode ? (
      <article class="value-lsh-selected">
        <div class="value-lsh-selected-head">
          <div>
            <span>{defaultNode.type} · {defaultNode.valueClass}</span>
            <h3>{defaultNode.primaryUrl ? <a href={defaultNode.primaryUrl} target="_blank" rel="noopener">{defaultNode.title}</a> : defaultNode.title}</h3>
          </div>
          <div class="value-lsh-selected-actions">
            {defaultNode.reportUrl ? <a href={defaultNode.reportUrl} target="_blank" rel="noopener">report</a> : null}
            {defaultNode.url ? <a href={defaultNode.url} target="_blank" rel="noopener">source</a> : null}
            {defaultNode.rawUrl ? <a href={defaultNode.rawUrl} target="_blank" rel="noopener">raw</a> : null}
          </div>
        </div>
        <div class="value-lsh-selected-metrics">
          <div><strong>{defaultNode.score.toFixed(2)}</strong><span>triage score</span></div>
          <div><strong>{defaultNode.confidence.toFixed(2)}</strong><span>confidence</span></div>
          <div><strong>{defaultNode.embeddingCluster}</strong><span>k-means cluster</span></div>
        </div>
        <p>{defaultNode.rawUrl ? <a href={defaultNode.rawUrl} target="_blank" rel="noopener">{defaultNode.sourcePath || defaultNode.id}</a> : (defaultNode.sourcePath || defaultNode.id)}{defaultNode.lshCluster ? ` · ${defaultNode.lshCluster}` : ''}</p>
        <h4>LSH neighbors</h4>
        <p>共享 hash bands 的近邻召回，不等于上面的 k-means cluster 标签。</p>
        <ul>
          {defaultNeighbors.length ? defaultNeighbors.map((neighbor) => (
            <li>
              <strong>{neighbor.reportUrl || neighbor.url || neighbor.rawUrl ? <a href={neighbor.reportUrl || neighbor.url || neighbor.rawUrl || undefined} target="_blank" rel="noopener">{neighbor.title}</a> : neighbor.title}</strong>
              <span>{neighbor.type} · triage score {neighbor.value_score.toFixed(2)} · shared buckets {neighbor.shared_bucket_count}</span>
              <small>{neighbor.shared_features.slice(0, 4).join(' / ')}</small>
            </li>
          )) : (
            <li><span>当前采样内没有可展示邻居。</span></li>
          )}
        </ul>
      </article>
    ) : (
      <div class="value-lsh-inspector-empty">No nodes available.</div>
    )}
  </div>
</div>

<script>
  import * as THREE from 'three';

  type SceneNeighbor = {
    id: string;
    title: string;
    type: string;
    value_score: number;
    value_class: string;
    shared_bucket_count: number;
    shared_features: string[];
    relation_weight: number;
    url?: string | null;
    rawUrl?: string | null;
    reportUrl?: string | null;
  };
  type SceneNode = {
    id: string;
    type: string;
    title: string;
    url?: string | null;
    sourcePath?: string | null;
    rawUrl?: string | null;
    reportUrl?: string | null;
    primaryUrl?: string | null;
    score: number;
    confidence: number;
    valueClass: string;
    embeddingCluster: string;
    lshCluster?: string | null;
    neighbors: SceneNeighbor[];
    x: number;
    y: number;
    z: number;
  };
  type SceneRegion = {
    kind: string;
    title: string;
    shortLabel: string;
    arrow: string;
    color: string;
    clusterId: string;
    rankingLabel: string;
    metricKey: string;
    metricValue: number;
    meaning: string;
    meaningEn: string;
    summary: string;
    summaryEn: string;
    metrics?: {
      value: number;
      confidence: number;
      frontier: number;
      attention: number;
      quality: number;
      highValueShare: number;
      githubPaperShare: number;
      socialBlogShare: number;
    };
    nodeCount: number;
    fallbackOverlay?: {
      centerX: number;
      centerY: number;
      boxX: number;
      boxY: number;
      boxWidth: number;
      boxHeight: number;
      labelX: number;
      labelY: number;
    };
    centroid: { x: number; y: number; z: number };
    bounds: {
      min: { x: number; y: number; z: number };
      max: { x: number; y: number; z: number };
    };
    representativeId?: string | null;
    representatives?: {
      id: string;
      title: string;
      type: string;
      url?: string | null;
      value_score: number;
      confidence: number;
      source_path?: string | null;
    }[];
    topFacets?: { id: string; label: string; average: number }[];
    contrasts?: {
      kind: string;
      arrow: string;
      rankingLabel: string;
      clusterId: string;
      axisDiffs: { axis: 'x' | 'y' | 'z'; delta: number }[];
      metricDiffs: { key: 'frontier' | 'attention' | 'quality'; label: string; delta: number }[];
      separationNote: string;
      metricNote: string;
    }[];
    spatialMap?: {
      width: number;
      height: number;
      nodes: {
        kind: string;
        arrow: string;
        rankingLabel: string;
        clusterId: string;
        x: number;
        y: number;
        current: boolean;
      }[];
      links: {
        fromX: number;
        fromY: number;
        toX: number;
        toY: number;
        kind: string;
      }[];
    };
  };
  type ScenePayload = { variant?: string; nodes?: SceneNode[]; colors: Record<string, string>; regions?: SceneRegion[] };

  const roots = document.querySelectorAll('[data-value-lsh-three]');
  roots.forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.valueLshReady === 'true') return;
    root.dataset.valueLshReady = 'true';

    const payloadElement = root.querySelector('[data-value-lsh-points]');
    const stage = root.querySelector('[data-value-lsh-stage]');
    const canvas = root.querySelector('[data-value-lsh-canvas]');
    const inspector = root.querySelector('[data-value-lsh-inspector]');
    const markerLayer = root.querySelector('[data-region-markers]');
    if (!(payloadElement instanceof HTMLScriptElement) || !(stage instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement) || !(inspector instanceof HTMLElement) || !(markerLayer instanceof HTMLElement)) return;

    let payload: ScenePayload;
    try {
      payload = JSON.parse(payloadElement.textContent || '{}');
    } catch {
      return;
    }
    const nodes: SceneNode[] = Array.isArray(payload.nodes) ? payload.nodes : [];
    const regions: SceneRegion[] = Array.isArray(payload.regions) ? payload.regions : [];
    if (!nodes.length) return;

    let renderer: THREE.WebGLRenderer | null = null;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    } catch {
      renderer = null;
    }
    const hasWebGL = Boolean(renderer);

    renderer?.setClearColor(0x000000, 0);
    renderer?.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(44, 1, 0.1, 100);
    camera.position.set(0, 0, payload.variant === 'compact' ? 4.25 : 4.75);
    const raycaster = new THREE.Raycaster();
    raycaster.params.Points.threshold = payload.variant === 'compact' ? 0.1 : 0.08;
    const pointer = new THREE.Vector2();
    const nodeById = new Map(nodes.map((node) => [node.id, node]));

    const group = new THREE.Group();
    group.rotation.x = -0.26;
    group.rotation.y = 0.34;
    scene.add(group);

    const positions = new Float32Array(nodes.length * 3);
    const colors = new Float32Array(nodes.length * 3);
    const baseColors = new Float32Array(nodes.length * 3);
    const color = new THREE.Color();
    nodes.forEach((node: SceneNode, index: number) => {
      const i = index * 3;
      positions[i] = node.x * 1.72;
      positions[i + 1] = node.y * 1.72;
      positions[i + 2] = node.z * 1.72;
      color.set(payload.colors[node.valueClass] || '#007AFF');
      colors[i] = color.r;
      colors[i + 1] = color.g;
      colors[i + 2] = color.b;
      baseColors[i] = color.r;
      baseColors[i + 1] = color.g;
      baseColors[i + 2] = color.b;
    });

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
      size: payload.variant === 'compact' ? 0.072 : 0.062,
      vertexColors: true,
      transparent: true,
      opacity: 0.96,
      depthWrite: false,
      sizeAttenuation: true,
    });
    const pointsCloud = new THREE.Points(geometry, material);
    group.add(pointsCloud);

    const highlightGroup = new THREE.Group();
    group.add(highlightGroup);
    const regionGroup = new THREE.Group();
    group.add(regionGroup);
    const transitionGroup = new THREE.Group();
    group.add(transitionGroup);

    const escapeHtml = (value: unknown) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
    const metricLabel = (key?: string | null) => ({
      frontier: 'frontier evidence',
      attention: 'attention signal',
      quality: 'evidence density',
    }[String(key || '')] || String(key || 'triage metric'));
    const renderLink = (href: string | null | undefined, label: string) => href
      ? `<a href="${escapeHtml(href)}" target="_blank" rel="noopener">${escapeHtml(label)}</a>`
      : escapeHtml(label);
    const formatSignedDeltaLabel = (value: number) => `${value > 0 ? '+' : value < 0 ? '' : ''}${value.toFixed(2)}`;

    const nodePosition = (node: SceneNode) => new THREE.Vector3(node.x * 1.72, node.y * 1.72, node.z * 1.72);
    const regionPosition = (region: SceneRegion) => new THREE.Vector3(region.centroid.x * 1.72, region.centroid.y * 1.72, region.centroid.z * 1.72);
    const focusNodeInView = (node: SceneNode) => {
      const focusVector = nodePosition(node).normalize();
      const planar = Math.sqrt(focusVector.x ** 2 + focusVector.z ** 2) || 1;
      const focusTilt = -Math.atan2(focusVector.y, planar) - 0.08;
      const focusTurn = Math.atan2(focusVector.x, focusVector.z) - 0.04;
      targetX = Math.max(-1.15, Math.min(1.15, focusTilt));
      targetY = focusTurn;
    };
    const focusRegion = (region: SceneRegion) => {
      const focusVector = regionPosition(region).normalize();
      const planar = Math.sqrt(focusVector.x ** 2 + focusVector.z ** 2) || 1;
      const focusTilt = -Math.atan2(focusVector.y, planar) - 0.12;
      const focusTurn = Math.atan2(focusVector.x, focusVector.z) - 0.08;
      targetX = Math.max(-1.15, Math.min(1.15, focusTilt));
      targetY = focusTurn;
    };

    const regionSummaryPanel = root.querySelector('[data-region-summary-panel]');
    const regionSummaryCluster = root.querySelector('[data-region-summary-cluster]');
    const regionSummaryLabel = root.querySelector('[data-region-summary-label]');
    const regionSummaryMetricValue = root.querySelector('[data-region-summary-metric-value]');
    const regionSummaryMetricKey = root.querySelector('[data-region-summary-metric-key]');
    const regionSummaryNote = root.querySelector('[data-region-summary-note]');
    const regionSummaryMeaning = root.querySelector('[data-region-summary-meaning]');
    const regionSummaryMeaningEn = root.querySelector('[data-region-summary-meaning-en]');
    const regionSummaryFacets = root.querySelector('[data-region-summary-facets]');
    const regionSummaryFrontier = root.querySelector('[data-region-summary-frontier]');
    const regionSummaryAttention = root.querySelector('[data-region-summary-attention]');
    const regionSummaryQuality = root.querySelector('[data-region-summary-quality]');
    const regionSummaryNodes = root.querySelector('[data-region-summary-nodes]');
    const regionSummaryRationale = root.querySelector('[data-region-summary-rationale]');
    const regionSummaryContrasts = root.querySelector('[data-region-summary-contrasts]');
    const regionSummaryMap = root.querySelector('[data-region-summary-map]');
    const regionSummaryRepresentatives = root.querySelector('[data-region-summary-representatives]');
    const regionGuide = root.querySelector('[data-region-guide]');
    const regionGuideLabel = root.querySelector('[data-region-guide-label]');
    const regionGuideDetail = root.querySelector('[data-region-guide-detail]');
    const regionGuideBadges = root.querySelector('[data-region-guide-badges]');
    const regionArcGuide = root.querySelector('[data-region-arc-guide]');
    const regionArcGuideKicker = root.querySelector('[data-region-arc-kicker]');
    const regionArcGuideTitle = root.querySelector('[data-region-arc-title]');
    const regionArcGuideDetail = root.querySelector('[data-region-arc-detail]');
    const regionArcGuideBadges = root.querySelector('[data-region-arc-badges]');
    const fallbackSurface = root.querySelector('[data-value-lsh-fallback]');
    const fallbackSvg = root.querySelector('[data-region-fallback-svg]');
    const fallbackRouteLayer = root.querySelector('[data-region-fallback-route]');
    const fallbackTargets = [...root.querySelectorAll('[data-region-fallback-target]')].filter((element): element is SVGGElement => element instanceof SVGGElement);

    const updateRegionSummaryPanel = (region?: SceneRegion | null, previousRegion?: SceneRegion | null) => {
      if (!region || !(regionSummaryPanel instanceof HTMLElement)) return;
      if (regionSummaryCluster instanceof HTMLElement) regionSummaryCluster.textContent = `Region focus · ${region.clusterId}`;
      if (regionSummaryLabel instanceof HTMLElement) regionSummaryLabel.textContent = `${region.arrow} ${region.rankingLabel}`;
      if (regionSummaryMetricValue instanceof HTMLElement) regionSummaryMetricValue.textContent = Number(region.metricValue).toFixed(2);
      if (regionSummaryMetricKey instanceof HTMLElement) regionSummaryMetricKey.textContent = metricLabel(region.metricKey);
      if (regionSummaryNote instanceof HTMLElement) regionSummaryNote.textContent = region.summary;
      if (regionSummaryMeaning instanceof HTMLElement) regionSummaryMeaning.textContent = region.meaning;
      if (regionSummaryMeaningEn instanceof HTMLElement) regionSummaryMeaningEn.innerHTML = `<strong>English:</strong> ${escapeHtml(region.meaningEn || region.summaryEn || '')}`;
      if (regionSummaryFrontier instanceof HTMLElement) regionSummaryFrontier.textContent = Number(region.metrics?.frontier || 0).toFixed(2);
      if (regionSummaryAttention instanceof HTMLElement) regionSummaryAttention.textContent = Number(region.metrics?.attention || 0).toFixed(2);
      if (regionSummaryQuality instanceof HTMLElement) regionSummaryQuality.textContent = Number(region.metrics?.quality || 0).toFixed(2);
      if (regionSummaryNodes instanceof HTMLElement) regionSummaryNodes.textContent = String(region.nodeCount);
      if (regionSummaryFacets instanceof HTMLElement) {
        regionSummaryFacets.innerHTML = (region.topFacets || []).slice(0, 4).map((facet) => `<span>${escapeHtml(facet.label)}</span>`).join('');
      }
      if (regionSummaryRationale instanceof HTMLElement) {
        regionSummaryRationale.innerHTML = (region.topFacets || []).slice(0, 4).map((facet) => `
          <li>
            <div class="value-lsh-region-rationale-head">
              <strong>${escapeHtml(facet.label)}</strong>
              <span>${Number(facet.average).toFixed(2)}</span>
            </div>
            <div class="value-lsh-region-rationale-bar"><i style="width:${Math.max(16, Math.round(Math.abs(Number(facet.average)) * 100))}%"></i></div>
          </li>
        `).join('');
      }
      if (regionSummaryContrasts instanceof HTMLElement) {
        regionSummaryContrasts.innerHTML = (region.contrasts || []).map((contrast) => `
          <li>
            <div class="value-lsh-region-contrast-head">
              <strong>${escapeHtml(`${contrast.arrow} ${contrast.rankingLabel}`)}</strong>
              <span>${escapeHtml(contrast.clusterId)}</span>
            </div>
            <p>${escapeHtml(contrast.separationNote)} ${escapeHtml(contrast.metricNote)}</p>
            <div class="value-lsh-region-contrast-strip">
              ${(contrast.axisDiffs || []).map((item) => `<span>${escapeHtml(item.axis.toUpperCase())} ${formatSignedDeltaLabel(Number(item.delta || 0))}</span>`).join('')}
            </div>
            <div class="value-lsh-region-contrast-strip metric">
              ${(contrast.metricDiffs || []).map((item) => `<span>${escapeHtml(item.label)} ${formatSignedDeltaLabel(Number(item.delta || 0))}</span>`).join('')}
            </div>
          </li>
        `).join('');
      }
      if (regionSummaryMap instanceof SVGElement && region.spatialMap) {
        const transitionContrast = previousRegion && previousRegion.kind !== region.kind
          ? (region.contrasts || []).find((item) => item.kind === previousRegion.kind)
          : null;
        const transitionLink = transitionContrast && previousRegion
          ? (region.spatialMap.links || []).find((item) => item.kind === previousRegion.kind)
          : null;
        const transitionBadges = transitionContrast
          ? [
              transitionContrast.axisDiffs?.[0] ? `${transitionContrast.axisDiffs[0].axis.toUpperCase()} ${formatSignedDeltaLabel(Number(transitionContrast.axisDiffs[0].delta || 0))}` : '',
              transitionContrast.metricDiffs?.[0] ? `${transitionContrast.metricDiffs[0].label} ${formatSignedDeltaLabel(Number(transitionContrast.metricDiffs[0].delta || 0))}` : '',
            ].filter(Boolean)
          : [];
        regionSummaryMap.setAttribute('viewBox', `0 0 ${region.spatialMap.width} ${region.spatialMap.height}`);
        regionSummaryMap.innerHTML = `
          ${transitionLink ? `
            <defs>
              <marker
                id="region-map-arrow-${escapeHtml(region.kind)}"
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" fill="${escapeHtml(region.color)}"></path>
              </marker>
            </defs>
          ` : ''}
          ${(region.spatialMap.links || []).map((link) => `
            <path
              d="M ${Number(link.fromX).toFixed(1)} ${Number(link.fromY).toFixed(1)} L ${Number(link.toX).toFixed(1)} ${Number(link.toY).toFixed(1)}"
              fill="none"
              stroke="${transitionLink?.kind === link.kind ? escapeHtml(region.color) : 'rgba(20,25,34,.18)'}"
              stroke-width="${transitionLink?.kind === link.kind ? '3' : '1.5'}"
              stroke-dasharray="${transitionLink?.kind === link.kind ? 'none' : '5 4'}"
              stroke-linecap="round"
              marker-end="${transitionLink?.kind === link.kind ? `url(#region-map-arrow-${escapeHtml(region.kind)})` : 'none'}"
              data-region-map-link="${escapeHtml(link.kind)}"
            ></path>
          `).join('')}
          ${transitionLink && transitionBadges.length ? `
            <g data-region-map-transition-group="true">
              <rect
                x="${Number(((transitionLink.fromX + transitionLink.toX) / 2) - 44).toFixed(1)}"
                y="${Number(((transitionLink.fromY + transitionLink.toY) / 2) - 14).toFixed(1)}"
                rx="9"
                width="88"
                height="28"
                fill="rgba(255,252,248,.96)"
                stroke="${escapeHtml(region.color)}"
                stroke-width="1.5"
              ></rect>
              <text
                x="${Number((transitionLink.fromX + transitionLink.toX) / 2).toFixed(1)}"
                y="${Number(((transitionLink.fromY + transitionLink.toY) / 2) - 2).toFixed(1)}"
                text-anchor="middle"
                font-size="9"
                font-weight="700"
                fill="#1f2430"
                data-region-map-transition-badge="axis"
              >${escapeHtml(transitionBadges[0] || '')}</text>
              <text
                x="${Number((transitionLink.fromX + transitionLink.toX) / 2).toFixed(1)}"
                y="${Number(((transitionLink.fromY + transitionLink.toY) / 2) + 9).toFixed(1)}"
                text-anchor="middle"
                font-size="8"
                font-weight="700"
                fill="rgba(31,36,48,.68)"
                data-region-map-transition-badge="metric"
              >${escapeHtml(transitionBadges[1] || '')}</text>
            </g>
          ` : ''}
          ${transitionLink ? `
            <circle
              cx="${Number(transitionLink.toX).toFixed(1)}"
              cy="${Number(transitionLink.toY).toFixed(1)}"
              r="12"
              fill="none"
              stroke="${escapeHtml(region.color)}"
              stroke-width="1.5"
              stroke-opacity="0.3"
              data-region-map-target-ring="true"
            ></circle>
            <circle
              cx="${Number(transitionLink.fromX).toFixed(1)}"
              cy="${Number(transitionLink.fromY).toFixed(1)}"
              r="10"
              fill="none"
              stroke="rgba(20,25,34,.28)"
              stroke-width="1.2"
              stroke-dasharray="3 3"
              data-region-map-source-ring="true"
            ></circle>
          ` : ''}
          ${(region.spatialMap.nodes || []).map((item) => `
            <g>
              <circle
                cx="${Number(item.x).toFixed(1)}"
                cy="${Number(item.y).toFixed(1)}"
                r="${item.current ? 9 : 7}"
                data-region-map-node="${escapeHtml(item.kind)}"
                fill="${item.current ? escapeHtml(region.color) : 'rgba(255,252,248,.98)'}"
                stroke="${item.current ? escapeHtml(region.color) : 'rgba(20,25,34,.18)'}"
                stroke-width="${item.current ? 2.5 : 1.5}"
              ></circle>
              <text x="${Number(item.x).toFixed(1)}" y="${Number(item.y + 3).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="700" fill="${item.current ? '#fff' : '#1f2430'}">${escapeHtml(item.arrow)}</text>
              <text x="${Number(item.x + 12).toFixed(1)}" y="${Number(item.y - 8).toFixed(1)}" font-size="10" font-weight="700" fill="#1f2430">${escapeHtml(item.rankingLabel)}</text>
              <text x="${Number(item.x + 12).toFixed(1)}" y="${Number(item.y + 5).toFixed(1)}" font-size="9" font-weight="600" fill="rgba(31,36,48,.66)">${escapeHtml(item.clusterId)}</text>
            </g>
          `).join('')}
        `;
      }
      if (regionSummaryRepresentatives instanceof HTMLElement) {
        regionSummaryRepresentatives.innerHTML = (region.representatives || []).map((representative) => `
          <li>
            <div class="value-lsh-region-representative-head">
              <strong>${renderLink(representative.url || null, representative.title)}</strong>
              <button type="button" class="value-lsh-region-focus-button" data-region-focus-node="${escapeHtml(representative.id)}">focus</button>
            </div>
            <span>${escapeHtml(representative.type)} · triage score ${Number(representative.value_score).toFixed(2)} · confidence ${Number(representative.confidence).toFixed(2)}</span>
          </li>
        `).join('');
      }
    };

    const renderInspector = (node: SceneNode) => {
      const title = renderLink(node.primaryUrl, node.title);
      const actions = [
        node.reportUrl ? `<a href="${escapeHtml(node.reportUrl)}" target="_blank" rel="noopener">report</a>` : '',
        node.url ? `<a href="${escapeHtml(node.url)}" target="_blank" rel="noopener">source</a>` : '',
        node.rawUrl ? `<a href="${escapeHtml(node.rawUrl)}" target="_blank" rel="noopener">raw</a>` : '',
      ].filter(Boolean).join('');
      const sourcePath = node.rawUrl
        ? `<a href="${escapeHtml(node.rawUrl)}" target="_blank" rel="noopener">${escapeHtml(node.sourcePath || node.id)}</a>`
        : escapeHtml(node.sourcePath || node.id);
      const neighbors = node.neighbors.slice(0, 6).map((neighbor) => `
        <li>
          <strong>${renderLink(neighbor.reportUrl || neighbor.url || neighbor.rawUrl, neighbor.title)}</strong>
          <span>${escapeHtml(neighbor.type)} · triage score ${Number(neighbor.value_score).toFixed(2)} · shared buckets ${neighbor.shared_bucket_count}</span>
          <small>${escapeHtml((neighbor.shared_features || []).slice(0, 4).join(' / '))}</small>
        </li>
      `).join('');
      inspector.innerHTML = `
        <article class="value-lsh-selected">
          <div class="value-lsh-selected-head">
            <div>
              <span>${escapeHtml(node.type)} · ${escapeHtml(node.valueClass)}</span>
              <h3>${title}</h3>
            </div>
            <div class="value-lsh-selected-actions">${actions}</div>
          </div>
          <div class="value-lsh-selected-metrics">
            <div><strong>${Number(node.score).toFixed(2)}</strong><span>triage score</span></div>
            <div><strong>${Number(node.confidence).toFixed(2)}</strong><span>confidence</span></div>
            <div><strong>${escapeHtml(node.embeddingCluster)}</strong><span>k-means cluster</span></div>
          </div>
          <p>${sourcePath}${node.lshCluster ? ` · ${escapeHtml(node.lshCluster)}` : ''}</p>
          <h4>LSH neighbors</h4>
          <p>共享 hash bands 的近邻召回，不等于上面的 k-means cluster 标签。</p>
          <ul>${neighbors || '<li><span>当前采样内没有可展示邻居。</span></li>'}</ul>
        </article>
      `;
    };

    const regionButtons = [...root.querySelectorAll('[data-region-button]')].filter((element): element is HTMLButtonElement => element instanceof HTMLButtonElement);
    const regionCompareButtons = [...root.querySelectorAll('[data-region-compare-id]')].filter((element): element is HTMLButtonElement => element instanceof HTMLButtonElement);
    const regionVisuals = new Map<string, THREE.Group>();
    const regionMarkers = new Map<string, HTMLButtonElement>();
    const regionPrevButton = root.querySelector('[data-region-prev]');
    const regionNextButton = root.querySelector('[data-region-next]');
    const regionStatus = root.querySelector('[data-region-status]');
    let activeRegionIndex = 0;
    let activeRegionId: string | null = null;
    const mutedColor = new THREE.Color('#d8d1c7');
    const setMaterialOpacity = (material: THREE.Material | THREE.Material[], opacity: number) => {
      const materials = Array.isArray(material) ? material : [material];
      materials.forEach((item) => {
        item.transparent = true;
        item.opacity = opacity;
      });
    };

    const applyRegionClusterFocus = (activeClusterId?: string | null) => {
      for (let index = 0; index < nodes.length; index += 1) {
        const i = index * 3;
        if (!activeClusterId) {
          colors[i] = baseColors[i];
          colors[i + 1] = baseColors[i + 1];
          colors[i + 2] = baseColors[i + 2];
          continue;
        }
        const isActiveCluster = nodes[index]?.embeddingCluster === activeClusterId;
        if (isActiveCluster) {
          colors[i] = Math.min(1, baseColors[i] * 1.08);
          colors[i + 1] = Math.min(1, baseColors[i + 1] * 1.08);
          colors[i + 2] = Math.min(1, baseColors[i + 2] * 1.08);
        } else {
          colors[i] = baseColors[i] * 0.22 + mutedColor.r * 0.78;
          colors[i + 1] = baseColors[i + 1] * 0.22 + mutedColor.g * 0.78;
          colors[i + 2] = baseColors[i + 2] * 0.22 + mutedColor.b * 0.78;
        }
      }
      const colorAttribute = geometry.getAttribute('color');
      if (colorAttribute) colorAttribute.needsUpdate = true;
      material.opacity = activeClusterId ? 0.98 : 0.96;
      material.size = activeClusterId
        ? (payload.variant === 'compact' ? 0.076 : 0.068)
        : (payload.variant === 'compact' ? 0.072 : 0.062);
      material.needsUpdate = true;
    };

    const setRegionActiveState = (activeId?: string | null) => {
      regionButtons.forEach((button) => {
        button.dataset.active = button.dataset.regionId === activeId ? 'true' : 'false';
      });
      regionCompareButtons.forEach((button) => {
        button.dataset.active = button.dataset.regionCompareId === activeId ? 'true' : 'false';
      });
      regionMarkers.forEach((marker, key) => {
        marker.dataset.active = key === activeId ? 'true' : 'false';
      });
      regionVisuals.forEach((visual, key) => {
        const isActive = key === activeId;
        const opacity = key === activeId ? 0.95 : 0.22;
        visual.children.forEach((child) => {
          const candidateMaterial = Reflect.get(child as object, 'material');
          if (candidateMaterial && candidateMaterial instanceof THREE.Material) {
            setMaterialOpacity(candidateMaterial, opacity);
          } else if (Array.isArray(candidateMaterial) && candidateMaterial.every((item) => item instanceof THREE.Material)) {
            setMaterialOpacity(candidateMaterial, opacity);
          }
          if (child instanceof THREE.ArrowHelper) {
            setMaterialOpacity(child.line.material, opacity);
            setMaterialOpacity(child.cone.material, opacity);
          }
          if (child instanceof THREE.Mesh && child.name === 'focusHalo') {
            child.scale.setScalar(isActive ? 1.28 : 1);
            setMaterialOpacity(child.material, isActive ? 0.82 : 0.08);
          }
        });
      });
      const currentIndex = regions.findIndex((region) => region.kind === activeId);
      if (currentIndex >= 0) activeRegionIndex = currentIndex;
      activeRegionId = activeId ?? null;
      if (regionStatus instanceof HTMLElement && regions.length) {
        const region = regions[activeRegionIndex];
        regionStatus.textContent = `${activeRegionIndex + 1} / ${regions.length} · ${region?.rankingLabel ?? ''} · ${region?.clusterId ?? ''}`;
      }
      if (regionPrevButton instanceof HTMLButtonElement) {
        regionPrevButton.disabled = regions.length <= 1;
      }
      if (regionNextButton instanceof HTMLButtonElement) {
        regionNextButton.disabled = regions.length <= 1;
      }
    };

    const createRegionVisual = (region: SceneRegion) => {
      const visual = new THREE.Group();
      const size = new THREE.Vector3(
        Math.max((region.bounds.max.x - region.bounds.min.x) * 1.72, 0.2),
        Math.max((region.bounds.max.y - region.bounds.min.y) * 1.72, 0.2),
        Math.max((region.bounds.max.z - region.bounds.min.z) * 1.72, 0.2),
      );
      const center = regionPosition(region);
      const outline = new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.BoxGeometry(size.x, size.y, size.z)),
        new THREE.LineBasicMaterial({ color: region.color, transparent: true, opacity: 0.22 }),
      );
      outline.position.copy(center);
      visual.add(outline);

      const arrowDirection = center.clone().normalize();
      const arrowOrigin = center.clone().addScaledVector(arrowDirection, -0.65);
      const arrow = new THREE.ArrowHelper(arrowDirection, arrowOrigin, 0.52, region.color, 0.12, 0.08);
      setMaterialOpacity(arrow.line.material, 0.22);
      setMaterialOpacity(arrow.cone.material, 0.22);
      visual.add(arrow);

      const anchor = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 14, 14),
        new THREE.MeshBasicMaterial({ color: region.color, transparent: true, opacity: 0.22 }),
      );
      anchor.position.copy(center);
      visual.add(anchor);

      const halo = new THREE.Mesh(
        new THREE.TorusGeometry(0.115, 0.012, 12, 42),
        new THREE.MeshBasicMaterial({ color: region.color, transparent: true, opacity: 0.08 }),
      );
      halo.name = 'focusHalo';
      halo.position.copy(center);
      halo.rotation.x = Math.PI / 2;
      visual.add(halo);
      return visual;
    };

    const createRegionMarker = (region: SceneRegion, index: number) => {
      const marker = document.createElement('button');
      marker.type = 'button';
      marker.className = 'value-region-marker';
      marker.dataset.regionId = region.kind;
      marker.setAttribute('aria-label', `${index + 1}. ${region.rankingLabel}`);
      marker.innerHTML = `
        <span class="value-region-marker-rank">${index + 1}</span>
        <span class="value-region-marker-copy">
          <strong>${escapeHtml(region.arrow)} ${escapeHtml(region.rankingLabel)}</strong>
          <small>${escapeHtml(region.clusterId)}</small>
        </span>
      `;
      marker.addEventListener('click', () => selectRegion(region));
      markerLayer.append(marker);
      regionMarkers.set(region.kind, marker);
    };

    regions.forEach((region) => {
      const visual = createRegionVisual(region);
      regionVisuals.set(region.kind, visual);
      regionGroup.add(visual);
    });
    regions.forEach((region, index) => createRegionMarker(region, index));

    const updateRegionMarkers = () => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      group.updateMatrixWorld(true);
      camera.updateMatrixWorld();
      regions.forEach((region) => {
        const marker = regionMarkers.get(region.kind);
        if (!marker) return;
        const world = group.localToWorld(regionPosition(region).clone());
        const projected = world.project(camera);
        const visible = projected.z > -1 && projected.z < 1;
        if (!visible) {
          marker.dataset.hidden = 'true';
          return;
        }
        const x = ((projected.x + 1) / 2) * width;
        const y = ((-projected.y + 1) / 2) * height;
        const markerWidth = marker.offsetWidth || 146;
        const markerHeight = marker.offsetHeight || 40;
        const clampedX = Math.min(width - markerWidth / 2 - 8, Math.max(markerWidth / 2 + 8, x));
        const clampedY = Math.min(height - markerHeight / 2 - 8, Math.max(markerHeight / 2 + 8, y));
        const insideViewport = clampedX >= markerWidth / 2 && clampedX <= width - markerWidth / 2 && clampedY >= markerHeight / 2 && clampedY <= height - markerHeight / 2;
        marker.dataset.hidden = insideViewport ? 'false' : 'true';
        if (insideViewport) {
          marker.style.transform = `translate(${clampedX}px, ${clampedY}px) translate(-50%, -50%)`;
        }
      });
    };

    const selectNode = (node: SceneNode) => {
      highlightGroup.clear();
      const selectedMaterial = new THREE.MeshBasicMaterial({ color: payload.colors[node.valueClass] || '#007AFF', transparent: true, opacity: 0.95 });
      const selected = new THREE.Mesh(new THREE.SphereGeometry(0.075, 18, 18), selectedMaterial);
      const origin = nodePosition(node);
      selected.position.copy(origin);
      highlightGroup.add(selected);

      const linePositions: number[] = [];
      node.neighbors.slice(0, 8).forEach((neighbor) => {
        const target = nodeById.get(neighbor.id);
        if (!target) return;
        const targetPosition = nodePosition(target);
        linePositions.push(origin.x, origin.y, origin.z, targetPosition.x, targetPosition.y, targetPosition.z);
        const targetMarker = new THREE.Mesh(
          new THREE.SphereGeometry(0.044, 14, 14),
          new THREE.MeshBasicMaterial({ color: payload.colors[target.valueClass] || '#007AFF', transparent: true, opacity: 0.78 })
        );
        targetMarker.position.copy(targetPosition);
        highlightGroup.add(targetMarker);
      });
      if (linePositions.length) {
        const lineGeometry = new THREE.BufferGeometry();
        lineGeometry.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
        highlightGroup.add(new THREE.LineSegments(
          lineGeometry,
          new THREE.LineBasicMaterial({ color: 0x1a1a1a, transparent: true, opacity: 0.24 })
        ));
      }
      renderInspector(node);
    };

    const focusRepresentativeNode = (nodeId: string) => {
      const node = nodeById.get(nodeId);
      if (!node) return;
      focusNodeInView(node);
      selectNode(node);
    };

    let transitionFade = 0;
    let transitionTravel = 0;
    let transitionCurve: THREE.QuadraticBezierCurve3 | null = null;
    let transitionGuidePoint: THREE.Vector3 | null = null;
    const showRegionTransition = (fromRegion: SceneRegion, toRegion: SceneRegion) => {
      transitionGroup.clear();
      const start = regionPosition(fromRegion);
      const end = regionPosition(toRegion);
      const midpoint = start.clone().add(end).multiplyScalar(0.5);
      const lift = midpoint.clone().normalize().multiplyScalar(0.35);
      lift.y += 0.22;
      const control = midpoint.add(lift);
      const curve = new THREE.QuadraticBezierCurve3(start, control, end);
      transitionCurve = curve;
      transitionGuidePoint = curve.getPoint(0.56);
      const points = curve.getPoints(42);

      const line = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(points),
        new THREE.LineBasicMaterial({ color: toRegion.color, transparent: true, opacity: 0.88 })
      );
      line.name = 'transitionArc';
      transitionGroup.add(line);

      const spark = new THREE.Mesh(
        new THREE.SphereGeometry(0.046, 12, 12),
        new THREE.MeshBasicMaterial({ color: toRegion.color, transparent: true, opacity: 0.95 })
      );
      spark.name = 'transitionSpark';
      spark.position.copy(end);
      transitionGroup.add(spark);

      const sourceHalo = new THREE.Mesh(
        new THREE.RingGeometry(0.075, 0.11, 32),
        new THREE.MeshBasicMaterial({ color: fromRegion.color, transparent: true, opacity: 0.45, side: THREE.DoubleSide })
      );
      sourceHalo.name = 'transitionSourceHalo';
      sourceHalo.position.copy(start);
      sourceHalo.lookAt(camera.position);
      transitionGroup.add(sourceHalo);

      const targetHalo = new THREE.Mesh(
        new THREE.RingGeometry(0.085, 0.125, 32),
        new THREE.MeshBasicMaterial({ color: toRegion.color, transparent: true, opacity: 0.7, side: THREE.DoubleSide })
      );
      targetHalo.name = 'transitionTargetHalo';
      targetHalo.position.copy(end);
      targetHalo.lookAt(camera.position);
      transitionGroup.add(targetHalo);

      transitionFade = 1;
      transitionTravel = 0;
    };

    const selectRegion = (region: SceneRegion) => {
      const previousRegion = regions.find((candidate) => candidate.kind === activeRegionId) || null;
      setRegionActiveState(region.kind);
      updateRegionSummaryPanel(region, previousRegion);
      focusRegion(region);
      applyRegionClusterFocus(region.clusterId);
      targetCameraZ = baseCameraZ - (motionEnabled ? 0.48 : 0.18);
      window.setTimeout(() => {
        targetCameraZ = baseCameraZ;
      }, motionEnabled ? 760 : 320);
      announceRegionGuide(region, previousRegion);
      updateArcGuide(region, previousRegion);
      updateFallbackStage(region, previousRegion);
      if (previousRegion && previousRegion.kind !== region.kind) {
        showRegionTransition(previousRegion, region);
      }
      const targetNode = (region.representativeId && nodeById.get(region.representativeId))
        || nodes.find((node) => node.embeddingCluster === region.clusterId)
        || nodes[0];
      if (targetNode) selectNode(targetNode);
    };

    const selectRegionByIndex = (nextIndex: number) => {
      if (!regions.length) return;
      const normalizedIndex = (nextIndex + regions.length) % regions.length;
      const region = regions[normalizedIndex];
      if (region) selectRegion(region);
    };

    const ringMaterial = new THREE.LineBasicMaterial({ color: 0x7a6b5e, transparent: true, opacity: 0.18 });
    const makeRing = (radius: number, rotation: [number, number, number]) => {
      const points = [];
      for (let i = 0; i < 144; i += 1) {
        const angle = (i / 144) * Math.PI * 2;
        points.push(new THREE.Vector3(Math.cos(angle) * radius, Math.sin(angle) * radius, 0));
      }
      const ring = new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(points), ringMaterial);
      ring.rotation.set(rotation[0], rotation[1], rotation[2]);
      return ring;
    };
    group.add(makeRing(1.94, [0, 0, 0]));
    group.add(makeRing(1.94, [Math.PI / 2, 0, 0]));
    group.add(makeRing(1.94, [0, Math.PI / 2, 0]));

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      const width = Math.max(1, Math.floor(rect.width));
      const height = Math.max(1, Math.floor(rect.height));
      renderer?.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    resize();
    new ResizeObserver(resize).observe(stage);

    let pointerActive = false;
    let pointerMoved = false;
    let lastX = 0;
    let lastY = 0;
    let targetX = group.rotation.x;
    let targetY = group.rotation.y;
    const baseCameraZ = payload.variant === 'compact' ? 4.25 : 4.75;
    let targetCameraZ = baseCameraZ;
    let guideTimer = 0;
    const motionEnabled = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const describeTransitionReason = (region: SceneRegion, previousRegion?: SceneRegion | null) => {
      if (!previousRegion || previousRegion.kind === region.kind) {
        return {
          detail: 'camera focus + cluster spotlight',
          badges: [] as string[],
          arcTitle: `${region.rankingLabel}`,
          arcDetail: '3D route preview',
          arcKicker: '3D route cue',
        };
      }
      const contrast = (region.contrasts || []).find((item) => item.kind === previousRegion.kind);
      if (!contrast) {
        return {
          detail: `${previousRegion.rankingLabel} -> ${region.rankingLabel} · camera focus + cluster spotlight`,
          badges: [] as string[],
          arcTitle: `${previousRegion.rankingLabel} → ${region.rankingLabel}`,
          arcDetail: 'camera focus + cluster spotlight',
          arcKicker: '3D route cue',
        };
      }
      const axisLead = contrast.axisDiffs?.[0];
      const metricLead = contrast.metricDiffs?.[0];
      const axisText = axisLead
        ? `${axisLead.axis.toUpperCase()} ${formatSignedDeltaLabel(Number(axisLead.delta || 0))}`
        : 'space delta';
      const metricText = metricLead
        ? `${metricLead.label} ${formatSignedDeltaLabel(Number(metricLead.delta || 0))}`
        : 'metric delta';
      return {
        detail: `${previousRegion.rankingLabel} -> ${region.rankingLabel} · ${axisText} · ${metricText}`,
        badges: [axisText, metricText].filter(Boolean),
        arcTitle: `${previousRegion.rankingLabel} → ${region.rankingLabel}`,
        arcDetail: contrast.separationNote,
        arcKicker: '3D route cue',
      };
    };

    const updateArcGuidePosition = () => {
      if (!(regionArcGuide instanceof HTMLElement) || !transitionGuidePoint) return;
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      group.updateMatrixWorld(true);
      camera.updateMatrixWorld();
      const world = group.localToWorld(transitionGuidePoint.clone());
      const projected = world.project(camera);
      const visible = projected.z > -1 && projected.z < 1;
      if (!visible || transitionFade <= 0) {
        regionArcGuide.dataset.active = 'false';
        return;
      }
      const x = ((projected.x + 1) / 2) * width;
      const y = ((-projected.y + 1) / 2) * height;
      const guideWidth = regionArcGuide.offsetWidth || 220;
      const guideHeight = regionArcGuide.offsetHeight || 84;
      const clampedX = Math.min(width - guideWidth / 2 - 10, Math.max(guideWidth / 2 + 10, x));
      const clampedY = Math.min(height - 16, Math.max(guideHeight + 12, y));
      regionArcGuide.dataset.active = 'true';
      regionArcGuide.style.setProperty('--arc-guide-opacity', Math.max(0.16, transitionFade).toFixed(3));
      regionArcGuide.style.transform = `translate(${clampedX}px, ${clampedY}px) translate(-50%, -100%)`;
    };

    const updateArcGuide = (region: SceneRegion, previousRegion?: SceneRegion | null) => {
      if (!(regionArcGuide instanceof HTMLElement)) return;
      const guide = describeTransitionReason(region, previousRegion);
      regionArcGuide.dataset.active = previousRegion && previousRegion.kind !== region.kind ? 'true' : 'false';
      regionArcGuide.style.setProperty('--arc-guide-accent', region.color);
      if (regionArcGuideKicker instanceof HTMLElement) {
        regionArcGuideKicker.textContent = guide.arcKicker;
      }
      if (regionArcGuideTitle instanceof HTMLElement) {
        regionArcGuideTitle.textContent = guide.arcTitle;
      }
      if (regionArcGuideDetail instanceof HTMLElement) {
        regionArcGuideDetail.textContent = guide.arcDetail;
      }
      if (regionArcGuideBadges instanceof HTMLElement) {
        regionArcGuideBadges.innerHTML = guide.badges.map((badge) => `<span>${escapeHtml(badge)}</span>`).join('');
      }
    };

    const updateFallbackStage = (region: SceneRegion, previousRegion?: SceneRegion | null) => {
      fallbackTargets.forEach((target) => {
        const kind = target.getAttribute('data-region-fallback-target');
        target.dataset.active = kind === region.kind ? 'true' : 'false';
        target.dataset.routeSource = previousRegion && previousRegion.kind !== region.kind && kind === previousRegion.kind ? 'true' : 'false';
        target.dataset.routeTarget = previousRegion && previousRegion.kind !== region.kind && kind === region.kind ? 'true' : 'false';
      });
      if (!(fallbackRouteLayer instanceof SVGGElement)) return;
      if (!previousRegion || previousRegion.kind === region.kind || !region.fallbackOverlay || !previousRegion.fallbackOverlay) {
        fallbackRouteLayer.innerHTML = '';
        return;
      }
      const guide = describeTransitionReason(region, previousRegion);
      const badges = guide.badges.slice(0, 2);
      const startX = previousRegion.fallbackOverlay.centerX;
      const startY = previousRegion.fallbackOverlay.centerY;
      const endX = region.fallbackOverlay.centerX;
      const endY = region.fallbackOverlay.centerY;
      const controlX = Number(((startX + endX) / 2).toFixed(1));
      const controlY = Number((Math.min(startY, endY) - 54).toFixed(1));
      const midX = Number(((startX + endX) / 2).toFixed(1));
      const midY = Number((((startY + endY) / 2) - 42).toFixed(1));
      fallbackRouteLayer.innerHTML = `
        <defs>
          <marker
            id="value-lsh-fallback-route-arrow"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto"
          >
            <path d="M 0 0 L 10 5 L 0 10 z" fill="${escapeHtml(region.color)}"></path>
          </marker>
        </defs>
        <path
          d="M ${startX.toFixed(1)} ${startY.toFixed(1)} Q ${controlX} ${controlY} ${endX.toFixed(1)} ${endY.toFixed(1)}"
          fill="none"
          stroke="${escapeHtml(region.color)}"
          stroke-width="4"
          stroke-linecap="round"
          stroke-opacity="0.86"
          marker-end="url(#value-lsh-fallback-route-arrow)"
        ></path>
        <circle cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" r="10" fill="rgba(255,252,248,.96)" stroke="rgba(20,25,34,.24)" stroke-width="1.6"></circle>
        <circle cx="${endX.toFixed(1)}" cy="${endY.toFixed(1)}" r="12" fill="rgba(255,252,248,.98)" stroke="${escapeHtml(region.color)}" stroke-width="2.2"></circle>
        <g transform="translate(${midX}, ${midY})">
          <rect x="-88" y="-18" width="176" height="36" rx="12" fill="rgba(255,252,248,.96)" stroke="${escapeHtml(region.color)}" stroke-width="1.5"></rect>
          <text x="0" y="-3" text-anchor="middle" font-size="10" font-weight="800" fill="#1f2430">${escapeHtml(guide.arcTitle)}</text>
          <text x="0" y="10" text-anchor="middle" font-size="9" font-weight="700" fill="rgba(31,36,48,.68)">${escapeHtml(badges.join(' · '))}</text>
        </g>
      `;
    };

    const announceRegionGuide = (region: SceneRegion, previousRegion?: SceneRegion | null) => {
      if (!(regionGuide instanceof HTMLElement)) return;
      const guide = describeTransitionReason(region, previousRegion);
      regionGuide.dataset.active = 'true';
      if (regionGuideLabel instanceof HTMLElement) {
        regionGuideLabel.textContent = `Guiding to ${region.arrow} ${region.rankingLabel}`;
      }
      if (regionGuideDetail instanceof HTMLElement) {
        regionGuideDetail.textContent = guide.detail;
      }
      if (regionGuideBadges instanceof HTMLElement) {
        regionGuideBadges.innerHTML = guide.badges.map((badge) => `<span>${escapeHtml(badge)}</span>`).join('');
      }
      window.clearTimeout(guideTimer);
      guideTimer = window.setTimeout(() => {
        if (regionGuide instanceof HTMLElement) regionGuide.dataset.active = 'false';
      }, 1400);
    };

    stage.addEventListener('pointerdown', (event) => {
      pointerActive = true;
      pointerMoved = false;
      lastX = event.clientX;
      lastY = event.clientY;
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointermove', (event) => {
      if (!pointerActive) return;
      if (Math.abs(event.clientX - lastX) + Math.abs(event.clientY - lastY) > 2) pointerMoved = true;
      targetY += (event.clientX - lastX) * 0.006;
      targetX += (event.clientY - lastY) * 0.004;
      targetX = Math.max(-1.15, Math.min(1.15, targetX));
      lastX = event.clientX;
      lastY = event.clientY;
    });
    stage.addEventListener('pointerup', () => {
      pointerActive = false;
    });
    stage.addEventListener('pointercancel', () => {
      pointerActive = false;
    });

    stage.addEventListener('click', (event) => {
      if (!hasWebGL || pointerMoved) return;
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointer, camera);
      const hits = raycaster.intersectObject(pointsCloud);
      const hit = hits[0];
      if (!hit || typeof hit.index !== 'number') return;
      const node = nodes[hit.index];
      if (node) selectNode(node);
    });

    regionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const region = regions.find((candidate) => candidate.kind === button.dataset.regionId);
        if (region) selectRegion(region);
      });
    });
    regionCompareButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const region = regions.find((candidate) => candidate.kind === button.dataset.regionCompareId);
        if (region) selectRegion(region);
      });
    });
    if (regionSummaryMap instanceof SVGElement) {
      regionSummaryMap.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const node = target.closest('[data-region-map-node]');
        const regionId = node?.getAttribute('data-region-map-node');
        if (!regionId) return;
        const region = regions.find((candidate) => candidate.kind === regionId);
        if (region) selectRegion(region);
      });
    }
    if (fallbackSvg instanceof SVGSVGElement) {
      fallbackSvg.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const regionButton = target.closest('[data-region-fallback-target]');
        const regionId = regionButton?.getAttribute('data-region-fallback-target');
        if (!regionId) return;
        const region = regions.find((candidate) => candidate.kind === regionId);
        if (region) selectRegion(region);
      });
    }
    if (regionPrevButton instanceof HTMLButtonElement) {
      regionPrevButton.addEventListener('click', () => selectRegionByIndex(activeRegionIndex - 1));
    }
    if (regionNextButton instanceof HTMLButtonElement) {
      regionNextButton.addEventListener('click', () => selectRegionByIndex(activeRegionIndex + 1));
    }
    if (regionSummaryPanel instanceof HTMLElement) {
      regionSummaryPanel.addEventListener('click', (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest('[data-region-focus-node]') : null;
        if (!(target instanceof HTMLElement)) return;
        const nodeId = target.dataset.regionFocusNode;
        if (nodeId) focusRepresentativeNode(nodeId);
      });
    }

    const defaultRegion = regions[0];
    if (defaultRegion) {
      selectRegion(defaultRegion);
    } else {
      selectNode(nodes.find((node) => node.neighbors.length > 0) || nodes[0]);
    }

    if (hasWebGL) {
      root.classList.add('is-canvas-ready');
    } else {
      root.dataset.valueLshMode = 'fallback';
      if (fallbackSurface instanceof HTMLElement) {
